    // Progress bar for long operations.
    op-copying: string,
    op-moving: string,
    op-deleting: string,
    op-deleting-permanently: string,
    op-duplicating: string,
    op-scanning: string,
    op-done: string,
    op-cancelled: string,
    op-errors: string,           // e.g.: "Finished with errors"
