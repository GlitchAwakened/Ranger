    ow-pick-browse: string,
    ow-custom: string,
    ow-use-as-app: string,
    ow-manage: string,
    ow-title: string,
    ow-name: string,
    ow-program: string,
    ow-store-program: string,       // label of the frozen Program field (OS/Store app)
    ow-args: string,
    ow-tags: string,
    // Tooltips explaining what each insertable tag stands for.
    ow-tag-file: string,
    ow-tag-dir: string,
    ow-tag-dirname: string,
    ow-tag-name: string,
    ow-tag-stem: string,
    ow-tag-ext: string,
    ow-tag-uri: string,
    ow-tag-files: string,
    ow-preview: string,
    ow-add-suggested: string,
    ow-recipes-label: string,   // section title, also its accessible label
    ow-recipes-hint: string,    // what the recipes are and why some are absent
    ow-launch: string,
    ow-default-ext: string,
    ow-set-default: string,     // "Set as default" checkbox of the app picker
    ow-used-ext: string,        // "Suggested in Open with for these extensions"
    ow-run-as-admin: string,    // "Run as administrator" checkbox (Windows)
    ow-default-ext-hint: string, // tooltip for the "default app" label
    ow-show-in-section: string,  // title of the "Where to show this command" panel
    ow-ctx-menu: string,        // "Show in the context menu:" label
    ow-ctx-files: string,       // "Files" checkbox
    ow-ctx-dirs: string,        // "Folders" checkbox
    ow-ctx-background: string,  // "View background" checkbox
    ow-ctx-ext: string,         // extension filter of the Files entry
    ow-ctx-ext-hint: string,    // what "*" means, and that it only affects Files
    ow-used-ext-hint: string,   // what the "suggested for" list does
    settings-shellmenu-label: string, // settings card: Windows context menu
    settings-shellmenu-hint: string,
    settings-shellext-list-label: string, // sub-tab: detected Windows entries
    settings-shellext-list-hint: string,
    settings-shellext-empty: string,      // no entry detected
    ow-move-up: string,         // tooltips for the Open-with list buttons
    ow-move-down: string,
    ow-duplicate-tip: string,
    ow-edit-tip: string,
    ow-delete-tip: string,
    settings-openers-section: string,
    ow-add: string,
    ow-empty: string,
    ow-search-placeholder: string,
    ow-no-results: string,
    ow-promote: string,
    ow-promote-add: string,
}

// ---------- Internal components ----------

// ===== Custom application palette =====
// Slint does NOT allow overriding `Palette`'s colors (`out` properties
// locked by the Fluent style: light background #FAFAFA "too white", accent
// #005FB8 "flashy"). So we define OUR OWN palette and use it everywhere
// (the remaining `std-widgets` — settings combobox, scrollbars — stay
// styled by Fluent, which is marginal).
//
// `dark` is derived from the LUMINANCE of the background resolved by Fluent
// (`StyleMetrics.window-background`), which reflects the EFFECTIVE scheme, including
// "auto" mode (follows the system) — `apply-theme()` always drives
// `Palette.color-scheme`, Fluent resolves it, and we read the result here.
//
// Direction: cool "slate" ramp with DEPTH (stacked surfaces).
//   - Dark: "heightened" Polar Night, with moderate blue saturation and
//       contrast. Channel
//       #1b2230 < toolbar #222a39 < card #2a3242 < hover #3a455c <
//       border #46536e; brighter Frost cyan accent #7CCBE1. Bright snow text.
//   - Light: "muted slate" Nord, with a moderate luminance ceiling for visual
//       comfort. The soft surfaces and contrasted edges mirror the
//       dark theme's hierarchy, inverted. Polar Night text and the Frost
//       accent ensure crisp reading on large light surfaces.
global Theme {
    out property <bool> dark: Palette.background.to-hsv().value < 0.5;
    // Opacity of an untargeted HIDDEN entry (dotfile / HIDDEN): "pale" but
    // readable. Light theme one notch more opaque (dark text quickly loses its
    // contrast on a light background). Stays > 0.45 (= "cut off") to distinguish them.
    out property <float> hidden-opacity: root.dark ? 0.55 : 0.58;

    // "Channel" background (window + groove) — the MOST recessed level.
    // In light theme, a slightly cool grey sets the white cards apart from
    // the groove without weighing down the whole.
    out property <color> background: root.dark ? #1b2230 : #e3e9f1;
    // Card surface (panels) = VIEW BACKGROUND. Light: near-white,
    // very slightly cool (#f8fafc). The borders and chrome, a bit more
    // grey, outline the large file area without darkening its surface.
    out property <color> surface:    root.dark ? #2a3242 : #f8fafc;
    // Light "chrome": activity rail + sidebar + view's top toolbar
    // (tabs + navigation). Deliberately a real step below the card rather
    // than a near-identical shade — at 1.07:1 the two read as one surface and
    // the layout had no edges of its own. Now 1.28:1, with roughly three
    // times the blue chroma so the chrome is coloured and the reading area
    // stays neutral.
    out property <color> toolbar:    root.dark ? #222a39 : #E9EEF5;
    // Alternate background (hovers, bullets, headers). Kept BELOW the chrome
    // it sits on: a hover lighter than the sidebar would brighten there while
    // darkening on the file rows, the same gesture reading two ways. Visible
    // on both (1.22:1 over the chrome, 1.56:1 over the card).
    out property <color> alternate-background: root.dark ? #3a455c : #E9EEF5;
    // Text — bright snow (dark) / deep slate (light) = strong contrast.
    out property <color> foreground: root.dark ? #eceff4 : #202733;
    // Borders / hairlines — define the edges (the crisp relief gives the light theme its
    // clear readability, all the more necessary with light surfaces).
    out property <color> border: root.dark ? #46536e : #ccd6e4;
    // Accent and its associated text. Deepened along with the chrome: it
    // carries the drive icons INSIDE the sidebar, and the previous azure was
    // already under the 4.5:1 floor there (4.16:1) before the chrome moved.
    // Now 5.84:1 on the chrome and 4.79:1 on a hovered row.
    out property <color> accent-background: root.dark ? #7ccbe1 : #1f5292;
    out property <color> accent-foreground: root.dark ? #1b2230 : #ffffff;
}

// Shared design tokens, adapted to the active theme.
global Tokens {
    // "Danger" red = Nord Aurora (BF616A), softened/lightened depending on the theme.
    out property <color> danger: Theme.dark ? #c4757c : #bf616a;
    // "Success" green = Nord Aurora (A3BE8C), same theme-adaptation logic.
    out property <color> success: Theme.dark ? #a3be8c : #7a9a5e;
    // "Pending / unsaved" amber: signals a workspace that has been modified
    // but not saved. Distinct from danger (red = loss) and from the accent
    // (blue = identity/active).
    out property <color> warning: Theme.dark ? #eab464 : #d08019;
    out property <length> radius-overlay: 8px;
    // Left gutter of the lists: blank strip (not a row click zone)
    // so a right-click "paste into folder" still works even with a full
    // list. ONE single source of truth: strip width + content
    // inset (= gutter + small inset to give the icon room in the highlight).
    out property <length> gutter: 30px;
    out property <length> gutter-content: root.gutter + 6px;
    // Horizontal spacing between columns (header AND rows). MUST stay
    // in sync with `COL_GAP` on the bridge side (column offset computation).
    out property <length> col-gap: 8px;

    // ----- Card-style view design -----
    // Panel radius (soft, modern card look).
    out property <length> radius-panel: 9px;
    // Row highlight radius (selection / hover pill).
    out property <length> radius-row: 6px;
    // Half-gutter between panels: applied as an inset on all 4 sides of
    // each panel → 2x between two panels, 1x against the container edge.
    out property <length> panel-gap: 4px;
    // Padding of a panel's root row. Also referenced by `sel-touch`,
    // which extends over it so the ENTIRE visual gutter is draggable.
    out property <length> panel-pad: 7px;
    // Thin hairline (under the column header, subtle separators).
    out property <color> hairline: Theme.border.with-alpha(0.6);
    // Color of the "groove" (channel) between panels: the theme's "channel"
    // background (more recessed than the card surface → detached tiles).
    out property <color> trough: Theme.background;
    // Color of the file extension in the list (blue): light on a dark
    // background; saturated blue on a light background (accent family) to
    // clearly stand out on the near-white cards.
    out property <color> ext: Theme.dark ? #8ec7e6 : #3168c4;

    // All columns, including "age", "resolution", and "depth",
    // use a resizable width in `ColumnSpec.width`.
    // Text color for the age, based on the hot→cold bucket (0 = recent
    // … 6 = old). Hues stable across both themes; the pill background reuses
    // this color with a low alpha to keep the age scale unobtrusive.
    // Empty part of a gauge. Alpha-based so it tracks whatever surface it sits
    // on, and light enough that the filled part reads as the figure.
    out property <color> track: Theme.dark
        ? Theme.foreground.with-alpha(0.12)
        : #C0C8CD;

    // Fill of a drive's capacity gauge, by remaining-space level
    // (0 roomy · 1 low · 2 critical).
    //
    // Level 0 is deliberately colourless. A sidebar of five drives would
    // otherwise carry five saturated bars competing for attention with the
    // file list, and the one drive that IS running out would no longer stand
    // out among them. Colour is spent only where it means something.
    //
    // The warning hues are lifted straight from `warning`/`danger`, and the
    // light theme takes them much softer: these sit UNDER text, the reverse of
    // their usual role, and on a pale surface the same alpha that reads as
    // discreet on a dark one comes out heavy. A gauge is ambient information —
    // it should be legible at a glance and invisible the rest of the time.
    //
    // Alphas over the light toolbar (#eef2f7), against a 0.12 track:
    //   level 0  0.22 → #c0c5cc, twenty-odd levels below the track: present,
    //                   not a slab
    //   warning  0.42 → #e1c29a wash
    //   danger   0.42 → #dab5bc wash
    // The dark theme is unchanged; it was not the one at fault.
    public pure function disk-fill(level: int) -> color {
        level >= 2 ? (Theme.dark ? #d08d92 : root.danger.with-alpha(0.42))
            : level == 1 ? (Theme.dark ? root.warning : root.warning.with-alpha(0.42))
            : (Theme.dark ? Theme.foreground.with-alpha(0.30) : #A3ADB5);
    }

    // Ink for the part of the label that crosses the fill. On a colourless
    // fill it stays the ordinary text colour, so no seam shows; on a warning
    // fill in the dark theme the band is bright and takes dark ink instead.
    public pure function disk-ink(level: int) -> color {
        Theme.dark
            ? (level <= 0 ? Theme.foreground : Theme.background)
            : Theme.foreground;
    }

    public pure function age-color(bucket: int) -> color {
        bucket <= 0 ? (Theme.dark ? #f0786a : #c0392b)   // < 1h warm red
            : bucket == 1 ? (Theme.dark ? #ef9a4f : #b06317) // < 6h orange
            : bucket == 2 ? (Theme.dark ? #e3bd4e : #8a6d12) // < 1d amber
            : bucket == 3 ? (Theme.dark ? #9fc06a : #54802f) // < 7d yellow-green
            : bucket == 4 ? (Theme.dark ? #5fb39a : #2a7a66) // < 30d teal-green
            : bucket == 5 ? (Theme.dark ? #6ba0c4 : #3a6797) // < 1y blue
            : (Theme.dark ? #8b95a7 : #586780);              // ≥ 1y cool grey
    }
}

// GLOBAL tooltip: set by any button on hover, rendered at the
// window level (above everything) → never hidden/clipped by a
// panel drawn afterward. `text == ""` = hidden.
global Tip {
    in-out property <string> text: "";
    in-out property <length> x;
    in-out property <length> y;
}

// "Click elsewhere" closing of the context menu. This menu
// deliberately has NO backdrop (see its declaration: clicks on the CONTENT
// close it IN PASSING — selection + close in a single click, right-click =
// repositioning). The "chrome" (rail, sidebar, favorites, tabs, headers,
// nav buttons, splitters, empty areas) increments `serial` on every
// interaction; MainWindow observes it (`dismiss-watch`) and closes the menu.
// Surfaces that OPEN the menu (row right-click / empty list area)
// do NOT bump the counter. Same global-window principle as `Tip`.
global Dismiss {
    in-out property <int> serial: 0;
}

component NavIconButton inherits Rectangle {
    callback clicked();
    /// Variant with position: (button x, y BELOW the button + 4px), in
    /// absolute coordinates read by the INTERNAL TouchArea — the same reliable
    /// path used for tooltip positioning (`Tip`). Used by buttons that
    /// OPEN a menu anchored below them. Emitted in addition to `clicked`.
    callback clicked-at(length, length);
    in property <string> glyph;
    in property <image> icon;
    in property <string> tooltip-text;
    in property <bool> enabled: true;
    /// Unicode glyph size (ignored if `icon` is set).
    in property <length> glyph-size: 18px;
    /// false = does NOT increment the global Dismiss counter on click. REQUIRED for
    /// a button that OPENS a menu: MainWindow's (deferred) `changed dismiss-watch`
    /// would otherwise close the menu right AFTER it opens — the same
    /// reason the split token never bumped Dismiss.
    in property <bool> dismiss-bump: true;

    width: 32px;
    height: 28px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled
        ? Theme.alternate-background
        : transparent;
    opacity: root.enabled ? 1.0 : 0.35;

    if root.icon.width > 0 : Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: Theme.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.icon.width == 0 : Text {
        text: root.glyph;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: root.glyph-size;
        color: Theme.foreground;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            if (root.dismiss-bump) { Dismiss.serial += 1; }
            root.clicked-at(
                self.absolute-position.x,
                self.absolute-position.y + root.height + 4px);
            root.clicked();
        }
        // Tooltip below the button (URL bar on top). Sets/clears the global Tip.
        changed has-hover => {
            if (self.has-hover && root.tooltip-text != "") {
                Tip.text = root.tooltip-text;
                Tip.x = self.absolute-position.x;
                Tip.y = self.absolute-position.y + root.height + 4px;
            } else if (Tip.text == root.tooltip-text) {
                Tip.text = "";
            }
        }
    }
}

// Mini chevron scroll button for the tab bar. Same idiom as the "+"
// button (24x26, no border, hover = alternate-background), greyed out at the
// end (opacity 0.35). Press = tokens of the ACTIVE tab (accent). Tooltip via the global Tip.
component TabScrollButton inherits Rectangle {
    callback clicked();
    in property <image> icon;
    in property <string> tooltip-text;
    in property <bool> enabled: true;
    width: 24px;
    height: 26px;
    border-radius: 5px;
    opacity: root.enabled ? 1.0 : 0.35;
    background: !root.enabled
        ? transparent
        : (tsb-touch.pressed
            ? Theme.accent-background.with-alpha(0.22)
            : (tsb-touch.has-hover ? Theme.alternate-background : transparent));
    border-width: 1px;
    border-color: (root.enabled && tsb-touch.pressed)
        ? Theme.accent-background.with-alpha(0.55)
        : transparent;
    Image {
        source: root.icon;
        width: 12px;
        height: 12px;
        colorize: Theme.foreground.with-alpha((tsb-touch.has-hover && root.enabled) ? 1.0 : 0.75);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    tsb-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { Dismiss.serial += 1; root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip-text != "") {
                Tip.text = root.tooltip-text;
                Tip.x = self.absolute-position.x;
                Tip.y = self.absolute-position.y + root.height + 4px;
            } else if (Tip.text == root.tooltip-text) {
                Tip.text = "";
            }
        }
    }
}

component ColumnHeader inherits Rectangle {
    callback clicked();
    /// Resize in progress: new width (the parent applies it to the right
    /// property via `set-col-width` → no two-way binding, `for`-compatible).
    callback resized(length);
    /// End of resize (to persist it).
    callback resize-finished();
    /// Right-click on the header (absolute position) → column menu.
    callback right-clicked(length, length);
    /// Column reordering. The delta is computed in the event
    /// handlers, where `absolute-position` can be read without a reactive dependency.
    /// The drop target uses the offsets provided by the bridge so as not to
    /// create a cycle between layout and component properties.
    callback reorder-start(length /*center of the dragged column, px*/);
    callback reorder-move(length /*delta px*/);
    callback reorder-end(length /*delta px*/);
    callback report-drop-target(int);
    /// Current width (read-only — provided by the parent: `width-of(id)`).
    in property <length> column-width: 100px;
    in property <string> label;
    in property <string> column-id;
    in property <bool> active: false;
    in property <bool> asc: true;
    in property <length> min-col-width: 60px;
    in property <int> index;               // visible index (column 0 = anchor)
    in property <int> count;               // number of visible columns
    in property <length> offset;           // cumulative left offset (px), plain
    in property <bool> col-drag-active: false;
    in property <length> col-drag-new-center: 0px;  // dragged center + delta (plain)
    in property <int> col-drop-idx: -1;    // current target gap (from the parent)

    width: root.column-width;

    property <length> drag-start-x;        // resize grip
    property <length> drag-start-w;        // resize grip
    property <length> press-x;             // reorder drag
    property <bool> dragging: false;       // THIS header is being dragged
    // Gap claimed if the targeted center falls within THIS header (left half →
    // before it = `index`; right half → after = `index+1`). ≥ 1 (anchor `name`).
    // All in PLAIN (offset/width/new-center) → no layout cycle.
    property <int> my-drop-target:
        (!root.col-drag-active
            || root.col-drag-new-center < root.offset
            // Claimed zone = column + its right-hand gap → continuous tiling
            // (no dead zone between columns).
            || root.col-drag-new-center >= root.offset + root.column-width + Tokens.col-gap)
        ? -1
        : max(1, root.col-drag-new-center < root.offset + root.column-width / 2
            ? root.index
            : root.index + 1);
    changed my-drop-target => {
        if (root.my-drop-target >= 0) { root.report-drop-target(root.my-drop-target); }
    }

    opacity: root.dragging ? 0.4 : 1.0;

    background: root.dragging
        ? Theme.accent-background.with-alpha(0.18)
        : (touch.has-hover && !grip.has-hover
            ? Theme.alternate-background.with-alpha(0.6)
            : transparent);
    border-radius: 5px;

    // Live insertion line: to the left of the header at the target gap, and to the right of
    // the last header if the gap is "at the end".
    if root.col-drag-active && root.col-drop-idx == root.index && root.index >= 1 : Rectangle {
        // Aligned on the column separator (= right edge of the previous
        // column, where the resize grip line sits), so that the
        // preview coincides with the visible separation. The left edge of THIS
        // header is at `-col-gap` from the previous separator.
        x: -(Tokens.col-gap) - 1px;
        width: 2px;
        height: parent.height;
        background: Theme.accent-background;
    }
    if root.col-drag-active && root.index == root.count - 1 && root.col-drop-idx == root.count : Rectangle {
        // Drop at the end: on the right edge (separator) of the last header.
        x: parent.width - 1px;
        width: 2px;
        height: parent.height;
        background: Theme.accent-background;
    }

    touch := TouchArea {
        mouse-cursor: root.dragging ? grabbing : default;
        pointer-event(ev) => {
            // LEFT click on a header closes context menus; right-click
            // (column menu) does not bump → it can teleport the menu.
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) { Dismiss.serial += 1; }
            if (ev.button == PointerEventButton.left) {
                if (ev.kind == PointerEventKind.down) {
                    root.press-x = self.absolute-position.x + self.mouse-x;
                    root.dragging = false;
                }
                if (ev.kind == PointerEventKind.up) {
                    if (root.dragging) {
                        root.reorder-end(self.absolute-position.x + self.mouse-x - root.press-x);
                        root.dragging = false;
                    } else {
                        root.clicked();   // simple click = sort
                    }
                }
            }
            if (ev.kind == PointerEventKind.down
                    && ev.button == PointerEventButton.right) {
                root.right-clicked(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        moved => {
            if (self.pressed) {
                // Drag starts past a threshold; `name` (index 0) is frozen.
                if (!root.dragging && root.index > 0
                        && abs(self.absolute-position.x + self.mouse-x - root.press-x) > 5px) {
                    root.dragging = true;
                    root.reorder-start(root.offset + root.column-width / 2);
                }
                if (root.dragging) {
                    root.reorder-move(self.absolute-position.x + self.mouse-x - root.press-x);
                }
            }
        }
    }

    // This wrapper clips the label and caret to the column frame, even
    // when it is narrow. The reordering lines and the resize
    // grip stay outside this clip.
    Rectangle {
        clip: true;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 14px; // room for the grip on the right
            spacing: 4px;
            alignment: start;
            Text {
                text: root.label;
                font-size: 11px;
                font-weight: root.active ? 700 : 600;
                letter-spacing: 0.4px;
                color: root.active
                    ? Theme.foreground
                    : Theme.foreground.with-alpha(0.55);
                vertical-alignment: center;
            }
            // Full-height slot (the Rectangle fills the row height
            // within the HorizontalLayout) with the caret explicitly centered — an
            // `Image` placed directly in a layout snaps to the TOP, hence this
            // wrapper + manual centering.
            if root.active : Rectangle {
                width: 14px;
                Image {
                    source: root.asc
                        ? @image-url("../../assets/icons/caret-up.svg")
                        : @image-url("../../assets/icons/caret-down.svg");
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.accent-background;
                }
            }
        }
    }

    // Resize grip on the right edge. It stays instantiated for
    // all columns, since the header background references the `grip` element.
    Rectangle {
        visible: true;
        x: parent.width - self.width / 2;
        y: 3px;
        width: 8px;
        height: parent.height - 6px;
        background: grip.has-hover || grip.pressed
            ? Theme.foreground.with-alpha(0.25)
            : transparent;
        // 1px line, always visible.
        Rectangle {
            x: parent.width / 2 - 0.5px;
            width: 1px;
            height: parent.height;
            background: Theme.border;
        }
        grip := TouchArea {
            mouse-cursor: ew-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down
                        && ev.button == PointerEventButton.left) {
                    Dismiss.serial += 1;
                    root.drag-start-x = self.absolute-position.x + self.mouse-x;
                    root.drag-start-w = root.column-width;
                }
                if (ev.kind == PointerEventKind.up
                        && ev.button == PointerEventButton.left) {
                    root.resize-finished();
                }
            }
            moved => {
                if (self.pressed) {
                    root.resized(max(root.min-col-width,
                        root.drag-start-w
                        + (self.absolute-position.x + self.mouse-x - root.drag-start-x)));
                }
            }
        }
    }
}

// File row — PURELY visual (no per-row interactivity:
// clicks/drag/hover are handled by a single stable TouchArea above the
// viewport, see `sel-touch`, to survive row virtualization).
component FileRowView inherits Rectangle {
    in property <string> name;
    in property <string> name-base;
    in property <string> name-ext;
    in property <string> path;
    in property <string> size;
    in property <string> modified;
    in property <bool> is-dir;
    in property <bool> is-symlink;        // symbolic link / junction
    in property <int> kind;
    in property <bool> selected;
    in property <bool> cut;
    in property <bool> hovered;
    in property <bool> hidden;            // hidden (dotfile / HIDDEN attribute)
    in property <string> age;             // formatted age ("age" column)
    in property <int> age-bucket;         // 0 recent (hot) … 6 old; -1 unknown
    in property <string> resolution;      // "1920x1080" (optional column)
    in property <string> depth;           // "32-bit +A" (optional column)
    in property <string> ext;             // extension without the dot (optional column)
    in property <bool> preview-mode;     // preview mode (thumbnails)
    in property <length> row-h: 28px;    // EFFECTIVE height of this row
    in property <image> thumbnail;       // empty if not generated / no preview
    in property <image> app-icon;        // OS app icon by extension — empty = fall back to SVG
    in property <bool> link-folder;      // .lnk shortcut → folder: folder icon + arrow

    // Sizes derived from zoom. In list mode, the icon grows gently
    // with height; in thumbnail mode, the thumbnail/icon fills almost
    // the entire row height (no empty bands top/bottom).
    property <bool> enlarged-row: root.preview-mode && root.row-h > 34px;
    property <length> icon-size: root.enlarged-row
        ? root.row-h - 4px
        : clamp(root.row-h - 12px, 16px, 26px);
    // Slot (cell) that reserves room for the icon/thumbnail in the name column.
    // Wider than tall in thumbnail mode → landscape images fill the
    // height without being too cramped; bounded by the name column width (minus
    // a margin for the text) so it never overflows into the other columns.
    property <length> icon-slot: root.enlarged-row
        ? max(40px, min(root.row-h * 1.5, root.col-name-width - 40px))
        : root.icon-size + 4px;
    in property <length> col-name-width;
    in property <length> col-path-width;
    in property <length> col-size-width;
    in property <length> col-modified-width;
    in property <length> col-ext-width;   // resizable width, "ext"
    in property <length> col-resolution-width;  // resizable width
    in property <length> col-depth-width;        // resizable width
    in property <length> col-age-width;          // resizable width, "age"
    in property <length> content-width;   // total width of visible columns
    in property <[ColumnInfo]> columns;   // visible columns, in order

    // Resizable width of a column, resolved from its identifier.
    function width-of(id: string) -> length {
        id == "path" ? root.col-path-width
            : id == "size" ? root.col-size-width
            : id == "modified" ? root.col-modified-width
            : id == "ext" ? root.col-ext-width
            : id == "resolution" ? root.col-resolution-width
            : id == "depth" ? root.col-depth-width
            : id == "age" ? root.col-age-width
            : root.col-name-width;
    }
    // Text content of a cell based on the column id.
    function cell-text(id: string) -> string {
        id == "path" ? root.path
            : id == "size" ? root.size
            : id == "modified" ? root.modified
            : id == "ext" ? root.ext
            : id == "resolution" ? root.resolution
            : id == "depth" ? root.depth
            : root.name;
    }

    // Real thumbnail available (preview mode + decoded image)?
    property <bool> show-thumb: root.preview-mode && root.thumbnail.width > 0;
    // OS app icon available: non-folder file, non-empty extracted icon,
    // and NO real thumbnail to display. So true in list mode AND in
    // preview mode when the file has no content thumbnail (doc, archive…).
    // In preview mode, the icon is extracted at 256px → crisp even when enlarged.
    property <bool> show-app-icon: !root.show-thumb && root.kind != 0 && root.app-icon.width > 0;

    // Dim hidden entries at the primitive level. Applying opacity to the whole
    // row would make Slint render its multi-child subtree into an offscreen
    // layer; compositing that texture at a fractional UI scale softens text.
    // Per-primitive alpha keeps glyphs rasterized at the effective DPI and is
    // cheaper than allocating one intermediate layer per visible hidden row.
    property <float> hidden-content-alpha: (!root.cut && root.hidden
        && !root.selected && !root.hovered) ? Theme.hidden-opacity : 1.0;

    height: root.row-h;
    // A cut row remains globally faded to preserve the existing semantics.
    // Hidden fading is handled per primitive above and never stacks with it.
    opacity: root.cut ? 0.45 : 1.0;

    // Highlight (selection / hover) as a rounded PILL, inset from
    // the gutter on the left (which stays blank) and a small margin on the right
    // → modern "selected row" look that doesn't touch the edges.
    Rectangle {
        x: Tokens.gutter;
        y: 2px;
        // Bounded to the right edge of the columns to reserve the empty area for the
        // selection rectangle. If the columns fill the view, it takes up
        // the whole available width.
        // Columns: from `gutter-content` to `gutter-content + content-width`; the
        // pill starts at `gutter` → max width = content-width + (gutter-content
        // - gutter).
        width: min(
            parent.width - Tokens.gutter - 8px,
            root.content-width + (Tokens.gutter-content - Tokens.gutter));
        height: parent.height - 4px;
        border-radius: Tokens.radius-row;
        background: root.selected
            ? Theme.accent-background.with-alpha(0.20)
            : (root.hovered
                // Hover: theme's alternate background → present but subtle, and clearly
                // distinct from selection (which is tinted accent + outline).
                ? Theme.alternate-background
                : transparent);
        // Subtle accent outline on the selected row (reinforces without shouting).
        border-width: root.selected ? 1px : 0px;
        border-color: Theme.accent-background.with-alpha(0.45);
    }

    // Cells rendered DYNAMICALLY from the column model: order
    // + visibility driven by `columns`. The "name" cell carries the icon/
    // thumbnail + the name; the others are a plain Text aligned according to the id.
    HorizontalLayout {
        // Content indent = `Tokens.gutter-content` (gutter + icon inset).
        // Must match the column header AND the click threshold in `sel-touch`.
        padding-left: Tokens.gutter-content;
        padding-right: 8px;
        spacing: Tokens.col-gap;

        for col[ci] in root.columns : Rectangle {
            width: root.width-of(col.id);

            // -- Name cell: icon/thumbnail + text --
            if col.id == "name" : HorizontalLayout {
                padding-left: 0px;
                padding-right: 0px;
                spacing: 8px;
                alignment: start;
                Rectangle {
                    width: root.icon-slot;
                    height: parent.height;
                    // Thumbnail: fills the row height (minus a thin margin)
                    // → no empty area above/below; `contain` preserves
                    // the ratio, the slot width lets landscape images breathe.
                    if root.show-thumb : Image {
                        source: root.thumbnail;
                        image-fit: contain;
                        opacity: root.hidden-content-alpha;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    // Real OS application icon for the extension —
                    // in color (no colorize), list mode only.
                    if root.show-app-icon : Image {
                        source: root.app-icon;
                        image-fit: contain;
                        opacity: root.hidden-content-alpha;
                        width: root.icon-size;
                        height: root.icon-size;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    if !root.show-thumb && !root.show-app-icon : Image {
                        opacity: root.hidden-content-alpha;
                        width: root.icon-size;
                        height: root.icon-size;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: root.link-folder ? @image-url("../../assets/icons/folder-symlink.svg")
                            : root.kind == 0 && root.is-symlink ? @image-url("../../assets/icons/folder-symlink.svg")
                            : root.kind == 0 ? @image-url("../../assets/icons/folder.svg")
                            : root.kind == 2 ? @image-url("../../assets/icons/application.svg")
                            : root.kind == 3 ? @image-url("../../assets/icons/archive.svg")
                            : root.kind == 4 ? @image-url("../../assets/icons/audio.svg")
                            : root.kind == 5 ? @image-url("../../assets/icons/document.svg")
                            : root.kind == 6 ? @image-url("../../assets/icons/image.svg")
                            : root.kind == 7 ? @image-url("../../assets/icons/video.svg")
                            : root.kind == 8 ? @image-url("../../assets/icons/reg.svg")
                            : @image-url("../../assets/icons/file.svg");
                        // Folders use a deepened Nord gold (#d9a441),
                        // contrasted enough on light cards. The other types
                        // keep their dedicated hues.
                        colorize: root.link-folder ? #d9a441
                            : root.kind == 0 ? #d9a441
                            : root.kind == 2 ? #a3be8c
                            : root.kind == 3 ? #d08770
                            : root.kind == 4 ? #b48ead
                            : root.kind == 5 ? #81a1c1
                            : root.kind == 6 ? #bf616a
                            : root.kind == 7 ? #8fbcbb
                            : root.kind == 8 ? #8b95a7
                            : Theme.foreground.with-alpha(0.55);
                    }
                }
                // Name = stem + colored extension, JOINED (spacing 0, no
                // gap) → natural "file.ext" rendering. The stem is bounded to
                // (available width − extension width) and elides if too long;
                // the extension therefore always stays visible and attached to the stem.
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;
                    alignment: start;
                    Text {
                        text: root.name-base;
                        font-size: 13px;
                        color: Theme.foreground.with-alpha(root.hidden-content-alpha);
                        vertical-alignment: center;
                        overflow: elide;
                        // Width bounded to the available space of the "name" cell
                        // (col-name-width − icon slot − spacing − extension).
                        // We reference the COLUMN width (explicit, driven
                        // by the bridge) and not `parent.width` (= this layout) →
                        // no binding loop; the stem elides, the extension
                        // stays visible and attached.
                        width: min(
                            self.preferred-width,
                            root.col-name-width - root.icon-slot - 8px - ext-txt.preferred-width);
                    }
                    ext-txt := Text {
                        text: root.name-ext;
                        font-size: 13px;
                        color: Tokens.ext.with-alpha(root.hidden-content-alpha);
                        vertical-alignment: center;
                    }
                }
            }

            // -- Other cells: text (size/modified right-aligned) --
            if col.id != "name" && col.id != "age" : Text {
                text: root.cell-text(col.id);
                font-size: 12px;
                // "ext": same blue hue as the colored extension in the "name"
                // column (Tokens.ext). "path" dimmed; the rest neutral.
                color: col.id == "path"
                    ? Theme.foreground.with-alpha(0.55 * root.hidden-content-alpha)
                    : col.id == "ext"
                    ? Tokens.ext.with-alpha(root.hidden-content-alpha)
                    : Theme.foreground.with-alpha(0.75 * root.hidden-content-alpha);
                vertical-alignment: center;
                horizontal-alignment: (col.id == "size" || col.id == "modified") ? right : left;
                overflow: elide;
                width: parent.width;
            }

            // "age" cell: hot→cold colored pill. The background
            // reuses the bucket color at low alpha, the text takes it at
            // full → freshness spotted at a glance. bucket < 0 →
            // unknown mtime: neutral dimmed text, no pill.
            if col.id == "age" : Rectangle {
                Rectangle {
                    width: age-cell-txt.preferred-width + 14px;
                    height: 18px;
                    x: (parent.width - self.width) / 2;
                    border-radius: 6px;
                    background: root.age-bucket < 0
                        ? transparent
                        : Tokens.age-color(root.age-bucket).with-alpha(
                            (Theme.dark ? 0.20 : 0.16) * root.hidden-content-alpha);
                    age-cell-txt := Text {
                        text: root.age;
                        font-size: 11.5px;
                        font-weight: 600;
                        color: root.age-bucket < 0
                            ? Theme.foreground.with-alpha(0.4 * root.hidden-content-alpha)
                            : Tokens.age-color(root.age-bucket).with-alpha(root.hidden-content-alpha);
                        x: (parent.width - self.width) / 2;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
            }
        }
    }

}

// Shared deferred focus for LineEdits created inside a conditional popup.
// The one-iteration delay lets Slint finish building the widget and
// avoids the cycles observed with a direct focus() in `changed *-open`.
// Text field with EDITING shortcuts wired explicitly.
//
// Slint normally handles Ctrl+A/C/X/V in its `TextInput`… but only if
// the backend delivers the LETTER (`text == "a"`): its shortcut resolution
// only compares letters, and an earlier check rejects CONTROL characters
// before even getting there. Depending on the keyboard layer, Ctrl+A can arrive
// as `"\u{1}"` (SOH) rather than `"a"` — the editing shortcuts then become
// silently inert, including in our popups.
//
// `TextInput` calls this `key-pressed` callback BEFORE its own handling: we
// therefore cover both encodings, once and for all, for every
// field (this component is used in place of `LineEdit`).
component EditTextInput inherits TextInput {
    /// Applies Ctrl+A/C/X/V and returns `true` if the key was consumed.
    /// Public: fields that already have their own `key-pressed` (Escape…)
    /// call it instead of duplicating the logic.
    public function edit-shortcut(ev: KeyEvent) -> bool {
        if (ev.modifiers.control && !ev.modifiers.alt && !ev.modifiers.meta
                && !ev.modifiers.shift) {
            if (ev.text == "a" || ev.text == "A" || ev.text == "\u{1}") {
                self.select-all();
                return true;
            }
            if (ev.text == "c" || ev.text == "C" || ev.text == "\u{3}") {
                self.copy();
                return true;
            }
            // Cut/paste make no sense on a read-only field.
            if (!self.read-only && (ev.text == "x" || ev.text == "X" || ev.text == "\u{18}")) {
                self.cut();
                return true;
            }
            if (!self.read-only && (ev.text == "v" || ev.text == "V" || ev.text == "\u{16}")) {
                self.paste();
                return true;
            }
        }
        return false;
    }
    key-pressed(ev) => {
        return self.edit-shortcut(ev) ? accept : reject;
    }
}

component EditLineEdit inherits LineEdit {
    key-pressed(ev) => {
        // Alt/Meta excluded: those are other combinations (e.g. Alt+Enter).
        if (ev.modifiers.control && !ev.modifiers.alt && !ev.modifiers.meta) {
            // Shift+Ctrl+letter is left to the rest of the application.
            if (!ev.modifiers.shift) {
                if (ev.text == "a" || ev.text == "A" || ev.text == "\u{1}") {
                    self.select-all();
                    return accept;
                }
                if (ev.text == "c" || ev.text == "C" || ev.text == "\u{3}") {
                    self.copy();
                    return accept;
                }
                if (ev.text == "x" || ev.text == "X" || ev.text == "\u{18}") {
                    self.cut();
                    return accept;
                }
                if (ev.text == "v" || ev.text == "V" || ev.text == "\u{16}") {
                    self.paste();
                    return accept;
                }
            }
        }
        return reject;
    }
}

component DeferredLineEditFocus inherits Rectangle {
    in-out property <bool> armed: false;
    callback apply-focus();
    width: 0px;
    height: 0px;
    Timer {
        interval: 1ms;
        running: root.armed;
        triggered => {
            root.apply-focus();
            root.armed = false;
        }
    }
}

/// Closes a flyout after a short delay when neither the parent entry nor the
/// flyout itself is hovered (tolerates passing the cursor through the gap
/// between them). Shared by the "Open with", "New", and Windows shell
/// sub-menu cascade flyouts.
component FlyoutCloseTimer inherits Rectangle {
    in-out property <bool> open;
    in property <bool> parent-hover;
    in property <bool> flyout-hover;
    width: 0px;
    height: 0px;
    Timer {
        interval: 260ms;
        running: root.open;
        triggered => {
            if (!root.parent-hover && !root.flyout-hover) { root.open = false; }
        }
    }
}

// Auto-scrolls a scroll frame while a drag hovers near its top or bottom edge,
// so a drop target sitting off-screen can be reached without releasing the drag.
// Bind `viewport-y` two-way to the target ScrollView/Flickable; the timer only
// nudges it within [min-vy, 0]. Inputs are in the window's absolute frame:
// `cursor-y - frame-y` is the pointer's offset inside the visible area. Shared
// by the file list and the favorites tree so both drag-scroll with the same feel.
component DragEdgeScroller inherits Rectangle {
    in property <bool> active;          // a drag is in progress over this frame
    in property <length> cursor-y;      // absolute pointer Y
    in property <length> frame-y;       // absolute Y of the visible frame's top
    in property <length> frame-h;       // visible frame height
    in property <length> min-vy;        // most-negative viewport-y (0 if it all fits)
    in-out property <length> viewport-y;
    // Edge band that arms the scroll, and the per-tick step.
    property <length> edge: 30px;
    property <length> step: 15px;
    width: 0px;
    height: 0px;
    Timer {
        interval: 16ms;
        running: root.active;
        triggered => {
            let top: length = root.cursor-y - root.frame-y;
            if (top >= 0px && top < root.edge && root.viewport-y < 0px) {
                root.viewport-y = min(0px, root.viewport-y + root.step);
            } else if (top > root.frame-h - root.edge && top <= root.frame-h
                    && root.viewport-y > root.min-vy) {
                root.viewport-y = max(root.min-vy, root.viewport-y - root.step);
            }
        }
    }
}

component MenuItem inherits Rectangle {
    callback clicked();
    in property <string> label;
    in property <bool> enabled: true;
    /// Keyboard shortcut shown in grey on the right (empty = hidden). Common
    /// pattern: font-size: 11px, color foreground.with-alpha(0.4).
    in property <string> shortcut;

    height: 26px;
    border-radius: 4px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: touch.has-hover && root.enabled ? Theme.alternate-background : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.shortcut != "" : Text {
            text: root.shortcut;
            font-size: 11px;
            color: Theme.foreground.with-alpha(0.4);
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Context menu row WITH ICON — pinned user commands
//. Same visual template as `ShellMenuRow` (16px icon + generic fallback)
// so both families of entries line up in the menu.
// Shared command icon renderer. Recipe icons are embedded SVGs and take
// precedence over an executable icon so their identity survives wrapper
// scripts and platform changes. Kind values mirror `OpenerIcon::as_i32`.
component CommandIcon inherits Rectangle {
    in property <int> kind: 0;
    in property <image> extracted;
    in property <bool> available: true;
    in property <float> fallback-alpha: 0.7;
    width: 18px;

    if root.kind == 1 : Image {
        source: @image-url("../../assets/icons/recipe-7zip.svg");
        width: 16px; height: 16px;
        x: 0; y: (parent.height - self.height) / 2;
        colorize: Theme.foreground.with-alpha(root.available ? 0.8 : 0.35);
    }
    if root.kind == 2 : Image {
        source: @image-url("../../assets/icons/recipe-archive.svg");
        width: 16px; height: 16px;
        x: 0; y: (parent.height - self.height) / 2;
        colorize: Theme.foreground.with-alpha(root.available ? 0.8 : 0.35);
    }
    if root.kind == 3 : Image {
        source: @image-url("../../assets/icons/recipe-email.svg");
        width: 16px; height: 16px;
        x: 0; y: (parent.height - self.height) / 2;
        colorize: Theme.foreground.with-alpha(root.available ? 0.8 : 0.35);
    }
    if root.kind == 4 : Image {
        source: @image-url("../../assets/icons/recipe-device.svg");
        width: 16px; height: 16px;
        x: 0; y: (parent.height - self.height) / 2;
        colorize: Theme.foreground.with-alpha(root.available ? 0.8 : 0.35);
    }
    if root.kind == 0 && root.extracted.width > 0 : Image {
        source: root.extracted;
        width: 16px; height: 16px;
        x: 0; y: (parent.height - self.height) / 2;
        opacity: root.available ? 1.0 : 0.4;
    }
    if root.kind == 0 && root.extracted.width == 0 : Image {
        source: @image-url("../../assets/icons/application.svg");
        width: 15px; height: 15px;
        x: 0; y: (parent.height - self.height) / 2;
        colorize: root.available
            ? Theme.foreground.with-alpha(root.fallback-alpha)
            : Tokens.danger;
    }
}

component IconMenuRow inherits Rectangle {
    callback clicked();
    in property <string> label;
    in property <image> icon;
    in property <int> icon-kind: 0;
    height: 26px;
    border-radius: 4px;
    background: im-ta.has-hover ? Theme.alternate-background : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 8px;
        CommandIcon {
            kind: root.icon-kind;
            extracted: root.icon;
            fallback-alpha: 0.45;
        }
        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    im-ta := TouchArea { clicked => { root.clicked(); } }
}

// Row of a WINDOWS CONTEXT MENU entry (shell extensions):
// program icon + label + "›" if cascading. A cascade opens as a FLYOUT
// on hover (same mechanism as "Open with"): `sub-hover` reports the
// absolute coordinates, `hover-changed` feeds the deferred close.
component ShellMenuRow inherits Rectangle {
    callback run(int);
    callback sub-hover(length, length);   // flyout coords (cascade only)
    callback hover-changed(bool);
    in property <ShellCtxEntry> entry;
    in property <bool> sub-open: false;   // THIS row's flyout is open
    height: 26px;
    border-radius: 4px;
    background: (sm-ta.has-hover || root.sub-open) ? Theme.alternate-background : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 8px;
        Rectangle {
            // Stable gutter: if the shell extension doesn't publish a valid
            // icon, we leave it empty instead of inventing a generic
            // application pictogram. This keeps the labels aligned.
            width: 18px;
            if root.entry.icon.width > 0 : Image {
                source: root.entry.icon;
                // Re-tint a monochrome system glyph to the theme foreground
                // (white in dark); `transparent` = no colorization, keeps
                // coloured app icons intact.
                colorize: root.entry.monochrome ? Theme.foreground : transparent;
                width: 16px;
                height: 16px;
                x: 0;
                y: (parent.height - self.height) / 2;
            }
        }
        Text {
            text: root.entry.label;
            font-size: 12px;
            color: Theme.foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.entry.has-sub : Text {
            text: "›";
            font-size: 15px;
            color: Theme.foreground.with-alpha(0.5);
            vertical-alignment: center;
        }
    }
    sm-ta := TouchArea {
        clicked => {
            if (!root.entry.has-sub) { root.run(root.entry.id); }
        }
        changed has-hover => {
            root.hover-changed(self.has-hover);
            if (self.has-hover && root.entry.has-sub) {
                root.sub-hover(self.absolute-position.x + self.width - 4px,
                               self.absolute-position.y - 4px);
            }
        }
    }
}

// A ready-made-command chip in the "Open with" settings. Factored out so the
// two wrapped rows share one definition; `activate` bubbles the click up with
// the recipe's index into the bridge's table.
// One ready-made command, as a full-width row.
//
// The width comes from the column, never from the text: a chip sized on its
// own label pushed the row past the panel in ALL five languages, and the
// scrollbar appeared. The label elides instead, which turns the available
// width into a guarantee rather than an estimate — a longer translation can no
// longer widen anything.
component OwRecipeButton inherits Rectangle {
    in property <OwRecipe> recipe;
    callback activate();
    height: 24px;
    horizontal-stretch: 1;
    min-width: 0px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rcp-ta.has-hover ? Theme.accent-background : transparent;
    background: rcp-ta.has-hover
        ? Theme.accent-background.with-alpha(0.18)
        : Theme.foreground.with-alpha(0.07);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        CommandIcon {
            kind: root.recipe.icon-kind;
            width: 15px;
        }
        Text {
            text: root.recipe.label;
            font-size: 11px;
            color: Theme.foreground.with-alpha(0.85);
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    rcp-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }
}

// Full-window dim behind a modal card. It ALWAYS swallows the wheel: an
// unhandled scroll would otherwise fall through to whatever sits behind the
// modal (the settings panel, the file view underneath) and scroll or select
// there while the modal is up. Clicks on the dim are absorbed; set
// `dismiss-on-click` to also close the modal from a click in the dim.
component ModalBackdrop inherits Rectangle {
    in property <bool> dismiss-on-click: false;
    callback dismiss();
    background: #000000.with-alpha(0.45);
    TouchArea {
        scroll-event(ev) => { return accept; }
        clicked => { if (root.dismiss-on-click) { root.dismiss(); } }
    }
}

// View filter bar — SHARED between the by-name type-ahead filter and
// the by-extension filter. Both display the same emulated caret: input
// stays driven by the global FocusScope, but the bar is visually
// identifiable as editable. `close()` = close.
component FilterBar inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> hint;   // shown greyed out when `text` is empty
    property <bool> caret-visible: true;
    changed text => { root.caret-visible = true; }
    callback close();
    height: 30px;
    border-radius: Tokens.radius-row;
    background: Theme.accent-background.with-alpha(0.13);
    border-width: 1px;
    border-color: Theme.accent-background.with-alpha(0.40);
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 4px;
        spacing: 8px;
        // Icon (full-height slot → vertical centering).
        Rectangle {
            width: 15px;
            height: parent.height;
            Image {
                width: 15px;
                height: 15px;
                y: (parent.height - self.height) / 2;
                source: root.icon;
                colorize: Theme.accent-background;
            }
        }
        // Typed text, pale hint when nothing is entered, then a blinking caret
        // positioned after the preferred width of the actual text.
        Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            value-text := Text {
                width: parent.width;
                height: parent.height;
                text: root.text;
                font-size: 13px;
                color: Theme.foreground;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.text == "" : Text {
                x: 4px;
                width: parent.width - self.x;
                height: parent.height;
                text: root.hint;
                font-size: 13px;
                color: Theme.foreground.with-alpha(0.3);
                vertical-alignment: center;
                overflow: elide;
            }
            if root.caret-visible : Rectangle {
                x: min(parent.width - 1px,
                    root.text == "" ? 0px : value-text.preferred-width + 1px);
                y: (parent.height - self.height) / 2;
                width: 1px;
                height: 16px;
                background: Theme.foreground.with-alpha(0.85);
            }
        }
        // Close ("x") button (single) → closes the filter.
        Rectangle {
            width: 28px;
            height: parent.height;
            Rectangle {
                width: 24px;
                height: 24px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 5px;
                background: fb-close.has-hover ? Tokens.danger.with-alpha(0.20) : transparent;
                Image {
                    width: 13px;
                    height: 13px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../../assets/icons/close.svg");
                    colorize: fb-close.has-hover ? Tokens.danger : Theme.foreground.with-alpha(0.7);
                }
            }
            fb-close := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.close(); }
            }
        }
    }
    Timer {
        interval: 520ms;
        running: true;
        triggered => { root.caret-visible = !root.caret-visible; }
    }
}

// Text field with a PALE hint (placeholder) overlaid: the
// native `LineEdit` placeholder is too light and gets confused with actual input.
component HintEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> hint;
    callback edited(string);
    height: 32px;
    edit := EditLineEdit {
        width: parent.width;
        height: parent.height;
        text <=> root.text;
        edited(t) => { root.edited(t); }
    }
    // Overlaid hint, visible only when the field is empty. Not
    // interactive → clicks fall through to the LineEdit underneath.
    Text {
        x: 10px;
        width: parent.width - 16px;
        height: parent.height;
        visible: root.text == "";
        text: root.hint;
        font-size: 13px;
        color: Theme.foreground.with-alpha(0.3);
        vertical-alignment: center;
        overflow: elide;
    }
    // Puts the caret at the end and scrolls there. Text appended from outside
    // (the tag buttons) lands past the visible width on a long command, so
    // without this the click produces no visible change at all.
    public function focus-end() {
        edit.focus();
        edit.set-selection-offsets(99999, 99999);
    }
}

// "Split" menu entry: orientation icon + label.
// `stacked = false` → side by side (split.svg); `true` → one below the other
// (two-horizontal-bars glyph drawn inline).
component SplitMenuItem inherits Rectangle {
    callback clicked();
    in property <string> label;
    in property <bool> stacked;
    in property <string> shortcut;    // shortcut shown on the right (grey)

    height: 36px;
    border-radius: 4px;
    background: smi-touch.has-hover ? Theme.accent-background.with-alpha(0.18) : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 14px;
        spacing: 10px;
        alignment: start;

        // Orientation icon, centered within 18px.
        Rectangle {
            width: 18px;
            height: parent.height;
            if !root.stacked : Image {
                source: @image-url("../../assets/icons/split.svg");
                width: 16px;
                height: 16px;
                colorize: Theme.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.stacked : Rectangle {
                width: 16px;
                height: 16px;
                Rectangle {
                    x: 0; y: 1px;
                    width: 16px; height: 6px;
                    border-width: 1.5px;
                    border-color: Theme.foreground;
                    border-radius: 1.5px;
                }
                Rectangle {
                    x: 0; y: 9px;
                    width: 16px; height: 6px;
                    border-width: 1.5px;
                    border-color: Theme.foreground;
                    border-radius: 1.5px;
                }
            }
        }

        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        // Shortcut, in grey on the right (learning by exposure).
        Text {
            text: root.shortcut;
            font-size: 11px;
            color: Theme.foreground.with-alpha(0.45);
            vertical-alignment: center;
        }
    }

    smi-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// "Tab bar position" menu item: icon + label +
// checkmark on the right for the CURRENT option (3-state radio semantics).
component TabBarMenuItem inherits Rectangle {
    callback clicked();
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;

    height: 36px;
    border-radius: 4px;
    background: tbmi-touch.has-hover ? Theme.accent-background.with-alpha(0.18) : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        Rectangle {
            width: 18px;
            height: parent.height;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.selected ? Theme.accent-background : Theme.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 16px;
            height: parent.height;
            if root.selected : Image {
                source: @image-url("../../assets/icons/check.svg");
                width: 13px;
                height: 13px;
                colorize: Theme.accent-background;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    tbmi-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Row made of a label, a selectable monospace path, and a button
// that opens the folder in the system's file manager.
component PathRow inherits VerticalLayout {
    callback open-clicked();
    in property <string> label;
    in property <string> value;
    in property <string> open-text;
    spacing: 4px;

    // Row header — fixed-height parent Rectangle to allow absolute
    // vertical centering of the "Open" button (a HorizontalLayout without
    // an explicit height pushed the button toward the top).
    Rectangle {
        height: 22px;
        Text {
            x: 0;
            y: (parent.height - self.height) / 2;
            text: root.label;
            font-size: 10px;
            font-weight: 600;
            color: Theme.foreground.with-alpha(0.55);
            letter-spacing: 0.3px;
        }
        Rectangle {
            x: parent.width - self.width;
            y: (parent.height - self.height) / 2;
            width: 64px;
            height: 22px;
            border-radius: 4px;
            background: open-touch.has-hover
                ? Theme.accent-background.with-alpha(0.15)
                : transparent;
            border-width: 1px;
            border-color: open-touch.has-hover
                ? Theme.accent-background
                : Theme.border;
            Text {
                text: root.open-text;
                font-size: 11px;
                color: Theme.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            open-touch := TouchArea {
                clicked => { root.open-clicked(); }
            }
        }
    }
    EditTextInput {
        text: root.value;
        read-only: true;
        font-size: 12px;
        font-family: "monospace";
        color: Theme.foreground;
        single-line: false;
        wrap: word-wrap;
        selection-background-color: Theme.accent-background.with-alpha(0.5);
        selection-foreground-color: Theme.foreground;
    }
}

component TabItem inherits Rectangle {
    callback clicked();
    callback close-clicked();
    callback right-clicked(length, length);   // tab context menu
    /// Drag in progress: (delta_px, abs_x, abs_y). Lets the parent
    /// preview the drop AND detect a cross-view target.
    callback drag-progress(length, length, length);
    /// Drag completed: (delta_px, abs_x, abs_y).
    callback drag-completed(length, length, length);
    in property <string> title;
    in property <bool> active: false;
    /// Full path of the tab — tooltip on hover (empty = no tooltip).
    in property <string> tip-path;

    // Geometry & insertion gap claiming -----
    // Width IMPOSED by the model (bridge) — no fit-to-text: the layout no
    // longer depends on the text, and the drop logic uses THE SAME plain value.
    // Like `ColumnHeader.my-drop-target`, this binding only observes
    // simple model values: offset, width, and the propagated cursor position. It
    // never depends on `self.x`, `self.width`, or the layout cache, so as not to
    // create a reactive cycle.
    // ORIENTATION: `tab-width`/`tab-offset`/`reorder-cur` live on the
    // bar's MAIN AXIS (X horizontally, Y vertically) — the gap
    // claim below is thus SHARED between both bars.
    // `vertical` only toggles the visual geometry (width ↔ height).
    in property <bool> vertical: false;
    in property <length> cross-len: 120px;  // VISUAL width in vertical mode
    // Active indicator on the inner edge of the vertical bar: on the right
    // when the bar sits to the left of the content, and vice versa.
    in property <bool> indicator-right: true;
    in property <length> tab-width: 120px;  // extent along the main axis
    in property <length> tab-offset;        // offset (main axis) within the bar (bridge)
    in property <int> tab-index;
    in property <int> tab-count;
    in property <bool> reorder-active;      // drag in progress + cursor within the panel's bar
    in property <length> reorder-cur;       // drag cursor along the main axis (content-relative)
    /// Emitted when THIS tab claims the gap: (gap index, gap x).
    callback claim-drop(int, length);
    // Claimed zone = tab + its right-hand gap (2px spacing) → continuous
    // tiling; the first tab extends left, the last extends right (outer gaps).
    // Left half → insert BEFORE (index); right half → AFTER (index+1).
    property <int> my-claim:
        (!root.reorder-active
            || (root.reorder-cur < root.tab-offset && root.tab-index != 0)
            || (root.reorder-cur >= root.tab-offset + root.tab-width + 2px
                && root.tab-index != root.tab-count - 1))
        ? -1
        : (root.reorder-cur < root.tab-offset + root.tab-width / 2
            ? root.tab-index
            : root.tab-index + 1);
    changed my-claim => {
        if (root.my-claim >= 0) {
            root.claim-drop(root.my-claim,
                root.my-claim == root.tab-index
                    ? root.tab-offset
                    : root.tab-offset + root.tab-width + 2px);
        }
    }

    height: root.vertical ? root.tab-width : 26px;
    width: root.vertical ? root.cross-len : root.tab-width;
    // 15% of the 26px tab height. At 6px (23%) the corners read as a pill;
    // this keeps the shape a rectangle that happens to be softened.
    border-radius: 5px;
    opacity: dragging ? 0.5 : 1.0;
    // Clean tab bar: the ACTIVE tab is filled/accented, inactive ones
    // fade out (transparent) and only reveal themselves on hover → clear hierarchy.
    background: root.active
        ? Theme.accent-background.with-alpha(0.22)
        : (touch.has-hover
            ? Theme.foreground.with-alpha(0.06)
            : transparent);
    border-width: 1px;
    // Active tab: accent outline. Inactive: faint light outline to
    // distinguish them from the background (a bit stronger on hover).
    border-color: root.active
        ? Theme.accent-background.with-alpha(0.55)
        : (touch.has-hover
            ? Theme.foreground.with-alpha(0.30)
            : Theme.foreground.with-alpha(0.18));

    property <length> ds-x;
    property <length> ds-y;
    property <bool> dragging: false;

    // IMPORTANT: `touch` (the tab's root TouchArea) MUST be declared BEFORE
    // the close button, otherwise in Slint it intercepts all clicks (z-order
    // = declaration order, the LAST one is topmost).
    touch := TouchArea {
        pointer-event(ev) => {
            // LEFT click on a tab closes menus; right-click (tab
            // menu) does not bump → it can teleport the menu.
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) { Dismiss.serial += 1; }
            if (ev.button == PointerEventButton.left
                    && ev.kind == PointerEventKind.down) {
                root.ds-x = self.absolute-position.x + self.mouse-x;
                root.ds-y = self.absolute-position.y + self.mouse-y;
                root.dragging = false;
            }
            if (ev.button == PointerEventButton.left
                    && ev.kind == PointerEventKind.up) {
                if (root.dragging) {
                    root.drag-completed(
                        self.absolute-position.x + self.mouse-x - root.ds-x,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y,
                    );
                    root.dragging = false;
                } else {
                    root.clicked();
                }
            }
            // Middle-click → closes the tab (common browser convention).
            if (ev.button == PointerEventButton.middle
                    && ev.kind == PointerEventKind.up) {
                root.close-clicked();
            }
            // Right-click → tab context menu (save as favorite…).
            if (ev.button == PointerEventButton.right
                    && ev.kind == PointerEventKind.down) {
                root.right-clicked(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
        moved => {
            // Drag threshold on BOTH axes: a vertical tab drag
            // starts with a Y movement — an X-only threshold wouldn't catch it.
            if (self.pressed && !root.dragging) {
                if (abs(self.absolute-position.x + self.mouse-x - root.ds-x) > 6px
                        || abs(self.absolute-position.y + self.mouse-y - root.ds-y) > 6px) {
                    root.dragging = true;
                }
            }
            if (self.pressed && root.dragging) {
                root.drag-progress(
                    self.absolute-position.x + self.mouse-x - root.ds-x,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
        // Tooltip below the tab: the full path distinguishes identical
        // titles. The `Tip` overlay stays bounded to the window dimensions.
        changed has-hover => {
            if (self.has-hover && root.tip-path != "" && !root.dragging) {
                Tip.text = root.tip-path;
                Tip.x = self.absolute-position.x;
                Tip.y = self.absolute-position.y + root.height + 4px;
            } else if (Tip.text == root.tip-path) {
                Tip.text = "";
            }
        }
    }

    // In vertical orientation, a 2px accent bar marks the active tab
    // on the inner edge, content side.
    if root.vertical && root.active : Rectangle {
        x: root.indicator-right ? parent.width - 2px : 0;
        y: 3px;
        width: 2px;
        height: parent.height - 6px;
        border-radius: 1px;
        background: Theme.accent-background;
    }

    // Title + "x" zone — visual positioned on top of the root touch area.
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 6px;
        Text {
            text: root.title;
            font-size: 11px;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // Space reserved for the close button — the real button is a sibling
        // (absolutely positioned) so it properly captures clicks.
        Rectangle { width: 18px; }
    }

    // Close button: sibling of touch, declared AFTER so it's topmost.
    Rectangle {
        x: parent.width - self.width - 4px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        // Hover: subtle red — consistent with the "x" in the Settings panel.
        background: close-touch.has-hover ? Tokens.danger.with-alpha(0.27) : transparent;
        Image {
            source: @image-url("../../assets/icons/close.svg");
            width: 11px;
            height: 11px;
            colorize: close-touch.has-hover ? Tokens.danger : Theme.foreground.with-alpha(0.7);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        close-touch := TouchArea {
            clicked => { Dismiss.serial += 1; root.close-clicked(); }
        }
    }
}

// VTabBar: a panel's VERTICAL tab bar ----------
// Full-height column stacked to the left or right of the content. Full
// parity with the horizontal strip: same TabItem (plain geometry on
// the Y axis — uniform 26+2 px pitch computed by the bridge), same gap
// claiming, wheel = next/previous tab, double-click on empty area = new tab,
// non-interactive overflow fades, auto-scroll at the edges during a drag,
// "+" in a fixed footer.
// The component is instantiated on BOTH sides (width 0 when inactive): the ids
// stay referenceable (a conditional `if` element would not be).
component VTabBar inherits Rectangle {
    in property <[TabInfo]> tabs;
    in property <int> active-tab-idx;
    in property <bool> on-left;            // bar on the left → active indicator on the right
    in property <bool> overlay-open;
    in property <string> new-tab-tooltip;
    in property <bool> show-tooltip: false;   // tab path tooltip (opt-in)
    // Tab drag: cursor presence within this bar and Y coordinate within
    // the content, computed by the PanelComponent without depending on the layout cache.
    in property <bool> reorder-here;
    in property <length> reorder-cur;
    in property <length> cursor-in-bar-y;  // VISIBLE Y cursor (auto-scroll at edges)
    // Insertion preview (claimed gap, content-relative position).
    in property <int> preview-idx: -1;
    in property <length> preview-pos;
    // Current scroll (viewport-y ≤ 0) — read by the PanelComponent to
    // convert the drag cursor to a content-relative position (PLAIN read).
    out property <length> vp-y: flick.viewport-y;
    callback claim-drop(int, length);
    callback tab-clicked(int);
    callback tab-closed(int);
    callback tab-context(int, length, length);
    callback tab-drag-progress(int, length, length);
    callback tab-drag-completed(int, length, length);
    callback tab-new();
    callback bar-clicked();                // click on empty area → activate the panel
    callback bar-context(length, length);  // right-click on empty area (absolute position)
    callback wheel(bool /*fwd*/);          // wheel → next/previous tab
    callback scrolled(length);             // viewport-y reported to the bridge
    callback scroll-target(int, bool, length, length) -> length;

    // Reveals tab `idx` (scroll-into-view) — same bridge target as the
    // horizontal chevrons (exact geometry, no arbitrary jump).
    public function reveal(idx: int) {
        flick.viewport-y = root.scroll-target(idx, true, flick.viewport-y, flick.height);
    }

    property <bool> can-scroll-up: flick.viewport-y < -0.5px;
    property <bool> can-scroll-down:
        flick.viewport-y > flick.height - flick.viewport-height + 0.5px;

    background: Theme.toolbar;
    border-radius: Tokens.radius-row;

    VerticalLayout {
        padding: 4px;
        spacing: 4px;

        // ----- Fixed header: new tab, stable target always visible. -----
        Rectangle {
            height: 24px;
            border-radius: 5px;
            background: vnew-touch.has-hover ? Theme.alternate-background : transparent;
            Image {
                source: @image-url("../../assets/icons/plus.svg");
                width: 13px;
                height: 13px;
                colorize: Theme.foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            vnew-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.bar-clicked(); root.tab-new(); }
                changed has-hover => {
                    if (self.has-hover && root.new-tab-tooltip != "") {
                        Tip.text = root.new-tab-tooltip;
                        // CONTENT side (doesn't hide the list while scanning).
                        Tip.x = root.on-left
                            ? self.absolute-position.x + root.width + 4px
                            : self.absolute-position.x - 120px;
                        Tip.y = self.absolute-position.y;
                    } else if (Tip.text == root.new-tab-tooltip) {
                        Tip.text = "";
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Tokens.hairline; }

        // ----- Tab list (vertical scrolling) -----
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // Wheel + clicks on empty area — BELOW the TabItems (declared before).
            vwheel := TouchArea {
                clicked => { root.bar-clicked(); }
                double-clicked => { root.bar-clicked(); root.tab-new(); }
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down
                            && ev.button == PointerEventButton.right) {
                        root.bar-context(
                            self.absolute-position.x + self.mouse-x,
                            self.absolute-position.y + self.mouse-y);
                    }
                }
                scroll-event(ev) => {
                    if (root.overlay-open) { return accept; }
                    if (ev.delta-y < 0 || ev.delta-x < 0) { root.wheel(true); return accept; }
                    if (ev.delta-y > 0 || ev.delta-x > 0) { root.wheel(false); return accept; }
                    return reject;
                }
            }

            flick := Flickable {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: max(self.height, vtabs-col.preferred-height);
                interactive: false;
                animate viewport-y { duration: 120ms; easing: ease-out; }
                changed viewport-y => { root.scrolled(self.viewport-y); }

                vtabs-col := VerticalLayout {
                    spacing: 2px;               // MUST == VTAB_SPACING (bridge)
                    alignment: start;
                    for tab[idx] in root.tabs : TabItem {
                        vertical: true;
                        cross-len: flick.width;
                        indicator-right: root.on-left;
                        title: tab.title;
                        // Path tooltip: opt-in — empty = disabled.
                        tip-path: root.show-tooltip ? tab.path : "";
                        active: idx == root.active-tab-idx;
                        tab-width: tab.width;   // Y extent (26px, bridge)
                        tab-offset: tab.offset;
                        tab-index: idx;
                        tab-count: root.tabs.length;
                        reorder-active: root.reorder-here;
                        reorder-cur: root.reorder-cur;
                        claim-drop(g, gy) => { root.claim-drop(g, gy); }
                        clicked => { root.tab-clicked(idx); }
                        close-clicked => { root.tab-closed(idx); }
                        right-clicked(x, y) => { root.tab-context(idx, x, y); }
                        drag-progress(d, ax, ay) => { root.tab-drag-progress(idx, ax, ay); }
                        drag-completed(d, ax, ay) => { root.tab-drag-completed(idx, ax, ay); }
                    }
                    // Bottom clearance: the last tab (and its close button) escapes
                    // the fade (vertical equivalent of the `tab-cluster-w` spacer).
                    Rectangle { height: 8px; }
                }
                // Drop preview line — HORIZONTAL between two tabs, as an
                // out-of-layout overlay (Flickable content-relative position).
                if root.preview-idx >= 0 : Rectangle {
                    x: 2px;
                    y: root.preview-pos - 1px;
                    width: parent.width - 4px;
                    height: 2px;
                    background: Theme.accent-background;
                }
            }
            // Top/bottom overflow fades — WITHOUT a TouchArea (wheel and clicks
            // pass through), fading toward the bar's actual color.
            if root.can-scroll-up : Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: 20px;
                background: @linear-gradient(180deg,
                    Theme.toolbar 0%, Theme.toolbar.with-alpha(0.0) 100%);
            }
            if root.can-scroll-down : Rectangle {
                x: 0; y: parent.height - self.height;
                width: parent.width;
                height: 20px;
                background: @linear-gradient(0deg,
                    Theme.toolbar 0%, Theme.toolbar.with-alpha(0.0) 100%);
            }
            // Auto-scroll during a reorder drag near the
            // edges: `reorder-cur` follows
            // `viewport-y` → the gap recomputes as scrolling progresses.
            Timer {
                interval: 16ms;
                running: root.reorder-here
                    && flick.viewport-height > flick.height + 0.5px;
                triggered => {
                    if (root.cursor-in-bar-y < 28px && root.can-scroll-up) {
                        flick.viewport-y = min(0px, flick.viewport-y + 12px);
                    } else if (root.cursor-in-bar-y > flick.height - 12px && root.can-scroll-down) {
                        flick.viewport-y = max(
                            flick.height - flick.viewport-height,
                            flick.viewport-y - 12px);
                    }
                }
            }

            // ----- Overlaid mini-scrollbar for free scrolling -----
            // Revealed on hover when the list overflows; 4px track on the right
            // edge (scrollbar convention). Grabbable anywhere on the track:
            // the thumb's center follows the mouse.
            sb := Rectangle {
                x: parent.width - 5px;
                y: 0;
                width: 4px;
                height: parent.height;
                property <bool> show: flick.viewport-height > flick.height + 0.5px
                    && (vwheel.has-hover || sbt.has-hover || sbt.pressed);
                opacity: self.show ? 1.0 : 0.0;
                animate opacity { duration: 120ms; easing: ease-out; }
                property <length> thumb-h: max(24px,
                    flick.height * flick.height / max(1px, flick.viewport-height));
                property <length> thumb-y: (flick.height - self.thumb-h)
                    * (-flick.viewport-y)
                    / max(1px, flick.viewport-height - flick.height);
                Rectangle {
                    x: 0;
                    y: sb.thumb-y;
                    width: parent.width;
                    height: sb.thumb-h;
                    border-radius: 2px;
                    background: Theme.foreground.with-alpha(sbt.pressed ? 0.55 : 0.35);
                }
                // Widened hit area (10px) around the 4px track.
                sbt := TouchArea {
                    x: -3px;
                    width: 10px;
                    enabled: flick.viewport-height > flick.height + 0.5px;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down
                                && ev.button == PointerEventButton.left) {
                            flick.viewport-y = -clamp(
                                (self.mouse-y - sb.thumb-h / 2) / max(1px, flick.height - sb.thumb-h),
                                0, 1) * (flick.viewport-height - flick.height);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            flick.viewport-y = -clamp(
                                (self.mouse-y - sb.thumb-h / 2) / max(1px, flick.height - sb.thumb-h),
                                0, 1) * (flick.viewport-height - flick.height);
                        }
                    }
                }
            }
        }
    }

    // Resize grip on the inner edge.
    // 7px band straddling the content-side edge. The PanelComponent receives
    // the mouse's absolute position and recomputes the width (shared clamp).
    callback grip-moved(length /*abs-x*/);
    callback grip-done();
    grip := TouchArea {
        x: root.on-left ? root.width - 3px : -4px;
        y: 0;
        width: 7px;
        height: root.height;
        mouse-cursor: ew-resize;
        moved => {
            if (self.pressed) {
                root.grip-moved(self.absolute-position.x + self.mouse-x);
            }
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.up
                    && ev.button == PointerEventButton.left) {
                root.grip-done();
            }
        }
    }
    // Affordance: accent thread on the inner edge on grip hover/drag.
    if grip.has-hover || grip.pressed : Rectangle {
        x: root.on-left ? root.width - 2px : 0;
        y: 0;
        width: 2px;
        height: root.height;
        background: Theme.accent-background.with-alpha(0.7);
    }
}

// Vertical splitter component between two side-by-side panels. Horizontal drag
// → emits the cumulative delta since the start of the drag. The bridge converts it
// into a stretch adjustment for the adjacent panels.
// Separator positioned absolutely on the seam between two zones.
// Vertical (side by side) or horizontal (stacked). Emits the pointer's
// **absolute** position; the conversion to a ratio is done on the Rust side (drift-free,
// since it's an absolute, not incremental, computation).
component PanelSplitterAbs inherits Rectangle {
    in property <bool> vertical;
    callback dragged(/* abs_x */ length, /* abs_y */ length);

    // Invisible at rest: the groove and borders separate the views. A thin
    // accent pill appears on hover and during the drag to signal the grip.
    background: transparent;

    property <bool> lit: drag-touch.has-hover || drag-touch.pressed;
    // Inset along the seam so the pill does NOT overlap the panels' rounded
    // part: gap (up to the tile edge) + corner radius
    // (up to the start of the straight edge). It thus only covers the flat segment.
    property <length> seam-inset: Tokens.panel-gap + Tokens.radius-panel;

    Rectangle {
        x: root.vertical ? (parent.width - self.width) / 2 : root.seam-inset;
        y: root.vertical ? root.seam-inset : (parent.height - self.height) / 2;
        width: root.vertical ? 3px : parent.width - 2 * root.seam-inset;
        height: root.vertical ? parent.height - 2 * root.seam-inset : 3px;
        border-radius: 1.5px;
        background: root.lit ? Theme.accent-background : transparent;
        opacity: root.lit ? 1.0 : 0.0;
        animate opacity { duration: 110ms; easing: ease-out; }
    }

    drag-touch := TouchArea {
        mouse-cursor: root.vertical ? ew-resize : ns-resize;
        pointer-event(ev) => {
            // Grabbing a splitter closes the context menu.
            if (ev.kind == PointerEventKind.down) { Dismiss.serial += 1; }
        }
        moved => {
            if (self.pressed) {
                root.dragged(self.absolute-position.x + self.mouse-x,
                             self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// ---------- PanelComponent: a complete panel (tabs + nav + rows + footer) ----------

component PanelComponent inherits Rectangle {
    // IMPORTANT: `preferred-width: 0` is necessary for the splitter
    // to move pixel-perfectly with the mouse. Without it, Slint reserves the
    // "natural" preferred-width (tab strip + breadcrumb + etc.) for each
    // panel BEFORE distributing the rest via stretch, and dragging the
    // splitter only changes the "rest", which makes the movement
    // ~50% slower than the mouse.
    preferred-width: 0px;
    min-width: 0px;
    max-width: 99999px;

    in property <PanelView> view;
    // Footer text ("N selected / M items") DECOUPLED from
    // `view`: the selection count changes on every rubber-band step;
    // if it lived in `PanelView`, updating it would rewrite the whole struct
    // (via `set_row_data` on the panels model) and invalidate the Repeater's
    // `rendered-rows` model property → selection changes would no longer be
    // rendered in place until a re-list happens (hence the "skipped"
    // entries until a scroll). Driven separately via
    // `panel-footers[idx]`, it never invalidates the list anymore.
    in property <string> footer-text;
    in property <bool> active;
    in property <bool> can-close: false;
    in property <Strings> strings;
    // Column widths SPECIFIC to this panel: initialized from the model
    // (`view`), mutated locally by the header grips. On resize end,
    // `column-resized(id, width)` reports it to the bridge (which stores it per panel
    // to survive model rebuilds). GENERIC callback per column
    // → no tuple that needs to grow with every new column.
    in-out property <length> col-name-width: root.view.col-name-w;
    in-out property <length> col-path-width: root.view.col-path-w;
    in-out property <length> col-size-width: root.view.col-size-w;
    in-out property <length> col-modified-width: root.view.col-modified-w;
    in-out property <length> col-ext-width: root.view.col-ext-w;
    in-out property <length> col-resolution-width: root.view.col-resolution-w;
    in-out property <length> col-depth-width: root.view.col-depth-w;
    in-out property <length> col-age-width: root.view.col-age-w;
    callback column-resized(string /*id*/, length /*width*/);
    // check/uncheck a column (id, visible) + right-click header.
    callback column-toggle(string, bool);
    callback open-columns-menu(length, length);   // absolute position
    // Reordering: column identifier and signed delta in pixels.
    callback column-moved(string, int);
    // type-ahead filter — current text (shown if view is active) + reset.
    in property <string> filter-text: "";
    callback filter-clear();
    // Exact vertical viewport (content coordinate + visible height). The
    // bridge adjusts the small rendered window and thumbnail priority.
    callback rows-viewport-changed(length /*top*/, length /*height*/);
    // Vertical hit-test in the rows' variable geometry. The bridge does
    // a binary search in `FileRow.visual-y/visual-h`.
    callback row-at-content-y(length /*content y*/) -> int;
    // extension filter — bar's close button (disables the mode). TYPING
    // goes through filter-type/backspace (shared with type-ahead), not here.
    callback ext-filter-toggle();
    // current tab bar scroll (viewport-x, plain) —
    // reported to the bridge via `panel-tabs-scrolled(idx, vx)`.
    callback tabs-scrolled(length);
    property <bool> col-drag-active: false;
    property <length> col-drag-center: 0px;   // center of the dragged column (plain)
    property <length> col-drag-delta: 0px;
    property <int> col-drop-idx: -1;
    property <string> col-drag-id: "";

    // Width of a column by its id. All resizable.
    function width-of(id: string) -> length {
        id == "path" ? root.col-path-width
            : id == "size" ? root.col-size-width
            : id == "modified" ? root.col-modified-width
            : id == "ext" ? root.col-ext-width
            : id == "resolution" ? root.col-resolution-width
            : id == "depth" ? root.col-depth-width
            : id == "age" ? root.col-age-width
            : root.col-name-width;
    }
    // Applies a width to the right property (live resize, `for`-compatible).
    function set-col-width(id: string, w: length) {
        if (id == "path") { root.col-path-width = w; }
        else if (id == "size") { root.col-size-width = w; }
        else if (id == "modified") { root.col-modified-width = w; }
        else if (id == "ext") { root.col-ext-width = w; }
        else if (id == "resolution") { root.col-resolution-width = w; }
        else if (id == "depth") { root.col-depth-width = w; }
        else if (id == "age") { root.col-age-width = w; }
        else { root.col-name-width = w; }
    }

    // Path bar edit mode: false = clickable breadcrumbs,
    // true = TextInput. Local to the panel, toggled by clicking empty area / Enter / Escape.
    in-out property <bool> path-edit-mode: false;
    // Ctrl+L: counter propagated from MainWindow. On its change, the
    // ACTIVE panel enters edit mode (the TextInput auto-focuses via its `init`),
    // exactly like clicking the breadcrumb's empty area.
    in property <int> address-focus-gen;
    changed address-focus-gen => {
        if (root.active) {
            root.url-edit-text = root.view.current-path;
            root.path-edit-mode = true;
        }
    }

    // === Tab drag: preview handled locally in Slint ===
    /// Global "a drag is in progress" flag propagated from MainWindow to
    /// **all** PanelComponents — lets each panel compute
    /// ITS OWN preview, and thus display the line in the cross-view
    /// target panel.
    in property <bool> drag-active: false;
    /// Absolute X position of the mouse during the drag (propagated from
    /// MainWindow). Each panel compares it with its tabs-row to know
    /// whether the mouse is within its tab zone.
    in property <length> drag-abs-x: 0px;
    in property <length> drag-abs-y: 0px;
    /// "Full path" tooltip on tab hover — opt-in
    /// (global setting), propagated to tabs of both orientations.
    in property <bool> tab-tooltip-enabled: false;

    // Directional drop zones -----
    // Drag cursor position in THIS panel's frame.
    property <length> dl-x: root.drag-abs-x - root.absolute-position.x;
    property <length> dl-y: root.drag-abs-y - root.absolute-position.y;
    // Is the drag cursor over this panel?
    out property <bool> drag-over: root.drag-active
        && root.dl-x >= 0px && root.dl-x <= root.width
        && root.dl-y >= 0px && root.dl-y <= root.height;

    // FILE drag'n'drop between views -----
    // (Same principles as the tab drag: absolute position propagated from
    // MainWindow; each panel computes whether it is hovered. `absolute-position`
    // is safe here because panels are positioned with an explicit `x:`.)
    in property <bool> file-drag-active: false;
    in property <length> file-drag-abs-x: 0px;
    in property <length> file-drag-abs-y: 0px;
    in property <bool> is-file-drag-source: false;
    out property <bool> file-drag-over: root.file-drag-active
        && root.file-drag-abs-x >= root.absolute-position.x
        && root.file-drag-abs-x <= root.absolute-position.x + root.width
        && root.file-drag-abs-y >= root.absolute-position.y
        && root.file-drag-abs-y <= root.absolute-position.y + root.height;
    // Emitted by `sel-touch` (see below) to MainWindow.
    callback file-drag-started(int /*row_idx*/, length /*abs_x*/, length /*abs_y*/);
    callback file-drag-progress(length, length);
    callback file-drag-dropped(length, length);
    // Top of the body (below the tabs + nav header) = list-area position.
    property <length> body-top: list-area.absolute-position.y - root.absolute-position.y;
    // Actual LEFT inset of list-area within the panel: root row's
    // padding (`Tokens.panel-pad`) + 6px spacing consumed by `vbar-left`, which
    // stays in the tree at zero width when the vertical tab bar is
    // inactive — i.e. 13px in the common case. Not to be confused with
    // `body-left` (body bounds excluding the vertical bar, zero if tab-mode != 1).
    // Measured rather than hardcoded, to stay accurate if the layout changes.
    // Same read as `body-top` (panel absolute-position = proven safe):
    // used only to place `gutter-strip`, which takes part in no layout →
    // no cycle.
    property <length> list-inset-x: list-area.absolute-position.x - root.absolute-position.x;
    // (FOLDER) row hovered during a file-drag → allows dropping the
    // selection INTO this subfolder. Same reads as `file-drag-over` /
    // `body-top` (panel absolute-position = proven safe); the hit-test consults
    // the precomputed geometry, no reentrant layout read. -1 = no
    // folder-row under the cursor (falls back to the panel's current folder).
    property <length> drag-y-in-body: root.file-drag-abs-y - root.absolute-position.y - root.body-top;
    // Exact X position of the row area (accounts for vertical bar,
    // padding, and horizontal scroll). It shares the same dead bounds as
    // normal hover/click: gutter on the left, end of columns on the right.
    property <length> fd-x-in-list: root.file-drag-abs-x - list-area.absolute-position.x;
    property <int> drag-hover-row: -1;
    function update-drag-hover-row() {
        root.drag-hover-row =
            (root.file-drag-active && root.file-drag-over && root.drag-y-in-body >= 0px
                && root.fd-x-in-list >= Tokens.gutter
                && root.fd-x-in-list <= root.content-right)
            ? root.row-idx-at-y(root.drag-y-in-body)
            : -1;
    }
    changed file-drag-active => { root.update-drag-hover-row(); }
    changed file-drag-over => { root.update-drag-hover-row(); }
    changed file-drag-abs-x => { root.update-drag-hover-row(); }
    changed file-drag-abs-y => { root.update-drag-hover-row(); }
    out property <int> drag-target-row: root.drag-hover-row;
    out property <bool> drag-target-exec:
        root.drag-hover-row >= 0 && root.drag-hover-row < root.view.rows.length
        && !root.view.rows[root.drag-hover-row].is-dir
        && root.view.rows[root.drag-hover-row].drop-runnable;
    out property <int> drag-folder-row:
        (root.drag-hover-row >= 0 && root.drag-hover-row < root.view.rows.length
            && root.view.rows[root.drag-hover-row].is-dir)
        ? root.drag-hover-row
        : -1;
    // Normalized [0,1] coordinates WITHIN the body — X renormalized OUTSIDE the
    // vertical bar: otherwise the "west/east" zone and the 30/70%
    // thresholds would be offset by the bar's width.
    property <float> body-nx:
        (root.dl-x - root.body-left) / max(1px, root.body-right - root.body-left);
    property <float> body-ny: (root.dl-y - root.body-top) / max(1px, root.height - root.body-top);
    // Drop zone: 0 none · 1 center (move) · 2 west · 3 east · 4 north · 5 south.
    // Central 40%x40% band = move; otherwise the nearest edge (diagonals).
    // The TAB BAR (top band OR side column) and the nav bar
    // count as "center" (move zone, no split).
    out property <int> drag-zone:
        !root.drag-over ? 0
        : (root.drag-in-bar || root.dl-y < root.body-top) ? 1
        : (root.body-nx >= 0.30 && root.body-nx <= 0.70
                && root.body-ny >= 0.30 && root.body-ny <= 0.70) ? 1
        : (min(root.body-nx, 1 - root.body-nx) < min(root.body-ny, 1 - root.body-ny))
            ? (root.body-nx < 0.5 ? 2 : 3)
            : (root.body-ny < 0.5 ? 4 : 5);
    /// Absolute X start of `tabs-row` = `root.absolute-position.x` (PanelComponent
    /// position, STABLE, independent of internal layout) + cumulative inset
    /// up to the tabs: root VerticalLayout padding (7px) + toolbar
    /// padding (6px) = 13px. No dependency on tabs-row's layout.
    property <length> tabs-row-x: root.absolute-position.x + 13px;

    // Vertical tab bar -----
    // THIS panel's bar position: 0 top · 1 left · 2 right.
    property <int> tab-mode: root.view.tab-bar-mode;
    // USER width of the bar (0 = automatic). Initialized from the model,
    // mutated locally by the grip (LIVE resize), reported to the bridge at the
    // end of the drag (`vbar-resized`) — same pattern as column widths.
    in-out property <length> vbar-live-w: root.view.vbar-user-w;
    // EFFECTIVE bar width — MUST == `vbar_width` (bridge): user
    // width if set, otherwise 40% of the panel capped at 180; the whole thing bounded
    // between 110px and 60% of the panel to preserve content width.
    property <length> vbar-w:
        max(110px, min(
            root.vbar-live-w > 0px ? root.vbar-live-w : min(180px, root.width * 0.4),
            max(110px, root.width * 0.6)));
    /// End of the bar's resize (grip released): effective width to
    /// persist per view.
    callback vbar-resized(length);
    // ABSOLUTE Y origin of the vertical tab list: panel + content
    // padding (7) + bar padding (4) + "+" header (24) + spacing (4) +
    // thread (1) + spacing (4) = 44px — FIXED insets from the
    // PanelComponent's position, never layout-cache (same pattern as `tabs-row-x`).
    // MUST == the vertical inset of `locate_tab_drop` (bridge, 48 with panel-gap).
    property <length> vtabs-col-y: root.absolute-position.y + 44px;
    // Is the tab drag cursor within THIS panel's BAR? Common
    // gate: gap claiming, insertion preview, split drop's "center"
    // zone — regardless of mode (top band OR side column).
    property <bool> drag-in-bar: root.tab-mode == 0
        ? root.dl-y < root.body-top
        : (root.tab-mode == 1
            ? root.dl-x <= 7px + root.vbar-w + 4px
            : root.dl-x >= root.width - 7px - root.vbar-w - 4px);
    // Body X bounds, excluding the vertical bar. They normalize the split
    // zones and limit row hover during a file drag.
    property <length> body-left: root.tab-mode == 1 ? 7px + root.vbar-w + 6px : 0px;
    property <length> body-right: root.tab-mode == 2
        ? root.width - 7px - root.vbar-w - 6px
        : root.width;
    // Tab bar overflow -----
    // Direct Flickable reads (`viewport-width`, `viewport-x`, `width`),
    // no dependency on the layout cache. `viewport-x ≤ 0`, with 0 at the start and
    // `width - viewport-width` at the right end. The epsilon stabilizes the edges.
    property <bool> tabs-overflow: tabs-flick.viewport-width > tabs-flick.width + 0.5px;
    property <bool> can-scroll-left: tabs-flick.viewport-x < -0.5px;
    property <bool> can-scroll-right:
        tabs-flick.viewport-x > tabs-flick.width - tabs-flick.viewport-width + 0.5px;
    // Width of the right overlay cluster (chevrons): reserved on the right (spacer at
    // the end of `tabs-row` + effective right bound below) so the last
    // tab clears the cluster. MUST == the backdrop's width.
    property <length> tab-cluster-w: 62px;
    // EFFECTIVE right edge for revealing: the useful visible area stops where
    // the cluster begins (otherwise a tab would align UNDER the cluster).
    property <length> tabs-view-w: tabs-flick.width - root.tab-cluster-w;
    // Scroll target computed by the BRIDGE (exact `TabInfo` widths):
    // reveals "tab by tab" rather than an arbitrary jump. `idx<0` = no chevron
    // in the `forward` direction; `idx>=0` = reveal tab `idx`.
    callback scroll-target(int, bool, length, length) -> length;
    function tabs-scroll-left() {
        tabs-flick.viewport-x =
            root.scroll-target(-1, false, tabs-flick.viewport-x, root.tabs-view-w);
    }
    function tabs-scroll-right() {
        tabs-flick.viewport-x =
            root.scroll-target(-1, true, tabs-flick.viewport-x, root.tabs-view-w);
    }
    // Index to reveal AFTER the model rebuild triggered by a wheel
    // `tab-clicked`. The rebuild resets `viewport-x` → we reveal DEFERRED via
    // `reveal-timer` (one loop iteration later, once the model is
    // applied), otherwise the scroll gets overwritten.
    property <int> pending-reveal-idx: -1;
    reveal-timer := Timer {
        interval: 8ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.pending-reveal-idx >= 0) {
                // Dispatch by orientation: same bridge target
                // (`scroll-target`), different axis.
                if (root.tab-mode == 0) {
                    tabs-flick.viewport-x = root.scroll-target(
                        root.pending-reveal-idx, true, tabs-flick.viewport-x, root.tabs-view-w);
                } else if (root.tab-mode == 1) {
                    vbar-left.reveal(root.pending-reveal-idx);
                } else {
                    vbar-right.reveal(root.pending-reveal-idx);
                }
                root.pending-reveal-idx = -1;
            }
        }
    }
    // Automatically reveals the active tab after any activation source:
    // wheel, Ctrl+Tab, creation, closing, cross-instance receipt, or
    // orientation change. Only the index and mode values are
    // observed, to react only to an actual change.
    property <int> active-tab-watch: root.view.active-tab-idx;
    changed active-tab-watch => {
        root.pending-reveal-idx = root.view.active-tab-idx;
        reveal-timer.running = true;
    }
    property <int> tab-mode-watch: root.view.tab-bar-mode;
    changed tab-mode-watch => {
        root.pending-reveal-idx = root.view.active-tab-idx;
        reveal-timer.running = true;
    }
    // Tab bar auto-scroll during a REORDER DRAG when
    // the cursor nears an edge (bar overflowing) → allows dropping
    // behind a tab that stayed off-screen. `reorder-cur` follows `viewport-x`
    // → the drop gap recomputes itself as scrolling progresses.
    property <length> strip-cursor-x: root.drag-abs-x - root.tabs-row-x;
    Timer {
        interval: 16ms;
        running: root.tab-mode == 0 && root.drag-active && root.drag-over
            && root.dl-y < root.body-top && root.tabs-overflow;
        triggered => {
            if (root.strip-cursor-x < 28px && root.can-scroll-left) {
                tabs-flick.viewport-x = min(0px, tabs-flick.viewport-x + 12px);
            } else if (root.strip-cursor-x > root.tabs-view-w - 12px && root.can-scroll-right) {
                tabs-flick.viewport-x = max(
                    tabs-flick.width - tabs-flick.viewport-width,
                    tabs-flick.viewport-x - 12px);
            }
        }
    }
    // Wheel over the tab bar = next/previous tab (circular wrap)
    // THEN scroll-into-view (deferred) of the new tab.
    function tab-wheel(fwd: bool) {
        if (root.view.tabs.length == 0) { return; }
        let ni: int = fwd
            ? (root.view.active-tab-idx >= root.view.tabs.length - 1 ? 0 : root.view.active-tab-idx + 1)
            : (root.view.active-tab-idx <= 0 ? root.view.tabs.length - 1 : root.view.active-tab-idx - 1);
        root.activate();
        root.tab-clicked(ni);
        root.pending-reveal-idx = ni;
        reveal-timer.running = true;
    }
    /// Tab reordering: gaps are claimed BY the TabItems
    /// from 100% PLAIN geometries (width/offset provided by the bridge
    /// in the `TabInfo` model) — no layout observation, no cycle. The
    /// claimed gap is stored here (local preview) AND reported to MainWindow
    /// (`tab-gap-claimed`) for cross-view drop (TARGET panel's gap).
    property <int> tab-drop-idx: -1;
    property <length> tab-drop-x;
    /// Emitted (synchronously) on every gap claim — MainWindow stores
    /// (gap, panel) for cross-view drop.
    callback tab-gap-claimed(int);
    function report-tab-drop(i: int, x: length) {
        root.tab-drop-idx = i;
        root.tab-drop-x = x;
        root.tab-gap-claimed(i);
    }
    // New drag → starts over from an undefined gap (avoids a leftover from the previous drag).
    changed drag-active => { if (root.drag-active) { root.tab-drop-idx = -1; } }
    /// Drop preview line index. `-1` = no drag, or cursor outside
    /// **THIS panel's bar** (gate `drag-in-bar`: top band OR side
    /// column depending on mode — prevents neighboring views from displaying it).
    property <int> drag-preview-idx:
        (!root.drag-active || !root.drag-over || !root.drag-in-bar)
        ? -1
        : root.tab-drop-idx;

    // Callbacks emitted to MainWindow (which dispatches to the active panel).
    callback activate();
    callback go-back();
    callback go-forward();
    callback go-parent();
    callback go-home();
    callback refresh();
    callback sort-clicked(string);
    callback row-activated(int);
    callback row-clicked(int);
    callback row-ctrl-clicked(int);
    callback row-shift-clicked(int);
    // Slow second click on the single selected entry: reuses the
    // global rename route (same popup as F2 / context menu).
    callback rename-selected();
    callback right-clicked(int, length, length);
    callback select-all();
    callback deselect-all();
    callback rubber-band-begin(int /*mode: 0 replace, 1 add, 2 subtract*/);
    callback rubber-band-update(length, length, length, length);
    callback tab-new();
    callback tab-clicked(int);
    callback tab-closed(int);
    callback tab-context(int, length, length);   // tab right-click
    callback tab-bar-context(length, length);    // right-click on the bar's dead zone
    /// Tab drag completed: (src_idx, target_intra_idx, abs_x, abs_y).
    /// `target_intra_idx` is computed locally in Slint (insertion position
    /// BEFORE removal), or `-1` if the mouse left the tab zone
    /// (the bridge will then try a cross-view target via `abs_x`).
    callback tab-drag-completed(int, int, length, length);
    /// Drag progress: (src_idx, abs_x, abs_y). Used by the bridge for
    /// possible global decisions (no preview here — handled in Slint).
    callback tab-drag-progress(int, length, length);
    callback request-focus();
    /// Emitted when the user submits a path typed in the URL bar.
    callback navigate-to(string);
    /// Emitted on right-click in the empty area (below the rows) — the bridge
    /// opens the context menu on the current folder.
    callback empty-right-clicked(/* abs_x */ length, /* abs_y */ length);
    /// Emitted when the user clicks the header's "x" to close this panel.
    callback close-panel();
    /// Emitted on click of the split token — requests opening the
    /// "Split" menu at position (abs_x, abs_y) below the token.
    callback open-split-menu(length, length);
    /// Emitted on click of the "tab bar position" button —
    /// requests opening the 3-option menu at (abs_x, abs_y) below the button.
    callback open-tabbar-menu(length, length);
    /// Toggles the active tab's display mode (list ↔ preview).
    callback toggle-preview-mode();
    /// Entry zoom (Ctrl+wheel): +1 enlarges, -1 shrinks. The bridge maps
    /// the level to a row height, then returns the new `viewport-top`
    /// that keeps the anchor entry at the same visual position.
    callback zoom-step(int /*delta*/, length /*top*/, length /*height*/,
        length /*pointer-y*/) -> length;
    /// Global keystroke counter. Any keystroke cancels a deferred
    /// second-click: keyboard input/navigation takes priority over slow rename.
    in property <int> keyboard-interaction-gen;
    /// A modal overlay (menu / popup / dialog) is open → the wheel must
    /// NOT scroll/zoom the view (otherwise the view "moves" under the focused popup).
    in property <bool> overlay-open;
    /// Shows / hides hidden files in the active tab.
    callback toggle-show-hidden();
    /// Right-click in the URL bar → Paste/Copy path menu, at (x, y).
    callback open-url-menu(length, length);
    /// Closes the context menu (left-click in a panel's content).
    callback close-ctx-menu();
    // Editable text of the URL bar (bound to MainWindow's shared property).
    in-out property <string> url-edit-text;
    // URL menu open? → prevents exiting edit mode on focus loss.
    in property <bool> url-menu-open;
    /// Bumped by the URL menu's "Copy". The field itself watches this and
    /// copies, because only IT knows what is selected — see `url-input`.
    in property <int> url-copy-serial;
    in property <int> url-paste-serial;

    // Rubber-band (selection rectangle).
    // To stay correct while the list is scrolled, the anchor and the current
    // point are stored in **content coordinates** (= visible − scroll).
    // The bridge compares them against the exact `visual-y/visual-h` bands; the
    // drawn rectangle converts back to visible (+ viewport-y).
    property <bool> rb-active: false;
    property <length> rb-anchor-x;    // visible x at the start
    property <length> rb-anchor-cy;   // CONTENT y at the start (anchor)
    property <length> rb-cur-x;       // current visible x
    property <length> rb-cur-vy;      // current VISIBLE y (mouse)
    // current content y — reactive to scroll (key to edge auto-scroll).
    property <length> rb-cur-cy: root.rb-cur-vy - rows-scroll.viewport-y;
    // Lower (negative) bound of viewport-y; 0 if the content fits without scrolling.
    property <length> rb-min-vy: rows-scroll.viewport-height > rows-scroll.height
        ? -(rows-scroll.viewport-height - rows-scroll.height)
        : 0px;
    // Auto-scroll on middle-click held down (browser/PDF style): we
    // store the cursor's origin on press; a Timer scrolls continuously at a
    // speed proportional to the current offset — vertical AND horizontal.
    property <bool> mid-scroll-active: false;
    property <length> mid-origin-y;
    // Horizontal axis: `sel-touch` SCROLLS horizontally with the Flickable,
    // so `mouse-x` alone (relative to sel-touch) drifts as the view scrolls. The
    // FIXED reference is `mouse-x + flickable.viewport-x`. We store it on every
    // change of `mouse-x` (consistent instant); the Timer reads the stored value.
    property <length> mid-origin-fx;   // fixed reference at click (origin)
    property <length> mid-cur-fx;      // current fixed reference

    // Hovered row index (-1 = none) — driven by `sel-touch`.
    property <int> hovered-idx: -1;
    // Very short lock around Ctrl+wheel's synchronous relayout. Without it,
    // the `rows-revision` notification would republish the OLD viewport onto the
    // NEW geometry just before the restored anchor is applied.
    property <bool> zoom-adjusting: false;

    // Close / merge previews -----
    // `is-drag-source` = this panel is the source of the ongoing tab drag.
    in property <bool> is-drag-source: false;
    // (A) Hovering the "x" button = explicit CLOSE → danger red (actual loss
    // of the layout + tabs). Driven by close-panel-touch.
    property <bool> close-hover: false;
    // (B) Dragging the last tab = the view is about to be ABSORBED via merge. This
    // is an ALLOWED, non-destructive action (the tab migrates) → definitely NOT red:
    // treated as a neutral "dissolution" (grey veil + faded content).
    property <bool> will-merge: root.is-drag-source && root.view.tabs.length <= 1;

    // ACTUAL content height. Unlike Slint's standard ListView,
    // no average-height computation is involved: scrollbar and hit-tests
    // share exactly the same cumulative reference.
    property <length> rows-content-height:
        root.view.rows.length > 0
            ? root.view.rows[root.view.rows.length - 1].visual-y
                + root.view.rows[root.view.rows.length - 1].visual-h
            : 0px;

    function report-rows-viewport() {
        root.rows-viewport-changed(max(0px, -rows-scroll.viewport-y), rows-scroll.height);
    }
    function update-pointer-hover() {
        if (sel-touch.has-hover && !sel-touch.pressed && !root.mid-scroll-active) {
            let hover: int = root.row-idx-at-xy(sel-touch.mouse-x, sel-touch.mouse-y);
            root.hovered-idx = hover;
            if (sel-touch.rename-pending && hover != sel-touch.rename-candidate-idx) {
                sel-touch.cancel-rename-candidate();
            }
        }
    }
    property <int> rows-revision-watch: root.view.rows-revision;
    property <int> viewport-reset-watch: root.view.viewport-reset-gen;
    property <length> rows-viewport-height-watch: list-area.height;
    changed rows-revision-watch => {
        if (!root.zoom-adjusting) {
            rows-scroll.viewport-y = clamp(rows-scroll.viewport-y, root.rb-min-vy, 0px);
            root.report-rows-viewport();
            root.update-drag-hover-row();
            root.update-pointer-hover();
        }
    }
    changed rows-viewport-height-watch => {
        rows-scroll.viewport-y = clamp(rows-scroll.viewport-y, root.rb-min-vy, 0px);
        root.report-rows-viewport();
        root.update-pointer-hover();
    }
    changed viewport-reset-watch => {
        rows-scroll.viewport-y = 0px;
        root.report-rows-viewport();
        root.update-drag-hover-row();
        root.update-pointer-hover();
    }

    // Index of the row under the ordinate `y` (list-area frame), accounting
    // for scrolling. `-1` if outside the list.
    function row-idx-at-y(y: length) -> int {
        if (y < 0px) {
            return -1;
        }
        return root.row-at-content-y(y - rows-scroll.viewport-y);
    }
    // RIGHT edge of the columns (Flickable content position): beyond it is a
    // DEAD ZONE (like the left gutter) → click/hover/drag there start a
    // rubber-band, not a row action. Columns run from `gutter-content`
    // to `gutter-content + content-width`.
    property <length> content-right: Tokens.gutter-content + root.view.content-width;
    // Row index under `(x, y)`, respecting the left (gutter) AND right
    // (beyond the columns) dead zones. `-1` = dead zone / outside the list.
    function row-idx-at-xy(x: length, y: length) -> int {
        (x < Tokens.gutter || x > root.content-right) ? -1 : root.row-idx-at-y(y);
    }

    // Keyboard navigation: brings row `idx` into the visible area by
    // adjusting the exact vertical scroll (viewport-y ≤ 0). Only moves if the
    // row overflows top or bottom. Bounded by `rb-min-vy`.
    function scroll-row-into-view(idx: int) {
        if (idx < 0) {
            return;
        }
        if (idx >= root.view.rows.length) {
            return;
        }
        let top: length = root.view.rows[idx].visual-y;
        let height: length = root.view.rows[idx].visual-h;
        let row-top-in-view: length = top + rows-scroll.viewport-y;
        if (row-top-in-view < 0px) {
            rows-scroll.viewport-y = clamp(-top, root.rb-min-vy, 0px);
        } else if (row-top-in-view + height > rows-scroll.height) {
            rows-scroll.viewport-y = clamp(rows-scroll.height - top - height, root.rb-min-vy, 0px);
        }
    }

    // We ONLY observe `scroll-gen` (bumped on every keyboard cursor
    // move) → scrolls only on keyboard navigation, not on other
    // PanelView refreshes.
    property <int> scroll-gen-watch: root.view.scroll-gen;
    changed scroll-gen-watch => { root.scroll-row-into-view(root.view.cursor-row); }

    // The active state reads as a crisp accent outline (2px); inactive panels
    // carry a discreet thread. (No drop shadow: `panels-container` clips
    // and the z-order between tiles would make it inconsistent from one side to the other.)
    border-width: root.close-hover ? 2px
        : (root.will-merge ? 1.5px
            : (root.active ? 2px : 1px));
    border-color: root.close-hover
        ? Tokens.danger                              // (A) close = red
        : (root.will-merge
            ? Theme.border.with-alpha(0.6)         // (B) absorption = neutral
            : (root.active
                ? Theme.accent-background           // active = accent outline
                : Tokens.hairline));                  // inactive = discreet thread
    border-radius: Tokens.radius-panel;
    // Card surface (slightly detached from the channel/groove = Theme.background).
    background: Theme.surface;
    // NO `clip` HERE: a `clip` combined with a `border-radius` forces Slint to
    // render the whole subtree into an offscreen layer (rounded mask), a layer
    // allocated/recomposed at a fractional size → the WHOLE panel (URL
    // bar, entries) becomes BLURRY, and inconsistently from one panel
    // to another. The clip is carried by `content-clip` (rectangular = scissor,
    // no layer, hence crisp). The rounded corner remains purely visual here.

    // Activates this panel on click of any "dead" zone (empty tab
    // strip, footer, nav bar gaps). Placed BEHIND the content:
    // interactive elements (tabs, buttons, rows…) are on top and
    // keep their clicks; only clicks on empty area land here. Slint
    // dispatches to the topmost TouchArea under the pointer.
    activate-bg := TouchArea {
        clicked => { root.activate(); root.close-ctx-menu(); }
    }

    // Wrapper that CLIPS the content — rectangular, WITHOUT border-radius → clip
    // via scissor (no offscreen layer, hence NO blur). Confines the
    // header buttons to a narrow view (otherwise they'd overflow into the
    // neighboring view). The rounded corner is still carried by the root Rectangle.
    content-clip := Rectangle {
        width: 100%;
        height: 100%;
        clip: true;
    // Root row: [left vertical tab bar] · content ·
    // [right vertical bar]. BOTH bars stay in the tree (zero width
    // and invisible when inactive): a conditional `if` element would not be
    // referenceable (reveal, viewport-y, drag cursor).
    HorizontalLayout {
        padding: Tokens.panel-pad;
        spacing: 6px;
        // "Dissolution" fade when the view is about to be absorbed via merge
        // (dragging its last tab) — main signal, neutral (not red).
        opacity: root.will-merge ? 0.55 : 1.0;
        animate opacity { duration: 200ms; easing: ease-out; }

        vbar-left := VTabBar {
            width: root.tab-mode == 1 ? root.vbar-w : 0px;
            visible: root.tab-mode == 1;
            on-left: true;
            tabs: root.view.tabs;
            active-tab-idx: root.view.active-tab-idx;
            overlay-open: root.overlay-open;
            new-tab-tooltip: root.strings.tab-new-tooltip;
            show-tooltip: root.tab-tooltip-enabled;
            reorder-here: root.tab-mode == 1 && root.drag-active
                && root.drag-over && root.drag-in-bar;
            // Drag cursor in the list's CONTENT position (plain values only:
            // fixed origin `vtabs-col-y` + viewport reported by the bar).
            reorder-cur: root.drag-abs-y - root.vtabs-col-y - self.vp-y;
            cursor-in-bar-y: root.drag-abs-y - root.vtabs-col-y;
            preview-idx: root.tab-mode == 1 ? root.drag-preview-idx : -1;
            preview-pos: root.tab-drop-x;
            claim-drop(g, gy) => { root.report-tab-drop(g, gy); }
            tab-clicked(i) => { root.activate(); root.tab-clicked(i); }
            tab-closed(i) => { root.activate(); root.tab-closed(i); }
            tab-context(i, x, y) => { root.activate(); root.tab-context(i, x, y); }
            // NO `activate()` during the drag (would rebuild the model →
            // lost grab; activation on drop, bridge side) — strip parity.
            tab-drag-progress(i, ax, ay) => { root.tab-drag-progress(i, ax, ay); }
            tab-drag-completed(i, ax, ay) => {
                root.tab-drag-completed(i, root.drag-preview-idx, ax, ay);
            }
            tab-new => { root.activate(); root.close-ctx-menu(); root.tab-new(); }
            bar-clicked => { root.activate(); root.close-ctx-menu(); }
            bar-context(x, y) => { root.activate(); root.tab-bar-context(x, y); }
            wheel(fwd) => { root.tab-wheel(fwd); }
            scrolled(vy) => { root.tabs-scrolled(vy); }
            scroll-target(ti, fwd, vp, vw) => {
                return root.scroll-target(ti, fwd, vp, vw);
            }
            // Resize via the inner grip: width = mouse −
            // bar's left edge (panel + padding 7). Shared clamp
            // via `vbar-w` (the raw live-w is bounded by the formula).
            grip-moved(ax) => {
                root.vbar-live-w = ax - root.absolute-position.x - 7px;
            }
            grip-done => { root.vbar-resized(root.vbar-w); }
        }

    VerticalLayout {
        spacing: 6px;

        // ===== Top toolbar (tabs + nav) =====
        // `Theme.toolbar` background (one notch darker than the surface) to clearly
        // set apart the top part (tabs + URL + buttons) from the bottom part
        // (list). Inset rounded block (the card's border/corner remain
        // visible around it).
        Rectangle {
            background: Theme.toolbar;
            border-radius: Tokens.radius-row;
            VerticalLayout {
                padding: 6px;
                // Vertical bar: the strip's row is COLLAPSED (height
                // 0) → no spacing above the nav bar.
                spacing: root.tab-mode == 0 ? 6px : 0px;

        // ===== Tab strip =====
        // Wrapped in a horizontal layout containing:
        //  - a horizontally scrollable Flickable (tabs + "+" button)
        // (The "split" and "x close panel" tokens live in the
        // nav bar — same location in all THREE bar modes.)
        // COLLAPSED (height 0, invisible) when the tab bar is VERTICAL:
        // the element stays in the tree — its ids (tabs-flick…) are referenced
        // by the panel's properties/Timers (an `if` would break them).
        HorizontalLayout {
            spacing: 4px;
            height: root.tab-mode == 0 ? 26px : 0px;
            visible: root.tab-mode == 0;

            // Scrollable tab zone: it isolates their cumulative width from
            // the panel's minimum width and leaves the splitter free.
            tabs-area := Rectangle {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                max-width: 99999px;
                clip: true;

                // TouchArea for the wheel → switches tab (on hover over the
                // tab zone, regardless of which specific tab). Covers
                // also covers clicking the empty area of the strip, to the right of the tabs.
                // Since this TouchArea consumes clicks, it activates the
                // panel itself.
                tabs-wheel := TouchArea {
                    clicked => { root.activate(); root.close-ctx-menu(); }
                    // Double-click in the EMPTY area of the tab bar → new tab
                    // (like the "+" button), browser convention.
                    double-clicked => { root.activate(); root.close-ctx-menu(); root.tab-new(); }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down
                                && ev.button == PointerEventButton.right) {
                            root.activate();
                            root.tab-bar-context(
                                self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                        }
                    }
                    scroll-event(ev) => {
                        // Modal overlay open → wheel neutralized (no tab
                        // switching while a popup has focus).
                        if (root.overlay-open) {
                            return accept;
                        }
                        // Covers horizontal trackpads and vertical wheel.
                        // `tab-wheel` changes tab (wrap) THEN reveals the new
                        // tab (reliable scroll-into-view).
                        if (ev.delta-y < 0 || ev.delta-x < 0) { root.tab-wheel(true); return accept; }
                        if (ev.delta-y > 0 || ev.delta-x > 0) { root.tab-wheel(false); return accept; }
                        return reject;
                    }
                }

                // The preview line is interleaved between the TabItems
                // to exactly follow each tab's individual width.

                tabs-flick := Flickable {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    viewport-width: max(self.width, tabs-row.preferred-width);
                    viewport-height: self.height;
                    interactive: false;
                    // Smooth scrolling driven by the chevrons + scroll-into-view
                    // (SOLE writers of `viewport-x` → no contention, no
                    // cycle: `tabs-row`'s layout does not depend on `viewport-x`).
                    animate viewport-x { duration: 120ms; easing: ease-out; }
                    // Reports scrolling to the bridge (insertion hit-test for a
                    // tab received from another instance). `viewport-x` is a
                    // PLAIN property already observed (can-scroll-left/right) → the
                    // `changed` fires reliably.
                    changed viewport-x => { root.tabs-scrolled(self.viewport-x); }

                    tabs-row := HorizontalLayout {
                        spacing: 2px;
                        alignment: start;
                        // Tabs with 100% PLAIN geometry: width/offset
                        // come from the MODEL (bridge). Gap claiming is
                        // computed INSIDE TabItem on these plain values (ColumnHeader pattern).
                        for tab[idx] in root.view.tabs : TabItem {
                            title: tab.title;
                            // Path tooltip: opt-in — empty = disabled.
                            tip-path: root.tab-tooltip-enabled ? tab.path : "";
                            active: idx == root.view.active-tab-idx;
                            tab-width: tab.width;
                            tab-offset: tab.offset;
                            tab-index: idx;
                            tab-count: root.view.tabs.length;
                            // Mode gate: the collapsed strip (vertical bar
                            // active) must NEVER claim a
                            // gap — its TabItems always exist in the tree.
                            reorder-active: root.tab-mode == 0 && root.drag-active
                                && root.drag-over && root.drag-in-bar;
                            // Cursor in tabs-row's CONTENT coordinates: visible
                            // position (`drag-abs-x - tabs-row-x`) MINUS the scroll
                            // (`viewport-x` ≤ 0). Without this term, a scrolled bar
                            // (half-tabs) would claim the wrong drop gap. The
                            // preview (inside the Flickable) is already content-relative →
                            // consistent. Plain read of `viewport-x` → safe.
                            reorder-cur: root.drag-abs-x - root.tabs-row-x - tabs-flick.viewport-x;
                            claim-drop(g, gx) => { root.report-tab-drop(g, gx); }
                            clicked => { root.activate(); root.tab-clicked(idx); }
                            close-clicked => { root.activate(); root.tab-closed(idx); }
                            right-clicked(x, y) => { root.activate(); root.tab-context(idx, x, y); }
                            // NO `root.activate()` during the drag (would rebuild
                            // the model → lost grab; activation on drop, bridge side).
                            drag-progress(d, abs-x, abs-y) => {
                                root.tab-drag-progress(idx, abs-x, abs-y);
                            }
                            drag-completed(d, abs-x, abs-y) => {
                                root.tab-drag-completed(idx, root.drag-preview-idx, abs-x, abs-y);
                            }
                        }
                        // The "+" button belongs to the fixed right-hand cluster and
                        // stays visible even when the tabs overflow.
                        // Spacer = overlay cluster width: reserves room on
                        // the right so the LAST tab (and its close button) clears the
                        // cluster instead of being half-hidden under it. Also extends
                        // the Flickable's scroll range accordingly.
                        Rectangle { width: root.tab-cluster-w; }
                    }
                    // Drop preview line — out-of-layout OVERLAY (doesn't shift the
                    // tabs → no binding cycle). At the claimed gap `tab-drop-x`
                    // (tabs-row position = Flickable content).
                    if root.drag-preview-idx >= 0 : Rectangle {
                        x: root.tab-drop-x - 1px;
                        y: 0;
                        width: 2px;
                        height: parent.height;
                        background: Theme.accent-background;
                    }
                }
                // Edge fades: signal that there are hidden tabs to the
                // left/right. Rectangles WITHOUT a TouchArea → intercept nothing (the
                // `tabs-wheel` wheel and clicks pass through). Fades toward
                // `Theme.toolbar` (actual color behind) → theme-aware.
                if root.can-scroll-left : Rectangle {
                    x: 0;
                    y: 0;
                    width: 24px;
                    height: parent.height;
                    background: @linear-gradient(90deg,
                        Theme.toolbar 0%, Theme.toolbar.with-alpha(0.0) 100%);
                }
                // RIGHT scroll cluster: OVERLAY within `tabs-area` (not
                // in the row's layout) → does NOT affect `tabs-area.width`,
                // hence no `tabs-overflow ↔ width` loop. Visible only on
                // overflow. Fades toward `Theme.toolbar` on the left (dissolves the
                // tabs) then an opaque zone under the 2 chevrons (legible). The
                // chevrons carry their own TouchArea → clickable; the fade (to
                // their left) lets wheel/clicks pass through.
                if root.tabs-overflow : Rectangle {
                    x: parent.width - self.width;
                    y: 0;
                    width: 62px;
                    height: parent.height;
                    background: @linear-gradient(90deg,
                        Theme.toolbar.with-alpha(0.0) 0%,
                        Theme.toolbar 22%,
                        Theme.toolbar 100%);
                    // Guard placed below the chevrons: it captures clicks and wheel
                    // events over the whole area without forwarding them to the
                    // tabs underneath. Declared before the chevrons, it leaves
                    // them clickable on top.
                    TouchArea {
                        clicked => { root.activate(); root.close-ctx-menu(); }
                        scroll-event(ev) => {
                            if (root.overlay-open) { return accept; }
                            if (ev.delta-y < 0 || ev.delta-x < 0) { root.tab-wheel(true); return accept; }
                            if (ev.delta-y > 0 || ev.delta-x > 0) { root.tab-wheel(false); return accept; }
                            return reject;
                        }
                    }
                    HorizontalLayout {
                        x: 10px;
                        width: 50px;
                        height: parent.height;
                        spacing: 2px;
                        TabScrollButton {
                            icon: @image-url("../../assets/icons/chevron-left.svg");
                            tooltip-text: root.strings.tab-scroll-left;
                            enabled: root.can-scroll-left;
                            clicked => { root.activate(); root.close-ctx-menu(); root.tabs-scroll-left(); }
                        }
                        TabScrollButton {
                            icon: @image-url("../../assets/icons/chevron-right.svg");
                            tooltip-text: root.strings.tab-scroll-right;
                            enabled: root.can-scroll-right;
                            clicked => { root.activate(); root.close-ctx-menu(); root.tabs-scroll-right(); }
                        }
                    }
                }
            }

            // The scroll chevrons are overlaid within `tabs-area`, outside
            // this layout, to avoid a width ↔ overflow dependency.

            // "+" button outside the Flickable, hence always visible.
            Rectangle {
                width: 28px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                border-radius: 5px;
                background: new-touch.has-hover ? Theme.alternate-background : transparent;
                Image {
                    source: @image-url("../../assets/icons/plus.svg");
                    width: 13px;
                    height: 13px;
                    colorize: Theme.foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                new-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.activate(); root.close-ctx-menu(); root.tab-new(); }
                    changed has-hover => {
                        if (self.has-hover && root.strings.tab-new-tooltip != "") {
                            Tip.text = root.strings.tab-new-tooltip;
                            Tip.x = self.absolute-position.x;
                            Tip.y = self.absolute-position.y + self.height + 4px;
                        } else if (Tip.text == root.strings.tab-new-tooltip) {
                            Tip.text = "";
                        }
                    }
                }
            }

            // The Split and Close-panel actions live in the
            // navigation bar, at a stable location in all three modes.
        }

        // ===== Nav bar + breadcrumb =====
        HorizontalLayout {
            spacing: 4px;
            alignment: stretch;
            height: 28px;

            NavIconButton {
                enabled: root.view.can-go-back;
                icon: @image-url("../../assets/icons/chevron-left.svg");
                tooltip-text: root.strings.nav-prev;
                clicked => { root.activate(); root.go-back(); }
            }
            NavIconButton {
                enabled: root.view.can-go-forward;
                icon: @image-url("../../assets/icons/chevron-right.svg");
                tooltip-text: root.strings.nav-next;
                clicked => { root.activate(); root.go-forward(); }
            }
            NavIconButton {
                icon: @image-url("../../assets/icons/arrow-up.svg");
                tooltip-text: root.strings.nav-parent;
                clicked => { root.activate(); root.go-parent(); }
            }
            NavIconButton {
                icon: @image-url("../../assets/icons/home.svg");
                tooltip-text: root.strings.nav-home;
                clicked => { root.activate(); root.go-home(); }
            }
            NavIconButton {
                icon: @image-url("../../assets/icons/refresh.svg");
                tooltip-text: root.strings.nav-refresh;
                clicked => { root.activate(); root.refresh(); }
            }
            // List / preview toggle. The icon shows the TARGET mode:
            // grid = switch to preview mode; list = go back to list mode.
            // (Embedded SVGs rather than Unicode glyphs ▦/☰: these symbols are
            // missing from Segoe UI → "tofu" boxes on Windows. See DEVBOOK.)
            NavIconButton {
                icon: root.view.preview-mode
                    ? @image-url("../../assets/icons/list.svg")
                    : @image-url("../../assets/icons/grid.svg");
                tooltip-text: root.strings.view-mode-tooltip;
                clicked => { root.activate(); root.toggle-preview-mode(); }
            }
            // Shows / hides hidden files, per view. The icon
            // reflects the CURRENT state: eye = hidden files shown; crossed-out eye = hidden.
            NavIconButton {
                icon: root.view.show-hidden
                    ? @image-url("../../assets/icons/eye.svg")
                    : @image-url("../../assets/icons/eye-off.svg");
                tooltip-text: root.strings.show-hidden-tooltip;
                clicked => { root.activate(); root.toggle-show-hidden(); }
            }
            // Tab bar position: 3-option dropdown menu
            // (top / left / right). The icon reflects the current state via a
            // radio-choice semantics, at the same location in all three modes.
            NavIconButton {
                icon: root.tab-mode == 1
                    ? @image-url("../../assets/icons/tabs-left.svg")
                    : (root.tab-mode == 2
                        ? @image-url("../../assets/icons/tabs-right.svg")
                        : @image-url("../../assets/icons/tabs-top.svg"));
                tooltip-text: root.strings.tabbar-menu-tooltip;
                dismiss-bump: false;   // opens a menu → don't auto-close it
                // Position provided by the button's internal TouchArea via
                // `clicked-at`, same as for tooltips. It thus shares the
                // same reference frame as the pointer event.
                clicked-at(mx, my) => {
                    root.close-ctx-menu();
                    root.open-tabbar-menu(mx, my);
                    root.activate();
                }
            }

            // Path bar: two modes.
            //  - Display (default): breadcrumb of clickable segments.
            //    Clicking a segment → navigate-to(segment.path). Clicking the
            //    empty area on the right → switches to edit mode.
            //  - Edit: TextInput (type an arbitrary path). Enter
            //    submits, Escape cancels. Nautilus pattern (Ctrl+L to edit).
            Rectangle {
                // Visual frame (background + rounded corners) WITHOUT clip: a clip with
                // border-radius forces an offscreen layer rendered at a
                // fractional size → VERY BLURRY URL bar. The clip is carried by
                // the inner rectangular wrapper (scissor, crisp).
                background: Theme.alternate-background;
                border-radius: 4px;
                border-width: root.path-edit-mode ? 1px : 0;
                border-color: Theme.accent-background;
                horizontal-stretch: 1;

                url-clip := Rectangle {
                width: 100%;
                height: 100%;
                clip: true;

                // --- DISPLAY mode: breadcrumbs ---
                if !root.path-edit-mode : TouchArea {
                    // Click on the empty area (not on a segment) → edit mode.
                    clicked => {
                        root.activate();
                        root.close-ctx-menu();
                        root.url-edit-text = root.view.current-path;
                        root.path-edit-mode = true;
                    }
                    // Right-click → enters edit mode (pre-filled field) + Paste/Copy
                    // menu, so "Paste" fills the field.
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down
                                && ev.button == PointerEventButton.right) {
                            root.activate();
                            root.close-ctx-menu();
                            root.url-edit-text = root.view.current-path;
                            root.path-edit-mode = true;
                            root.open-url-menu(
                                self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 0px;
                        alignment: start;
                        for crumb[ci] in root.view.crumbs : HorizontalLayout {
                            spacing: 0px;
                            // "›" separator between segments (not before the first).
                            if ci > 0 : Rectangle {
                                width: 16px;
                                Image {
                                    source: @image-url("../../assets/icons/chevron-right.svg");
                                    width: 11px;
                                    height: 11px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Theme.foreground.with-alpha(0.4);
                                }
                            }
                            crumb-rect := Rectangle {
                                height: parent.height;
                                border-radius: 3px;
                                background: crumb-touch.has-hover
                                    ? Theme.accent-background.with-alpha(0.18)
                                    : transparent;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    Text {
                                        text: crumb.label;
                                        font-size: 12px;
                                        color: Theme.foreground;
                                        vertical-alignment: center;
                                    }
                                }
                                crumb-touch := TouchArea {
                                    clicked => {
                                        root.activate();
                                        root.close-ctx-menu();
                                        root.navigate-to(crumb.path);
                                    }
                                }
                            }
                        }
                    }
                }

                // --- EDIT mode: TextInput + "confirm" button on the right ---
                if root.path-edit-mode : Rectangle {
                    // Right-click thread BEHIND the TextInput: the latter only
                    // handles the left button (cursor/selection), so the
                    // right-click falls through here → Paste/Copy menu.
                    TouchArea {
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down
                                    && ev.button == PointerEventButton.right) {
                                root.open-url-menu(
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    url-input := EditTextInput {
                        x: 8px;
                        y: 0;
                        // Leaves room for the confirm button (28px) on the right.
                        width: parent.width - 8px - 30px;
                        height: parent.height;
                        // Shared text (initialized to the current path on entering
                        // edit mode; replaceable via "Paste").
                        text <=> root.url-edit-text;
                        font-size: 12px;
                        color: Theme.foreground;
                        single-line: true;
                        vertical-alignment: center;
                        selection-background-color: Theme.accent-background.with-alpha(0.5);
                        selection-foreground-color: Theme.foreground;
                        // Focus + select the WHOLE path (direct replacement
                        // on click; desired default behavior).
                        init => {
                            self.focus();
                            self.set-selection-offsets(0, 99999);
                            self.copy-seen = root.url-copy-serial;
                            self.paste-seen = root.url-paste-serial;
                        }
                        // "Copy" in the URL menu acts on the SELECTION, like
                        // this field's own Ctrl+C — copying the whole path
                        // whatever was highlighted made selecting part of it
                        // pointless. Only the field knows its selection, and
                        // the menu lives at window level, out of reach of it;
                        // the menu therefore bumps a counter and the field
                        // acts on it. Same broadcast idiom as `Dismiss`.
                        //
                        // The snapshot taken on `init` is what keeps entering
                        // edit mode from copying on its own: only a counter
                        // that moved AFTER this field appeared is a request.
                        property <int> copy-seen;
                        property <int> copy-request: root.url-copy-serial;
                        changed copy-request => {
                            if (self.copy-request > self.copy-seen) {
                                self.copy-seen = self.copy-request;
                                self.copy();
                            }
                        }
                        // Same reasoning for "Paste": handing the clipboard to
                        // the field through its text replaced the whole line,
                        // where the toolkit's own paste drops it at the caret
                        // and replaces just the selection — what every text
                        // field does, and what Ctrl+V here already did.
                        property <int> paste-seen;
                        property <int> paste-request: root.url-paste-serial;
                        changed paste-request => {
                            if (self.paste-request > self.paste-seen) {
                                self.paste-seen = self.paste-request;
                                self.paste();
                            }
                        }
                        // Focus loss → exits edit mode without navigating
                        // ("cancel on blur"). BUT not if the URL menu is
                        // open (right-click → menu): we must stay in edit mode
                        // so "Paste" fills the field.
                        changed has-focus => {
                            if (!self.has-focus && !root.url-menu-open) {
                                root.path-edit-mode = false;
                            }
                        }
                        accepted => {
                            root.path-edit-mode = false;
                            root.activate();
                            root.navigate-to(self.text);
                            root.request-focus();
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.path-edit-mode = false;
                                root.request-focus();
                                return accept;
                            }
                            // Shared editing shortcuts (see EditTextInput):
                            // this field overrides `key-pressed`, so it must
                            // call them explicitly.
                            if (self.edit-shortcut(event)) { return accept; }
                            return reject;
                        }
                    }

                    // "Confirm" button: applies the entered path and exits
                    // edit mode (equivalent to Enter), clickable.
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        x: parent.width - 26px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: validate-touch.has-hover
                            ? Theme.accent-background
                            : Theme.accent-background.with-alpha(0.85);
                        Image {
                            source: @image-url("../../assets/icons/check.svg");
                            width: 13px;
                            height: 13px;
                            colorize: Theme.accent-foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        validate-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.path-edit-mode = false;
                                root.activate();
                                root.close-ctx-menu();
                                root.navigate-to(url-input.text);
                                root.request-focus();
                            }
                        }
                    }
                }
                } // closes url-clip (rectangular clip wrapper = crisp)
            }

            // Split token: opens the "Split" menu. Moved from the
            // strip to the nav bar: a single location, stable across the
            //    three tab bar modes. --
            Rectangle {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: split-touch.has-hover
                    ? Theme.accent-background.with-alpha(0.18)
                    : transparent;
                border-width: 1px;
                border-color: split-touch.has-hover
                    ? Theme.accent-background.with-alpha(0.55)
                    : Theme.border;
                Image {
                    source: @image-url("../../assets/icons/split.svg");
                    width: 14px;
                    height: 14px;
                    colorize: Theme.foreground.with-alpha(split-touch.has-hover ? 1.0 : 0.7);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                split-touch := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => {
                        if (self.has-hover) {
                            Tip.text = root.strings.panel-split-view;
                            Tip.x = self.absolute-position.x;
                            Tip.y = self.absolute-position.y + self.height + 4px;
                        } else if (Tip.text == root.strings.panel-split-view) {
                            Tip.text = "";
                        }
                    }
                    clicked => {
                        root.close-ctx-menu();
                        // Capture the position + open the menu BEFORE activate()
                        // (which may rebuild this panel, invalidating `self`).
                        root.open-split-menu(
                            self.absolute-position.x,
                            self.absolute-position.y + self.height);
                        root.activate();
                    }
                }
            }

            // -- "x" button to close this panel (visible if > 1 panel) --
            if root.can-close : Rectangle {
                width: 22px;
                height: 22px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: close-panel-touch.has-hover ? Tokens.danger.with-alpha(0.27) : transparent;
                border-width: 1px;
                border-color: close-panel-touch.has-hover ? Tokens.danger.with-alpha(0.4) : Theme.border;
                Image {
                    source: @image-url("../../assets/icons/close.svg");
                    width: 12px;
                    height: 12px;
                    colorize: close-panel-touch.has-hover ? Tokens.danger : Theme.foreground.with-alpha(0.7);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                close-panel-touch := TouchArea {
                    // Hover → "danger" preview across the whole panel (it will
                    // close on click). `changed` because has-hover is not a
                    // direct binding usable from the root.
                    changed has-hover => { root.close-hover = self.has-hover; }
                    clicked => { root.close-ctx-menu(); root.close-panel(); }
                }
            }
        }
            } // closes the toolbar's inner VerticalLayout
        } // closes the toolbar (Theme.toolbar)

        // ===== View filter bar — SHARED component =====
        // By-NAME type-ahead filter: magnifying glass + typed text; shows as soon as
        // text is entered. "x" / Escape = reset (see key-scope).
        if root.active && root.filter-text != "" && !root.view.ext-filter-on : FilterBar {
            icon: @image-url("../../assets/icons/search.svg");
            text: root.filter-text;
            close => { root.close-ctx-menu(); root.filter-clear(); }
        }
        // By-EXTENSION filter: funnel + text (hint "jpg, png" if empty).
        // Activated from the columns menu; driven by keyboard like the
        // type-ahead (input routed bridge-side). "x" = disables it.
        if root.view.ext-filter-on : FilterBar {
            icon: @image-url("../../assets/icons/filter.svg");
            text: root.view.ext-filter;
            hint: "jpg, png";
            close => { root.ext-filter-toggle(); }
        }

        // ===== Flickable wrapper: headers + list scroll TOGETHER horizontally =====
        // If the sum of column widths exceeds the available width,
        // a custom scrollbar appears at the bottom of the panel (see below).
        Rectangle {
            vertical-stretch: 1;
            preferred-width: 0px;
            min-width: 0px;
            max-width: 99999px;

            // Actual row width: left gutter (`gutter-content`) +
            // visible columns (`content-width`) + right padding. It must
            // match the rows' and header's indents so the
            // viewport doesn't add spurious horizontal overflow.
            property <length> total-col-w:
                root.view.content-width + Tokens.gutter-content + 8px;
            // A 6px threshold absorbs residual rounding and spacing to
            // avoid a scrollbar almost as wide as the viewport.
            property <bool> needs-hscroll: total-col-w > self.width + 6px;

            flickable := Flickable {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height - (parent.needs-hscroll ? 10px : 0px);
                viewport-width: max(self.width, parent.total-col-w);
                viewport-height: self.height;
                // `interactive: false`: otherwise the Flickable captures the
                // drags and the rubber-band no longer receives anything. Horizontal
                // scrolling happens via the custom scrollbar at the bottom + via
                // shift+wheel within the list.
                interactive: false;

                VerticalLayout {
                    spacing: 2px;

                    // === Column header (inside the Flickable
                    //     to scroll along with the rows) ===
                    // "Pro table" look: no filled rounded chip, just
                    // a flat header topping a thin hairline.
                    Rectangle {
                        background: transparent;
                        height: 30px;
                        // Thin hairline separating header / list.
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Tokens.hairline;
                        }
                        HorizontalLayout {
                            // Aligned with the rows' content (see FileRowView).
                            padding-left: Tokens.gutter-content;
                            padding-right: 8px;
                            spacing: Tokens.col-gap;
                            alignment: start;

                            // Headers rendered dynamically based on their order and
                            // visibility. The width is resolved via `width-of`, then
                            // applied via `set-col-width` and persisted.
                            for col[ci] in root.view.columns : ColumnHeader {
                                column-width: root.width-of(col.id);
                                label: col.label;
                                column-id: col.id;
                                active: root.view.sort-column == col.id;
                                asc: root.view.sort-asc;
                                index: ci;
                                count: root.view.columns.length;
                                offset: col.offset;
                                col-drag-active: root.col-drag-active;
                                col-drag-new-center: root.col-drag-center + root.col-drag-delta;
                                col-drop-idx: root.col-drop-idx;
                                clicked => { root.activate(); root.sort-clicked(col.id); }
                                resized(w) => { root.set-col-width(col.id, w); }
                                resize-finished => { root.column-resized(col.id, root.width-of(col.id)); }
                                right-clicked(x, y) => { root.activate(); root.open-columns-menu(x, y); }
                                reorder-start(center) => {
                                    root.col-drag-active = true;
                                    root.col-drag-id = col.id;
                                    root.col-drag-center = center;
                                    root.col-drag-delta = 0px;
                                    root.col-drop-idx = -1;
                                }
                                reorder-move(delta) => { root.col-drag-delta = delta; }
                                report-drop-target(t) => { root.col-drop-idx = t; }
                                reorder-end(delta) => {
                                    if (root.col-drag-active && root.col-drag-id != "") {
                                        root.column-moved(root.col-drag-id, delta / 1px);
                                    }
                                    root.col-drag-active = false;
                                    root.col-drag-id = "";
                                    root.col-drag-delta = 0px;
                                    root.col-drop-idx = -1;
                                }
                            }
                        }
                    }

                    // === List + empty area + rubber-band overlay ===
                    list-area := Rectangle {
            vertical-stretch: 1;
            preferred-width: 0px;
            min-width: 0px;
            max-width: 99999px;
            // Confines the selection rectangle (and the rows) to the list
            // area: without this, a negative rubber-band `y` would make it overflow
            // OVER the column header (list-area draws afterward).
            clip: true;

            // Vertical Flickable with EXACT content. The standard `ListView` estimates
            // its anchor via the delegates' average height, which is not
            // compatible with a mix of 28/76/… px. `rendered-rows` stays a
            // sub-model bounded to the viewport + overscan: virtualization is
            // preserved without ever approximating the geometry.
            rows-scroll := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: max(self.height, root.rows-content-height);
                interactive: false;
                changed viewport-y => {
                    if (!root.zoom-adjusting) {
                        root.report-rows-viewport();
                        root.update-drag-hover-row();
                        root.update-pointer-hover();
                    }
                }
                for entry[visible-idx] in root.view.rendered-rows : FileRowView {
                    x: 0px;
                    y: entry.visual-y;
                    width: rows-scroll.viewport-width;
                    name: entry.name;
                    name-base: entry.name-base;
                    name-ext: entry.name-ext;
                    hidden: entry.hidden;
                    age: entry.age;
                    age-bucket: entry.age-bucket;
                    path: entry.path;
                    size: entry.size;
                    modified: entry.modified;
                    is-dir: entry.is-dir;
                    is-symlink: entry.is-symlink;
                    kind: entry.kind;
                    selected: entry.selected;
                    cut: entry.cut;
                    // A drag target receives the same hover as mouse
                    // hover, including from another Ranger view/instance.
                    hovered: entry.model-index == root.hovered-idx
                        || (root.file-drag-over && entry.model-index == root.drag-hover-row
                            && (entry.is-dir || entry.drop-runnable));
                    preview-mode: root.view.preview-mode;
                    row-h: entry.visual-h;
                    resolution: entry.resolution;
                    depth: entry.depth;
                    ext: entry.ext;
                    thumbnail: entry.thumbnail;
                    app-icon: entry.app-icon;
                    link-folder: entry.link-folder;
                    col-name-width: root.col-name-width;
                    col-path-width: root.col-path-width;
                    col-size-width: root.col-size-width;
                    col-modified-width: root.col-modified-width;
                    col-ext-width: root.col-ext-width;
                    col-resolution-width: root.col-resolution-width;
                    col-depth-width: root.col-depth-width;
                    col-age-width: root.col-age-width;
                    content-width: root.view.content-width;
                    columns: root.view.columns;
                }
            }

            // "Folder not found" banner: inaccessible folder (network
            // drive not started, missing mount). We KEEP the tab + this message
            // PERSISTENT; it disappears on its own once the folder becomes
            // accessible again (automatic recheck, see `recheck-unavailable`).
            if root.view.unavailable : Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                background: Theme.background;
                // LEFT-ALIGNED block — on a narrow/cramped view, a
                // centered warning can "fall" outside the visible area or get
                // clipped; anchored on the left, it always stays legible. Centered
                // vertically only.
                VerticalLayout {
                    alignment: center;              // centers the block VERTICALLY
                    spacing: 7px;
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    // Icon wrapped in a LEFT-aligned HorizontalLayout: a
                    // fixed-size Image is NOT stretched by the VerticalLayout.
                    HorizontalLayout {
                        alignment: start;
                        Image {
                            source: @image-url("../../assets/icons/network.svg");
                            width: 24px;
                            height: 24px;
                            colorize: Tokens.danger;
                        }
                    }
                    Text {
                        text: root.strings.tab-unavailable;
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.foreground;
                        horizontal-alignment: left;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.view.current-path;
                        font-size: 12px;
                        color: Theme.foreground.with-alpha(0.65);
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    Text {
                        text: root.strings.tab-unavailable-hint;
                        font-size: 11px;
                        color: Theme.foreground.with-alpha(0.5);
                        horizontal-alignment: left;
                        wrap: word-wrap;
                    }
                }
            }

            // SINGLE, STABLE TouchArea above the viewport: handles hover,
            // clicks (single / Ctrl / Shift / right / double) and rubber-band, by
            // deducing the row index from `mouse-y` (see row-idx-at-y).
            // Since it is never virtualized, mouse-up is always received
            // → the rubber-band ends cleanly even after auto-scroll.
            sel-touch := TouchArea {
                // This TouchArea covers the viewport to handle clicks, hover, and
                // the selection rectangle without depending on virtualized rows.
                // It reserves 14px on the right for the native scrollbar in case of
                // overflow, and keeps x=0 to keep local coordinates
                // aligned. `gutter-strip` covers the inset outside the clip.
                x: 0;
                y: 0;
                width: rows-scroll.viewport-height > rows-scroll.height
                    ? parent.width - 14px
                    : parent.width;
                height: parent.height;

                property <length> down-x;
                property <length> down-y;
                property <bool> dragging: false;
                // Was the press on a ROW (≥ gutter) → file drag;
                // otherwise (dead zone) → selection rectangle.
                property <bool> down-on-row: false;
                property <int> down-idx: -1;
                // Was the entry already selected AT THE TIME of the new
                // press? This is the signature of Explorer's slow second click.
                property <bool> down-was-selected: false;
                // A click that primarily serves to ACTIVATE another view must never
                // count as the slow second click of an Explorer rename.
                property <bool> down-view-was-active: false;
                // Same lock for a click that primarily serves to CLOSE a
                // backdrop-less context menu. On release the menu is already closed,
                // so its state must be stored BEFORE `close-ctx-menu()`.
                property <bool> down-overlay-was-open: false;
                // Modifiers stored on press (source: pointer event)
                // → rubber-band mode robust to a keyboard focus loss.
                property <bool> down-ctrl: false;
                property <bool> down-shift: false;
                property <bool> file-drag: false;
                // Rename candidate armed on release of the second click. The
                // delay gives priority to a double-click; path + index make
                // the check robust to a re-list/re-sort during the wait.
                property <bool> rename-pending: false;
                property <int> rename-candidate-idx: -1;
                property <string> rename-candidate-dir: "";
                property <string> rename-candidate-name: "";
                property <int> rename-candidate-tab: -1;
                property <int> rename-candidate-activation: -1;
                // An activation (double-click) consumes the whole click sequence
                // that produced it. The counter, captured on pointer-down, makes the
                // decision independent of the backend's `double-clicked`/pointer-up
                // ordering and of any reentrancy during ShellExecute.
                property <int> activation-generation: 0;
                property <int> activation-at-down: 0;
                // Also prevents a fast third click from accidentally becoming
                // a "slow second click" right after launching an entry.
                property <bool> activation-cooldown: false;

                function cancel-rename-candidate() {
                    self.rename-pending = false;
                    self.rename-candidate-idx = -1;
                    self.rename-candidate-activation = -1;
                }
                // Folder/tab change, overlay, active panel, keystroke, or
                // click in the chrome: all invalidate the candidate's context.
                property <string> dir-watch: root.view.current-path;
                property <int> tab-watch: root.view.active-tab-idx;
                property <int> dismiss-serial: Dismiss.serial;
                property <int> keyboard-serial: root.keyboard-interaction-gen;
                property <bool> overlay-watch: root.overlay-open;
                property <bool> active-watch: root.active;
                changed dir-watch => { self.cancel-rename-candidate(); }
                changed tab-watch => { self.cancel-rename-candidate(); }
                changed dismiss-serial => { self.cancel-rename-candidate(); }
                changed keyboard-serial => { self.cancel-rename-candidate(); }
                changed overlay-watch => {
                    if (self.overlay-watch) { self.cancel-rename-candidate(); }
                }
                changed active-watch => {
                    if (!self.active-watch) { self.cancel-rename-candidate(); }
                }
                // The drag was externalized (native OLE): the "button released"
                // event is consumed by the modal loop → Slint never receives it. We
                // therefore ignore any `moved` until the NEXT press, to avoid
                // restarting a "phantom" drag.
                property <bool> native-done: false;

                // Wheel: Ctrl+wheel = zoom entries (growing size,
                // switches to thumbnails past the threshold); otherwise normal scrolling
                // (the viewport sits under this TouchArea, which captures the events).
                scroll-event(ev) => {
                    // The row under a stationary pointer changes during a scroll:
                    // a deferred rename must never target the old entry.
                    self.cancel-rename-candidate();
                    // During a FILE DRAG: the wheel ALWAYS SCROLLS the
                    // hovered view (never zooms, even with Ctrl+drag) → reach an
                    // off-screen folder without releasing the drag. This branch
                    // precedes the overlay gate because the drag is itself part of
                    // `any-overlay-open`.
                    if (root.file-drag-active) {
                        if (root.file-drag-over) {
                            rows-scroll.viewport-y = clamp(
                                rows-scroll.viewport-y + ev.delta-y, root.rb-min-vy, 0px);
                        }
                        return accept;
                    }
                    // A modal overlay is open → we consume the wheel event without
                    // doing anything: the view must not scroll/zoom under the popup.
                    if (root.overlay-open) {
                        return accept;
                    }
                    // Ctrl+wheel = zoom. We read the modifier CARRIED BY
                    // THE EVENT (`ev.modifiers.control`), the AUTHORITATIVE
                    // keyboard state maintained by Slint's core, rather than
                    // `root.ctrl-down`: the latter is only up to date if
                    // `key-scope` has keyboard focus. Since an element can take it
                    // away (hover/click elsewhere), `ctrl-down` used to stay stuck
                    // at false → Ctrl+wheel stopped zooming and scrolled instead.
                    if (ev.modifiers.control && ev.delta-y != 0) {
                        root.activate();
                        root.zoom-adjusting = true;
                        let anchored-top: length = root.zoom-step(
                            ev.delta-y > 0 ? 1 : -1,
                            max(0px, -rows-scroll.viewport-y),
                            rows-scroll.height,
                            self.mouse-y);
                        // The callback is synchronous: the rows' geometry is
                        // already the new one. Re-applying the anchor AFTER this relayout
                        // prevents an absolute scroll value from targeting other
                        // files when the heights change.
                        rows-scroll.viewport-y = clamp(
                            -anchored-top, root.rb-min-vy, 0px);
                        root.zoom-adjusting = false;
                        // Intermediate notifications were coalesced:
                        // a single final publish drives virtualization,
                        // thumbnail priority, drag-hover, and mouse hover.
                        root.report-rows-viewport();
                        root.update-drag-hover-row();
                        root.update-pointer-hover();
                        return accept;
                    }
                    rows-scroll.viewport-y = clamp(
                        rows-scroll.viewport-y + ev.delta-y, root.rb-min-vy, 0px);
                    return accept;
                }

                moved => {
                    // Externalized drag (native OLE): we ignore any movement
                    // until the next press — otherwise `self.pressed` staying true
                    // (release consumed by the modal loop) would restart a
                    // phantom drag.
                    if (self.native-done) { return; }
                    if (self.file-drag && self.dragging && !root.file-drag-active) {
                        self.native-done = true;
                        self.dragging = false;
                        self.file-drag = false;
                        return;
                    }
                    if (self.pressed) {
                        if (!self.dragging
                                && (abs(self.mouse-x - self.down-x) > 4px
                                    || abs(self.mouse-y - self.down-y) > 4px)) {
                            self.cancel-rename-candidate();
                            self.dragging = true;
                            if (self.down-on-row) {
                                // Press on a file/folder → cross-view drag.
                                self.file-drag = true;
                                root.file-drag-started(self.down-idx,
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            } else {
                                // Dead zone → selection rectangle. Mode based on the
                                // modifier: Ctrl = subtract, Shift = add,
                                // otherwise replace. The bridge captures the base;
                                // no more `deselect-all` here (the 1st UPDATE handles it
                                // in replace mode).
                                self.file-drag = false;
                                root.rb-active = true;
                                root.rubber-band-begin(self.down-ctrl ? 2 : (self.down-shift ? 1 : 0));
                                root.rb-anchor-x = self.down-x;
                                root.rb-anchor-cy = self.down-y - rows-scroll.viewport-y;
                            }
                        }
                        if (self.dragging && self.file-drag) {
                            root.file-drag-progress(
                                self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                        } else if (self.dragging) {
                            root.rb-cur-x = self.mouse-x;
                            root.rb-cur-vy = self.mouse-y;
                            root.rubber-band-update(
                                min(root.rb-anchor-x, root.rb-cur-x),
                                min(root.rb-anchor-cy, root.rb-cur-cy),
                                max(root.rb-anchor-x, root.rb-cur-x),
                                max(root.rb-anchor-cy, root.rb-cur-cy),
                            );
                        }
                    }
                    // NB: `moved` fires ONLY during a press (drag);
                    // plain hover is handled by `changed mouse-y` below.
                }

                // Hover (no press): `mouse-y`/`mouse-x` update as the
                // cursor moves → we highlight the row under the pointer.
                // The left gutter (`Tokens.gutter`) is a dead zone: no
                // hover (consistent with click/right-click, which also ignore it).
                // `mouse-x` is handled in addition to `mouse-y` to cover a
                // purely horizontal movement entering/exiting the gutter.
                // (Not during middle-click auto-scroll, to avoid flickering.)
                changed mouse-y => {
                    if (!self.pressed && !root.mid-scroll-active) {
                        let hover: int = root.row-idx-at-xy(self.mouse-x, self.mouse-y);
                        root.hovered-idx = hover;
                        if (self.rename-pending && hover != self.rename-candidate-idx) {
                            self.cancel-rename-candidate();
                        }
                    }
                }
                changed mouse-x => {
                    // Horizontal middle-click auto-scroll: stores the position
                    // in the FIXED reference `mouse-x + viewport-x` at this instant (where
                    // mouse-x is consistent with the geometry) → the Timer reads it without
                    // drift. Otherwise, row hover (horizontal movement).
                    if (root.mid-scroll-active) {
                        root.mid-cur-fx = self.mouse-x + flickable.viewport-x;
                    } else if (!self.pressed) {
                        let hover: int = root.row-idx-at-xy(self.mouse-x, self.mouse-y);
                        root.hovered-idx = hover;
                        if (self.rename-pending && hover != self.rename-candidate-idx) {
                            self.cancel-rename-candidate();
                        }
                    }
                }

                changed has-hover => {
                    if (!self.has-hover) {
                        self.cancel-rename-candidate();
                        root.hovered-idx = -1;
                        // Safety: if the cursor leaves the area (e.g. button
                        // released outside), we cut the middle-click auto-scroll.
                        root.mid-scroll-active = false;
                    }
                }

                pointer-event(ev) => {
                    // Any new interaction cancels a previous candidate.
                    // The current left click may arm a new one on up.
                    if (ev.kind == PointerEventKind.down) {
                        self.cancel-rename-candidate();
                    }
                    // SIDE mouse buttons (X1/X2) = Back / Forward
                    // in the panel's history, like Windows Explorer.
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.back) {
                        root.activate();
                        root.go-back();
                    }
                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.forward) {
                        root.activate();
                        root.go-forward();
                    }
                    if (ev.kind == PointerEventKind.down
                            && ev.button == PointerEventButton.left) {
                        // Modifiers stored from the EVENT (authoritative
                        // source, up to date even if `key-scope` doesn't have
                        // keyboard focus). The rubber-band mode captured a
                        // moment later in `moved` relies on this rather
                        // than `root.ctrl-down`/`shift-down` (which can be
                        // stuck after a focus loss).
                        self.down-ctrl = ev.modifiers.control;
                        self.down-shift = ev.modifiers.shift;
                        // Captured BEFORE `activate()`: after the call, `root.active`
                        // would already be true and the information would be lost.
                        self.down-view-was-active = root.active;
                        // Captured BEFORE `close-ctx-menu()` to distinguish a real
                        // second click from a click meant to dismiss the menu.
                        self.down-overlay-was-open = root.overlay-open;
                        root.activate();
                        // A left click closes the context menu (and still goes on
                        // to select the row on release).
                        root.close-ctx-menu();
                        self.down-x = self.mouse-x;
                        self.down-y = self.mouse-y;
                        self.dragging = false;
                        self.file-drag = false;
                        self.native-done = false;   // new press → re-arm
                        self.activation-at-down = self.activation-generation;
                        // Is the press on a row (outside the gutter)?
                        self.down-idx = root.row-idx-at-xy(self.mouse-x, self.mouse-y);
                        self.down-on-row = self.down-idx >= 0;
                        self.down-was-selected = self.down-idx >= 0
                            && self.down-idx < root.view.rows.length
                            && root.view.rows[self.down-idx].selected;
                    }
                    if (ev.kind == PointerEventKind.up
                            && ev.button == PointerEventButton.left) {
                        if (self.activation-at-down != self.activation-generation) {
                            // End of a sequence consumed by `double-clicked`:
                            // does not select the entry that appeared under the mouse
                            // after a navigation, and never arms the rename.
                        } else if (self.dragging && self.file-drag) {
                            // End of a file drag → MainWindow decides
                            // (drop menu if ANOTHER view is under the cursor).
                            root.file-drag-dropped(
                                self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                            self.file-drag = false;
                        } else if (self.dragging) {
                            // FINAL update at the RELEASE position before
                            // closing: a fast drag often releases between two
                            // coalesced `moved` events → the band was only extended
                            // up to the last `moved`, leaving the last
                            // swept rows out of the selection.
                            root.rb-cur-x = self.mouse-x;
                            root.rb-cur-vy = self.mouse-y;
                            root.rubber-band-update(
                                min(root.rb-anchor-x, root.rb-cur-x),
                                min(root.rb-anchor-cy, root.rb-cur-cy),
                                max(root.rb-anchor-x, root.rb-cur-x),
                                max(root.rb-anchor-cy, root.rb-cur-cy),
                            );
                            root.rb-active = false; // clean end of the rubber-band
                        } else {
                            // Left gutter AND right dead zone (beyond the
                            // columns) are NOT entry click zones: a
                            // left click there deselects (blank area).
                            let idx: int = root.row-idx-at-xy(self.mouse-x, self.mouse-y);
                            if (idx < 0) {
                                root.deselect-all();
                            } else if (ev.modifiers.control) {
                                root.row-ctrl-clicked(idx);
                            } else if (ev.modifiers.shift) {
                                root.row-shift-clicked(idx);
                            } else {
                                root.row-clicked(idx);
                                // A first click selects. Only a following click
                                // on this already-selected entry arms the popup.
                                // The Timer will still check hover, identity, and state.
                                if (!self.activation-cooldown
                                        && self.down-view-was-active
                                        && !self.down-overlay-was-open
                                        && self.down-was-selected && idx == self.down-idx) {
                                    self.rename-candidate-idx = idx;
                                    self.rename-candidate-dir = root.view.current-path;
                                    self.rename-candidate-name = root.view.rows[idx].name;
                                    self.rename-candidate-tab = root.view.active-tab-idx;
                                    self.rename-candidate-activation = self.activation-generation;
                                    self.rename-pending = true;
                                }
                            }
                        }
                        self.dragging = false;
                        root.request-focus();
                    }
                    // Middle-click held down → auto-scroll (origin = press
                    // position). Release (any button) → stop.
                    if (ev.kind == PointerEventKind.down
                            && ev.button == PointerEventButton.middle) {
                        root.activate();
                        root.mid-origin-y = self.mouse-y;
                        root.mid-origin-fx = self.mouse-x + flickable.viewport-x;
                        root.mid-cur-fx = root.mid-origin-fx;
                        root.mid-scroll-active = true;
                    }
                    if (ev.kind == PointerEventKind.up
                            && ev.button == PointerEventButton.middle) {
                        root.mid-scroll-active = false;
                    }
                    if (ev.kind == PointerEventKind.down
                            && ev.button == PointerEventButton.right) {
                        root.activate();
                        // Right-click in the left gutter OR the right dead zone
                        // = background menu (Paste…) even if a row is there.
                        let ridx: int = root.row-idx-at-xy(self.mouse-x, self.mouse-y);
                        if (ridx < 0) {
                            root.empty-right-clicked(
                                self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                        } else {
                            root.right-clicked(
                                ridx,
                                self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                        }
                    }
                }

                double-clicked => {
                    // Double-click keeps its opening semantics and always
                    // wins over the slow second-click. Incrementing BEFORE the
                    // application-level call also invalidates a Timer already queued if
                    // opening the file causes a focus loss or re-enters the
                    // native event loop.
                    self.cancel-rename-candidate();
                    self.activation-generation += 1;
                    self.activation-cooldown = true;
                    rename-activation-cooldown-timer.restart();
                    // Respects the dead zones (gutter / beyond the columns).
                    let idx: int = root.row-idx-at-xy(self.mouse-x, self.mouse-y);
                    if (idx >= 0) {
                        root.activate();
                        root.row-activated(idx);
                    }
                }
            }

            // Explorer-style rename: after the second click, wait a bit
            // and only open if the pointer is still targeting EXACTLY the same
            // entry. F2 and the context menu still use the same route.
            rename-delay-timer := Timer {
                interval: 500ms;
                // IMPORTANT: the Timer's lifecycle must be driven by
                // reactive state. A `running: false` + `restart()` gets canceled
                // by the next Slint re-evaluation and makes the nominal case
                // inoperative. `cancel-rename-candidate()` is enough to stop it.
                running: sel-touch.rename-pending;
                triggered => {
                    // `stop()` normally cancels the event. The explicit check
                    // additionally guards against a callback already queued during
                    // an external application activation.
                    let was-pending: bool = sel-touch.rename-pending;
                    let idx: int = sel-touch.rename-candidate-idx;
                    let activation: int = sel-touch.rename-candidate-activation;
                    sel-touch.cancel-rename-candidate();
                    if (was-pending
                            && activation == sel-touch.activation-generation
                            && root.active && !root.overlay-open && !root.file-drag-active
                            && idx >= 0 && idx < root.view.rows.length
                            && root.view.current-path == sel-touch.rename-candidate-dir
                            && root.view.active-tab-idx == sel-touch.rename-candidate-tab
                            && root.hovered-idx == idx
                            && root.view.rows[idx].selected
                            && root.view.rows[idx].name == sel-touch.rename-candidate-name) {
                        root.rename-selected();
                    }
                }
            }

            rename-activation-cooldown-timer := Timer {
                interval: 500ms;
                // Same principle: the guard always returns to false after the
                // delay, even if the activation modified the model or focus.
                running: sel-touch.activation-cooldown;
                triggered => { sel-touch.activation-cooldown = false; }
            }

            if root.rb-active : Rectangle {
                // Converts the rectangle (in content coords) back to visible.
                x: min(root.rb-anchor-x, root.rb-cur-x);
                y: min(root.rb-anchor-cy, root.rb-cur-cy) + rows-scroll.viewport-y;
                width: abs(root.rb-cur-x - root.rb-anchor-x);
                height: abs(root.rb-cur-cy - root.rb-anchor-cy);
                background: Theme.accent-background.with-alpha(0.15);
                border-width: 1px;
                border-color: Theme.accent-background.with-alpha(0.55);
            }

            // Automatic scroll when the rectangle reaches an edge.
            // As long as the rubber-band is active and the mouse is within the
            // edge zone, we scroll the viewport; since `rb-cur-cy` is reactive to
            // scroll, the selection extends on its own to the revealed rows.
            Timer {
                interval: 16ms;
                running: root.rb-active;
                triggered => {
                    if (root.rb-cur-vy < 24px && rows-scroll.viewport-y < 0px) {
                        rows-scroll.viewport-y = min(0px, rows-scroll.viewport-y + 18px);
                        root.rubber-band-update(
                            min(root.rb-anchor-x, root.rb-cur-x),
                            min(root.rb-anchor-cy, root.rb-cur-cy),
                            max(root.rb-anchor-x, root.rb-cur-x),
                            max(root.rb-anchor-cy, root.rb-cur-cy),
                        );
                    } else if (root.rb-cur-vy > list-area.height - 24px
                            && rows-scroll.viewport-y > root.rb-min-vy) {
                        rows-scroll.viewport-y = max(root.rb-min-vy, rows-scroll.viewport-y - 18px);
                        root.rubber-band-update(
                            min(root.rb-anchor-x, root.rb-cur-x),
                            min(root.rb-anchor-cy, root.rb-cur-cy),
                            max(root.rb-anchor-x, root.rb-cur-x),
                            max(root.rb-anchor-cy, root.rb-cur-cy),
                        );
                    }
                }
            }

            // Auto-scroll during a FILE DRAG when the cursor nears the top/bottom
            // edge of the body → reaches an off-screen folder; `drag-folder-row`
            // follows the scroll, so the target updates on its own. Active only on
            // the hovered panel. `list-area` is the unscrolled body frame, so
            // `file-drag-abs-y - list-area.y` is the in-body offset the edges use.
            DragEdgeScroller {
                active: root.file-drag-active && root.file-drag-over;
                cursor-y: root.file-drag-abs-y;
                frame-y: list-area.absolute-position.y;
                frame-h: list-area.height;
                min-vy: root.rb-min-vy;
                viewport-y <=> rows-scroll.viewport-y;
            }

            // Auto-scroll on middle-click held down (browser/PDF style):
            // as long as the middle button is held, we scroll at a speed
            // proportional to the gap between the mouse and the press point
            // (10px dead zone to stay still near the origin). The
            // two axes are independent → diagonal scrolling is possible.
            Timer {
                interval: 16ms;
                running: root.mid-scroll-active;
                triggered => {
                    let dead: length = 10px;
                    // --- Vertical (exact Flickable viewport-y) ---
                    if (rows-scroll.viewport-height > rows-scroll.height) {
                        let d: length = sel-touch.mouse-y - root.mid-origin-y;
                        let eff: length = d > dead ? d - dead : (d < -dead ? d + dead : 0px);
                        rows-scroll.viewport-y = clamp(
                            rows-scroll.viewport-y - eff / 6, root.rb-min-vy, 0px);
                    }
                    // Horizontal (Flickable viewport-x) — FIXED reference ---
                    if (flickable.viewport-width > flickable.width) {
                        let dx: length = root.mid-cur-fx - root.mid-origin-fx;
                        let effx: length = dx > dead ? dx - dead : (dx < -dead ? dx + dead : 0px);
                        flickable.viewport-x = clamp(
                            flickable.viewport-x - effx / 6,
                            -(flickable.viewport-width - flickable.width), 0px);
                    }
                }
            }
        }
                } // closes the VerticalLayout inside the Flickable
            } // closes Flickable

            // ===== Custom horizontal scrollbar (visible on overflow) =====
            if needs-hscroll : hscrollbar := Rectangle {
                x: 0;
                y: parent.height - 7px;
                width: parent.width;
                height: 5px;
                // TRANSPARENT track (no more background band): discreet, can
                // no longer read as a dark line.
                background: transparent;
                border-radius: 2.5px;

                property <length> thumb-w:
                    max(30px, self.width * flickable.width / max(1px, flickable.viewport-width));

                // Thumb: position driven by the Flickable's viewport-x.
                Rectangle {
                    x: -flickable.viewport-x
                        / max(1px, flickable.viewport-width - flickable.width)
                        * (hscrollbar.width - hscrollbar.thumb-w);
                    y: 0;
                    width: hscrollbar.thumb-w;
                    height: parent.height;
                    // Dimmed (0.22 at rest, formerly 0.4) → light indicator, not a
                    // dark bar; crisp accent on hover/drag.
                    background: thumb-touch.has-hover || thumb-touch.pressed
                        ? Theme.accent-background.with-alpha(0.7)
                        : Theme.foreground.with-alpha(0.22);
                    border-radius: parent.border-radius;

                    property <length> drag-start-x;
                    property <length> drag-start-viewport-x;
                    thumb-touch := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(ev) => {
                            if (ev.button == PointerEventButton.left
                                    && ev.kind == PointerEventKind.down) {
                                root.close-ctx-menu();
                                parent.drag-start-x = self.absolute-position.x + self.mouse-x;
                                parent.drag-start-viewport-x = flickable.viewport-x;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                flickable.viewport-x = parent.drag-start-viewport-x
                                    - (self.absolute-position.x + self.mouse-x - parent.drag-start-x)
                                        / max(1px, hscrollbar.width - hscrollbar.thumb-w)
                                        * (flickable.viewport-width - flickable.width);
                            }
                        }
                    }
                }
            }

            // ===== Custom VERTICAL scrollbar (visible on vertical overflow) =====
            // Pinned to the RIGHT edge of the VIEW (not the content) → ALWAYS visible,
            // even when the columns overflow horizontally. Same
            // style/logic as the
            // custom horizontal scrollbar.
            if root.rb-min-vy < 0px : vscrollbar := Rectangle {
                x: parent.width - 7px;
                y: 32px;                              // below the header (30px + 2px spacing)
                width: 5px;
                height: flickable.height - 32px;      // stops above the hscrollbar
                background: transparent;
                border-radius: 2.5px;

                property <length> thumb-h:
                    max(30px, self.height * rows-scroll.height / max(1px, rows-scroll.viewport-height));

                Rectangle {
                    x: 0;
                    // Position driven by viewport-y (∈ [rb-min-vy, 0]).
                    y: -rows-scroll.viewport-y
                        / max(1px, rows-scroll.viewport-height - rows-scroll.height)
                        * (vscrollbar.height - vscrollbar.thumb-h);
                    width: parent.width;
                    height: vscrollbar.thumb-h;
                    background: vthumb-touch.has-hover || vthumb-touch.pressed
                        ? Theme.accent-background.with-alpha(0.7)
                        : Theme.foreground.with-alpha(0.22);
                    border-radius: parent.border-radius;

                    property <length> drag-start-y;
                    property <length> drag-start-viewport-y;
                    vthumb-touch := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(ev) => {
                            if (ev.button == PointerEventButton.left
                                    && ev.kind == PointerEventKind.down) {
                                root.close-ctx-menu();
                                parent.drag-start-y = self.absolute-position.y + self.mouse-y;
                                parent.drag-start-viewport-y = rows-scroll.viewport-y;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                rows-scroll.viewport-y = clamp(
                                    parent.drag-start-viewport-y
                                        - (self.absolute-position.y + self.mouse-y - parent.drag-start-y)
                                            / max(1px, vscrollbar.height - vscrollbar.thumb-h)
                                            * (rows-scroll.viewport-height - rows-scroll.height),
                                    root.rb-min-vy, 0px);
                            }
                        }
                    }
                }
            }
        } // closes the wrapper Rectangle (Flickable + scrollbar)

        // ===== Footer =====
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            height: 18px;
            Text {
                text: root.footer-text;
                font-size: 11px;
                color: Theme.foreground.with-alpha(0.6);
            }
        }
    }

        vbar-right := VTabBar {
            width: root.tab-mode == 2 ? root.vbar-w : 0px;
            visible: root.tab-mode == 2;
            on-left: false;
            tabs: root.view.tabs;
            active-tab-idx: root.view.active-tab-idx;
            overlay-open: root.overlay-open;
            new-tab-tooltip: root.strings.tab-new-tooltip;
            show-tooltip: root.tab-tooltip-enabled;
            reorder-here: root.tab-mode == 2 && root.drag-active
                && root.drag-over && root.drag-in-bar;
            reorder-cur: root.drag-abs-y - root.vtabs-col-y - self.vp-y;
            cursor-in-bar-y: root.drag-abs-y - root.vtabs-col-y;
            preview-idx: root.tab-mode == 2 ? root.drag-preview-idx : -1;
            preview-pos: root.tab-drop-x;
            claim-drop(g, gy) => { root.report-tab-drop(g, gy); }
            tab-clicked(i) => { root.activate(); root.tab-clicked(i); }
            tab-closed(i) => { root.activate(); root.tab-closed(i); }
            tab-context(i, x, y) => { root.activate(); root.tab-context(i, x, y); }
            tab-drag-progress(i, ax, ay) => { root.tab-drag-progress(i, ax, ay); }
            tab-drag-completed(i, ax, ay) => {
                root.tab-drag-completed(i, root.drag-preview-idx, ax, ay);
            }
            tab-new => { root.activate(); root.close-ctx-menu(); root.tab-new(); }
            bar-clicked => { root.activate(); root.close-ctx-menu(); }
            bar-context(x, y) => { root.activate(); root.tab-bar-context(x, y); }
            wheel(fwd) => { root.tab-wheel(fwd); }
            scrolled(vy) => { root.tabs-scrolled(vy); }
            scroll-target(ti, fwd, vp, vw) => {
                return root.scroll-target(ti, fwd, vp, vw);
            }
            // Resize (bar on the RIGHT): width = bar's right edge
            // (panel + width − padding 7) − mouse.
            grip-moved(ax) => {
                root.vbar-live-w = root.absolute-position.x + root.width - 7px - ax;
            }
            grip-done => { root.vbar-resized(root.vbar-w); }
        }
    } // closes the root row [left bar · content · right bar]

    // ===== Left gutter: draggable strip =====
    // The `body-left` inset is VISUALLY part of the gutter, but no
    // TouchArea in the body can cover it: `list-area` has `clip: true` and the
    // Flickable also clips — and a clip bounds the HIT-TEST just as much as the rendering.
    // (Trying to extend `sel-touch` toward negative x's therefore fails, and on
    // top of that shifts all its local coordinates.) We place here, as the last child of
    // content-clip — so above the root row and `activate-bg`, but
    // BELOW the panel's overlays (context menu, drop targets) — a
    // strip that drives the SAME rubber-band: same `rb-*` properties, same
    // callbacks, same auto-scroll (the Timer only reads root properties).
    // Coordinates converted into `list-area`'s frame (`x - body-left`, hence
    // always negative): consistent with `row-idx-at-xy`, which sees it as a dead
    // zone there. Zero width when the LEFT vertical tab bar is
    // displayed: that space then belongs to it.
    gutter-strip := TouchArea {
        x: 0;
        y: root.body-top;
        width: root.tab-mode == 1 ? 0px : root.list-inset-x;
        height: list-area.height;

        property <length> down-x;   // list-area position (negative)
        property <length> down-y;
        property <bool> dragging;
        // Modifiers stored on press (event = authoritative source) →
        // rubber-band mode robust to a keyboard focus loss.
        property <bool> down-ctrl: false;
        property <bool> down-shift: false;

        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down
                    && ev.button == PointerEventButton.left) {
                root.activate();
                root.close-ctx-menu();
                self.down-x = self.mouse-x - root.list-inset-x;
                self.down-y = self.mouse-y;
                self.down-ctrl = ev.modifiers.control;
                self.down-shift = ev.modifiers.shift;
                self.dragging = false;
            }
            if (ev.kind == PointerEventKind.up
                    && ev.button == PointerEventButton.left) {
                if (self.dragging) {
                    root.rb-active = false;   // clean end of the rubber-band
                } else {
                    // Plain click on the blank area → deselection, like the
                    // inner gutter (see `sel-touch`).
                    root.deselect-all();
                }
                self.dragging = false;
            }
        }

        moved => {
            if (self.pressed) {
                if (!self.dragging
                        && (abs(self.mouse-x - root.list-inset-x - self.down-x) > 4px
                            || abs(self.mouse-y - self.down-y) > 4px)) {
                    self.dragging = true;
                    root.rb-active = true;
                    root.rubber-band-begin(self.down-ctrl ? 2 : (self.down-shift ? 1 : 0));
                    root.rb-anchor-x = self.down-x;
                    root.rb-anchor-cy = self.down-y - rows-scroll.viewport-y;
                }
                if (self.dragging) {
                    root.rb-cur-x = self.mouse-x - root.list-inset-x;
                    root.rb-cur-vy = self.mouse-y;
                    root.rubber-band-update(
                        min(root.rb-anchor-x, root.rb-cur-x),
                        min(root.rb-anchor-cy, root.rb-cur-cy),
                        max(root.rb-anchor-x, root.rb-cur-x),
                        max(root.rb-anchor-cy, root.rb-cur-cy),
                    );
                }
            }
        }
    }
    } // closes content-clip (rectangular clip wrapper = crisp)

    // ===== File drop target =====
    // Veil + accent outline on the hovered view during a file drag
    // (except the source view). Purely visual (no TouchArea).
    if root.file-drag-over && !root.is-file-drag-source : Rectangle {
        background: Theme.accent-background.with-alpha(0.10);
        border-width: 2px;
        border-color: Theme.accent-background;
        border-radius: Tokens.radius-panel;
    }

    // ===== Close / merge previews =====
    // (A) Hovering the "x" → RED veil (explicit close = destruction).
    if root.close-hover : Rectangle {
        background: Tokens.danger.with-alpha(0.10);
    }
    // (B) Dragging the last tab → NEUTRAL grey veil (absorption, not danger).
    // The content is additionally faded to 55% (see the VerticalLayout's opacity).
    if root.will-merge : Rectangle {
        background: Theme.foreground.with-alpha(0.05);
    }

    // ===== Drop zone overlay =====
    // During a tab drag, the hovered panel shows the candidate zone:
    // the accent plate occupies the half the new panel would take (or
    // the whole panel in the center = move), + an oriented cut line.
    // Only one zone visible at a time (by design): only the panel under the
    // cursor has `drag-over`. Purely visual (no TouchArea → intercepts
    // nothing; the drag stays driven by the tab).
    // No plate when the tab insertion line is active (header):
    // strip → insertion line; body → zone plate. Clean separation.
    if root.drag-over && root.drag-zone > 0 && root.drag-preview-idx < 0 : Rectangle {
        // Candidate plate.
        Rectangle {
            x: root.drag-zone == 3 ? root.width / 2 : 0px;
            y: root.drag-zone == 5 ? root.height / 2 : 0px;
            width: (root.drag-zone == 2 || root.drag-zone == 3) ? root.width / 2 : root.width;
            height: (root.drag-zone == 4 || root.drag-zone == 5) ? root.height / 2 : root.height;
            background: Theme.accent-background.with-alpha(0.16);
            border-width: 2px;
            border-color: Theme.accent-background.with-alpha(0.9);
            border-radius: Tokens.radius-overlay;
        }
        // Cut line — vertical (side by side) or horizontal (stacked).
        if root.drag-zone == 2 || root.drag-zone == 3 : Rectangle {
            x: root.width / 2 - 1px;
            width: 2px;
            height: root.height;
            background: Theme.accent-background;
        }
        if root.drag-zone == 4 || root.drag-zone == 5 : Rectangle {
            y: root.height / 2 - 1px;
            width: root.width;
            height: 2px;
            background: Theme.accent-background;
        }
    }
}

// Small text button reusable in the Workspaces overlay.
component WsButton inherits Rectangle {
    callback clicked();
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> danger: false;
    height: 28px;
    border-radius: 5px;
    background: root.primary
        ? (touch.has-hover ? Theme.accent-background.with-alpha(0.85) : Theme.accent-background)
        : (root.danger
            ? (touch.has-hover ? Tokens.danger.with-alpha(0.2) : transparent)
            : (touch.has-hover ? Theme.alternate-background : transparent));
    border-width: 1px;
    border-color: root.primary
        ? Theme.accent-background
        : (root.danger ? Tokens.danger.with-alpha(0.4) : Theme.border);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.label;
            font-size: 12px;
            color: root.primary
                ? Theme.accent-foreground
                : (root.danger ? Tokens.danger : Theme.foreground);
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A row in the list of saved workspaces. Handles inline rename and
// the two-step delete confirmation locally.
// Small icon button (glyph OR SVG image) with an optional tooltip.
component WsIconBtn inherits Rectangle {
    callback clicked();
    in property <string> glyph;       // used if `icon` is not provided
    in property <image> icon;
    in property <string> tooltip;     // tooltip (empty = none)
    in property <bool> danger: false;
    // Amber variant: ⟳ "Save changes" on the current MODIFIED
    // row — warning tint, matches the row's amber dot.
    in property <bool> amber: false;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: touch.has-hover
        ? (root.danger
            ? Tokens.danger.with-alpha(0.13)
            : (root.amber ? Tokens.warning.with-alpha(0.16) : Theme.accent-background.with-alpha(0.18)))
        : transparent;

    if root.icon.width > 0 : Image {
        source: root.icon;
        width: 15px;
        height: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
        colorize: root.amber
            ? Tokens.warning
            : (touch.has-hover
                ? (root.danger ? Tokens.danger : Theme.foreground)
                : Theme.foreground.with-alpha(0.6));
    }
    if root.icon.width == 0 : Text {
        text: root.glyph;
        font-size: 14px;
        color: root.amber
            ? Tokens.warning
            : (touch.has-hover
                ? (root.danger ? Tokens.danger : Theme.foreground)
                : Theme.foreground.with-alpha(0.6));
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        // Tooltip ABOVE the button via the global Tip (rendered at the
        // window level → never clipped by the strip, including on the 1st row).
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                Tip.text = root.tooltip;
                Tip.x = self.absolute-position.x;
                Tip.y = self.absolute-position.y - 26px;
            } else if (Tip.text == root.tooltip) {
                Tip.text = "";
            }
        }
    }
}

// Row of a workspace, with three mutually exclusive states:
// normal (click = load, actions revealed on hover), editing (inline rename),
// delete confirmation (two-step red bar).
component WorkspaceRow inherits Rectangle {
    callback load();
    callback overwrite();
    callback update-now();   // direct "Update" (current amber pill)
    callback delete();
    callback rename(string);
    in property <string> name;
    in property <int> panels;
    in property <int> tabs;
    // CURRENTLY loaded workspace (accent rail + semibold name) and, if
    // modified without being saved, DIRTY (dot + amber "Update" pill).
    in property <bool> is-current: false;
    in property <bool> is-dirty: false;
    in property <Strings> strings;
    property <bool> editing: false;
    property <bool> confirming-delete: false;
    property <bool> confirming-overwrite: false;
    // Armed on entering edit mode to focus the field AFTER layout (see
    // focus-timer in the edit block) — a direct `focus()` in `init` loops.
    property <bool> focus-armed: false;

    // --- Deferred state transitions (anti "Recursion detected") ---
    // A button that modifies `editing`/`confirming-*` from its own
    // `clicked` would get DESTROYED (the `if` block containing it disappears)
    // during the callback's execution → reentrancy. We therefore go through a
    // `pending` property (referenced by no `if`, so the button survives the
    // click); a Timer applies the transition on the next event-loop turn.
    // codes: 1=enter edit · 2=enter delete-confirm · 3=exit edit
    //         · 4=exit delete-confirm · 5=enter overwrite-confirm
    //         · 6=exit overwrite-confirm.
    property <int> pending: 0;
    property <string> pending-rename: "";
    property <bool> pending-delete: false;
    property <bool> pending-overwrite: false;
    Timer {
        interval: 1ms;
        running: root.pending != 0;
        triggered => {
            if (root.pending == 1) { root.editing = true; root.focus-armed = true; }
            if (root.pending == 2) { root.confirming-delete = true; }
            if (root.pending == 3) {
                root.editing = false;
                if (root.pending-rename != "") { root.rename(root.pending-rename); }
                root.pending-rename = "";
            }
            if (root.pending == 4) {
                root.confirming-delete = false;
                if (root.pending-delete) { root.delete(); }
                root.pending-delete = false;
            }
            if (root.pending == 5) { root.confirming-overwrite = true; }
            if (root.pending == 6) {
                root.confirming-overwrite = false;
                if (root.pending-overwrite) { root.overwrite(); }
                root.pending-overwrite = false;
            }
            root.pending = 0;
        }
    }

    height: 44px;
    border-radius: 7px;
    background: root.confirming-delete
        ? Tokens.danger.with-alpha(0.10)
        : (root.confirming-overwrite
            ? Theme.accent-background.with-alpha(0.10)
            : ((row-touch.has-hover || root.editing)
                ? Theme.alternate-background
                : transparent));

    // The "Load" TouchArea covers the whole row, including action buttons,
    // to keep a stable hover state. The icons' nested TouchAreas
    // capture their own clicks; the row's only receives the empty areas.
    row-touch := TouchArea {
        // Provides a stable `has-hover` that encompasses the child buttons.
        // Loading goes through the explicit "Load" button, with no accidental
        // row-click that would overwrite the current layout). The child
        // TouchAreas capture their own clicks since they're deeper.

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;

        // ===== NORMAL mode =====
        if !root.editing && !root.confirming-delete && !root.confirming-overwrite : Image {
            width: 16px;
            source: @image-url("../../assets/icons/workspace.svg");
            colorize: root.is-current ? Theme.accent-background : Theme.foreground.with-alpha(0.5);
        }
        if !root.editing && !root.confirming-delete && !root.confirming-overwrite : Text {
            text: root.name;
            font-size: 14px;
            // Semibold name on the currently loaded workspace.
            font-weight: root.is-current ? 600 : 400;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // "Unsaved changes" dot, AT THE END OF THE NAME (status
        // marker: doesn't shift the icon+name alignment of other rows,
        // persists at rest AND on hover). Tooltip on hover to remove
        // ambiguity about its meaning (widened hover area; the dot centers).
        if !root.editing && !root.confirming-delete && !root.confirming-overwrite && root.is-dirty : Rectangle {
            width: 16px;
            dot-touch := TouchArea {
                changed has-hover => {
                    if (self.has-hover) {
                        Tip.text = root.strings.ws-dirty-tooltip;
                        Tip.x = self.absolute-position.x - 70px;
                        Tip.y = self.absolute-position.y - 26px;
                    } else if (Tip.text == root.strings.ws-dirty-tooltip) {
                        Tip.text = "";
                    }
                }
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: Tokens.warning;
                }
            }
        }
        // Metadata at rest (unchanged even on a modified workspace: the only
        // amber signal at rest remains the dot above).
        if !root.editing && !root.confirming-delete && !root.confirming-overwrite && !row-touch.has-hover : Text {
            text: root.panels + " " + root.strings.ws-panels-short + "  ·  " + root.tabs + " " + root.strings.ws-tabs-short;
            font-size: 12px;
            color: Theme.foreground.with-alpha(0.45);
            vertical-alignment: center;
        }
        // …replaced on hover by the secondary actions (with tooltips).
        if !root.editing && !root.confirming-delete && !root.confirming-overwrite && row-touch.has-hover : HorizontalLayout {
            spacing: 2px;
            // On the current MODIFIED row, the ⟳ "overwrite" becomes the
            // "Save changes" action: tinted amber (matches the
            // dot) and a single DIRECT click (unambiguous intent). On other
            // rows, it keeps its 2-step confirmation.
            WsIconBtn {
                icon: @image-url("../../assets/icons/overwrite.svg");
                amber: root.is-dirty;
                tooltip: root.is-dirty ? root.strings.ws-dirty-save-action : root.strings.ws-update;
                clicked => {
                    if (root.is-dirty) { root.update-now(); }
                    else { root.pending = 5; } // enter overwrite confirmation
                }
            }
            WsIconBtn {
                icon: @image-url("../../assets/icons/pencil.svg");
                tooltip: root.strings.ws-rename;
                clicked => { root.pending = 1; } // enter edit mode (deferred)
            }
            WsIconBtn {
                icon: @image-url("../../assets/icons/trash.svg");
                danger: true;
                tooltip: root.strings.ws-delete;
                clicked => { root.pending = 2; } // enter delete confirmation (deferred)
            }
        }
        // "Load" button — always visible (explicit primary action).
        if !root.editing && !root.confirming-delete && !root.confirming-overwrite : WsButton {
            label: root.strings.ws-load;
            primary: true;
            clicked => { root.load(); }
        }

        // ===== EDIT mode (inline rename) =====
        // NB: the TextInput fills via `horizontal-stretch` in an inner
        // layout (NOT via `width: parent.width - X`). In a repeated
        // component (`for`), a width computed from `parent.width`
        // creates a layout cycle → "Recursion detected".
        if root.editing : HorizontalLayout {
            spacing: 6px;
            padding-top: 7px;
            padding-bottom: 7px;
            // Deferred focus: `edit-input.focus()` is called by this Timer on
            // the event-loop turn following the field's appearance (stable layout),
            // NOT in the TextInput's `init` (which loops in a repeater).
            // `focus-armed` is set by the main Timer on entering edit mode.
            Timer {
                interval: 1ms;
                running: root.focus-armed;
                triggered => {
                    edit-input.focus();
                    // Caret at the end of the line (no full selection).
                    edit-input.set-selection-offsets(99999, 99999);
                    root.focus-armed = false;
                }
            }
            // No `y: parent.height…` or fixed `height:` on the Rectangle:
            // in a repeated component, a geometry depending on
            // `parent.height` triggers a vertical layout cycle
            // ("Recursion detected"). The HL's padding gives the height;
            // the Rectangle fills it, the TextInput is centered.
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.background;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.accent-background;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    edit-input := EditTextInput {
                        horizontal-stretch: 1;
                        text: root.name;
                        font-size: 13px;
                        color: Theme.foreground;
                        vertical-alignment: center;
                        single-line: true;
                        selection-background-color: Theme.accent-background.with-alpha(0.5);
                        // Focus handled by the `focus-timer` above (deferred,
                        // outside `init`) — an `init => focus()` loops in a
                        // repeated component (see DEVBOOK).
                        accepted => {
                            root.pending-rename = self.text;
                            root.pending = 3;
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) { root.pending = 3; return accept; }
                            // Same here: local override → explicit call.
                            if (self.edit-shortcut(event)) { return accept; }
                            return reject;
                        }
                    }
                }
            }
            WsIconBtn {
                icon: @image-url("../../assets/icons/check.svg");
                clicked => {
                    root.pending-rename = edit-input.text;
                    root.pending = 3;
                }
            }
            WsIconBtn {
                icon: @image-url("../../assets/icons/close.svg");
                clicked => { root.pending = 3; }
            }
        }

        // ===== DELETE CONFIRMATION mode (two-step red bar) =====
        if root.confirming-delete : HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.strings.ws-delete-confirm;
                font-size: 13px;
                color: Tokens.danger;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            WsButton {
                label: root.strings.btn-cancel;
                clicked => { root.pending = 4; } // exit confirmation (deferred)
            }
            WsButton {
                label: root.strings.ws-delete;
                danger: true;
                clicked => {
                    root.pending-delete = true;
                    root.pending = 4; // exit + delete (deferred)
                }
            }
        }

        // ===== OVERWRITE CONFIRMATION mode (two-step accent bar) =====
        if root.confirming-overwrite : HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.strings.ws-overwrite-confirm;
                font-size: 13px;
                color: Theme.foreground;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            WsButton {
                label: root.strings.btn-cancel;
                clicked => { root.pending = 6; } // exit without overwriting (pending-overwrite false)
            }
            WsButton {
                label: root.strings.ws-update;
                primary: true;
                clicked => {
                    root.pending-overwrite = true;
                    root.pending = 6; // exit + overwrite (deferred)
                }
            }
        }
    }
    } // closes row-touch (enclosing TouchArea)

    // "Loaded workspace" identity rail. Overlaid on the left
    // edge, purely decorative (captures no clicks). VERY THIN and
    // subtle bar (2px, 85% accent). Hardcoded height (34 = 44 − 2x5): reading
    // `parent.height` in a repeated component can create a vertical layout
    // cycle ("Recursion detected", see edit mode).
    if root.is-current : Rectangle {
        x: 0;
        y: 5px;
        width: 2px;
        height: 34px;
        border-radius: 1px;
        background: Theme.accent-background.with-alpha(0.85);
    }
}

// Progress toast.
// Non-blocking floating card (no backdrop) anchored bottom-right.
// 6px bar, progress measured in bytes or items, animation in
// indeterminate mode, and a Cancel or Close button depending on the state.
component ProgressToast inherits Rectangle {
    in property <int> op-state;          // 1 running,2 scan,3 success,4 error,5 cancelled
    in property <float> progress;        // 0..1
    in property <bool> indeterminate;
    in property <string> title;
    in property <string> detail;
    in property <string> percent;
    in property <string> cancel-label;
    callback cancel();
    callback dismiss();

    width: 360px;
    height: 88px;
    background: Theme.background;
    border-radius: Tokens.radius-overlay;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 24px;
    drop-shadow-color: #000000.with-alpha(0.35);
    drop-shadow-offset-y: 6px;

    property <bool> terminal: root.op-state == 3 || root.op-state == 4 || root.op-state == 5;
    property <color> fill-color: root.op-state == 4
        ? Tokens.danger
        : (root.op-state == 5 ? Theme.foreground.with-alpha(0.35) : Theme.accent-background);
    property <bool> sweep: false;

    // Absorbs clicks on the card (but NOT elsewhere → non-blocking).
    TouchArea { }

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        // Line 1: title + percentage + "x" (terminal state).
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 600;
                color: root.op-state == 4 ? Tokens.danger : Theme.foreground;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.percent;
                font-size: 13px;
                font-weight: 600;
                color: Theme.foreground.with-alpha(0.7);
                vertical-alignment: center;
            }
            if root.terminal : Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 4px;
                background: dismiss-touch.has-hover ? Theme.alternate-background : transparent;
                Image {
                    source: @image-url("../../assets/icons/close.svg");
                    width: 11px;
                    height: 11px;
                    colorize: Theme.foreground.with-alpha(0.6);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                dismiss-touch := TouchArea {
                    clicked => { root.dismiss(); }
                }
            }
        }

        // Line 2: track + fill.
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.foreground.with-alpha(0.12);
            clip: true;
            if !root.indeterminate : Rectangle {
                x: 0;
                width: parent.width * clamp(root.progress, 0, 1);
                height: parent.height;
                border-radius: 3px;
                background: root.fill-color;
                animate width { duration: 120ms; easing: ease-out; }
            }
            if root.indeterminate : Rectangle {
                width: parent.width * 0.3;
                height: parent.height;
                border-radius: 3px;
                background: Theme.accent-background;
                x: root.sweep ? parent.width - self.width : 0px;
                animate x { duration: 1100ms; easing: ease-in-out; }
            }
        }

        // Line 3: detail + Cancel (non-terminal states).
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.detail;
                font-size: 11px;
                color: Theme.foreground.with-alpha(0.6);
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if !root.terminal : Rectangle {
                width: 78px;
                height: 24px;
                border-radius: 5px;
                border-width: 1px;
                border-color: Theme.border;
                background: cancel-touch.has-hover ? Theme.alternate-background : transparent;
                Text {
                    text: root.cancel-label;
                    font-size: 12px;
                    color: Theme.foreground.with-alpha(0.85);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                cancel-touch := TouchArea {
                    clicked => { root.cancel(); }
                }
            }
        }
    }

    // Indeterminate animation: ping-pong of the glowing block.
    Timer {
        interval: 1100ms;
        running: root.indeterminate && root.op-state == 2;
        triggered => { root.sweep = !root.sweep; }
    }

    // Auto-dismiss: success after 1.5s, cancelled after 1.2s. An error stays
    // until closed by hand. Held by the card itself so that each toast in the
    // stack times out on its own.
    Timer {
        interval: root.op-state == 5 ? 1200ms : 1500ms;
        running: root.op-state == 3 || root.op-state == 5;
        triggered => { root.dismiss(); }
    }
}

// "Places" sidebar ----------

// Capacity gauge shown at the right end of a drive row.
//
// Fill and figures both measure what is USED, so they say one thing: the bar
// grows, the number grows, the volume is filling. Showing free space here was
// tried and read as a contradiction — a bar advancing while its own caption
// counted down. Free space is what the reader usually wants, so it leads the
// hover hint, where there is room to name it.
//
// The label straddles the seam between fill and empty track — a two-tone
// ground no single text colour survives once the fill is coloured. It is
// therefore drawn TWICE at the very same position, the second pass clipped to
// the fill. Each half is then read against one flat colour, and the glyph
// crossing the seam splits exactly where the bar ends. When the fill is
// colourless both passes use the same ink, so nothing shows.
//
// No animation: a value that moves by a fraction of a percent per minute has
// nothing to animate, and a sliding bar here would read as a copy in progress.
component DriveGauge inherits Rectangle {
    in property <float> used-ratio;
    in property <int> level;
    in property <string> label;     // "" renders the bare gauge
    in property <length> avail-width;

    // Floored so a nearly empty volume still shows a sliver rather than an
    // apparently broken gauge, and capped short of the full width so the
    // remaining track stays visible on a nearly full one — the two ends are
    // where the reading matters most.
    property <length> fill-w: root.used-ratio <= 0
        ? 0px
        : min(root.width, max(8px, root.width * clamp(root.used-ratio, 0, 1)));

    height: 18px;
    // A true capsule. `Tokens.radius-row` is already the radius of the row
    // highlight sitting behind it; repeating it would read as a misalignment.
    border-radius: self.height / 2;
    // Measured text plus air, never wider than the row can spare, never so
    // narrow the capsule stops reading as a gauge.
    width: clamp(txt.preferred-width + 16px, 28px, root.avail-width);
    background: Tokens.track;
    clip: true;

    Rectangle {
        x: 0;
        width: root.fill-w;
        height: parent.height;
        background: Tokens.disk-fill(root.level);
    }

    // Pass 1 — the whole label, over the empty track.
    txt := Text {
        x: (parent.width - self.width) / 2;
        height: parent.height;
        text: root.label;
        font-size: 10.5px;
        font-weight: 400;
        color: Theme.foreground;
        vertical-alignment: center;
    }

    // Pass 2 — same label, same box, clipped to the fill. Centring on the
    // GAUGE and not on this clip rectangle is what keeps the two passes in
    // register to the pixel; any drift would show as a doubled edge.
    Rectangle {
        x: 0;
        width: root.fill-w;
        height: parent.height;
        clip: true;
        Text {
            x: (root.width - self.width) / 2;
            height: parent.height;
            text: root.label;
            font-size: 10.5px;
            font-weight: 400;
            color: Tokens.disk-ink(root.level);
            vertical-alignment: center;
        }
    }
}

// A clickable sidebar entry (icon + label).
component SidebarItem inherits Rectangle {
    callback clicked();
    callback middle-clicked();                 // open in a new tab
    callback right-clicked(length, length);   // absolute position
    in property <string> label;
    in property <int> kind;   // 0 folder · 1 home · 2 drive · 3 trash · 4 network · 5 phone
    in property <int> space-level: -1;   // -1 = unmeasurable → no gauge at all
    in property <float> space-used-ratio;
    in property <string> space-text;
    in property <string> space-text-short;
    in property <string> space-hint;
    /// Width of the whole side panel, handed down rather than measured.
    ///
    /// The gauge sizes itself to its text, so it FEEDS the row's layout. Were
    /// its content chosen from the row's resolved width, that width would
    /// depend on the gauge and the gauge on the width — a binding loop the
    /// compiler rejects outright. The panel width is set by the user and
    /// depends on nothing below it, which breaks the cycle at the source.
    in property <length> panel-width;

    // The row trades detail for room as the panel narrows: full figures, then
    // free space alone — the bar already carries the ratio, so the total is
    // the one redundant part — then the bare gauge, which still shows the
    // proportion and the warning colour.
    //
    // Fixed costs per row: 12px of section padding, then 8 padding + 16 icon +
    // 9 + 9 spacing + 8 padding = 50px of row chrome. The thresholds keep at
    // least 64px for the drive's name, because a row that says how full a disk
    // is but no longer says WHICH disk has traded away the wrong thing.
    property <int> space-tier: root.panel-width >= 185px ? 2
        : root.panel-width >= 170px ? 1
        : 0;

    // Below the narrowest tier the gauge is dropped entirely rather than shown
    // bare. A capsule with no figures still costs 28px of a row that has none
    // to spare, and it says only what the row could no longer name — the
    // drive's own label matters more than how full it is.
    property <bool> show-gauge: root.space-level >= 0 && root.space-tier > 0;

    height: 30px;
    border-radius: Tokens.radius-row;
    // Both areas count: the gauge's sits on top of the row's, so over the
    // gauge only IT reports hover — without this the row would lose its
    // highlight exactly where the pointer is.
    background: (touch.has-hover || gauge-hover.has-hover)
        ? Theme.alternate-background
        : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 9px;
        // Full-height icon slot → vertically centered image (otherwise the
        // layout pins the 16px image to the top of the row).
        Rectangle {
            width: 16px;
            height: parent.height;
            Image {
                width: 16px;
                height: 16px;
                x: 0;
                y: (parent.height - self.height) / 2;
                colorize: (root.kind == 2 || root.kind == 4 || root.kind == 5)
                    ? Theme.accent-background
                    : Theme.foreground.with-alpha(0.7);
                source: root.kind == 1 ? @image-url("../../assets/icons/home.svg")
                    : root.kind == 2 ? @image-url("../../assets/icons/drive.svg")
                    : root.kind == 3 ? @image-url("../../assets/icons/trash.svg")
                    : root.kind == 4 ? @image-url("../../assets/icons/network.svg")
                    : root.kind == 5 ? @image-url("../../assets/icons/phone.svg")
                    : @image-url("../../assets/icons/folder.svg");
            }
        }
        Text {
            text: root.label;
            font-size: 12px;
            color: Theme.foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // Capacity gauge, local volumes only and only when the size could
        // actually be read. Declared inside the SAME layout so it costs no
        // extra height.
        //
        // ALWAYS instantiated, collapsed to nothing when there is no capacity
        // to show, rather than wrapped in an `if`: a conditional element is
        // out of scope for the row, which needs its position to tell whether
        // the pointer is over it. Zero width and hidden is the same
        // "instantiate and collapse" idiom the Favorites tree uses.
        gauge-slot := Rectangle {
            width: root.show-gauge ? gauge.width : 0px;
            visible: root.show-gauge;
            // Full-height slot → vertically centred gauge, same reason as the
            // icon above: the layout would otherwise pin it to the top.
            height: parent.height;
            gauge := DriveGauge {
                y: (parent.height - self.height) / 2;
                used-ratio: root.space-used-ratio;
                level: root.space-level;
                avail-width: max(28px, root.panel-width - 126px);
                label: root.space-tier == 2 ? root.space-text : root.space-text-short;
            }
        }
    }
    // Button handling for the row, shared by the two touch areas below so that
    // clicking the gauge behaves exactly like clicking anywhere else on the
    // row — one implementation, not a copy that can drift.
    function dispatch-pointer(ev: PointerEvent, abs-x: length, abs-y: length) {
        // LEFT click on the sidebar closes menus; right-click (drive/
        // trash menu) does not bump → it can teleport the menu.
        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
            Dismiss.serial += 1;
        }
        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
            root.right-clicked(abs-x, abs-y);
        }
        // Middle-click → open the target in a NEW tab (active view).
        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.middle) {
            root.middle-clicked();
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(ev) => {
            root.dispatch-pointer(ev,
                self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y);
        }
    }

    // Hover target for the gauge, and the gauge only.
    //
    // Declared AFTER `touch` so it sits ON TOP of it and is the one the
    // pointer reaches — the same front-to-back rule the Favorites tree relies
    // on. It hands every button straight back to the row, so nothing is lost
    // by covering it.
    //
    // This replaces an earlier attempt that compared the row's `mouse-x`
    // against the gauge's position. That looked cheaper but was unreliable:
    // entering the gauge did not raise the hint, moving on to another row did,
    // and leaving the gauge sideways left it up — the pointer coordinate is
    // simply not dependable at the moment hovering begins. A real touch area
    // has one honest state, `has-hover`, and Slint maintains it. Zero width
    // when there is no gauge, so it cannot intercept anything.
    gauge-hover := TouchArea {
        x: gauge-slot.x;
        y: 0;
        width: root.show-gauge ? gauge-slot.width : 0px;
        height: parent.height;
        mouse-cursor: pointer;
        // Names each figure, which the gauge alone cannot: "26,0/57,3 Go" does
        // not say which number is which. `absolute-position` is read HERE, in
        // an event handler where the layout has settled — reading it from a
        // property derived from the geometry aborted the whole window with
        // "Recursion detected", the row being inside a ScrollView.
        changed has-hover => {
            if (self.has-hover && root.space-hint != "") {
                Tip.text = root.space-hint;
                Tip.x = self.absolute-position.x;
                Tip.y = self.absolute-position.y + self.height + 4px;
            } else if (Tip.text == root.space-hint) {
                Tip.text = "";
            }
        }
        clicked => { root.clicked(); }
        pointer-event(ev) => {
            root.dispatch-pointer(ev,
                self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y);
        }
    }
}

// Small icon button reserved for the Favorites header actions. Declared before
// the shared header so its deeper TouchAreas keep priority
// over the drag surface placed behind them.
component SidebarHeaderAction inherits Rectangle {
    callback clicked();
    in property <image> icon;
    in property <string> tooltip;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.alternate-background : transparent;
    Image {
        source: root.icon;
        width: 14px;
        height: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: touch.has-hover ? Theme.foreground : Theme.foreground.with-alpha(0.6);
    }
    touch := TouchArea {
        clicked => { Dismiss.serial += 1; root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                Tip.text = root.tooltip;
                Tip.x = self.absolute-position.x;
                Tip.y = self.absolute-position.y + self.height + 4px;
            } else if (Tip.text == root.tooltip) {
                Tip.text = "";
            }
        }
    }
}

// Explicitly centers a 24x24 action within the 30px header without
// modifying `SidebarHeaderAction`, also used in the Open With settings.
component SidebarHeaderActionSlot inherits Rectangle {
    callback clicked();
    in property <image> icon;
    in property <string> tooltip;
    width: 24px;
    height: 30px;
    SidebarHeaderAction {
        y: (parent.height - self.height) / 2;
        icon: root.icon;
        tooltip: root.tooltip;
        clicked => { root.clicked(); }
    }
}

// Header shared by the four reorderable sections. A release before the
// 6px threshold keeps the legacy collapse click; past this threshold, the gesture
// becomes exclusively a drag and never changes the chevron's state.
component SidebarSectionHeader inherits Rectangle {
    callback toggled();
    callback drag-started(int, length, length); // section, absolute x/y
    callback drag-moved(int, length, length);
    callback drag-dropped(int, length, length);
    callback new-container();
    callback collapse-all();
    in property <int> section-code;
    in property <string> label;
    in property <bool> collapsed;
    in property <bool> favorite-actions: false;
    in property <bool> can-collapse: false;
    in property <string> new-container-tooltip;
    in property <string> collapse-tooltip;
    in property <bool> reorder-drag-active: false;
    property <length> down-abs-x;
    property <length> down-abs-y;
    property <bool> dragging: false;

    height: 30px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.toggled(); }
    background: root.dragging
        ? Theme.accent-background.with-alpha(0.08)
        : (header-touch.has-hover ? Theme.foreground.with-alpha(0.05) : transparent);

    changed reorder-drag-active => {
        if (!root.reorder-drag-active) { root.dragging = false; }
    }

    // Whole surface draggable, below the Favorites action buttons.
    header-touch := TouchArea {
        mouse-cursor: root.dragging ? grabbing : grab;
        pointer-event(ev) => {
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                Dismiss.serial += 1;
                root.down-abs-x = self.absolute-position.x + self.mouse-x;
                root.down-abs-y = self.absolute-position.y + self.mouse-y;
                root.dragging = false;
            }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) {
                let ax: length = self.absolute-position.x + self.mouse-x;
                let ay: length = self.absolute-position.y + self.mouse-y;
                if (root.dragging) {
                    root.drag-dropped(root.section-code, ax, ay);
                    root.dragging = false;
                } else if (self.mouse-x >= 0px && self.mouse-x <= self.width
                        && self.mouse-y >= 0px && self.mouse-y <= self.height) {
                    root.toggled();
                }
            }
        }
        moved => {
            if (self.pressed) {
                let ax: length = self.absolute-position.x + self.mouse-x;
                let ay: length = self.absolute-position.y + self.mouse-y;
                if (!root.dragging
                        && (abs(ax - root.down-abs-x) > 6px
                            || abs(ay - root.down-abs-y) > 6px)) {
                    root.dragging = true;
                    Tip.text = "";
                    root.drag-started(root.section-code, ax, ay);
                }
                if (root.dragging) {
                    root.drag-moved(root.section-code, ax, ay);
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        Image {
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
            source: root.collapsed
                ? @image-url("../../assets/icons/chevron-right.svg")
                : @image-url("../../assets/icons/chevron-down.svg");
            colorize: Theme.foreground.with-alpha(header-touch.has-hover ? 0.7 : 0.4);
        }
        Text {
            text: root.label;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
            color: Theme.foreground.with-alpha(0.5);
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // The two Favorites actions precede the handle: this way it stays
        // at the same X, all the way to the right, across all four headers.
        if root.favorite-actions : SidebarHeaderActionSlot {
            icon: @image-url("../../assets/icons/plus.svg");
            tooltip: root.new-container-tooltip;
            clicked => { root.new-container(); }
        }
        if root.favorite-actions : SidebarHeaderActionSlot {
            icon: root.can-collapse
                ? @image-url("../../assets/icons/chevron-up.svg")
                : @image-url("../../assets/icons/chevron-down.svg");
            tooltip: root.collapse-tooltip;
            clicked => { root.collapse-all(); }
        }
        // 24px full-height slot: the 3x2-dot SVG is centered on both
        // axes and stays crisp regardless of the header's number of actions.
        Rectangle {
            width: 24px;
            height: 30px;
            Image {
                source: @image-url("../../assets/icons/grip-horizontal.svg");
                width: 16px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: Theme.foreground;
                opacity: root.dragging ? 0.90 : (header-touch.has-hover ? 0.65 : 0.32);
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Tokens.hairline;
    }
}

// A semantic section of places. Its header exists even when its
// model is empty (notably Network), a necessary condition for moving it.
component Sidebar inherits Rectangle {
    in property <[SidebarPlace]> places;
    in property <Strings> strings;
    in property <int> section-code;
    in property <string> title;
    in property <bool> collapsed: false;
    in property <bool> header-visible: true;
    in property <bool> reorder-drag-active: false;
    in property <int> reorder-drag-source: -1;
    /// Width of the side panel, forwarded to the rows — see `SidebarItem`.
    in property <length> panel-width;
    callback place-clicked(string, int);   // (path, kind)
    callback place-middle-clicked(string, int);   // (path, kind) → new tab
    callback place-right-clicked(string, int, bool, string, length, length);   // (path, kind, removable, device, x, y)
    callback section-toggled();
    callback section-drag-started(int, length, length);
    callback section-drag-moved(int, length, length);
    callback section-drag-dropped(int, length, length);

    background: Theme.toolbar;
    opacity: root.reorder-drag-active && root.reorder-drag-source == root.section-code ? 0.55 : 1.0;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        if root.header-visible : SidebarSectionHeader {
            section-code: root.section-code;
            label: root.title;
            collapsed: root.collapsed;
            reorder-drag-active: root.reorder-drag-active;
            toggled => { root.section-toggled(); }
            drag-started(section, x, y) => { root.section-drag-started(section, x, y); }
            drag-moved(section, x, y) => { root.section-drag-moved(section, x, y); }
            drag-dropped(section, x, y) => { root.section-drag-dropped(section, x, y); }
        }
        // The items scroll on their own. Without this, a long list claims its
        // full height from the panel's layout and pushes whatever follows past
        // the bottom edge, out of reach — there was no way to scroll to it.
        // `min-height: 0` is what lets the layout shrink the list instead;
        // collapsing then zeroes the height rather than dropping the element,
        // the same way the Favorites tree does it.
        places-scroll := ScrollView {
            vertical-stretch: 1;
            visible: !root.collapsed;
            min-height: 0px;
            // Never taller than its own content, so the next section follows
            // immediately instead of hanging below an empty gap. Slint
            // geometry: item 30px + 2px of top padding.
            max-height: root.collapsed ? 0px : root.places.length * 32px;
            // Content height stated explicitly, for the reason given on the
            // Favorites tree: a view told nothing about its content cannot
            // know it has anything to scroll to.
            viewport-height: max(self.height, root.places.length * 32px);
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                for p in root.places : HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 2px;
                    SidebarItem {
                        label: p.kind == 1 ? root.strings.sidebar-home
                            : p.kind == 3 ? root.strings.sidebar-trash
                            : (p.kind == 2 && p.label == "") ? root.strings.sidebar-root
                            : p.label;
                        kind: p.kind;
                        space-level: p.space-level;
                        space-used-ratio: p.space-used-ratio;
                        space-text: p.space-text;
                        space-text-short: p.space-text-short;
                        space-hint: p.space-hint;
                        panel-width: root.panel-width;
                        clicked => { root.place-clicked(p.path, p.kind); }
                        middle-clicked => { root.place-middle-clicked(p.path, p.kind); }
                        right-clicked(x, y) => { root.place-right-clicked(p.path, p.kind, p.removable, p.device, x, y); }
                    }
                }
            }
        }
    }
}

// A row of the favorites tree: container or favorite, indented by
// depth. PURELY visual on the chevron side (left click expands a
// container / opens a favorite, handled by the parent via `activate`).
component FavRow inherits Rectangle {
    in property <FavNode> node;
    in property <bool> selected;
    in property <int> row-index;                // position in the visible list
    in property <bool> drag-active;             // a reorder drag is in progress
    in property <int> drag-target-index;        // current target row (-1 = none)
    in property <int> drag-zone;                // 0 before · 1 inside · 2 after
    // Target of a tab or file drag: this container is hovered and the
    // target dropped here will be saved as a favorite. Same "drop-into" rendering as
    // the internal reorder drag.
    in property <bool> drop-hover: false;
    callback activate();
    callback middle-clicked();
    callback right-clicked(length, length);
    // Drag: (source row-index, absolute cursor y, top y of THIS row). The bridge
    // computes the target/zone in f32 (reliable) and performs the move on drop.
    callback drag-move(int, length, length);
    callback drag-drop(int, length, length);

    height: 30px;
    border-radius: Tokens.radius-row;
    // Indentation capped at 5 levels (beyond that, it degrades without aligning).
    property <length> indent: 8px + min(root.node.depth, 5) * 14px;
    // "Drop INTO this container" highlight: internal (reorder) drag
    // OR a tab/file drag — same rendering.
    property <bool> drop-into: (root.drag-active && root.drag-target-index == root.row-index
        && root.drag-zone == 1 && root.node.is-container) || root.drop-hover;
    property <length> ds-y;
    property <length> row-top;
    property <bool> dragging: false;

    opacity: root.dragging ? 0.4 : 1.0;
    background: root.drop-into
        ? Theme.accent-background.with-alpha(0.18)
        : (root.selected
            ? Theme.accent-background.with-alpha(0.20)
            : (touch.has-hover ? Theme.alternate-background : transparent));
    border-width: (root.selected || root.drop-into) ? 1px : 0px;
    border-color: Theme.accent-background.with-alpha(0.45);

    // Insertion bar (reorder before / after).
    if root.drag-active && root.drag-target-index == root.row-index && root.drag-zone == 0 : Rectangle {
        y: 0;
        height: 2px;
        x: root.indent;
        width: parent.width - root.indent - 8px;
        background: Theme.accent-background;
        border-radius: 1px;
    }
    if root.drag-active && root.drag-target-index == root.row-index && root.drag-zone == 2 : Rectangle {
        y: parent.height - 2px;
        height: 2px;
        x: root.indent;
        width: parent.width - root.indent - 8px;
        background: Theme.accent-background;
        border-radius: 1px;
    }

    // Root TouchArea: the visual content is declared afterward and clicks on
    // empty areas fall through here. Renaming uses a modal popup.
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(ev) => {
            // LEFT click on a favorite closes menus; right-click (favorite
            // menu) does not bump → it can teleport the menu.
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) { Dismiss.serial += 1; }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down) {
                root.ds-y = self.absolute-position.y + self.mouse-y;
                root.row-top = self.absolute-position.y;
                root.dragging = false;
            }
            if (ev.button == PointerEventButton.left && ev.kind == PointerEventKind.up) {
                if (root.dragging) {
                    // CURRENT top of the row (auto-corrects if the list moved
                    // during the drag, e.g. auto-expand of a hovered container).
                    root.drag-drop(root.row-index, self.absolute-position.y + self.mouse-y, self.absolute-position.y);
                    root.dragging = false;
                } else {
                    root.activate();
                }
            }
            if (ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down) {
                root.right-clicked(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
            if (ev.button == PointerEventButton.middle && ev.kind == PointerEventKind.down) {
                root.middle-clicked();
            }
        }
        moved => {
            if (self.pressed) {
                if (!root.dragging
                        && abs(self.absolute-position.y + self.mouse-y - root.ds-y) > 6px) {
                    root.dragging = true;
                }
                if (root.dragging) {
                    root.drag-move(root.row-index, self.absolute-position.y + self.mouse-y, self.absolute-position.y);
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: root.indent;
        padding-right: 8px;
        spacing: 4px;
        alignment: start;
        // Chevron slot (16px) — shown only for a non-empty container.
        Rectangle {
            width: 16px;
            height: parent.height;
            if root.node.is-container && root.node.has-children : Image {
                width: 12px;
                height: 12px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.node.expanded
                    ? @image-url("../../assets/icons/chevron-down.svg")
                    : @image-url("../../assets/icons/chevron-right.svg");
                colorize: Theme.foreground.with-alpha(touch.has-hover ? 0.7 : 0.45);
            }
        }
        // Icon slot (16px): folder (container, accent if expanded) / bookmark (favorite).
        Rectangle {
            width: 16px;
            height: parent.height;
            Image {
                width: 16px;
                height: 16px;
                x: 0;
                y: (parent.height - self.height) / 2;
                source: root.node.is-container
                    ? @image-url("../../assets/icons/folder.svg")
                    : @image-url("../../assets/icons/bookmark.svg");
                colorize: root.node.is-container
                    ? (root.node.expanded ? Theme.accent-background : Theme.foreground.with-alpha(0.7))
                    : (root.node.available ? Theme.foreground.with-alpha(0.65) : Tokens.danger.with-alpha(0.8));
            }
        }
        // Node label, renamed via a modal popup.
        Rectangle {
            horizontal-stretch: 1;
            Text {
                text: root.node.label;
                font-size: 12px;
                font-weight: root.node.is-container ? 600 : 400;
                color: (root.node.is-container || root.node.available)
                    ? Theme.foreground
                    : Theme.foreground.with-alpha(0.4);
                vertical-alignment: center;
                overflow: elide;
                width: parent.width;
            }
        }
    }
}

// "Favorites" panel: header (title + actions) + scrollable flattened tree.
component FavPanel inherits Rectangle {
    in property <[FavNode]> nodes;
    in property <Strings> strings;
    in property <string> selected-id;
    in property <bool> drag-active;
    in property <int> drag-target-index;
    in property <int> drag-zone;
    in property <int> section-code: 2;
    in property <bool> reorder-drag-active: false;
    in property <int> reorder-drag-source: -1;
    callback section-drag-started(int, length, length);
    callback section-drag-moved(int, length, length);
    callback section-drag-dropped(int, length, length);
    // Target of a tab or file drag over a favorites folder.
    // ABSOLUTE (window-relative) cursor position, propagated by MainWindow based on
    // the ONGOING drag (tab OR file — mutually exclusive). Used to know
    // which favorites folder is hovered, to drop the target there.
    in property <bool> tab-drag-active: false;
    in property <length> tab-drag-abs-x: 0px;
    in property <length> tab-drag-abs-y: 0px;
    in property <bool> file-drag-active: false;
    in property <length> file-drag-abs-x: 0px;
    in property <length> file-drag-abs-y: 0px;
    // Is a drag (tab OR file) in progress? + its current position.
    property <bool> drag-on: root.tab-drag-active || root.file-drag-active;
    property <length> drag-ax: root.tab-drag-active ? root.tab-drag-abs-x : root.file-drag-abs-x;
    property <length> drag-ay: root.tab-drag-active ? root.tab-drag-abs-y : root.file-drag-abs-y;
    // Absolute cursor Y captured continuously during an INTERNAL reorder drag
    // (a file/tab drag carries its own `drag-ay`). Feeds the edge auto-scroll so
    // an off-screen target row can be reached without releasing the drag.
    property <length> reorder-cursor-y;
    // Index of the row hovered by the drag (uniform pitch 30 + 1px = 31px), or
    // -1. CRITICAL (→): every `absolute-position` read is CONFINED
    // to the "drag active" branch of the ternary → never evaluated outside a drag (the
    // ternary only evaluates the taken branch). We read the UNSCROLLED frame of the
    // ScrollView (`fav-scroll.absolute-position`, like the PanelComponent's
    // `list-area`) + its `viewport-y` — NEVER the absolute-position of the
    // scrolled content, which used to trigger "Recursion detected". Truncation to
    // `int` = floor for a gap ≥ 0 (guarded by the threshold).
    property <int> hover-row:
        !root.drag-on ? -1
        : (root.drag-ax >= fav-scroll.absolute-position.x
                && root.drag-ax <= fav-scroll.absolute-position.x + fav-scroll.width
                && root.drag-ay >= fav-scroll.absolute-position.y
                && root.drag-ay <= fav-scroll.absolute-position.y + fav-scroll.height
                && root.drag-ay
                    >= fav-scroll.absolute-position.y + fav-scroll.viewport-y + 6px)
            ? (root.drag-ay - fav-scroll.absolute-position.y - fav-scroll.viewport-y - 6px) / 31px
            : -1;
    // Id of the hovered CONTAINER (only containers accept a drop), or "".
    // Read by MainWindow (pull-based) on drop → drop target (robust even on a
    // cross-instance drop whose async hover lags behind).
    out property <string> hover-container:
        (root.hover-row >= 0 && root.hover-row < root.nodes.length
            && root.nodes[root.hover-row].is-container)
        ? root.nodes[root.hover-row].id
        : "";
    // Is the cursor OVER the favorites area (scroll) during a
    // drag? Used as a fallback: a drop outside a container ("no favorites" area,
    // or dead zone when there are only root-level favorites) adds AT THE ROOT.
    out property <bool> hover-panel:
        root.drag-on
        && root.drag-ax >= fav-scroll.absolute-position.x
        && root.drag-ax <= fav-scroll.absolute-position.x + fav-scroll.width
        && root.drag-ay >= fav-scroll.absolute-position.y
        && root.drag-ay <= fav-scroll.absolute-position.y + fav-scroll.height;
    // Id of the hovered container if it is COLLAPSED and NOT EMPTY → candidate for
    // auto-expansion during a tab/file drag, like the internal reorder
    // drag. "" otherwise.
    out property <string> hover-collapsed-container:
        (root.hover-row >= 0 && root.hover-row < root.nodes.length
            && root.nodes[root.hover-row].is-container
            && root.nodes[root.hover-row].has-children
            && !root.nodes[root.hover-row].expanded)
        ? root.nodes[root.hover-row].id
        : "";
    callback row-activate(string);
    callback row-middle(string);
    callback row-context(string, bool, string, length, length);   // id, is-container, label, x, y
    callback row-drag-move(int, length, length);           // (row-index, cur-y, row-top)
    callback row-drag-drop(int, length, length);
    callback new-container();
    callback collapse-all();
    callback expand-all();
    in property <bool> can-collapse;                       // >=1 expanded container
    // Collapse of the Favorites SECTION: hides the tree (the header stays). State
    // carried by MainWindow (which also adjusts this panel's vertical-stretch).
    in property <bool> section-collapsed: false;
    callback toggle-section();
    background: Theme.toolbar;
    opacity: root.reorder-drag-active && root.reorder-drag-source == root.section-code ? 0.55 : 1.0;
    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        SidebarSectionHeader {
            section-code: root.section-code;
            label: root.strings.fav-title;
            collapsed: root.section-collapsed;
            favorite-actions: true;
            can-collapse: root.can-collapse;
            new-container-tooltip: root.strings.fav-new-container;
            collapse-tooltip: root.can-collapse
                ? root.strings.fav-collapse-all
                : root.strings.fav-expand-all;
            reorder-drag-active: root.reorder-drag-active;
            toggled => { root.toggle-section(); }
            new-container => { root.new-container(); }
            collapse-all => {
                if (root.can-collapse) { root.collapse-all(); } else { root.expand-all(); }
            }
            drag-started(section, x, y) => { root.section-drag-started(section, x, y); }
            drag-moved(section, x, y) => { root.section-drag-moved(section, x, y); }
            drag-dropped(section, x, y) => { root.section-drag-dropped(section, x, y); }
        }
        // List or empty state, always instantiated for the drag's hit-test. When
        // the section is collapsed, it becomes invisible with zero height
        // rather than using a conditional element.
        fav-scroll := ScrollView {
            vertical-stretch: 1;
            visible: !root.section-collapsed;
            // `min-height: 0` neutralizes the ScrollView's minimum height so that
            // FavPanel can shrink down to just its header when collapsed.
            min-height: 0px;
            max-height: root.section-collapsed ? 0px : 100000px;
            // The content height, stated rather than inferred. `content-rect`
            // is a plain Rectangle pinned to the visible height, so nothing
            // would tell the view its rows go further down: the tree simply got
            // clipped at the bottom edge, with no scrollbar and no way to
            // reach the last favourites. Same approach as the file list, and
            // the same geometry the hit-test below already assumes: row 30px +
            // 1px gap = 31, list padding 11, empty state 132.
            viewport-height: max(
                self.height,
                root.nodes.length == 0 ? 132px : 11px + root.nodes.length * 31px);
            // Container filled to AT LEAST the visible height → the "dead"
            // area below the list stays clickable (left click = closes menus).
            content-rect := Rectangle {
                min-height: parent.visible-height;
                // Background TouchArea (declared BEFORE the rows → behind): a
                // left click on empty space closes menus. The New folder,
                // Expand all, and Collapse all actions live in the header.
                TouchArea {
                    width: parent.width;
                    height: parent.height;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                            Dismiss.serial += 1;
                        }
                    }
                }
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                if root.nodes.length == 0 : Rectangle {
                    height: 120px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Image {
                            source: @image-url("../../assets/icons/bookmark.svg");
                            width: 28px;
                            height: 28px;
                            colorize: Theme.foreground.with-alpha(0.25);
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.strings.fav-empty;
                            font-size: 11px;
                            color: Theme.foreground.with-alpha(0.45);
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
                for n[i] in root.nodes : FavRow {
                    node: n;
                    selected: n.id == root.selected-id;
                    row-index: i;
                    drag-active: root.drag-active;
                    drag-target-index: root.drag-target-index;
                    drag-zone: root.drag-zone;
                    // Highlighted if THIS container is the row targeted by a drag
                    // (tab OR file).
                    drop-hover: root.drag-on && i == root.hover-row && n.is-container;
                    activate => { root.row-activate(n.id); }
                    middle-clicked => { root.row-middle(n.id); }
                    right-clicked(x, y) => { root.row-context(n.id, n.is-container, n.label, x, y); }
                    drag-move(ri, cy, rt) => { root.reorder-cursor-y = cy; root.row-drag-move(ri, cy, rt); }
                    drag-drop(ri, cy, rt) => { root.row-drag-drop(ri, cy, rt); }
                }
            }
            }   // closes content-rect
        }
    }

    // Edge auto-scroll while a drag hovers the tree: an internal reorder (its
    // cursor Y flows through `reorder-cursor-y`) or a tab/file drag (`drag-ay`,
    // gated to the tree's X span so a drag over the file view never scrolls it).
    // The pastille (`hover-row`) is reactive to `viewport-y`, so it follows the
    // scroll onto the newly revealed containers. Frame reads target the ScrollView
    // itself (unscrolled), the same safe read as `hover-row`.
    DragEdgeScroller {
        active: root.drag-active
            || (root.drag-on
                && root.drag-ax >= fav-scroll.absolute-position.x
                && root.drag-ax <= fav-scroll.absolute-position.x + fav-scroll.width);
        cursor-y: root.drag-active ? root.reorder-cursor-y : root.drag-ay;
        frame-y: fav-scroll.absolute-position.y;
        frame-h: fav-scroll.height;
        min-vy: fav-scroll.viewport-height > fav-scroll.height
            ? -(fav-scroll.viewport-height - fav-scroll.height)
            : 0px;
        viewport-y <=> fav-scroll.viewport-y;
    }
}

// Activity rail button: centered 16px icon + tooltip on the RIGHT (the rail
// is at the far left) + optional active state (sidebar toggle).
// Modeled on WsIconBtn, tooltip repositioned.
component RailBtn inherits Rectangle {
    callback clicked();
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> active: false;
    width: 36px;
    height: 34px;
    border-radius: Tokens.radius-row;
    background: root.active
        ? Theme.accent-background.with-alpha(0.18)
        : (touch.has-hover ? Theme.alternate-background : transparent);
    border-width: root.active ? 1px : 0px;
    border-color: root.active ? Theme.accent-background.with-alpha(0.5) : transparent;
    animate background { duration: 110ms; easing: ease-out; }
    // A shortcut customization can change the text while the
    // mouse is still on the button: also keeps the global Tip synchronized.
    changed tooltip => {
        if (touch.has-hover) { Tip.text = root.tooltip; }
    }
    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: root.active
            ? Theme.accent-background
            : (touch.has-hover ? Theme.foreground : Theme.foreground.with-alpha(0.7));
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { Dismiss.serial += 1; root.clicked(); }
        // Tooltip toward the RIGHT (rail at the far left). Sets/clears the
        // global Tip, rendered at the window level → never hidden by a panel.
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                Tip.text = root.tooltip;
                Tip.x = self.absolute-position.x + root.width + 6px;
                Tip.y = self.absolute-position.y + (root.height - 22px) / 2;
            } else if (Tip.text == root.tooltip) {
                Tip.text = "";
            }
        }
    }
}

// Always-visible vertical activity rail: "Places" panel toggle
// at the top and system actions (Workspaces, Settings) at the bottom.
component ActivityRail inherits Rectangle {
    // Left panel: 0 collapsed · 1 open (Places + Favorites unified).
    in property <int> left-panel;
    in property <Strings> strings;
    in property <MenuShortcuts> shortcuts;
    callback toggle-places();
    callback open-workspaces();
    callback open-settings();
    width: 48px;
    background: Theme.toolbar;
    // Right thread only when NO panel is open (otherwise visual
    // continuity with the panel that shares the same background).
    if root.left-panel == 0 : Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Tokens.hairline;
    }
    VerticalLayout {
        padding-top: 4px;
        padding-bottom: 6px;
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        // Toggle for the unified side panel (Places + Favorites). Re-click = collapses.
        RailBtn {
            icon: @image-url("../../assets/icons/sidebar.svg");
            tooltip: root.strings.sidebar-tooltip;
            active: root.left-panel == 1;
            clicked => { root.toggle-places(); }
        }
        // Thin separator between the panel toggle and the system actions.
        Rectangle {
            height: 9px;
            Rectangle { y: 4px; height: 1px; background: Tokens.hairline; }
        }
        RailBtn {
            icon: @image-url("../../assets/icons/workspaces.svg");
            tooltip: root.strings.ws-tooltip
                + (root.shortcuts.open-workspaces != ""
                    ? "  (" + root.shortcuts.open-workspaces + ")" : "");
            clicked => { root.open-workspaces(); }
        }
        RailBtn {
            icon: @image-url("../../assets/icons/gear.svg");
            tooltip: root.strings.settings-tooltip
                + (root.shortcuts.open-settings != ""
                    ? "  (" + root.shortcuts.open-settings + ")" : "");
            clicked => { root.open-settings(); }
        }
        // Spacer: takes up the bottom of the rail (buttons grouped at the top).
        Rectangle { vertical-stretch: 1; }
    }
}

// ---------- Main window ----------

// An "install command" row of the ffmpeg panel: distro badge,
// monospace command, copy button (icon → checkmark ~1.3s after copying). The
// DETECTED row is promoted (left accent bar + "Detected" chip).
component FfmpegCmdRow inherits Rectangle {
    in property <string> distro;
    in property <string> command;
    in property <bool> promoted;
    in property <string> detected-label;
    callback copy(string);
    property <bool> copied: false;

    height: 34px;
    border-radius: 5px;
    background: root.promoted
        ? Theme.accent-background.with-alpha(0.07)
        : (row-touch.has-hover ? Theme.alternate-background : transparent);

    // Left accent bar: marker for the detected distro (like the active tab).
    if root.promoted : Rectangle {
        x: 0;
        y: 4px;
        width: 2px;
        height: parent.height - 8px;
        border-radius: 1px;
        background: Theme.accent-background.with-alpha(0.85);
    }
    // Row hover (below the content → doesn't intercept the copy button).
    row-touch := TouchArea { }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 8px;
        // Distro badge (label, not decoration).
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 18px;
            border-radius: 4px;
            background: Theme.foreground.with-alpha(0.07);
            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                Text {
                    text: root.distro;
                    font-size: 11px;
                    font-weight: 500;
                    color: Theme.foreground.with-alpha(0.75);
                    vertical-alignment: center;
                }
            }
        }
        if root.promoted : Text {
            text: root.detected-label;
            font-size: 10px;
            font-weight: 600;
            color: Theme.accent-background;
            vertical-alignment: center;
        }
        // Command to paste in the terminal.
        Text {
            text: root.command;
            horizontal-stretch: 1;
            font-family: "monospace";
            font-size: 12px;
            color: Theme.foreground.with-alpha(0.92);
            vertical-alignment: center;
            overflow: elide;
        }
        // Copy button (feedback: green "checkmark" icon for ~1.3s).
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 28px;
            height: 28px;
            border-radius: 5px;
            background: copy-touch.has-hover ? Theme.alternate-background : transparent;
            border-width: copy-touch.has-hover ? 1px : 0px;
            border-color: Theme.accent-background;
            Image {
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: root.copied
                    ? @image-url("../../assets/icons/check.svg")
                    : @image-url("../../assets/icons/duplicate.svg");
                colorize: root.copied ? Tokens.success : Theme.foreground.with-alpha(0.6);
            }
            copy-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.copy(root.command);
                    root.copied = true;
                    copied-timer.restart();
                }
            }
        }
    }
    copied-timer := Timer {
        interval: 1300ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }
}

export component MainWindow inherits Window {
    // OS title (taskbar / Alt-Tab). Default "Ranger"; the bridge
    // replaces it with "{workspace} — Ranger" based on the current workspace.
    in property <string> window-title: root.strings.app-title;
    title: root.window-title;
    // Application icon (title bar / taskbar / Alt-Tab).
    icon: @image-url("../../assets/ranger.svg");
    // Window background = theme's channel color (otherwise the Fluent default would reappear).
    background: Theme.background;

    preferred-width: 1300px;
    preferred-height: 750px;
    min-width: 720px;
    min-height: 420px;

    // ----- Strings + selectors -----
    in property <Strings> strings;
    in property <[string]> language-labels;
    in property <[string]> theme-labels;
    in property <[string]> ui-scale-labels;      // "80%", "100%", …
    in-out property <int> language-index: 0;
    in-out property <int> theme-pref: 0;
    in-out property <int> ui-scale-index: 0;      // index into ui-scale-labels
    callback language-changed(int);
    callback theme-changed(int);
    callback ui-scale-changed(int);               // → applies + persists the zoom
    // "Video thumbnails (ffmpeg)" section (Linux). State set by the bridge.
    in property <bool> ffmpeg-found: false;
    in property <string> ffmpeg-version;          // "8.1.2"; empty if unknown
    in property <bool> ffmpeg-flatpak: false;     // sandbox → host commands useless
    in property <int> ffmpeg-detected-index: -1;  // 0 Debian·1 Fedora·2 Arch·3 Alpine; -1 unknown
    callback ffmpeg-recheck();                    // re-runs detection
    callback settings-copy(string);               // copies text to the clipboard
    // DEFAULT tab bar position for new views "from
    // scratch" (new workspace / reset) — global setting.
    in property <[string]> tabbar-default-labels;
    in-out property <int> tabbar-default-pref: 0;
    callback tabbar-default-changed(int);
    // Timezone for the "Modified" column: 0 = local time (default), 1 = UTC.
    in-out property <int> clock-utc-pref: 0;
    callback clock-mode-changed(int);
    // "Full path" tooltip on tab hover — opt-in.
    in-out property <bool> tab-tooltip-enabled: false;
    callback tab-tooltip-changed(bool);
    // "Unsaved changes" guard before loading —
    // checked by default; the bridge reads `ws-warn-unsaved` in `ws-load-guarded`.
    in-out property <bool> ws-warn-unsaved: true;
    callback ws-warn-unsaved-changed(bool);
    // Preview mode: compact single-icon rows, enabled by default.
    in-out property <bool> compact-preview-rows-enabled: true;
    callback compact-preview-rows-changed(bool);

    // Panels: flattened rendering of the layout tree.
    in property <[PanelView]> panels;
    // Per-panel footers, indexed like `panels`. PARALLEL model,
    // deliberately kept separate from `panels`: the bridge can write the selection
    // count to it on every rubber-band step without rewriting the `PanelView`s
    // (see `PanelComponent.footer-text`).
    in property <[string]> panel-footers;
    in property <[SplitterView]> splitters;
    in property <int> active-panel-idx: 0;
    // Counter bumped by Ctrl+L (`focus-address`) → each PanelComponent observes it;
    // the ACTIVE panel enters address bar edit mode.
    property <int> address-focus-gen: 0;
    in property <bool> can-add-panel: true;
    callback panel-clicked(int);
    callback panel-closed(int);
    /// Splits the active panel. `dir`: 0 = side by side (Row), 1 = stacked (Column).
    callback panel-split(int);
    /// Resize of a splitter: `idx` of the Split node, `frac` = pointer
    /// position as a fraction [0,1] of the container along the split axis.
    callback splitter-resized(int, float);
    /// Toggles list ↔ preview mode for panel `idx`'s active tab.
    callback toggle-preview-mode(int);
    /// Zoom of panel `idx`'s active tab entries: `delta` = +1 / -1.
    /// The viewport and pointer position let the bridge preserve
    /// a semantic anchor despite variable row heights.
    callback zoom-view(int /*idx*/, int /*delta*/, length /*top*/, length /*height*/,
        length /*pointer-y*/) -> length;
    /// Current state of the Ctrl key (tracked by the root FocusScope) — used
    /// to distinguish wheel (scroll) from Ctrl+wheel (zoom).
    in-out property <bool> ctrl-down: false;
    /// Current state of the Shift key (tracked like `ctrl-down`) — rubber-band mode:
    /// Shift = add to selection, Ctrl = subtract.
    in-out property <bool> shift-down: false;
    property <int> keyboard-interaction-gen: 0;
    /// Shows / hides hidden files for panel `idx`'s active tab.
    callback toggle-show-hidden(int);
    /// Keyboard navigation of the active view's cursor. `kind`: 0=up,
    /// 1=down, 2=start, 3=end. `extend` = extend the selection (Shift).
    callback move-cursor(int, bool);
    /// Resolves a key combination → action id (or "" if none) using the
    /// effective shortcut map (defaults + overrides). `keyname` is already
    /// normalized by `chord-key-name`.
    callback match-action(string, bool, bool, bool) -> string;
    /// Emitted by the bridge when a thumbnail is ready (full path, generation, image).
    callback thumb-ready(string, int, image);
    /// Exact viewport of a panel: drives virtualization and prioritization.
    callback panel-viewport-changed(int /*panel*/, length /*top*/, length /*height*/);
    /// Hit-test of a content ordinate within variable-height rows.
    callback panel-row-at-content-y(int /*panel*/, length /*y*/) -> int;
    /// Wakes the UI thread from the INITIAL FILL thread: drains
    /// the channel of delivered listings (the Rust handler captured the AppState).
    callback initial-listing-drain();
    /// Ordinary background listings delivered off-UI, with an anti-race generation.
    callback async-listing-drain();
    // the worker computed a folder's recursive stats (path, Unix mtime, total
    // size in bytes — both as text to dodge Slint's `int` i32 limit; an empty
    // string means "not computed" for that metric).
    callback folder-stats-ready(int /* panel */, int /* row */, string /* path */, string /* mtime */, string /* size */);
    // the worker read an image's metadata (path, resolution, bits).
    callback imgmeta-ready(
        int /* panel */, int /* row */, string /* path */,
        string /* resolution */, string /* depth */, string /* mtime (unix, text) */
    );
    // "Split" menu: opened via a panel's token (which activates
    // beforehand), so it acts on the active panel via `panel-split`.
    in-out property <bool> split-menu-open: false;
    in-out property <length> split-menu-x;
    in-out property <length> split-menu-y;

    // "Tab bar position" menu: 3 radio options (top /
    // left / right), per view. `set-tab-bar-mode(panel, mode)` → bridge.
    in-out property <bool> tabbar-menu-open: false;
    in-out property <length> tabbar-menu-x;
    in-out property <length> tabbar-menu-y;
    in-out property <int> tabbar-menu-panel: -1;
    in-out property <int> tabbar-menu-mode: 0;     // CURRENT mode (checked option)
    callback set-tab-bar-mode(int /*panel*/, int /*mode*/);
    /// Vertical bar width resized via the grip —
    /// persisted per view on the bridge side.
    callback panel-vbar-resized(int /*panel*/, length /*width*/);

    // URL bar menu (right-click): Paste / Copy path.
    in-out property <bool> url-menu-open: false;
    /// Bumped by the menu's "Copy"; the URL field watches it and copies its
    /// own selection. A callback could not do this: the field is inside a
    /// panel, and only it knows what is highlighted.
    in-out property <int> url-copy-serial: 0;
    in-out property <int> url-paste-serial: 0;
    in-out property <length> url-menu-x;
    in-out property <length> url-menu-y;
    // EDITABLE text of the URL bar (shared: only one panel in edit mode at
    // a time). Lets the bridge paste the clipboard into it without submitting.
    in-out property <string> url-edit-text;

    // ----- Column widths: PER PANEL (carried by each PanelView).
    //       A header resize reports here with the panel's index. -----
    callback panel-column-resized(int /*panel*/, string /*id*/, length /*width*/);
    // Tab bar scroll target — geometric computation on the bridge side
    // (panel, tab_idx[-1=chevron], forward, viewport-x, view-w) → viewport-x.
    callback panel-scroll-target(int, int, bool, length, length) -> length;
    // check/uncheck a column (panel_idx, col_id, visible) + menu.
    callback column-toggle(int, string, bool);
    // Reordering: panel, column identifier, and target visible index.
    callback column-moved(int, string, int);
    // extension filter. `ext-filter-toggle(panel)` shows/hides the bar
    // (from the columns menu OR the close button). Input is shared with the
    // type-ahead (filter-type/backspace/clear routed bridge-side).
    callback ext-filter-toggle(int);
    in-out property <bool> columns-menu-open: false;
    in-out property <length> columns-menu-x;
    in-out property <length> columns-menu-y;
    in-out property <int> columns-menu-panel: 0;
    // changes the grouping mode (panel_idx, code "folders"/"files"/"mixed").
    callback set-group-mode(int, string);
    // Active view's "type-ahead" filter -----
    // Typed text (maintained by the bridge). The bar shows in the active view
    // as soon as it's non-empty. Reset on navigation / panel change / Escape.
    in property <string> active-filter: "";
    // Active panel's "extension filter" mode: when true, keyboard
    // input (filter-type/backspace/clear) feeds the extension filter instead of
    // the by-name type-ahead → shared routing on the bridge side.
    in property <bool> active-ext-filter-on: false;
    callback filter-type(string);       // a printable character typed
    callback filter-backspace();        // removes the last character
    callback filter-clear();            // clears it ("x" / Escape)
    // Is an overlay/popup open? (gates the filter's keyboard capture)
    property <bool> any-overlay-open:
        root.settings-open || root.workspaces-open || root.rename-popup-open
        || root.create-popup-open || root.ctx-menu-open
        || root.paste-conflict-open || root.columns-menu-open || root.trash-menu-open
        || root.drive-menu-open
        || root.url-menu-open || root.split-menu-open || root.tabbar-menu-open
        || root.file-drop-menu-open || root.file-drag-active
        || root.fav-menu-open || root.fav-name-open || root.fav-save-open
        || root.fav-newc-open || root.tab-menu-open || root.tab-empty-menu-open
        || root.ow-menu-open || root.new-menu-open || root.ow-popup-open || root.ow-picker-open
        || root.delete-warning-open;
    // Settings: default columns (1st launch / Reset) — all of them, with their
    // default visibility. `default-column-toggle(id, visible)` updates the config.
    in property <[ColumnInfo]> settings-columns;
    callback default-column-toggle(string, bool);
    // recursive folder modification-date depth
    // (0 = disabled). Drives `Config.recursive_mtime_depth`.
    in-out property <int> rmtime-depth: 0;
    callback rmtime-depth-changed(int);
    // recursive folder SIZE depth (0 = disabled).
    // Drives `Config.recursive_size_depth`.
    in-out property <int> size-depth: 0;
    callback size-depth-changed(int);

    // Configurable shortcuts -----
    // Action groups (pushed by the bridge when settings open and
    // after each modification / search).
    in property <[ShortcutGroup]> shortcut-groups;
    // EFFECTIVE shortcuts displayed in context menus, pushed by
    // the bridge (dynamic: follow user rebinds).
    in property <MenuShortcuts> menu-shortcuts;
    // True if at least one override exists (enables "Reset all").
    in property <bool> shortcut-has-overrides: false;
    // Action currently being reassigned (keyboard capture); "" = none.
    in-out property <string> shortcut-capturing: "";
    // Pending conflict: targeted action + localized message ready to display.
    // (in-out: set by the bridge, reset by the UI on close.)
    in-out property <string> shortcut-conflict-action: "";
    in-out property <string> shortcut-conflict-message: "";
    // Current search/filter text.
    in-out property <string> shortcut-search-text: "";
    callback shortcut-rebind(string /*action_id*/, string /*raw chord*/);
    callback shortcut-reset(string /*action_id*/);
    callback shortcut-unassign(string /*action_id*/);
    callback shortcut-reset-all();
    callback shortcut-resolve-conflict(bool /*reassign*/);
    callback shortcut-search(string);

    /// Index where the drop preview line appears during a tab drag.

    // ----- Per-panel callbacks (routed from the active panel) -----
    callback go-back();
    callback go-forward();
    callback go-parent();
    callback go-home();
    callback refresh();
    callback sort-clicked(string);
    callback row-activated(int);
    callback row-clicked(int);
    callback row-ctrl-clicked(int);
    callback row-shift-clicked(int);
    callback select-all();
    callback deselect-all();
    callback rubber-band-begin(int);
    callback rubber-band-update(length, length, length, length);
    callback row-right-clicked(int, length, length);
    callback tab-new();
    callback tab-clicked(int);
    callback tab-closed(int);
    // (src_panel, src_tab, target_intra, abs_x, abs_y) — src_panel passed
    // explicitly to handle a drag from a NON-active panel.
    callback tab-drag-completed(int, int, int, length, length);
    callback tab-drag-progress(int, length, length);
    /// Drop of a tab on a FAVORITES folder: (src_panel, src_tab,
    /// container id). Saves the tab's path into this folder.
    callback tab-to-favorite(int, int, string);
    /// Drop of a view's SELECTION (files/folders) on a FAVORITES
    /// folder: (src_panel, container id).
    callback file-to-favorite(int, string);
    /// Favorites container currently hovered by a drag (tab OR file),
    /// "" if none. Read PULL-BASED on release (the binding is re-evaluated on read
    /// → reflects the current position of the `*-drag-abs-*`), making it robust
    /// even when cross-instance hover lags behind. Exposed from the
    /// unconditional FavPanel.
    out property <string> fav-hover-container: fav-panel.hover-container;
    out property <bool> fav-hover-panel: fav-panel.hover-panel;   // root fallback

    /// Global tab drag state — propagated to ALL PanelComponents
    /// so each computes its own preview line.
    in-out property <bool> drag-active: false;
    in-out property <length> drag-abs-x: 0px;
    in-out property <length> drag-abs-y: 0px;
    /// Last insertion gap claimed during the drag + claiming panel
    /// . Read by the BRIDGE on cross-view drop: if `drag-target-gap-panel`
    /// == target panel, the drop in its header uses this EXACT gap; otherwise
    /// (drop in the body) the tab goes to the end of the bar. Reset at drag start.
    in-out property <int> drag-target-gap: -1;
    in-out property <int> drag-target-gap-panel: -1;
    // Index of the tab drag's SOURCE panel (for the danger preview "will
    // close" on the source whose last tab is being dragged). -1 = none.
    in-out property <int> drag-source-panel: -1;
    // Drop target — set by the panel under the cursor.
    // `panel` = index (-1 if none); `zone` = 0 none·1 center·2 W·3 E·4 N·5 S.
    in-out property <int> drag-target-panel: -1;
    in-out property <int> drag-target-zone: 0;

    // File drag'n'drop between views -----
    in-out property <bool> file-drag-active: false;
    in-out property <length> file-drag-abs-x: 0px;
    in-out property <length> file-drag-abs-y: 0px;
    in-out property <int> file-drag-source-panel: -1;
    in-out property <int> file-drag-target-panel: -1;   // panel under the cursor
    in-out property <int> file-drag-target-row: -1;     // hovered row (folder/executable/other)
    in-out property <bool> file-drag-target-folder: false;
    in-out property <bool> file-drag-target-exec: false;
    in-out property <bool> file-drag-target-invalid: false; // target = source/descendant
    callback file-drop-target-invalid(int /*src panel*/, int /*target panel*/, int /*row*/) -> bool;
    function claim-file-drag-target(panel: int, row: int, folder: bool, executable: bool) {
        root.file-drag-target-panel = panel;
        root.file-drag-target-row = row;
        root.file-drag-target-folder = folder;
        root.file-drag-target-exec = executable;
        root.file-drag-target-invalid = root.file-drag-active && panel >= 0
            && root.file-drop-target-invalid(root.file-drag-source-panel, panel, row);
    }
    function refresh-file-drag-target-invalid() {
        root.file-drag-target-invalid = root.file-drag-active
            && root.file-drag-target-panel >= 0
            && root.file-drop-target-invalid(root.file-drag-source-panel,
                root.file-drag-target-panel, root.file-drag-target-row);
    }
    function clear-file-drag-target(panel: int) {
        if (root.file-drag-target-panel == panel) {
            root.file-drag-target-panel = -1;
            root.file-drag-target-row = -1;
            root.file-drag-target-folder = false;
            root.file-drag-target-exec = false;
            root.file-drag-target-invalid = false;
        }
    }
    // During a file drag: would releasing at the CURRENT position do
    // NOTHING? EXACT mirror of `file-drag-dropped`'s drop condition
    // (favorites OR folder/executable OR another panel): true
    // = unsuitable zone (scrollbars, headers, tab bar, footer, dead zone,
    // or the SOURCE folder itself). Drives the "cancel" pill that follows
    // the cursor → the indicator can never lie about what the drop will do.
    property <bool> file-drop-will-cancel:
        root.file-drag-active
        && root.fav-hover-container == ""
        && !root.fav-hover-panel
        && (root.file-drag-target-invalid
            || !(root.file-drag-target-panel >= 0
                && (root.file-drag-target-folder
                    || root.file-drag-target-exec
                    || root.file-drag-target-panel != root.file-drag-source-panel)));
    in-out property <bool> file-drag-copy: false;       // internal Ctrl or external OLE key-state
    // A watcher event that arrived during the gesture is replayed cleanly after
    // the drag/menu/operation instead of rebuilding the model under the mouse.
    in-out property <bool> file-drag-refresh-pending: false;
    // Native (OLE) drag triggered once when the cursor leaves the
    // window during a drag → external apps. Re-armed on every new drag.
    in-out property <bool> native-drag-armed: false;
    callback start-native-drag(int /*src_panel*/);
    callback file-drag-begin(int /*src_panel*/, int /*row_idx*/);  // ensures the selection
    // Drop menu (Move / Copy / Link here) + panels captured on drop.
    in-out property <bool> file-drop-menu-open: false;
    in-out property <length> file-drop-menu-x;
    in-out property <length> file-drop-menu-y;
    in-out property <int> file-drop-src-panel: -1;
    in-out property <int> file-drop-target-panel: -1;
    in-out property <int> file-drop-target-row: -1;     // target folder row captured on drop (1 = current folder)
    callback file-drop-action(int /*0 move · 1 copy · 2 link*/);
    // Drop onto an executable → launches it with the files as arguments.
    // Returns true if launched (the bridge reads the already-set file-drop-src/target/row).
    callback file-drop-onto-exec() -> bool;
    callback refresh-all();   // re-lists ALL panels (after a multi-view op)

    callback rename-confirmed(string);
    callback rename-force-replace(string) -> bool;
    callback navigate-to(string);
    /// Emitted on right-click in a panel's empty area (useful for Paste).
    callback empty-right-clicked(length, length);

    // ----- Settings: open an XDG path in the OS file manager -----
    callback open-config-dir();
    callback open-data-dir();
    callback open-cache-dir();

    // True on Windows only (pushed by the bridge): gates the
    // "Open with…" entry (native picker), absent on other OSes.
    in property <bool> platform-windows: false;

    // Open with -----
    in property <[OpenerItem]> openers-suggested;   // "Open with" submenu
    in property <[OpenerItem]> openers-all;         // Settings list
    in-out property <string> opener-search-text: "";
    callback opener-search(string);
    in property <bool> selection-is-executable;     // drives "Use as application"
    callback run-opener(string /*id*/);             // runs an opener on the selection
    callback ow-use-as-app();                       // creates an opener from the selected exe
    callback ow-add();                              // blank creation popup (Settings)
    // Ready-made archiving commands, empty when no archiver is installed.
    // Recipes are pre-split into two balanced rows on the bridge side (Slint's
    // `for` cannot carry an inline `if`), so the block wraps without sideways
    // scroll. Row 1 holds the first half (the extra chip when the count is odd).
    // Two balanced columns of full-width rows. Splitting in Rust rather than
    // in Slint, whose `for` cannot carry an inline slice.
    in property <[OwRecipe]> ow-recipes-col1: [];
    in property <[OwRecipe]> ow-recipes-col2: [];
    // Tools none of whose recipes could be resolved, already worded by the
    // bridge — empty when everything supported is installed.
    in property <string> ow-recipes-missing: "";
    // Collapsed by default: expanded, the block would push the saved commands
    // — the tab's actual content — below the fold for everyone.
    in-out property <bool> ow-recipes-open: false;
    callback ow-recipe-add(int);                    // opens the editor prefilled
    callback ow-edit(string /*id*/);                // edit popup
    callback ow-duplicate(string /*id*/);           // clones an entry
    callback ow-delete(string /*id*/);
    callback ow-move(string /*id*/, int /*dir -1/+1*/);
    callback ow-popup-changed();                    // recomputes the preview (bridge)
    callback ow-popup-commit();                     // saves OR launches (depending on the case)
    callback ow-browse();                           // opens an exe picker (native)
    // Home-grown application picker: list enumerated by the OS.
    callback ow-open-picker();                      // "Choose an application…"
    callback ow-pick(string /*key handler*/);       // choice → launches + captures
    callback ow-pick-browse();                      // browse the OS → saves + launches
    in property <[OpenerItem]> ow-picker-handlers;
    in-out property <bool> ow-picker-open: false;
    // "Set as default": the chosen app becomes Ranger's default for the
    // file's extension (overrides the OS). Unchecked on every opening.
    in-out property <bool> ow-picker-set-default: false;
    // "Open with" submenu: flyout on hover of the entry (the parent menu
    // stays visible). Hover tracked via two properties (the entry + the flyout) for
    // a clean deferred close, without referencing conditional elements.
    in-out property <bool> ow-menu-open: false;
    in-out property <length> ow-menu-x;
    in-out property <length> ow-menu-y;
    in-out property <bool> ow-parent-hover: false;
    in-out property <bool> ow-flyout-hover: false;
    // "New" submenu (empty area) — SAME mechanism as "Open with"
    // above: flyout on hover, deferred close via two hover flags.
    in-out property <bool> new-menu-open: false;
    in-out property <length> new-menu-x;
    in-out property <length> new-menu-y;
    in-out property <bool> new-parent-hover: false;
    in-out property <bool> new-flyout-hover: false;
    // "Custom command" popup (create/edit/one-shot launch).
    in-out property <bool> ow-popup-open: false;
    in-out property <bool> ow-popup-focus-armed: false;
    in-out property <string> ow-popup-id: "";       // "" = creation
    in-out property <string> ow-popup-name: "";
    in-out property <string> ow-popup-program: "";
    // Persisted visual family inherited from a ready-made recipe.
    in-out property <int> ow-popup-icon-kind: 0;
    // Opener based on an OS association (Windows Store/UWP app, Linux .desktop):
    // no executable → the Program field is frozen + explicit label.
    in-out property <bool> ow-popup-is-store: false;
    in-out property <string> ow-popup-args: "";
    // Run as administrator (UAC elevation) — Windows only, unchecked by
    // default. The checkbox is only shown if `platform-windows`.
    in-out property <bool> ow-popup-elevated: false;
    // Pinning to the context menu: 3 checkboxes → file/folder/background bits.
    in-out property <bool> ow-popup-ctx-file: false;
    // Extensions the FILE entry is limited to; "*" means every file. Only
    // meaningful with the Files box — folders and the background have none.
    in-out property <string> ow-popup-ctx-ext: "";
    in-out property <bool> ow-popup-ctx-dir: false;
    in-out property <bool> ow-popup-ctx-bg: false;
    in-out property <string> ow-popup-default-ext: "";
    in-out property <string> ow-popup-used-ext: "";   // extensions listed in "Open with"
    in-out property <bool> ow-popup-add: true;       // "Add to applications"
    in property <string> ow-popup-preview: "";       // resolved preview (set by the bridge)
    // How many processes the command will start, already worded by the bridge.
    in property <string> ow-popup-runs: "";
    // Meaning of the tag currently hovered, shown next to the tag row.
    property <string> owp-hovered-tag: "";
    in property <bool> ow-popup-valid: false;        // valid program (set by the bridge)
    // Promotion toast after the native dialog (Windows).
    in-out property <bool> ow-promote-visible: false;
    callback ow-promote-accept();

    // ----- Global operations (target the active panel) -----
    callback action-open();
    callback action-open-new-tab();
    callback action-open-admin();   // "Open as administrator" (file, Windows)
    // Context menu target = a SINGLE file (not a folder) → on Windows,
    // "Open as administrator" replaces "Open in a new tab".
    in-out property <bool> ctx-selection-is-file: false;
    // A single item is selected (file OR folder) — gates "Create a shortcut".
    in-out property <bool> ctx-selection-single: false;
    // The primary selected item is a folder — hides "Open with" (files only).
    in-out property <bool> ctx-selection-is-dir: false;
    callback action-open-with();
    callback action-open-parent();
    callback action-open-terminal();
    callback action-copy();
    callback action-cut();
    callback action-paste();
    callback action-duplicate();
    callback action-copy-path();
    callback action-copy-name();
    callback action-rename();
    callback action-delete();
    callback action-delete-permanent();
    callback action-restore-last-trashed();
    // Internal deliveries from the trash workers, drained on the UI thread.
    callback process-trash-events();
    callback action-properties();
    callback ctx-close();

    // ----- Menu/properties state (global) -----
    in-out property <bool> ctx-menu-open: false;
    in-out property <length> ctx-menu-x;
    in-out property <length> ctx-menu-y;
    // Closes ALL context menus at once. A SINGLE shared mechanism:
    // no more per-menu backdrop. DIRECT function (not via a
    // `changed`) → deterministic order when a trigger closes-then-reopens (=
    // teleporting the menu under the cursor on a right-click in a valid zone).
    function close-ctx-menus() {
        root.ctx-menu-open = false;      // the "Open with" flyout follows via `changed`
        root.url-menu-open = false;
        root.drive-menu-open = false;
        root.trash-menu-open = false;
        root.columns-menu-open = false;
        root.tab-menu-open = false;
        root.tab-empty-menu-open = false;
        root.fav-menu-open = false;
        root.split-menu-open = false;
        root.tabbar-menu-open = false;
        root.file-drop-menu-open = false;
        root.shortcut-menu-open = false;
    }
    // Single route for the sidebar's right-clicks. The four reorderable
    // components and the Trash call it without duplicating menu
    // initialization or risking different behavior based on their rank.
    function open-sidebar-place-context(path: string, kind: int, removable: bool,
            device: string, x: length, y: length) {
        root.close-ctx-menus();
        if (kind == 3) {
            root.trash-menu-x = x;
            root.trash-menu-y = y;
            root.trash-menu-confirm = false;
            root.trash-menu-open = true;
        } else if (kind == 2 || kind == 4) {
            root.drive-menu-x = x;
            root.drive-menu-y = y;
            root.drive-menu-path = path;
            root.drive-menu-kind = kind;
            root.drive-menu-removable = removable;
            root.drive-menu-device = device;
            root.drive-menu-open = true;
        }
    }
    // Observes the "chrome" interaction counter (global Dismiss, bumped on a
    // LEFT click on rail/sidebar/headers/tabs/margins…) → closes menus (which
    // no longer have a backdrop). A RIGHT click on a valid zone does not bump and
    // reaches the trigger → reopens/teleports the menu.
    property <int> dismiss-watch: Dismiss.serial;
    changed dismiss-watch => { root.close-ctx-menus(); }
    // true = right-click on a blank area (no targeted entry) → menu
    // reduced to only the actions that make sense without a selection (Paste…).
    in-out property <bool> ctx-on-empty: false;
    // User commands PINNED to the context menu — pushed by the
    // bridge on EVERY opening (filtered by file/folder/background context).
    in property <[OpenerItem]> ctx-custom-entries;
    in-out property <bool> ctx-custom-bg: false;  // true = background menu (target = current folder)
    callback ctx-custom-run(string /*id*/);
    // Entries of the WINDOWS CONTEXT MENU (hosted shell extensions) —
    // pushed by the bridge on every opening (live IContextMenu session).
    in property <[ShellCtxEntry]> ctx-shell-entries;
    callback ctx-shell-run(int /*command offset*/);
    // Shell CASCADE flyout (PeaZip…) — same mechanism as the "Open
    // with" flyout: hover of the parent → the bridge pushes the children
    // (`ctx-shell-sub-hover`), deferred close Timer on both hovers.
    in property <[ShellCtxEntry]> ctx-shell-sub-entries;
    in-out property <bool> ctx-shell-sub-open: false;
    in-out property <length> ctx-shell-sub-x;
    in-out property <length> ctx-shell-sub-y;
    in-out property <int> ctx-shell-sub-for: -1;   // `sub` index of the open parent
    in-out property <bool> ctx-shell-sub-parent-hover: false;
    in-out property <bool> ctx-shell-sub-flyout-hover: false;
    callback ctx-shell-sub-hover(int /*sub*/);
    // Setting: integrate the Windows menu (kill-switch if the extension is slow/broken).
    in-out property <bool> shell-menu-enabled: true;
    callback shell-menu-changed(bool);
    // "Detected Windows entries" settings panel: list built at
    // launch (completed as used), checkboxes → hide/show the entry.
    in property <[ShellExtRow]> shell-ext-rows;
    callback shell-ext-toggle(string /*label*/, bool /*enabled*/);


    // ----- Rename modal popup -----
    in-out property <bool> rename-popup-open: false;
    in property <string> rename-current-name;
    // Folders keep the caret at the end; for a file, the bridge places
    // the caret right before the extension via `fs::ops::split_name`.
    in property <bool> rename-current-is-dir: false;
    in-out property <string> rename-new-name;
    callback filename-caret-offset(string /* name */, bool /* folder */) -> int;
    // Name conflict (same logic as paste): `rename-check` is called on
    // every keystroke; the bridge sets `rename-conflict` if the name is already
    // taken at the same level (or invalid). Blocks confirmation.
    in-out property <bool> rename-conflict: false;
    // Already-translated reason the name is refused ("" when it is fine).
    // Filled by the bridge, which alone knows whether the name is taken or
    // simply unusable on this filesystem.
    in-out property <string> rename-name-error: "";
    // Replaceable conflict, file↔file only. Distinguishes a real duplicate
    // from an invalid name or a conflict involving a folder.
    in-out property <bool> rename-replace-available: false;
    callback rename-check(string);
    // Deferred focus of the field (armed on opening, consumed by a Timer in the
    // popup block — a direct focus() can freeze / loop depending on the context).
    property <bool> rename-focus-armed: false;
    changed rename-popup-open => {
        if (root.rename-popup-open) { root.rename-focus-armed = true; }
        // On close the edit field is destroyed → return focus to the keyboard
        // scope so Escape / shortcuts keep working (see grouped note below).
        else { key-scope.focus(); }
    }

    // ----- New folder / file / shortcut popup (empty area) -----
    in-out property <bool> create-popup-open: false;
    // Type of entry to create: 0 = folder, 1 = file, 2 = shortcut.
    in-out property <int> create-kind: 0;
    in-out property <string> create-name;
    // New folder/file: live validation shared with Rename.
    // Shortcuts/links keep their own specific rules.
    in-out property <bool> create-name-valid: false;
    in-out property <bool> create-conflict: false;
    // Already-translated reason the name is refused ("" when it is fine), see
    // `rename-name-error`.
    in-out property <string> create-name-error: "";
    // Target of a shortcut (mode 2): pointed-to path, typed or chosen via Browse.
    in-out property <string> create-target;
    // Shortcut popup tab: true = target a FOLDER, false = a
    // FILE. Only drives the "Browse…" picker's type (creating
    // the .lnk is identical). Default: folder.
    in-out property <bool> create-shortcut-folder: true;
    // "Create a shortcut" popup tab (kind 3): true = symlink,
    // false = .lnk shortcut (Windows). Target = selected file (create-target).
    in-out property <bool> create-link-symlink: false;
    property <bool> create-focus-armed: false;
    property <bool> create-can-confirm:
        (root.create-kind == 0 || root.create-kind == 1)
            ? (root.create-name-valid && !root.create-conflict)
            : ((root.create-kind == 2 && root.create-target != "")
                || (root.create-kind == 3 && root.create-name != ""));
    callback create-check(int /*kind*/, string /*name*/);
    callback create-confirmed(int /*kind*/, string /*name*/, string /*target*/) -> bool;
    callback create-browse-target();           // native picker → fills create-target
    callback action-create-link();             // file context menu → kind 3 popup
    changed create-name => { root.create-check(root.create-kind, root.create-name); }
    changed create-kind => { root.create-check(root.create-kind, root.create-name); }
    changed create-popup-open => {
        if (root.create-popup-open) {
            root.create-check(root.create-kind, root.create-name);
            root.create-focus-armed = true;
        }
        // On close the edit field is destroyed → return focus to the keyboard
        // scope so Escape / shortcuts keep working (see grouped note below).
        else { key-scope.focus(); }
    }

    // Permanent-deletion warning, shared between a network volume
    // without a trash and the explicit Shift+Delete shortcut.
    in-out property <bool> delete-warning-open: false;
    // true = explicit permanent deletion; false = standard network
    // deletion (the `trash` primitive will itself fall back to permanent).
    in-out property <bool> delete-warning-permanent: false;
    callback delete-warning-confirmed();

    // Paste conflict popup -----
    in-out property <bool> paste-conflict-open: false;
    // Bumped by the bridge for EACH conflict, including when the popup stays
    // open between two items. This makes focus reliable across the whole series.
    in-out property <int> paste-conflict-focus-gen: 0;
    property <bool> paste-conflict-focus-armed: false;
    changed paste-conflict-open => {
        if (root.paste-conflict-open) { root.paste-conflict-focus-armed = true; }
        // On close the edit field is destroyed → return focus to the keyboard
        // scope so Escape / shortcuts keep working (see grouped note below).
        else { key-scope.focus(); }
    }
    changed paste-conflict-focus-gen => {
        if (root.paste-conflict-open) { root.paste-conflict-focus-armed = true; }
    }
    // Original name in conflict (shown in the message).
    in property <string> paste-conflict-original;
    // Type of the source, to never interpret a folder name's dot
    // as an extension when positioning the caret.
    in property <bool> paste-conflict-is-dir: false;
    // Name proposed / edited by the user.
    in-out property <string> paste-conflict-name;
    // True if the entered name is already taken (or invalid) — disables "Paste".
    in property <bool> paste-conflict-name-taken: false;
    // True when the conflict is a COPY WITHIN THE SAME FOLDER: overwriting
    // would amount to destroying the source, skipping amounts to canceling → we show
    // ONLY "Cancel" / "Paste" (with the renamed name). Set by the bridge.
    in property <bool> paste-conflict-rename-only: false;
    /// Live validation on every keystroke (the bridge updates name-taken).
    callback paste-conflict-check(string);
    /// Pastes with the entered name (resolves this conflict, moves to the next).
    callback paste-conflict-confirm(string);
    /// Skips this item — the others continue.
    callback paste-conflict-skip();
    /// Overwrites the existing target for THIS item, then moves to the next.
    callback paste-conflict-replace();
    /// Overwrites THIS item and all remaining conflicts, then runs.
    callback paste-conflict-replace-all();
    /// Skips THIS item and all remaining conflicts, then runs.
    callback paste-conflict-skip-all();
    /// Cancels the whole paste operation.
    callback paste-conflict-cancel();

    // Long operations in progress, one row per operation and one
    // non-blocking floating toast each. Driven by the bridge (background threads).
    // A row only appears once its operation passes the deferred-appearance
    // threshold, so a quick copy never flashes a toast.
    in property <[OpProgress]> ops: [];
    // "+N others" summary shown when more operations run than the stack displays.
    in property <string> ops-more-text;
    /// `true` while at least one operation is in flight — including those with no
    /// toast yet. Gates the deferred refreshes, which must not re-list mid-operation.
    in property <bool> op-busy: false;
    /// Emitted by the bridge (from a worker thread) to create or refresh one
    /// operation's row.
    callback op-progress(OpProgress);
    callback op-cancel(int);
    /// Emitted by the bridge at the end of an operation (releases it on the Rust side).
    callback op-finished(int);
    /// Closes one operation's toast, by hand or after its auto-dismiss delay.
    callback op-dismiss(int);

    // ----- Settings -----
    in-out property <bool> settings-open: false;
    // App version (CARGO_PKG_VERSION), set by the bridge.
    in property <string> app-version: "0.0.0";
    // Active tab of the Settings panel: 0 = General, 1 = Shortcuts (key
    // management has its own page so it no longer weighs down "General").
    in-out property <int> settings-tab: 0;
    // Sub-tab of the "Open with" tab: 0 = Ranger commands,
    // 1 = detected Windows entries (shell extensions).
    in-out property <int> ow-subtab: 0;
    // LAZY probe of the shell menu: triggered when the
    // sub-tab opens — nothing at startup (see `scan_shell_ext`).
    callback shell-ext-scan();
    changed ow-subtab => {
        if (self.ow-subtab == 1) { root.shell-ext-scan(); }
    }
    in property <string> config-dir-path;
    in property <string> data-dir-path;
    in property <string> cache-dir-path;
    // True when the config folder == the data folder (Windows case:
    // `config.toml` lives in the Data dir) → the "Configuration file" row
    // would be redundant and is hidden. On Linux the two differ.
    in property <bool> config-path-redundant: false;

    // Named workspaces (overlay) -----
    in-out property <bool> workspaces-open: false;
    // On menu OPENING, recomputes the list and flags from the
    // live state (including "unsaved changes") — regardless of how the menu was
    // opened (button, shortcut…).
    changed workspaces-open => {
        if (self.workspaces-open) { root.ws-refresh(); }
        // The "save as workspace" sub-input grabs focus; on close return it to
        // the keyboard scope so Escape / shortcuts keep working (grouped note below).
        else { key-scope.focus(); }
    }
    in property <[WorkspaceEntry]> workspaces;
    in-out property <string> ws-toast: "";   // feedback message (cleared by a Timer)
    // GLOBAL "notice" toast (e.g. "Access denied" on an unreadable folder) — set
    // by the bridge, auto-cleared by a Timer. Independent of overlays.
    in-out property <string> notice-text: "";
    // Toast tone: 0 = danger (red), 1 = success (green),
    // 2 = info (accent). Drives background + border + icon tint. Set by the bridge.
    in-out property <int> notice-tone: 0;
    // Toast icon: 0 = closed lock (access/error), 1 = open
    // lock (eject OK), 2 = checkmark (generic success), 3 = bookmark (favorites).
    in-out property <int> notice-icon: 0;
    // Toast display duration, set by the bridge based on message LENGTH
    // (adaptive reading time) — a long message (e.g. "service X is using the
    // device") stays displayed longer.
    in-out property <duration> notice-duration: 2800ms;
    // List sort direction: true = most recent first (default).
    in-out property <bool> ws-sort-newest-first: true;
    callback ws-save-new(string);       // saves the current state under this name
    callback ws-save-current();         // quick save of the current named workspace
    in-out property <bool> ws-name-taken: false;
    callback ws-name-check(string);     // live validation: name already used?
    // Deferred focus of the "workspace name" field — armed ONLY when the
    // panel opens because the user asked to SAVE a
    // still-unnamed workspace (Ctrl+S on an ad hoc state): the cursor is then in the
    // field, indicating a name must be entered. Normal opening (rail
    // button, Ctrl+Q) → not armed: the list is browsed, nothing gets named.
    in-out property <bool> ws-name-focus-armed: false;
    callback ws-load(string);           // loads workspace `id` (WITHOUT the guard)
    callback ws-overwrite(string);      // replaces workspace `id` with the current state
    callback ws-delete(string);         // deletes workspace `id`
    callback ws-rename(string, string); // (id, new-name)
    callback ws-reset();                // starts over from a blank space (1 panel, $HOME) — DIRECT
    callback ws-reset-guarded();        // "Start a new workspace" WITH the guard
    // "Unsaved changes" guard. The Load button goes
    // through `ws-load-guarded`: the bridge loads directly if the current state is clean,
    // otherwise it FILLS the dialog below (interpolated texts + target id) and
    // opens it. `ws-save-and-load` saves the current state THEN loads the target.
    callback ws-load-guarded(string /*target_id*/);
    callback ws-save-and-load();        // saves the current state THEN runs the pending action
    // Recomputes the list + the is-current/is-dirty flags from the LIVE state.
    // Called on EVERY menu opening (see `changed workspaces-open`): the
    // "unsaved changes" check happens when the menu opens, not
    // only after a save.
    callback ws-refresh();
    in-out property <bool> ws-dirty-warn-open: false;
    in-out property <string> ws-dirty-title-text;   // interpolated by the bridge
    in-out property <string> ws-dirty-body-text;    // interpolated by the bridge
    in-out property <string> ws-dirty-target-id;    // workspace to load after the decision
    // Nature of the pending action behind the dialog: false = load
    // `ws-dirty-target-id`, true = start over blank ("Start a new workspace").
    in-out property <bool> ws-dirty-reset: false;
    callback ws-toggle-sort();          // reverses the list's sort direction

    // "Places" sidebar -----
    // Stable semantic models. The order of the four movable sections
    // is a small model of codes: 0 Drives · 1 Shortcuts · 2 Favorites ·
    // 3 Network. Trash stays fixed below them.
    in property <[SidebarPlace]> sidebar-places-drives;
    in property <[SidebarPlace]> sidebar-places-shortcuts;
    in property <[SidebarPlace]> sidebar-places-network;
    in property <[SidebarPlace]> sidebar-places-trash;
    in property <[int]> sidebar-section-order;
    in-out property <bool> sidebar-section-drag-active: false;
    in-out property <int> sidebar-section-drag-source: -1;
    in-out property <int> sidebar-section-drag-target: -1;
    in-out property <length> sidebar-section-drag-preview-y: 0px;
    in-out property <length> sidebar-section-drag-last-x: 0px;
    in-out property <length> sidebar-section-drag-last-y: 0px;
    callback sidebar-section-reordered(int /*section*/, int /*final index*/);
    changed sidebar-section-order => { root.cancel-sidebar-section-drag(); }
    // Open left panel: 0 collapsed · 1 Places · 2 Favorites.
    in-out property <int> left-panel: 1;
    in-out property <length> sidebar-width: 210px;
    callback sidebar-place-clicked(string, int);   // (path, kind)
    callback place-open-new-tab(string, int);      // (path, kind) → new tab (active view)
    callback sidebar-refresh();                     // re-scans places
    callback poll-drives();                          // lightweight drive check: rebuilds only if changed
    // Cross-instance IPC init: `true` = initialized (the Timer stops),
    // `false` = window not ready yet → the Timer retries.
    callback init-ipc() -> bool;
    // Scroll of a panel's tab bar (viewport-x ≤ 0, plain) —
    // reported to the bridge for cross-instance insertion hit-testing.
    callback panel-tabs-scrolled(int, length);
    // PLAIN geometry of the panels container: read LAZILY by
    // the bridge (Rust getter, at the time of a cross-instance drop) → hit-test
    // of the target panel/gap. absolute-position read at the container level —
    // same family as `tabs-row-x` (proven pattern, no layout cycle).
    out property <length> panels-cont-x: panels-container.absolute-position.x;
    out property <length> panels-cont-y: panels-container.absolute-position.y;
    out property <length> panels-cont-w: panels-container.width;
    out property <length> panels-cont-h: panels-container.height;
    // "Unavailable" tabs (network/missing folder): `any-unavailable`
    // (set by the bridge) → a Timer calls `recheck-unavailable` to retry
    // as soon as a drive/mount changes.
    in-out property <bool> any-unavailable: false;
    callback recheck-unavailable();
    callback empty-trash();                         // empties the trash (permanent)
    // Trash context menu (right-click on the Trash entry).
    in-out property <bool> trash-menu-open: false;
    in-out property <length> trash-menu-x;
    in-out property <length> trash-menu-y;
    in-out property <bool> trash-menu-confirm: false;   // 2nd click = confirmation
    // Context menu of a drive / network location (right-click).
    in-out property <bool> drive-menu-open: false;
    in-out property <length> drive-menu-x;
    in-out property <length> drive-menu-y;
    in-out property <string> drive-menu-path;
    in-out property <int> drive-menu-kind;
    in-out property <bool> drive-menu-removable;   // → offers "Safely remove"
    in-out property <string> drive-menu-device;    // eject/disconnect target (empty → actions hidden)
    callback drive-eject(string);        // safe removal (device)
    callback drive-disconnect(string);   // disconnects a mapped network drive (device)
    callback place-copy-path(string);    // copies the path to the clipboard
    // Re-scans places when the Places panel is (re)opened.
    changed left-panel => {
        if (root.left-panel == 1) {
            root.sidebar-refresh();
        } else {
            root.cancel-sidebar-section-drag();
        }
    }
    // Auto-expand on drag: restarts the countdown when the
    // hovered collapsed container changes (declared at the component level to see the
    // property; the `fav-autoexp-timer` Timer lives in the window's body).
    changed fav-drag-hover-container => { fav-autoexp-timer.restart(); }
    // Auto-expand during a TAB/FILE drag: mirrors
    // `fav-panel.hover-collapsed-container` (hovered collapsed container) declared at the
    // ROOT to be visible to the Timer + its `changed` that restarts the countdown.
    property <string> fav-ext-collapsed: fav-panel.hover-collapsed-container;
    changed fav-ext-collapsed => { fav-autoexp-ext-timer.restart(); }
    // The "Open with" flyout closes along with its parent menu.
    changed ctx-menu-open => { if (!root.ctx-menu-open) { root.ow-menu-open = false; root.new-menu-open = false; root.ctx-shell-sub-open = false; } }

    // Tree-structured favorites -----
    in property <[FavNode]> fav-nodes;          // flattened tree (visible nodes)
    in-out property <string> fav-selected-id: "";
    callback fav-row-activate(string);          // click: container→toggle / favorite→open
    callback fav-row-middle(string);            // middle-click favorite → new tab
    callback fav-collapse-all();
    callback fav-open(string);                  // open favorite (new tab)
    callback fav-open-all(string);              // container: open all children
    callback fav-delete(string);
    callback fav-copy-path(string);
    // Drag reordering: delegated to the bridge (target/zone computed in f32).
    callback fav-drag-move(int, length, length);   // (row-index, cur-y, row-top)
    callback fav-drag-drop(int, length, length);
    // Context menu of a favorite node.
    in-out property <bool> fav-menu-open: false;
    in-out property <length> fav-menu-x;
    in-out property <length> fav-menu-y;
    in-out property <string> fav-menu-id: "";
    in-out property <string> fav-menu-name: "";             // label (pre-fills the rename)
    in-out property <bool> fav-menu-container: false;
    in-out property <bool> fav-menu-confirm-delete: false;  // 2nd click, non-empty container
    // Modal popup for creating or renaming a favorites container.
    // `rename` distinguishes create/rename; `target` = id to rename (rename) or
    // parent id (create; "" = root). `invalid` is set by the bridge.
    in-out property <bool> fav-name-open: false;
    in-out property <bool> fav-name-rename: false;
    in-out property <string> fav-name-target: "";
    in-out property <string> fav-name-value: "";
    in-out property <bool> fav-name-invalid: true;
    in-out property <bool> fav-name-focus-armed: false;
    callback fav-name-check(string);
    callback fav-name-confirm();
    // Drag indicators (set by the bridge during the move).
    in-out property <bool> fav-drag-active: false;
    in-out property <int> fav-drag-target-index: -1;
    in-out property <int> fav-drag-zone: 0;
    // Collapsed container currently hovered during a drag (auto-expand after a delay).
    in-out property <string> fav-drag-hover-container: "";
    callback fav-expand(string);   // expands a container (IN-PLACE insertion → drag preserved)
    // Toggle "Collapse all" / "Expand all" (containers).
    in-out property <bool> fav-can-collapse: false;
    callback fav-expand-all();
    // Collapse of the Favorites SECTION — hides the tree in the unified column.
    in-out property <bool> fav-section-collapsed: false;
    // The three other collapsible sections of the left column. These four
    // properties are restored from the workspace by the bridge.
    in-out property <bool> sidebar-shortcuts-collapsed: false;
    in-out property <bool> sidebar-drives-collapsed: false;
    in-out property <bool> sidebar-network-collapsed: false;
    callback sidebar-section-state-changed(int /*0 drives · 1 shortcuts · 2 favorites · 3 network*/,
        bool /*collapsed*/);
    function toggle-sidebar-section(section: int) {
        if (section == 0) {
            root.sidebar-drives-collapsed = !root.sidebar-drives-collapsed;
            root.sidebar-section-state-changed(0, root.sidebar-drives-collapsed);
        } else if (section == 1) {
            root.sidebar-shortcuts-collapsed = !root.sidebar-shortcuts-collapsed;
            root.sidebar-section-state-changed(1, root.sidebar-shortcuts-collapsed);
        } else if (section == 2) {
            root.fav-section-collapsed = !root.fav-section-collapsed;
            root.sidebar-section-state-changed(2, root.fav-section-collapsed);
        } else if (section == 3) {
            root.sidebar-network-collapsed = !root.sidebar-network-collapsed;
            root.sidebar-section-state-changed(3, root.sidebar-network-collapsed);
        }
    }
    // Rank in the global preference. The fallback preserves the historical
    // order during the very first milliseconds, before the bridge's push.
    pure function sidebar-section-rank(section: int) -> int {
        if (root.sidebar-section-order.length == 4) {
            if (root.sidebar-section-order[0] == section) { return 0; }
            if (root.sidebar-section-order[1] == section) { return 1; }
            if (root.sidebar-section-order[2] == section) { return 2; }
            if (root.sidebar-section-order[3] == section) { return 3; }
        }
        return section;
    }
    pure function sidebar-section-top(section: int) -> length {
        if (section == 0) { return drives-section.y; }
        if (section == 1) { return shortcuts-section.y; }
        if (section == 2) { return fav-panel.y; }
        return network-section.y;
    }
    pure function sidebar-section-bottom(section: int) -> length {
        if (section == 0) { return drives-section.y + drives-section.height; }
        if (section == 1) { return shortcuts-section.y + shortcuts-section.height; }
        if (section == 2) { return fav-panel.y + fav-panel.height; }
        return network-section.y + network-section.height;
    }
    pure function sidebar-section-header-middle(section: int) -> length {
        // All headers are exactly 30px. An expanded section's content
        // must never enlarge its reordering toggle zone.
        return root.sidebar-section-top(section) + 15px;
    }
    // Final index after removal then insertion. Only the centers of the three
    // (remaining) HEADERS matter: identical behavior whether the section is collapsed or very tall.
    pure function sidebar-section-target-at(source: int, local-y: length) -> int {
        return (source != 0 && local-y > root.sidebar-section-header-middle(0) ? 1 : 0)
            + (source != 1 && local-y > root.sidebar-section-header-middle(1) ? 1 : 0)
            + (source != 2 && local-y > root.sidebar-section-header-middle(2) ? 1 : 0)
            + (source != 3 && local-y > root.sidebar-section-header-middle(3) ? 1 : 0);
    }
    pure function sidebar-section-remaining-rank(section: int, source: int) -> int {
        return root.sidebar-section-rank(section)
            - (root.sidebar-section-rank(section) > root.sidebar-section-rank(source) ? 1 : 0);
    }
    pure function sidebar-section-at-remaining-rank(rank: int, source: int) -> int {
        if (source != 0 && root.sidebar-section-remaining-rank(0, source) == rank) { return 0; }
        if (source != 1 && root.sidebar-section-remaining-rank(1, source) == rank) { return 1; }
        if (source != 2 && root.sidebar-section-remaining-rank(2, source) == rank) { return 2; }
        return 3;
    }
    function update-sidebar-section-drag(section: int, abs-x: length, abs-y: length) {
        if (!root.sidebar-section-drag-active || section != root.sidebar-section-drag-source) { return; }
        root.sidebar-section-drag-last-x = abs-x;
        root.sidebar-section-drag-last-y = abs-y;
        let local-y: length = abs-y - sidebar-stack.absolute-position.y;
        if (abs-x < sidebar-stack.absolute-position.x
                || abs-x > sidebar-stack.absolute-position.x + sidebar-stack.width
                || local-y < 0px || local-y > sidebar-stack.height) {
            root.sidebar-section-drag-target = -1;
            return;
        }
        root.sidebar-section-drag-target = root.sidebar-section-target-at(section, local-y);
        if (root.sidebar-section-drag-target < 3) {
            root.sidebar-section-drag-preview-y = root.sidebar-section-top(
                root.sidebar-section-at-remaining-rank(root.sidebar-section-drag-target, section));
        } else {
            root.sidebar-section-drag-preview-y = root.sidebar-section-bottom(
                root.sidebar-section-at-remaining-rank(2, section));
        }
    }
    function refresh-sidebar-section-drag-geometry() {
        if (root.sidebar-section-drag-active) {
            root.update-sidebar-section-drag(root.sidebar-section-drag-source,
                root.sidebar-section-drag-last-x, root.sidebar-section-drag-last-y);
        }
    }
    function start-sidebar-section-drag(section: int, abs-x: length, abs-y: length) {
        if (section < 0 || section > 3 || root.left-panel != 1) { return; }
        root.sidebar-section-drag-active = true;
        root.sidebar-section-drag-source = section;
        root.sidebar-section-drag-target = root.sidebar-section-rank(section);
        root.update-sidebar-section-drag(section, abs-x, abs-y);
    }
    function drop-sidebar-section-drag(section: int, abs-x: length, abs-y: length) {
        root.update-sidebar-section-drag(section, abs-x, abs-y);
        let target: int = root.sidebar-section-drag-target;
        let source-rank: int = root.sidebar-section-rank(section);
        root.cancel-sidebar-section-drag();
        if (target >= 0 && target != source-rank) {
            root.sidebar-section-reordered(section, target);
        }
    }
    function cancel-sidebar-section-drag() {
        root.sidebar-section-drag-active = false;
        root.sidebar-section-drag-source = -1;
        root.sidebar-section-drag-target = -1;
    }
    // "Save as favorite" popup (from a tab / file).
    in-out property <bool> fav-save-open: false;
    in-out property <bool> fav-save-focus-armed: false;
    in-out property <string> fav-save-target: "";     // path (or "N items")
    in-out property <bool> fav-save-multi: false;
    in-out property <string> fav-save-alias: "";
    in property <[string]> fav-container-labels;       // indented labels (dropdown)
    in-out property <int> fav-container-index: 0;      // 0 = Root
    callback fav-save-commit(string, int);             // (alias, container index)
    callback fav-save-new-container(string, int);      // (name, parent container index) → creates + selects
    // "New container" sub-popup (from the save popup).
    in-out property <bool> fav-newc-open: false;
    in-out property <bool> fav-newc-focus-armed: false;
    in-out property <string> fav-newc-name: "";
    in-out property <int> fav-newc-parent-index: 0;    // 0 = Root
    // Save requests (triggered by the tab/file menus).
    callback fav-save-tab(int, int);                   // (panel, tab)
    callback fav-save-all-tabs(int);                   // (panel)
    callback duplicate-tab(int, int);                  // (panel, tab) → copy inserted after
    callback fav-add-selection();                      // selected files (active view)
    // Context menu of a tab (right-click).
    in-out property <bool> tab-menu-open: false;
    in-out property <length> tab-menu-x;
    in-out property <length> tab-menu-y;
    in-out property <int> tab-menu-panel: -1;
    in-out property <int> tab-menu-tab: -1;
    // Menu of a tab bar's dead zone. It reuses the existing favorites
    // callback and only exposes the specific restore action.
    in-out property <bool> tab-empty-menu-open: false;
    in-out property <length> tab-empty-menu-x;
    in-out property <length> tab-empty-menu-y;
    in-out property <int> tab-empty-menu-panel: -1;
    in-out property <bool> closed-tabs-available: false;
    callback reopen-last-closed-tab(int /*panel*/);

    // Context menu of a keyboard shortcut: same shared mechanism as
    // the other menus (close-ctx-menus / Dismiss). `action` = the targeted id.
    in-out property <bool> shortcut-menu-open: false;
    in-out property <length> shortcut-menu-x;
    in-out property <length> shortcut-menu-y;
    in-out property <string> shortcut-menu-action;
    function open-shortcut-menu(action: string, ax: length, ay: length) {
        root.close-ctx-menus();
        root.shortcut-menu-action = action;
        root.shortcut-menu-x = ax;
        root.shortcut-menu-y = ay;
        root.shortcut-menu-open = true;
    }

    // Opens the naming popup for a favorites container. `rename`: false =
    // create (target = parent id, "" = root), true = rename (target = id).
    function open-fav-name(rename: bool, target: string, value: string) {
        root.fav-name-rename = rename;
        root.fav-name-target = target;
        root.fav-name-value = value;
        root.fav-name-open = true;
        root.fav-name-focus-armed = true;
        root.fav-name-check(value);   // sets `fav-name-invalid` (empty → disabled)
    }

    // ----- Theme -----
    public function apply-theme() {
        if (root.theme-pref == 1) {
            Palette.color-scheme = ColorScheme.light;
        } else if (root.theme-pref == 2) {
            Palette.color-scheme = ColorScheme.dark;
        } else {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }
    init => { apply-theme(); }
    changed theme-pref => { apply-theme(); }
    // closing settings cancels any ongoing capture/conflict (otherwise the
    // `key-scope` would stay stuck in capture mode).
    changed settings-open => {
        if (!root.settings-open) {
            root.shortcut-capturing = "";
            root.shortcut-conflict-action = "";
            root.shortcut-conflict-message = "";
        } else {
            // On OPENING: re-detects ffmpeg (Linux) — the user may have
            // installed it since last time → status stays current with no action needed.
            root.ffmpeg-recheck();
            // On OPENING, returns focus to the root keyboard scope → Escape closes
            // the dialog even when it was opened via a click (gear button):
            // otherwise no element has focus and `key-scope.key-pressed` (which handles
            // Escape) never gets called. Consistent with shortcut capture, which
            // already requires this focus.
            key-scope.focus();
        }
    }

    // Text-field popups grab focus into their edit field when they open. On
    // CLOSE that field is destroyed, so — unless we act — focus is left on
    // nothing and `key-scope` (which handles Escape and the shortcuts) stops
    // receiving keys. Most visible when the popup sat on top of ANOTHER overlay,
    // e.g. Custom Command over Settings: after closing the popup with Escape, a
    // second Escape could no longer close the settings. Hand focus back to
    // `key-scope` on every close (all paths: Escape, buttons, backdrop).
    // rename / create / paste-conflict / workspaces do the same above.
    changed ow-popup-open => { if (!root.ow-popup-open) { key-scope.focus(); } }
    changed fav-name-open => { if (!root.fav-name-open) { key-scope.focus(); } }
    changed fav-newc-open => { if (!root.fav-newc-open) { key-scope.focus(); } }

    // Configurable shortcuts -----
    // Normalizes `event.text` into a canonical key name (special keys
    // are `Key.*` constants). Letters/digits/punctuation pass through as-
    // is (the bridge uppercases letters). Aligned with `shortcuts.rs`.
    pure function chord-key-name(t: string) -> string {
        if (t == Key.UpArrow) { return "ArrowUp"; }
        if (t == Key.DownArrow) { return "ArrowDown"; }
        if (t == Key.LeftArrow) { return "ArrowLeft"; }
        if (t == Key.RightArrow) { return "ArrowRight"; }
        if (t == Key.Tab) { return "Tab"; }
        if (t == Key.Backtab) { return "Tab"; }
        if (t == Key.Return) { return "Enter"; }
        if (t == Key.Delete) { return "Delete"; }
        if (t == Key.Home) { return "Home"; }
        if (t == Key.End) { return "End"; }
        if (t == Key.PageUp) { return "PageUp"; }
        if (t == Key.PageDown) { return "PageDown"; }
        if (t == Key.Insert) { return "Insert"; }
        if (t == Key.Space) { return "Space"; }
        if (t == Key.F1) { return "F1"; }
        if (t == Key.F2) { return "F2"; }
        if (t == Key.F3) { return "F3"; }
        if (t == Key.F4) { return "F4"; }
        if (t == Key.F5) { return "F5"; }
        if (t == Key.F6) { return "F6"; }
        if (t == Key.F7) { return "F7"; }
        if (t == Key.F8) { return "F8"; }
        if (t == Key.F9) { return "F9"; }
        if (t == Key.F10) { return "F10"; }
        if (t == Key.F11) { return "F11"; }
        if (t == Key.F12) { return "F12"; }
        // Backslash / pipe (Shift+\) → stable name independent of the layout.
        if (t == "\\" || t == "|") { return "Backslash"; }
        if (t == ",") { return "Comma"; }
        return t;
    }

    // Executes action `id` (resolved by `match-action`). Centralizes each
    // shortcut's behavior; the combination→id mapping is
    // driven by the config (rebind).
    function perform-action(id: string) {
        // Cursor navigation (keyboard)
        if (id == "cursor-up") { root.move-cursor(0, false); return; }
        if (id == "cursor-down") { root.move-cursor(1, false); return; }
        if (id == "cursor-first") { root.move-cursor(2, false); return; }
        if (id == "cursor-last") { root.move-cursor(3, false); return; }
        if (id == "extend-up") { root.move-cursor(0, true); return; }
        if (id == "extend-down") { root.move-cursor(1, true); return; }
        // Folder navigation
        if (id == "nav-back") { root.go-back(); return; }
        if (id == "nav-forward") { root.go-forward(); return; }
        if (id == "nav-parent") { root.go-parent(); return; }
        if (id == "nav-home") { root.go-home(); return; }
        if (id == "refresh") { root.refresh(); return; }
        // Ctrl+L: focuses the ACTIVE panel's address bar. The counter
        // is observed by each PanelComponent; only the active one enters edit mode.
        if (id == "focus-address") { root.address-focus-gen += 1; return; }
        // Selection
        if (id == "select-all") { root.select-all(); return; }
        // Tabs & views
        if (id == "tab-new") { root.tab-new(); return; }
        if (id == "tab-close") {
            if (root.active-panel-idx < root.panels.length) {
                root.tab-closed(root.panels[root.active-panel-idx].active-tab-idx);
            }
            return;
        }
        if (id == "tab-reopen-closed") {
            root.reopen-last-closed-tab(root.active-panel-idx);
            return;
        }
        if (id == "tab-next") {
            if (root.active-panel-idx < root.panels.length) {
                root.tab-clicked(mod(
                    root.panels[root.active-panel-idx].active-tab-idx + 1,
                    root.panels[root.active-panel-idx].tabs.length));
            }
            return;
        }
        if (id == "tab-prev") {
            if (root.active-panel-idx < root.panels.length) {
                root.tab-clicked(root.panels[root.active-panel-idx].active-tab-idx <= 0
                    ? root.panels[root.active-panel-idx].tabs.length - 1
                    : root.panels[root.active-panel-idx].active-tab-idx - 1);
            }
            return;
        }
        if (id == "view-next") {
            if (root.panels.length > 1) {
                root.panel-clicked(mod(root.active-panel-idx + 1, root.panels.length));
            }
            return;
        }
        if (id == "split-side") { root.panel-split(0); return; }
        if (id == "split-stack") { root.panel-split(1); return; }
        // File operations
        if (id == "open") { root.action-open(); return; }
        if (id == "copy") { root.action-copy(); return; }
        if (id == "cut") { root.action-cut(); return; }
        if (id == "paste") { root.action-paste(); return; }
        if (id == "rename") { root.action-rename(); return; }
        if (id == "delete") { root.action-delete(); return; }
        if (id == "delete-permanent") { root.action-delete-permanent(); return; }
        if (id == "restore-trash") { root.action-restore-last-trashed(); return; }
        if (id == "new-folder") { root.create-kind = 0; root.create-name = ""; root.create-target = ""; root.create-popup-open = true; return; }
        if (id == "new-file") { root.create-kind = 1; root.create-name = ""; root.create-target = ""; root.create-popup-open = true; return; }
        if (id == "terminal") { root.action-open-terminal(); return; }
        if (id == "properties") { root.action-properties(); return; }
        // Display options
        if (id == "toggle-hidden") { root.toggle-show-hidden(root.active-panel-idx); return; }
        if (id == "cycle-group") {
            if (root.active-panel-idx < root.panels.length) {
                root.set-group-mode(root.active-panel-idx,
                    root.panels[root.active-panel-idx].group-mode == "folders" ? "files"
                    : root.panels[root.active-panel-idx].group-mode == "files" ? "mixed"
                    : "folders");
            }
            return;
        }
        if (id == "toggle-view-mode") { root.toggle-preview-mode(root.active-panel-idx); return; }
        // Application
        if (id == "save-workspace") { root.ws-save-current(); return; }
        if (id == "open-settings") { root.settings-open = true; return; }
        if (id == "open-workspaces") { root.workspaces-open = true; return; }
    }

    // ----- Root focus scope (global keyboard shortcuts) -----
    key-scope := FocusScope {
        // Focus ON STARTUP: without this, the active view doesn't have keyboard
        // focus until it's been clicked into → a shortcut like Ctrl+L
        // would have no effect on a cold start.
        init => { self.focus(); }
        // Focus returning to Ranger (Alt-Tab, click from another window)
        // while a file drag is still "active": the user left then came
        // back → the gesture must have ended (mouse released
        // outside the window, `up` lost). We cancel this phantom drag, otherwise the pill
        // stays stuck to the cursor. The `file-drag-active` guard prevents any
        // effect during a normal focus change (a real drag never causes the
        // window to lose focus). The scope keeps focus on wake-up (Slint
        // forwards the activation event to the previously focused element).
        changed has-focus => {
            if (self.has-focus && root.sidebar-section-drag-active) {
                root.cancel-sidebar-section-drag();
            }
            // An external OLE drag can legitimately reactivate Ranger while
            // its source prepares temporary files. OLE DragLeave/Drop owns
            // that lifecycle; this focus fallback only cancels an INTERNAL
            // gesture whose mouse-up was lost outside the window.
            if (self.has-focus && root.file-drag-active
                    && root.file-drag-source-panel >= 0) {
                root.file-drag-active = false;
                root.file-drag-target-panel = -1;
                root.file-drag-target-row = -1;
                root.file-drag-target-folder = false;
                root.file-drag-target-exec = false;
                root.file-drag-target-invalid = false;
            }
        }
        // Ctrl key tracking: reflects the modifier on every key
        // → Ctrl+wheel = zoom entries (see PanelTile.scroll-event).
        key-released(event) => {
            if (event.text == Key.Control) { root.ctrl-down = false; }
            if (event.text == Key.Shift) { root.shift-down = false; }
            if (root.file-drag-active && root.file-drag-source-panel >= 0) {
                root.file-drag-copy = root.ctrl-down;
            }
            return reject;
        }
        key-pressed(event) => {
            root.keyboard-interaction-gen += 1;
            root.ctrl-down = event.modifiers.control;
            root.shift-down = event.modifiers.shift;
            if (root.file-drag-active && root.file-drag-source-panel >= 0) {
                root.file-drag-copy = root.ctrl-down;
            }
            // capturing an ongoing combination (rebind in settings).
            // Intercepts EVERYTHING as long as `shortcut-capturing` is set.
            if (root.shortcut-capturing != "") {
                if (event.text == Key.Escape) { root.shortcut-capturing = ""; return accept; }
                // Ignores lone modifiers: we're waiting for the actual key.
                if (event.text == Key.Control || event.text == Key.Shift
                        || event.text == Key.Alt || event.text == Key.Meta
                        || event.text == Key.AltGr) {
                    return accept;
                }
                root.shortcut-rebind(root.shortcut-capturing,
                    (event.modifiers.control ? "Ctrl+" : "")
                    + (event.modifiers.alt ? "Alt+" : "")
                    + (event.modifiers.shift ? "Shift+" : "")
                    + root.chord-key-name(event.text));
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.sidebar-section-drag-active) {
                    root.cancel-sidebar-section-drag();
                    return accept;
                }
                // Cancels an ongoing tab drag: hides the overlays and
                // forgets the target → if the user releases without moving again, the
                // drop is a no-op (see drag-target-panel = -1).
                if (root.drag-active) {
                    root.drag-active = false;
                    root.drag-target-panel = -1;
                    root.drag-target-zone = 0;
                    root.drag-source-panel = -1;
                    return accept;
                }
                if (root.file-drag-active) { root.file-drag-active = false; return accept; }
                if (root.file-drop-menu-open) { root.file-drop-menu-open = false; return accept; }
                if (root.split-menu-open) { root.split-menu-open = false; return accept; }
                if (root.tabbar-menu-open) { root.tabbar-menu-open = false; return accept; }
                if (root.url-menu-open) { root.url-menu-open = false; return accept; }
                if (root.trash-menu-open) { root.trash-menu-open = false; return accept; }
                if (root.drive-menu-open) { root.drive-menu-open = false; return accept; }
                if (root.columns-menu-open) { root.columns-menu-open = false; return accept; }
                // "Open with", favorites, and tab menus/popups that weren't
                // closed by Escape. Placed BEFORE settings: the "Custom
                // command" popup can be opened ON TOP OF the settings
                // → Escape closes the popup first, not the settings.
                if (root.ow-popup-open) { root.ow-popup-open = false; return accept; }
                if (root.ow-picker-open) { root.ow-picker-open = false; return accept; }
                if (root.ow-menu-open) { root.ow-menu-open = false; return accept; }
                if (root.new-menu-open) { root.new-menu-open = false; return accept; }
                if (root.fav-save-open) { root.fav-save-open = false; return accept; }
                if (root.fav-newc-open) { root.fav-newc-open = false; return accept; }
                if (root.fav-menu-open) { root.fav-menu-open = false; return accept; }
                if (root.tab-menu-open) { root.tab-menu-open = false; return accept; }
                if (root.tab-empty-menu-open) { root.tab-empty-menu-open = false; return accept; }
                if (root.paste-conflict-open) { root.paste-conflict-cancel(); root.paste-conflict-open = false; return accept; }
                if (root.ctx-menu-open) { root.ctx-close(); return accept; }
                if (root.settings-open) { root.settings-open = false; return accept; }
                // Escape first closes the guard (back to the list), not the
                // whole Workspaces overlay.
                if (root.ws-dirty-warn-open) { root.ws-dirty-warn-open = false; return accept; }
                if (root.workspaces-open) { root.workspaces-open = false; return accept; }
                if (root.rename-popup-open) { root.rename-popup-open = false; return accept; }
                if (root.create-popup-open) { root.create-popup-open = false; return accept; }
                if (root.delete-warning-open) { root.delete-warning-open = false; return accept; }
                if (root.fav-name-open) { root.fav-name-open = false; return accept; }
                // Escape first closes the active filter (by-name OR by-extension
                // type-ahead — shared via filter-clear bridge-side), otherwise
                // deselects.
                if (root.active-filter != "" || root.active-ext-filter-on) { root.filter-clear(); return accept; }
                root.deselect-all();
                return accept;
            }
            // Backspace: edits the active filter when there is one (by-name
            // OR by-extension type-ahead). Outside a filter, Backspace no longer has a
            // "parent" navigation effect — that now only goes through its
            // configurable shortcut (e.g. Alt+Up arrow).
            if (event.text == Key.Backspace && (root.active-filter != "" || root.active-ext-filter-on)) {
                root.filter-backspace();
                return accept;
            }
            // Configurable shortcuts: the bridge resolves the combination into
            // an action id, which we execute via `perform-action`. Suspended when an
            // overlay is open (it manages its own keys, e.g. rebind capture).
            if (!root.any-overlay-open) {
                let id: string = root.match-action(
                    root.chord-key-name(event.text),
                    event.modifiers.control, event.modifiers.alt, event.modifiers.shift);
                if (id != "") { root.perform-action(id); return accept; }
            }
            // PRINTABLE character outside an overlay → active view's type-ahead
            // filter. Special keys (>= U+F700) and controls (< U+0020) excluded;
            // Ctrl/Alt/Meta left to the shortcuts.
            if (!root.any-overlay-open
                    && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                    && event.text != "" && event.text >= " " && event.text < "\u{F700}") {
                root.filter-type(event.text);
                return accept;
            }
            return reject;
        }

        // Catch-all BELOW all content (declared first = bottom
        // of the z-order → steals no clicks from interactive elements above):
        // receives clicks that NOTHING consumes (window margins, rail /
        // sidebar backgrounds, empty strips) and closes the context menu.
        TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) { Dismiss.serial += 1; }
            }
        }

        VerticalBox {
            // Reduced top margin (the user finds it too bulky). The
            // other sides keep 10px for breathing room.
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 4px;
            padding-bottom: 10px;
            spacing: 6px;

            // ===== Activity rail, "Places" sidebar, and content =====
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // Always-visible vertical activity rail. Side panel toggle
                // at the top; system actions (Workspaces, Settings) at the bottom.
                ActivityRail {
                    left-panel: root.left-panel;
                    strings: root.strings;
                    shortcuts: root.menu-shortcuts;
                    toggle-places => { root.left-panel = root.left-panel == 1 ? 0 : 1; }
                    open-workspaces => { root.workspaces-open = true; }
                    open-settings => { root.settings-open = true; }
                }

                // ===== UNIFIED side column (Places + Favorites) =====
                // ALWAYS instantiated (width 0 when collapsed) to stay
                // referenceable: `fav-panel.fav-hover-container` is read on drop,
                // which would be impossible with a conditional element. The grid
                // keeps one instance per section and only varies their rank.
                // Favorites absorbs the available height up to its cap and scrolls.
                left-column := Rectangle {
                    width: root.left-panel == 1 ? root.sidebar-width : 0px;
                    visible: root.left-panel == 1;
                    background: Theme.toolbar;
                    // Full-height right thread (also covers the spacer's area
                    // when the Favorites section is collapsed).
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: Tokens.hairline;
                    }
                    // SINGLE local reference frame for the grid and its drop line:
                    // no mixing of absolute coordinates between containers.
                    sidebar-stack := Rectangle {
                        width: 100%;
                        height: 100%;
                        // Four STABLE instances within a grid: their `row`
                        // is the global rank. `fav-panel` keeps its identity and
                        // the preview causes no reflow.
                        ordered-sidebar := GridLayout {
                            width: 100%;
                            height: 100%;
                        spacing: 0px;
                        drives-section := Sidebar {
                            row: root.sidebar-section-rank(0);
                            col: 0;
                            places: root.sidebar-places-drives;
                            strings: root.strings;
                            // Only this section carries capacity gauges, so it
                            // is the only one that needs the panel's width.
                            panel-width: root.sidebar-width;
                            section-code: 0;
                            title: root.strings.sidebar-drives;
                            collapsed: root.sidebar-drives-collapsed;
                            reorder-drag-active: root.sidebar-section-drag-active;
                            reorder-drag-source: root.sidebar-section-drag-source;
                            changed y => { root.refresh-sidebar-section-drag-geometry(); }
                            changed height => { root.refresh-sidebar-section-drag-geometry(); }
                            section-toggled => { root.toggle-sidebar-section(0); }
                            section-drag-started(section, x, y) => { root.start-sidebar-section-drag(section, x, y); }
                            section-drag-moved(section, x, y) => { root.update-sidebar-section-drag(section, x, y); }
                            section-drag-dropped(section, x, y) => { root.drop-sidebar-section-drag(section, x, y); }
                            place-clicked(path, kind) => { root.sidebar-place-clicked(path, kind); }
                            place-middle-clicked(path, kind) => { root.place-open-new-tab(path, kind); }
                            place-right-clicked(path, kind, removable, device, x, y) => {
                                root.open-sidebar-place-context(path, kind, removable, device, x, y);
                            }
                        }
                        shortcuts-section := Sidebar {
                            row: root.sidebar-section-rank(1);
                            col: 0;
                            places: root.sidebar-places-shortcuts;
                            strings: root.strings;
                            section-code: 1;
                            title: root.strings.sidebar-shortcuts;
                            collapsed: root.sidebar-shortcuts-collapsed;
                            reorder-drag-active: root.sidebar-section-drag-active;
                            reorder-drag-source: root.sidebar-section-drag-source;
                            changed y => { root.refresh-sidebar-section-drag-geometry(); }
                            changed height => { root.refresh-sidebar-section-drag-geometry(); }
                            section-toggled => { root.toggle-sidebar-section(1); }
                            section-drag-started(section, x, y) => { root.start-sidebar-section-drag(section, x, y); }
                            section-drag-moved(section, x, y) => { root.update-sidebar-section-drag(section, x, y); }
                            section-drag-dropped(section, x, y) => { root.drop-sidebar-section-drag(section, x, y); }
                            place-clicked(path, kind) => { root.sidebar-place-clicked(path, kind); }
                            place-middle-clicked(path, kind) => { root.place-open-new-tab(path, kind); }
                            place-right-clicked(path, kind, removable, device, x, y) => {
                                root.open-sidebar-place-context(path, kind, removable, device, x, y);
                            }
                        }
                        fav-panel := FavPanel {
                            row: root.sidebar-section-rank(2);
                            col: 0;
                            // Height = the CONTENT's (header + tree), CAPPED
                            // (`max-height`) so Drives and Network immediately
                            // follow the favorites. Beyond the available space,
                            // the stretch takes back over and the tree scrolls within
                            // `fav-scroll` without changing the hit-test area. Constants = Slint
                            // geometry: header (separator included) 30; row 30 +
                            // 1 gap = 31; list padding 11; empty state 132.
                            vertical-stretch: 1;
                            max-height: root.fav-section-collapsed
                                ? 30px
                                : (root.fav-nodes.length == 0
                                    ? 162px
                                    : (41px + root.fav-nodes.length * 31px));
                            nodes: root.fav-nodes;
                            strings: root.strings;
                            selected-id: root.fav-selected-id;
                            drag-active: root.fav-drag-active;
                            drag-target-index: root.fav-drag-target-index;
                            drag-zone: root.fav-drag-zone;
                            // TAB or FILE drag over the favorites
                            // absolute cursor position propagated; the
                            // FavPanel computes the hovered folder (`hover-container`,
                            // read on drop, hit-test unchanged — scroll's own frame).
                            tab-drag-active: root.drag-active;
                            tab-drag-abs-x: root.drag-abs-x;
                            tab-drag-abs-y: root.drag-abs-y;
                            file-drag-active: root.file-drag-active;
                            file-drag-abs-x: root.file-drag-abs-x;
                            file-drag-abs-y: root.file-drag-abs-y;
                            section-collapsed: root.fav-section-collapsed;
                            reorder-drag-active: root.sidebar-section-drag-active;
                            reorder-drag-source: root.sidebar-section-drag-source;
                            changed y => { root.refresh-sidebar-section-drag-geometry(); }
                            changed height => { root.refresh-sidebar-section-drag-geometry(); }
                            toggle-section => { root.toggle-sidebar-section(2); }
                            section-drag-started(section, x, y) => { root.start-sidebar-section-drag(section, x, y); }
                            section-drag-moved(section, x, y) => { root.update-sidebar-section-drag(section, x, y); }
                            section-drag-dropped(section, x, y) => { root.drop-sidebar-section-drag(section, x, y); }
                            row-activate(id) => { root.fav-row-activate(id); }
                            row-middle(id) => { root.fav-row-middle(id); }
                            row-context(id, is-cont, label, x, y) => {
                                root.close-ctx-menus();
                                root.fav-menu-id = id;
                                root.fav-menu-name = label;
                                root.fav-menu-container = is-cont;
                                root.fav-menu-x = x;
                                root.fav-menu-y = y;
                                root.fav-menu-confirm-delete = false;
                                // Right-click doesn't affect `fav-selected-id` and
                                // therefore leaves no persistent highlight.
                                root.fav-menu-open = true;
                            }
                            row-drag-move(ri, cy, rt) => { root.fav-drag-move(ri, cy, rt); }
                            row-drag-drop(ri, cy, rt) => { root.fav-drag-drop(ri, cy, rt); }
                            can-collapse: root.fav-can-collapse;
                            // Header "+" → root container creation popup.
                            new-container => { root.open-fav-name(false, "", ""); }
                            collapse-all => { root.fav-collapse-all(); }
                            expand-all => { root.fav-expand-all(); }
                        }
                        network-section := Sidebar {
                            row: root.sidebar-section-rank(3);
                            col: 0;
                            places: root.sidebar-places-network;
                            strings: root.strings;
                            section-code: 3;
                            title: root.strings.sidebar-network;
                            collapsed: root.sidebar-network-collapsed;
                            reorder-drag-active: root.sidebar-section-drag-active;
                            reorder-drag-source: root.sidebar-section-drag-source;
                            changed y => { root.refresh-sidebar-section-drag-geometry(); }
                            changed height => { root.refresh-sidebar-section-drag-geometry(); }
                            section-toggled => { root.toggle-sidebar-section(3); }
                            section-drag-started(section, x, y) => { root.start-sidebar-section-drag(section, x, y); }
                            section-drag-moved(section, x, y) => { root.update-sidebar-section-drag(section, x, y); }
                            section-drag-dropped(section, x, y) => { root.drop-sidebar-section-drag(section, x, y); }
                            place-clicked(path, kind) => { root.sidebar-place-clicked(path, kind); }
                            place-middle-clicked(path, kind) => { root.place-open-new-tab(path, kind); }
                            place-right-clicked(path, kind, removable, device, x, y) => {
                                root.open-sidebar-place-context(path, kind, removable, device, x, y);
                            }
                        }
                        // Fixed Trash: it has neither a chevron nor a grip and does
                        // not take part in the global order array.
                        trash-section := Sidebar {
                            row: 4;
                            col: 0;
                            places: root.sidebar-places-trash;
                            strings: root.strings;
                            section-code: -1;
                            title: "";
                            header-visible: false;
                            place-clicked(path, kind) => { root.sidebar-place-clicked(path, kind); }
                            place-middle-clicked(path, kind) => { root.place-open-new-tab(path, kind); }
                            place-right-clicked(path, kind, removable, device, x, y) => {
                                root.open-sidebar-place-context(path, kind, removable, device, x, y);
                            }
                        }
                        // Remainder below all sections. The tiny stretch
                        // gives priority to Favorites for the available height.
                        Rectangle { row: 5; col: 0; vertical-stretch: 0.0001; }
                        }
                        // Destination indicator in the SAME local frame as
                        // the sections. `-1px` centers its 2px on the separator.
                        if root.sidebar-section-drag-active
                                && root.sidebar-section-drag-target >= 0
                                && root.sidebar-section-drag-target
                                    != root.sidebar-section-rank(root.sidebar-section-drag-source) : Rectangle {
                            x: 6px;
                            y: root.sidebar-section-drag-preview-y - 1px;
                            width: parent.width - 12px;
                            height: 2px;
                            border-radius: 1px;
                            background: Theme.accent-background;
                        }
                    }
                }

                // Left panel resize grip (horizontal drag).
                // Absolute delta since the start of the drag → no drift.
                if root.left-panel != 0 : Rectangle {
                    width: 6px;
                    property <length> start-w;
                    property <length> start-x;
                    background: sb-resize.has-hover || sb-resize.pressed
                        ? Theme.accent-background.with-alpha(0.45)
                        : transparent;
                    sb-resize := TouchArea {
                        mouse-cursor: ew-resize;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down
                                    && ev.button == PointerEventButton.left) {
                                Dismiss.serial += 1;
                                parent.start-w = root.sidebar-width;
                                parent.start-x = self.absolute-position.x + self.mouse-x;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.sidebar-width = clamp(
                                    parent.start-w
                                        + (self.absolute-position.x + self.mouse-x - parent.start-x),
                                    150px, 440px);
                            }
                        }
                    }
                }

            // ===== Panels container (flattened rendering of the tree) =====
            // Rectangle (NOT a layout): each panel is positioned in
            // **absolute** terms from its fractional geometry (fx/fy/fw/fh x container
            // size), splitters are overlays on the seams.
            // This bypasses Slint's layout engine (a source of
            // "Recursion detected" cycles on repeaters).
            panels-container := Rectangle {
                horizontal-stretch: 1;
                clip: true;
                // Groove: slightly recessed background so the tiles
                // (panels) stand out in the gap that separates them.
                background: Tokens.trough;
                for panel[idx] in root.panels : PanelComponent {
                    // Rounded to a WHOLE pixel: without this, a
                    // fractional position (fraction x width) places the panel on a
                    // half-pixel → blurry text/icons (and inconsistent from one
                    // panel to another depending on whether the fraction lands exactly).
                    // + uniform `panel-gap` inset on all 4 sides → a gap of
                    // 2xpanel-gap between neighbors, 1x against the edges. The seam
                    // (hence the splitter) stays centered on the same position.
                    x: round(panels-container.width * panel.fx / 1px) * 1px + Tokens.panel-gap;
                    y: round(panels-container.height * panel.fy / 1px) * 1px + Tokens.panel-gap;
                    width: round(panels-container.width * panel.fw / 1px) * 1px - 2 * Tokens.panel-gap;
                    height: round(panels-container.height * panel.fh / 1px) * 1px - 2 * Tokens.panel-gap;
                    view: panel;
                    // Footer drawn from the PARALLEL model `panel-footers`
                    // (never from `panel`) → its update does not invalidate
                    // `view.rendered-rows`.
                    footer-text: idx < root.panel-footers.length ? root.panel-footers[idx] : "";
                    active: idx == root.active-panel-idx;
                    can-close: root.panels.length > 1;
                    strings: root.strings;
                    drag-active: root.drag-active;
                    drag-abs-x: root.drag-abs-x;
                    drag-abs-y: root.drag-abs-y;
                    tab-tooltip-enabled: root.tab-tooltip-enabled;
                    is-drag-source: root.drag-active && idx == root.drag-source-panel;
                    // The panel under the cursor claims the drop target.
                    changed drag-zone => {
                        if (self.drag-zone > 0) {
                            root.drag-target-panel = idx;
                            root.drag-target-zone = self.drag-zone;
                        }
                    }
                    // File drag'n'drop between views ---
                    file-drag-active: root.file-drag-active;
                    file-drag-abs-x: root.file-drag-abs-x;
                    file-drag-abs-y: root.file-drag-abs-y;
                    is-file-drag-source: idx == root.file-drag-source-panel;
                    changed file-drag-over => {
                        if (self.file-drag-over) {
                            root.claim-file-drag-target(idx, self.drag-target-row,
                                self.drag-folder-row >= 0, self.drag-target-exec);
                        } else {
                            root.clear-file-drag-target(idx);
                        }
                    }
                    // The hovered row changes → publishes folder AND executable to
                    // the root to keep feedback and action aligned.
                    changed drag-target-row => {
                        if (root.file-drag-target-panel == idx) {
                            root.claim-file-drag-target(idx, self.drag-target-row,
                                self.drag-folder-row >= 0, self.drag-target-exec);
                        }
                    }
                    changed drag-target-exec => {
                        if (root.file-drag-target-panel == idx) {
                            root.claim-file-drag-target(idx, self.drag-target-row,
                                self.drag-folder-row >= 0, self.drag-target-exec);
                        }
                    }
                    changed drag-folder-row => {
                        if (root.file-drag-target-panel == idx) {
                            root.claim-file-drag-target(idx, self.drag-target-row,
                                self.drag-folder-row >= 0, self.drag-target-exec);
                        }
                    }
                    file-drag-started(ri, x, y) => {
                        root.file-drag-source-panel = idx;
                        root.file-drag-abs-x = x;
                        root.file-drag-abs-y = y;
                        root.file-drag-active = true;
                        root.file-drag-copy = root.ctrl-down;
                        root.native-drag-armed = false;   // re-arms the native drag
                        root.file-drag-begin(idx, ri);
                        // `file-drag-begin` just guaranteed the selection of the
                        // grabbed row: now recompute the target/source conflict.
                        root.refresh-file-drag-target-invalid();
                    }
                    file-drag-progress(x, y) => {
                        root.file-drag-abs-x = x;
                        root.file-drag-abs-y = y;
                        root.file-drag-copy = root.ctrl-down;
                        // The cursor LEAVES the window → switches to a native OLE drag
                        // (once) for external apps. We end the
                        // Slint drag (releases ghost + state) before the modal loop.
                        if (root.file-drag-active && !root.native-drag-armed
                                && (x < 0px || y < 0px || x > root.width || y > root.height)) {
                            root.native-drag-armed = true;
                            root.file-drag-active = false;
                            root.file-drag-target-panel = -1;
                            root.file-drag-target-row = -1;
                            root.file-drag-target-folder = false;
                            root.file-drag-target-exec = false;
                            root.file-drag-target-invalid = false;
                            root.start-native-drag(root.file-drag-source-panel);
                        }
                    }
                    file-drag-dropped(x, y) => {
                        root.file-drag-abs-x = x;
                        root.file-drag-abs-y = y;
                        // Drop on a FAVORITES folder: TAKES PRIORITY over the
                        // cross-view drop. `fav-hover-container` is read pull-based
                        // BEFORE cutting the drag (file-drag-abs position already up
                        // to date above); non-empty = hovered container → the
                        // selection is saved there as a favorite (no file operation).
                        if (root.fav-hover-container != "") {
                            root.close-ctx-menus();
                            root.file-to-favorite(root.file-drag-source-panel, root.fav-hover-container);
                        } else if (root.fav-hover-panel) {
                            // "No favorites" area or dead zone of the favorites
                            // section → adds AT THE ROOT (container "").
                            root.close-ctx-menus();
                            root.file-to-favorite(root.file-drag-source-panel, "");
                        } else if (!root.file-drag-target-invalid
                                && root.file-drag-target-panel >= 0
                                && (root.file-drag-target-folder
                                    || root.file-drag-target-exec
                                    || root.file-drag-target-panel != root.file-drag-source-panel)) {
                            root.close-ctx-menus();
                            root.file-drop-src-panel = root.file-drag-source-panel;
                            root.file-drop-target-panel = root.file-drag-target-panel;
                            root.file-drop-target-row = root.file-drag-target-row;
                            // Drop ONTO an executable (.cmd/.bat/.exe…) → we
                            // LAUNCH it with the dropped files as arguments (dev
                            // habit of "dragging a .txt onto a .cmd"). The bridge
                            // returns true if it launched; otherwise normal Copy/… menu.
                            if (root.file-drop-onto-exec()) {
                                // launched — nothing else to do
                            } else if (root.file-drag-copy) {
                                root.file-drop-action(1); // 1 = copy
                            } else {
                                root.file-drop-menu-x = x;
                                root.file-drop-menu-y = y;
                                root.file-drop-menu-open = true;
                            }
                        }
                        root.file-drag-active = false;
                        root.file-drag-target-invalid = false;
                    }
                    column-resized(id, w) => { root.panel-column-resized(idx, id, w); }
                    column-toggle(id, vis) => { root.column-toggle(idx, id, vis); }
                    column-moved(id, target) => { root.column-moved(idx, id, target); }
                    ext-filter-toggle => { root.ext-filter-toggle(idx); }
                    tabs-scrolled(vx) => { root.panel-tabs-scrolled(idx, vx); }
                    scroll-target(ti, fwd, vx, vw) => { return root.panel-scroll-target(idx, ti, fwd, vx, vw); }
                    filter-text: root.active-filter;
                    filter-clear => { root.filter-clear(); }
                    rows-viewport-changed(top, height) => {
                        root.panel-viewport-changed(idx, top, height);
                    }
                    row-at-content-y(y) => { return root.panel-row-at-content-y(idx, y); }
                    open-columns-menu(mx, my) => {
                        root.close-ctx-menus();
                        root.columns-menu-panel = idx;
                        root.columns-menu-x = mx;
                        root.columns-menu-y = my;
                        root.columns-menu-open = true;
                    }
                    open-split-menu(mx, my) => {
                        root.close-ctx-menus();
                        root.split-menu-x = mx;
                        root.split-menu-y = my;
                        root.split-menu-open = true;
                    }
                    open-tabbar-menu(mx, my) => {
                        root.close-ctx-menus();
                        root.tabbar-menu-panel = idx;
                        root.tabbar-menu-mode = panel.tab-bar-mode;
                        root.tabbar-menu-x = mx;
                        root.tabbar-menu-y = my;
                        root.tabbar-menu-open = true;
                    }
                    vbar-resized(w) => { root.panel-vbar-resized(idx, w); }
                    toggle-preview-mode => { root.toggle-preview-mode(idx); }
                    zoom-step(d, top, height, pointer-y) => {
                        return root.zoom-view(idx, d, top, height, pointer-y);
                    }
                    keyboard-interaction-gen: root.keyboard-interaction-gen;
                    address-focus-gen: root.address-focus-gen;
                    overlay-open: root.any-overlay-open;
                    toggle-show-hidden => { root.toggle-show-hidden(idx); }
                    open-url-menu(mx, my) => {
                        root.close-ctx-menus();
                        root.url-menu-x = mx;
                        root.url-menu-y = my;
                        root.url-menu-open = true;
                    }
                    close-ctx-menu => { root.close-ctx-menus(); }
                    url-edit-text <=> root.url-edit-text;
                    url-menu-open: root.url-menu-open;
                    url-copy-serial: root.url-copy-serial;
                    url-paste-serial: root.url-paste-serial;

                    activate => { root.panel-clicked(idx); }
                    go-back => { root.go-back(); }
                    go-forward => { root.go-forward(); }
                    go-parent => { root.go-parent(); }
                    go-home => { root.go-home(); }
                    refresh => { root.refresh(); }
                    sort-clicked(c) => { root.sort-clicked(c); }
                    row-activated(i) => { root.row-activated(i); }
                    row-clicked(i) => { root.row-clicked(i); }
                    row-ctrl-clicked(i) => { root.row-ctrl-clicked(i); }
                    row-shift-clicked(i) => { root.row-shift-clicked(i); }
                    rename-selected => { root.action-rename(); }
                    right-clicked(i, x, y) => { root.close-ctx-menus(); root.row-right-clicked(i, x, y); }
                    select-all => { root.select-all(); }
                    deselect-all => { root.deselect-all(); }
                    rubber-band-begin(m) => { root.rubber-band-begin(m); }
                    rubber-band-update(a, b, c, d) => { root.rubber-band-update(a, b, c, d); }
                    tab-new => { root.tab-new(); }
                    tab-clicked(i) => { root.tab-clicked(i); }
                    tab-closed(i) => { root.tab-closed(i); }
                    tab-context(ti, x, y) => {
                        root.close-ctx-menus();
                        root.tab-menu-panel = idx;
                        root.tab-menu-tab = ti;
                        root.tab-menu-x = x;
                        root.tab-menu-y = y;
                        root.tab-menu-open = true;
                    }
                    tab-bar-context(x, y) => {
                        root.close-ctx-menus();
                        root.tab-empty-menu-panel = idx;
                        root.tab-empty-menu-x = x;
                        root.tab-empty-menu-y = y;
                        root.tab-empty-menu-open = true;
                    }
                    tab-drag-completed(i, ti, ax, ay) => {
                        // Drop on a FAVORITES folder: takes priority over
                        // the normal drop (panel / tear-off / transfer), which is
                        // thus left 100% INTACT. `fav-hover-container` is read
                        // PULL-BASED BEFORE cutting the drag (the binding resets
                        // as soon as `drag-active = false`); non-empty = hovered container.
                        if (root.fav-hover-container != "") {
                            // `idx` = drag's SOURCE panel (may be non-active).
                            root.tab-to-favorite(idx, i, root.fav-hover-container);
                            root.drag-active = false;
                            root.drag-target-gap = -1;
                            root.drag-target-gap-panel = -1;
                        } else if (root.fav-hover-panel) {
                            // Empty / dead zone of the favorites → root ("").
                            root.tab-to-favorite(idx, i, "");
                            root.drag-active = false;
                            root.drag-target-gap = -1;
                            root.drag-target-gap-panel = -1;
                        } else {
                            root.drag-active = false;
                            root.tab-drag-completed(idx, i, ti, ax, ay);
                        }
                        root.drag-target-panel = -1;
                        root.drag-target-zone = 0;
                        root.drag-source-panel = -1;
                    }
                    tab-drag-progress(i, ax, ay) => {
                        // Drag start → purges the previous drag's gap.
                        if (!root.drag-active) {
                            root.drag-target-gap = -1;
                            root.drag-target-gap-panel = -1;
                        }
                        root.drag-active = true;
                        root.drag-abs-x = ax;
                        root.drag-abs-y = ay;
                        root.drag-source-panel = idx;
                        root.tab-drag-progress(i, ax, ay);
                    }
                    tab-gap-claimed(g) => {
                        root.drag-target-gap = g;
                        root.drag-target-gap-panel = idx;
                    }
                    request-focus => { key-scope.focus(); }
                    navigate-to(p) => { root.navigate-to(p); }
                    empty-right-clicked(x, y) => { root.close-ctx-menus(); root.empty-right-clicked(x, y); }
                    close-panel => { root.panel-closed(idx); }
                }

                // Separators (resize grips) overlaid on the seams.
                for sp[i] in root.splitters : PanelSplitterAbs {
                    vertical: sp.vertical;
                    x: sp.vertical
                        ? round(panels-container.width * sp.pos / 1px) * 1px - self.width / 2
                        : round(panels-container.width * sp.cross-start / 1px) * 1px;
                    y: sp.vertical
                        ? round(panels-container.height * sp.cross-start / 1px) * 1px
                        : round(panels-container.height * sp.pos / 1px) * 1px - self.height / 2;
                    width: sp.vertical ? 8px : round(panels-container.width * sp.cross-len / 1px) * 1px;
                    height: sp.vertical ? round(panels-container.height * sp.cross-len / 1px) * 1px : 8px;
                    dragged(ax, ay) => {
                        root.splitter-resized(sp.idx,
                            sp.vertical
                                ? (ax - panels-container.absolute-position.x) / panels-container.width
                                : (ay - panels-container.absolute-position.y) / panels-container.height);
                    }
                }
            }
            } // closes the HorizontalLayout (sidebar + panels)
        }

        // ===== Context menu =====
        // NO full-screen backdrop: it used to consume the 2nd click (the menu
        // wouldn't reposition on the next right-click) and swallow the left click
        // (the clicked row wasn't selected). Instead, clicks
        // within the content (sel-touch / dead-zones) close the menu, a right
        // click repositions it (the bridge rewrites ctx-menu-x/y + open), and
        // any interaction with the CHROME (rail, sidebar, tabs, headers,
        // splitters, empty areas…) closes it via the global `Dismiss`.
        if root.ctx-menu-open : Rectangle {
            x: root.ctx-menu-x;
            y: root.ctx-menu-y;
            width: 240px;
            // Adapted height: full menu (targeted entry) vs reduced menu
            // (blank area). Dynamic: + pinned commands (26px
            // each + 1px separator), + "Create a shortcut" (file),
            // + comparison entries. The bridge's clamp follows the same calculation.
            height: (root.ctx-on-empty ? 194px : 402px)
                + (root.ctx-custom-entries.length > 0 ? root.ctx-custom-entries.length * 26px + 1px : 0px)
                + (root.ctx-shell-entries.length > 0 ? root.ctx-shell-entries.length * 26px + 1px : 0px)
                + (!root.ctx-on-empty && root.ctx-selection-is-file ? 26px : 0px)
;
            background: Theme.background;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;

            // Catch-all: absorbs clicks in the menu's empty areas to
            // prevent propagation to the backdrop (which would close it).
            TouchArea { }

            // ----- Full menu: an entry (file/folder) is targeted -----
            if !root.ctx-on-empty : VerticalLayout {
                padding: 4px;
                spacing: 0px;

                MenuItem { label: root.strings.ctx-open;          shortcut: root.menu-shortcuts.open;  clicked => { root.ctx-close(); root.action-open(); } }
                // File on Windows → "Open as administrator" ("new
                // tab" would only open the parent folder: not very useful). Otherwise
                // (folder, multiple selection, or Linux) → "new tab".
                if root.platform-windows && root.ctx-selection-is-file : MenuItem {
                    label: root.strings.ctx-open-admin;
                    clicked => { root.ctx-close(); root.action-open-admin(); }
                }
                if !(root.platform-windows && root.ctx-selection-is-file) : MenuItem {
                    label: root.strings.ctx-open-new-tab;
                    clicked => { root.ctx-close(); root.action-open-new-tab(); }
                }
                // "Open with" → flyout on HOVER (the parent menu stays open).
                // Files only: a folder is opened by navigating into it, not by
                // handing it to an application.
                if !root.ctx-selection-is-dir : Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: (owrow-ta.has-hover || root.ow-menu-open) ? Theme.alternate-background : transparent;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: root.strings.ctx-open-with;
                            font-size: 12px;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "›";
                            font-size: 15px;
                            color: Theme.foreground.with-alpha(0.5);
                            vertical-alignment: center;
                        }
                    }
                    owrow-ta := TouchArea {
                        changed has-hover => {
                            root.ow-parent-hover = self.has-hover;
                            if (self.has-hover) {
                                root.ow-menu-x = self.absolute-position.x + self.width - 4px;
                                root.ow-menu-y = self.absolute-position.y - 4px;
                                root.ow-menu-open = true;
                            }
                        }
                    }
                }
                MenuItem { label: root.strings.ctx-open-parent;                       clicked => { root.ctx-close(); root.action-open-parent(); } }
                MenuItem { label: root.strings.ctx-open-terminal; shortcut: root.menu-shortcuts.terminal; clicked => { root.ctx-close(); root.action-open-terminal(); } }
                // Pinned user commands — filtered by the bridge
                // based on the target (file / folder).
                if root.ctx-custom-entries.length > 0 : Rectangle { height: 1px; background: Theme.border; }
                for cc in root.ctx-custom-entries : IconMenuRow {
                    label: cc.label;
                    icon: cc.icon;
                    icon-kind: cc.icon-kind;
                    clicked => { root.ctx-close(); root.ctx-custom-run(cc.id); }
                }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { label: root.strings.ctx-copy;          shortcut: root.menu-shortcuts.copy; clicked => { root.ctx-close(); root.action-copy(); } }
                MenuItem { label: root.strings.ctx-cut;           shortcut: root.menu-shortcuts.cut; clicked => { root.ctx-close(); root.action-cut(); } }
                MenuItem { label: root.strings.ctx-paste;         shortcut: root.menu-shortcuts.paste; clicked => { root.ctx-close(); root.action-paste(); } }
                MenuItem { label: root.strings.ctx-duplicate;                         clicked => { root.ctx-close(); root.action-duplicate(); } }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { label: root.strings.ctx-copy-path;                         clicked => { root.ctx-close(); root.action-copy-path(); } }
                MenuItem { label: root.strings.ctx-copy-name;                         clicked => { root.ctx-close(); root.action-copy-name(); } }
                MenuItem { label: root.strings.fav-add;                               clicked => { root.ctx-close(); root.fav-add-selection(); } }
                // "Create a shortcut" — any SINGLE item, file or folder: opens
                // the popup (.lnk shortcut / symlink tabs) creating a link in the
                // current folder to it. Folders link fine (junction on Windows,
                // symlink on Linux, or a .lnk pointing at the folder).
                if root.ctx-selection-single : MenuItem { label: root.strings.ctx-create-link; clicked => { root.ctx-close(); root.action-create-link(); } }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { label: root.strings.ctx-rename;        shortcut: root.menu-shortcuts.rename; clicked => { root.ctx-close(); root.action-rename(); } }
                MenuItem { label: root.strings.ctx-delete;        shortcut: root.menu-shortcuts.delete; clicked => { root.ctx-close(); root.action-delete(); } }
                // WINDOWS context menu entries (shell extensions).
                if root.ctx-shell-entries.length > 0 : Rectangle { height: 1px; background: Theme.border; }
                for se in root.ctx-shell-entries : ShellMenuRow {
                    entry: se;
                    sub-open: root.ctx-shell-sub-open && se.has-sub && root.ctx-shell-sub-for == se.sub;
                    run(id) => { root.ctx-close(); root.ctx-shell-run(id); }
                    hover-changed(h) => {
                        if (se.has-sub) { root.ctx-shell-sub-parent-hover = h; }
                        else if (h) { root.ctx-shell-sub-open = false; }
                    }
                    sub-hover(x, y) => {
                        root.ctx-shell-sub-x = x;
                        root.ctx-shell-sub-y = y;
                        root.ctx-shell-sub-for = se.sub;
                        root.ctx-shell-sub-hover(se.sub);
                        root.ctx-shell-sub-open = true;
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { label: root.strings.ctx-properties;    shortcut: root.menu-shortcuts.properties; clicked => { root.ctx-close(); root.action-properties(); } }
            }

            // ----- Reduced menu: right-click on a blank area -----
            // No Copy/Cut/Duplicate/Rename/Delete (no target).
            // Actions target the current folder (Paste, path, name…).
            if root.ctx-on-empty : VerticalLayout {
                padding: 4px;
                spacing: 0px;

                // Unified "New" entry → flyout on HOVER (folder / file
                // / shortcut). SAME mechanism as "Open with".
                Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: (newrow-ta.has-hover || root.new-menu-open) ? Theme.alternate-background : transparent;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: root.strings.ctx-new;
                            font-size: 12px;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "›";
                            font-size: 15px;
                            color: Theme.foreground.with-alpha(0.5);
                            vertical-alignment: center;
                        }
                    }
                    newrow-ta := TouchArea {
                        changed has-hover => {
                            root.new-parent-hover = self.has-hover;
                            if (self.has-hover) {
                                root.new-menu-x = self.absolute-position.x + self.width - 4px;
                                root.new-menu-y = self.absolute-position.y - 4px;
                                root.new-menu-open = true;
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { label: root.strings.ctx-paste;         shortcut: root.menu-shortcuts.paste; clicked => { root.ctx-close(); root.action-paste(); } }
                MenuItem { label: root.strings.ctx-open-parent;                       clicked => { root.ctx-close(); root.action-open-parent(); } }
                MenuItem { label: root.strings.ctx-open-terminal; shortcut: root.menu-shortcuts.terminal; clicked => { root.ctx-close(); root.action-open-terminal(); } }
                // Commands pinned to the view BACKGROUND — e.g. "Git Bash
                // here"; they target the current folder.
                if root.ctx-custom-entries.length > 0 : Rectangle { height: 1px; background: Theme.border; }
                for cc in root.ctx-custom-entries : IconMenuRow {
                    label: cc.label;
                    icon: cc.icon;
                    icon-kind: cc.icon-kind;
                    clicked => { root.ctx-close(); root.ctx-custom-run(cc.id); }
                }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { label: root.strings.ctx-copy-path;                         clicked => { root.ctx-close(); root.action-copy-path(); } }
                MenuItem { label: root.strings.ctx-copy-name;                         clicked => { root.ctx-close(); root.action-copy-name(); } }
                // WINDOWS context menu entries for the CURRENT FOLDER —
                // queried "as an item" (this exposes the
                // full PeaZip menu, Git Bash here, Select left folder…).
                if root.ctx-shell-entries.length > 0 : Rectangle { height: 1px; background: Theme.border; }
                for se in root.ctx-shell-entries : ShellMenuRow {
                    entry: se;
                    sub-open: root.ctx-shell-sub-open && se.has-sub && root.ctx-shell-sub-for == se.sub;
                    run(id) => { root.ctx-close(); root.ctx-shell-run(id); }
                    hover-changed(h) => {
                        if (se.has-sub) { root.ctx-shell-sub-parent-hover = h; }
                        else if (h) { root.ctx-shell-sub-open = false; }
                    }
                    sub-hover(x, y) => {
                        root.ctx-shell-sub-x = x;
                        root.ctx-shell-sub-y = y;
                        root.ctx-shell-sub-for = se.sub;
                        root.ctx-shell-sub-hover(se.sub);
                        root.ctx-shell-sub-open = true;
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                MenuItem { label: root.strings.ctx-properties;    shortcut: root.menu-shortcuts.properties; clicked => { root.ctx-close(); root.action-properties(); } }
            }
        }

        // ===== "Split" menu =====
        // Opened by a panel's split token. Transparent backdrop that
        // closes on an outside click; acts on the active panel (the token
        // activated it beforehand) via `panel-split`.
        // (no more backdrop — unified closing via close-ctx-menus/Dismiss.)
        if root.split-menu-open : Rectangle {
            // Clamped so it doesn't overflow the window.
            x: min(root.split-menu-x, root.width - self.width - 8px);
            y: min(root.split-menu-y, root.height - self.height - 8px);
            width: 224px;
            height: 82px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;

            // Catch-all: absorbs clicks in the menu's empty areas.
            TouchArea { }

            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                SplitMenuItem {
                    label: root.strings.split-side-by-side;
                    stacked: false;
                    shortcut: root.menu-shortcuts.split-side;
                    clicked => { root.split-menu-open = false; root.panel-split(0); }
                }
                SplitMenuItem {
                    label: root.strings.split-stacked;
                    stacked: true;
                    shortcut: root.menu-shortcuts.split-stack;
                    clicked => { root.split-menu-open = false; root.panel-split(1); }
                }
            }
        }

        // ===== "Tab bar position" menu =====
        // 3 radio options (checkmark on the current mode), per view.
        if root.tabbar-menu-open : Rectangle {
            x: min(root.tabbar-menu-x, root.width - self.width - 8px);
            y: min(root.tabbar-menu-y, root.height - self.height - 8px);
            width: 224px;
            height: 120px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;

            // Catch-all: absorbs clicks in the menu's empty areas.
            TouchArea { }

            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                TabBarMenuItem {
                    icon: @image-url("../../assets/icons/tabs-top.svg");
                    label: root.strings.tabbar-top;
                    selected: root.tabbar-menu-mode == 0;
                    clicked => {
                        root.tabbar-menu-open = false;
                        root.set-tab-bar-mode(root.tabbar-menu-panel, 0);
                    }
                }
                TabBarMenuItem {
                    icon: @image-url("../../assets/icons/tabs-left.svg");
                    label: root.strings.tabbar-left;
                    selected: root.tabbar-menu-mode == 1;
                    clicked => {
                        root.tabbar-menu-open = false;
                        root.set-tab-bar-mode(root.tabbar-menu-panel, 1);
                    }
                }
                TabBarMenuItem {
                    icon: @image-url("../../assets/icons/tabs-right.svg");
                    label: root.strings.tabbar-right;
                    selected: root.tabbar-menu-mode == 2;
                    clicked => {
                        root.tabbar-menu-open = false;
                        root.set-tab-bar-mode(root.tabbar-menu-panel, 2);
                    }
                }
            }
        }

        // ===== URL bar menu (right-click): Paste / Copy path =====
        if root.url-menu-open : Rectangle {
            x: min(root.url-menu-x, root.width - self.width - 8px);
            y: min(root.url-menu-y, root.height - self.height - 8px);
            width: 220px;
            height: 64px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                MenuItem {
                    label: root.strings.ctx-copy;     // "Copy"
                    clicked => { root.url-menu-open = false; root.url-copy-serial += 1; }
                }
                MenuItem {
                    label: root.strings.ctx-paste;    // "Paste"
                    clicked => { root.url-menu-open = false; root.url-paste-serial += 1; }
                }
            }
        }

        // ===== Trash context menu (sidebar): Empty (two-step) =====
        if root.trash-menu-open : Rectangle {
            x: min(root.trash-menu-x, root.width - self.width - 8px);
            y: min(root.trash-menu-y, root.height - self.height - 8px);
            width: 220px;
            height: 40px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: root.trash-menu-confirm
                        ? Tokens.danger.with-alpha(empty-touch.has-hover ? 0.34 : 0.20)
                        : (empty-touch.has-hover ? Tokens.danger.with-alpha(0.14) : transparent);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            // 1st click: "Empty trash"; 2nd: confirmation.
                            text: root.trash-menu-confirm
                                ? root.strings.sidebar-empty-trash-confirm
                                : root.strings.sidebar-empty-trash;
                            color: Tokens.danger;
                            font-size: 12px;
                            font-weight: root.trash-menu-confirm ? 700 : 400;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    empty-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.trash-menu-confirm) {
                                root.trash-menu-open = false;
                                root.empty-trash();
                            } else {
                                root.trash-menu-confirm = true;
                            }
                        }
                    }
                }
            }
        }

        // ===== Drive / Network context menu (sidebar) =====
        // Actions: open in a new tab · copy path · (removable)
        // safely remove · (mapped network, device = letter) disconnect.
        if root.drive-menu-open : dmenu := Rectangle {
            // Item count: open + copy (2) + eject? + disconnect?
            property <bool> can-eject: root.drive-menu-removable && root.drive-menu-device != "";
            property <bool> can-disconnect: root.drive-menu-kind == 4 && root.drive-menu-device != "";
            property <int> item-count: 2 + (self.can-eject ? 1 : 0) + (self.can-disconnect ? 1 : 0);
            x: min(root.drive-menu-x, root.width - self.width - 8px);
            y: min(root.drive-menu-y, root.height - self.height - 8px);
            width: 240px;
            height: 8px + self.item-count * 30px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                MenuItem {
                    label: root.strings.ctx-open-new-tab;
                    clicked => { root.drive-menu-open = false; root.place-open-new-tab(root.drive-menu-path, root.drive-menu-kind); }
                }
                MenuItem {
                    label: root.strings.ctx-copy-path;
                    clicked => { root.drive-menu-open = false; root.place-copy-path(root.drive-menu-path); }
                }
                if dmenu.can-eject : MenuItem {
                    label: root.strings.net-eject;
                    clicked => { root.drive-menu-open = false; root.drive-eject(root.drive-menu-device); }
                }
                if dmenu.can-disconnect : MenuItem {
                    label: root.strings.net-disconnect;
                    clicked => { root.drive-menu-open = false; root.drive-disconnect(root.drive-menu-device); }
                }
            }
        }

        // ===== "Open with" submenu (flyout on hover) =====
        // NO full-screen backdrop: the parent menu stays active behind it.
        if root.ow-menu-open : Rectangle {
            x: min(root.ow-menu-x, root.width - self.width - 8px);
            y: min(root.ow-menu-y, root.height - self.height - 8px);
            width: 240px;
            height: 8px
                + root.openers-suggested.length * 26px
                + (root.openers-suggested.length > 0 ? 8px : 0px)
                + 26px /* Choose an application */
                + 26px /* Custom command */
                + (root.selection-is-executable ? 26px : 0px)
                + 8px + 26px /* Manage */;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            // Tracks the flyout's hover state (for the deferred close). The content
            // is INSIDE the TouchArea → has-hover stays stable even while
            // hovering the items (see the WorkspaceRow pattern).
            TouchArea {
                changed has-hover => { root.ow-flyout-hover = self.has-hover; }
                VerticalLayout {
                    padding: 4px;
                    // Recent opener row: app icon (generic fallback) + label.
                    for op in root.openers-suggested : Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: sug-ta.has-hover ? Theme.alternate-background : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 10px;
                            CommandIcon {
                                kind: op.icon-kind;
                                extracted: op.icon;
                            }
                            Text {
                                text: op.label;
                                font-size: 12px;
                                color: Theme.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                        sug-ta := TouchArea {
                            // `ctx-close` closes the parent menu AND the flyout (via
                            // `changed ctx-menu-open`), like the normal items.
                            clicked => { root.ctx-close(); root.run-opener(op.id); }
                        }
                    }
                if root.openers-suggested.length > 0 : Rectangle {
                    height: 8px;
                    Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
                }
                MenuItem {
                    label: root.strings.ow-choose;
                    clicked => { root.ctx-close(); root.ow-open-picker(); }
                }
                MenuItem {
                    label: root.strings.ow-custom;
                    clicked => { root.ctx-close(); root.ow-add(); }
                }
                if root.selection-is-executable : MenuItem {
                    label: root.strings.ow-use-as-app;
                    clicked => { root.ctx-close(); root.ow-use-as-app(); }
                }
                Rectangle {
                    height: 8px;
                    Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
                }
                MenuItem {
                    label: root.strings.ow-manage;
                    // Directly opens the "Open with" tab of Settings.
                    clicked => {
                        root.ctx-close();
                        root.settings-tab = 2;
                        // "Manage applications" always targets the Ranger
                        // applications list, never the last Windows
                        // sub-tab remembered from a previous visit.
                        root.ow-subtab = 0;
                        root.settings-open = true;
                    }
                }
                }
            }
        }

        // ===== "New" submenu (flyout on hover) =====
        // Same mechanism as "Open with" above (no backdrop: the parent
        // menu stays active). Opens the creation popup with the right `create-kind`.
        if root.new-menu-open : Rectangle {
            x: min(root.new-menu-x, root.width - self.width - 8px);
            y: min(root.new-menu-y, root.height - self.height - 8px);
            width: 200px;
            height: 8px + (root.platform-windows ? 3 : 2) * 26px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea {
                changed has-hover => { root.new-flyout-hover = self.has-hover; }
                VerticalLayout {
                    padding: 4px;
                    MenuItem {
                        label: root.strings.ctx-new-folder;
                        clicked => { root.ctx-close(); root.create-kind = 0; root.create-name = ""; root.create-target = ""; root.create-popup-open = true; }
                    }
                    MenuItem {
                        label: root.strings.ctx-new-file;
                        clicked => { root.ctx-close(); root.create-kind = 1; root.create-name = ""; root.create-target = ""; root.create-popup-open = true; }
                    }
                    // .lnk shortcut: Windows ONLY (a concept absent on Linux,
                    // where symbolic links are followed natively).
                    if root.platform-windows : MenuItem {
                        label: root.strings.ctx-new-shortcut;
                        clicked => { root.ctx-close(); root.create-kind = 2; root.create-name = ""; root.create-target = ""; root.create-shortcut-folder = true; root.create-popup-open = true; }
                    }
                }
            }
        }

        // ===== Windows shell menu CASCADE flyout =====
        // Same mechanism as the "Open with" flyout: no backdrop, the parent
        // menu stays active; deferred close via the dedicated Timer.
        if root.ctx-shell-sub-open : Rectangle {
            x: min(root.ctx-shell-sub-x, root.width - self.width - 8px);
            y: min(root.ctx-shell-sub-y, root.height - self.height - 8px);
            width: 280px;
            height: 8px + root.ctx-shell-sub-entries.length * 26px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea {
                changed has-hover => { root.ctx-shell-sub-flyout-hover = self.has-hover; }
                VerticalLayout {
                    padding: 4px;
                    for se in root.ctx-shell-sub-entries : ShellMenuRow {
                        entry: se;
                        run(id) => { root.ctx-close(); root.ctx-shell-run(id); }
                    }
                }
            }
        }

        // ===== Home-grown application picker =====
        if root.ow-picker-open : ModalBackdrop {
            dismiss-on-click: true;
            dismiss => { root.ow-picker-open = false; }
        }
        if root.ow-picker-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 440px;
            height: 420px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;
            // This catch-all absorbs clicks in the panel's empty areas. Only
            // a click outside the panel, received by the backdrop, closes the picker.
            TouchArea { }
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: root.strings.ow-choose;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.alternate-background.with-alpha(0.5);
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    ScrollView {
                        VerticalLayout {
                            padding: 6px;
                            spacing: 1px;
                            if root.ow-picker-handlers.length == 0 : Text {
                                text: root.strings.ow-empty;
                                font-size: 12px;
                                color: Theme.foreground.with-alpha(0.45);
                                height: 40px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            for h in root.ow-picker-handlers : Rectangle {
                                height: 30px;
                                border-radius: 5px;
                                background: pick-ta.has-hover ? Theme.alternate-background : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Rectangle {
                                        width: 18px;
                                        height: parent.height;
                                        if h.icon.width > 0 : Image {
                                            source: h.icon;
                                            width: 16px;
                                            height: 16px;
                                            x: 0;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        if h.icon.width == 0 : Image {
                                            width: 16px;
                                            x: 0;
                                            y: (parent.height - self.height) / 2;
                                            source: @image-url("../../assets/icons/application.svg");
                                            colorize: Theme.foreground.with-alpha(0.7);
                                        }
                                    }
                                    Text {
                                        text: h.label;
                                        font-size: 13px;
                                        color: Theme.foreground;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                                pick-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.ow-picker-open = false; root.ow-pick(h.id); }
                                }
                            }
                        }
                    }
                }
                // "Set as default": when the app is chosen, also saves the
                // file's extension as a Ranger default (overrides the OS).
                CheckBox {
                    text: root.strings.ow-set-default;
                    checked <=> root.ow-picker-set-default;
                }
                HorizontalBox {
                    padding: 0px;
                    // Browse the OS for a custom exe (like the "…" in Custom
                    // Command): the handler saves it as an opener then launches it.
                    Button {
                        text: root.strings.ow-pick-browse;
                        clicked => { root.ow-pick-browse(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: root.strings.btn-cancel; clicked => { root.ow-picker-open = false; } }
                }
            }
        }

        // ===== Promotion toast after the native dialog (Windows) =====
        if root.ow-promote-visible : Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 18px;
            height: 40px;
            width: promo-row.preferred-width + 28px;
            border-radius: 10px;
            background: Theme.background;
            border-width: 1px;
            border-color: Theme.accent-background.with-alpha(0.45);
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000.with-alpha(0.30);
            drop-shadow-offset-y: 3px;
            Timer { interval: 6s; running: root.ow-promote-visible; triggered => { root.ow-promote-visible = false; } }
            promo-row := HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 12px;
                Text { text: root.strings.ow-promote; font-size: 12.5px; color: Theme.foreground; vertical-alignment: center; }
                Rectangle {
                    width: promo-btn-txt.preferred-width + 20px;
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: promo-ta.has-hover ? Theme.accent-background : Theme.accent-background.with-alpha(0.8);
                    promo-btn-txt := Text { text: root.strings.ow-promote-add; font-size: 12px; color: Theme.accent-foreground; x: (parent.width - self.width)/2; vertical-alignment: center; height: parent.height; }
                    promo-ta := TouchArea { clicked => { root.ow-promote-visible = false; root.ow-promote-accept(); } }
                }
            }
        }

        // The New folder, Expand all, and Collapse all actions live
        // in the Favorites section's header.

        if root.fav-menu-open : Rectangle {
            x: min(root.fav-menu-x, root.width - self.width - 8px);
            y: min(root.fav-menu-y, root.height - self.height - 8px);
            width: 220px;
            height: root.fav-menu-container ? 120px : 126px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                // --- CONTAINER ---
                if root.fav-menu-container : MenuItem {
                    label: root.strings.fav-open-all;
                    clicked => { root.fav-menu-open = false; root.fav-open-all(root.fav-menu-id); }
                }
                if root.fav-menu-container : Rectangle {
                    height: 7px;
                    Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
                }
                if root.fav-menu-container : MenuItem {
                    label: root.strings.fav-new-subcontainer;
                    clicked => { root.fav-menu-open = false; root.open-fav-name(false, root.fav-menu-id, ""); }
                }
                if root.fav-menu-container : MenuItem {
                    label: root.strings.fav-rename;
                    clicked => { root.fav-menu-open = false; root.open-fav-name(true, root.fav-menu-id, root.fav-menu-name); }
                }
                // Container deletion: 2nd click = confirmation (recursive).
                if root.fav-menu-container : Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: root.fav-menu-confirm-delete
                        ? Tokens.danger.with-alpha(fdc-touch.has-hover ? 0.34 : 0.20)
                        : (fdc-touch.has-hover ? Tokens.danger.with-alpha(0.14) : transparent);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: root.fav-menu-confirm-delete ? root.strings.fav-delete-confirm : root.strings.fav-delete;
                            color: Tokens.danger;
                            font-size: 12px;
                            font-weight: root.fav-menu-confirm-delete ? 700 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    fdc-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if (root.fav-menu-confirm-delete) {
                                root.fav-menu-open = false;
                                root.fav-delete(root.fav-menu-id);
                            } else {
                                root.fav-menu-confirm-delete = true;
                            }
                        }
                    }
                }
                // --- FAVORITE ---
                if !root.fav-menu-container : MenuItem {
                    label: root.strings.fav-open;
                    clicked => { root.fav-menu-open = false; root.fav-open(root.fav-menu-id); }
                }
                if !root.fav-menu-container : Rectangle {
                    height: 7px;
                    Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
                }
                if !root.fav-menu-container : MenuItem {
                    label: root.strings.fav-rename;
                    clicked => { root.fav-menu-open = false; root.open-fav-name(true, root.fav-menu-id, root.fav-menu-name); }
                }
                if !root.fav-menu-container : MenuItem {
                    label: root.strings.fav-delete;
                    clicked => { root.fav-menu-open = false; root.fav-delete(root.fav-menu-id); }
                }
                if !root.fav-menu-container : Rectangle {
                    height: 7px;
                    Rectangle { y: 3px; height: 1px; background: Tokens.hairline; }
                }
                if !root.fav-menu-container : MenuItem {
                    label: root.strings.fav-copy-path;
                    clicked => { root.fav-menu-open = false; root.fav-copy-path(root.fav-menu-id); }
                }
            }
        }

        // ===== Context menu of a tab bar's dead zone =====
        if root.tab-empty-menu-open : Rectangle {
            x: min(root.tab-empty-menu-x, root.width - self.width - 8px);
            y: min(root.tab-empty-menu-y, root.height - self.height - 8px);
            width: 270px;
            height: 60px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    label: root.strings.fav-save-all-tabs;
                    clicked => {
                        root.tab-empty-menu-open = false;
                        root.fav-save-all-tabs(root.tab-empty-menu-panel);
                    }
                }
                MenuItem {
                    label: root.strings.tab-reopen-closed;
                    shortcut: root.menu-shortcuts.tab-reopen-closed;
                    enabled: root.closed-tabs-available;
                    clicked => {
                        root.tab-empty-menu-open = false;
                        root.reopen-last-closed-tab(root.tab-empty-menu-panel);
                    }
                }
            }
        }

        // ===== Context menu of a tab =====
        if root.tab-menu-open : Rectangle {
            x: min(root.tab-menu-x, root.width - self.width - 8px);
            y: min(root.tab-menu-y, root.height - self.height - 8px);
            width: 260px;
            height: 96px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    label: root.strings.tab-duplicate;
                    clicked => {
                        root.tab-menu-open = false;
                        root.duplicate-tab(root.tab-menu-panel, root.tab-menu-tab);
                    }
                }
                MenuItem {
                    label: root.strings.fav-save-tab;
                    clicked => {
                        root.tab-menu-open = false;
                        root.fav-save-tab(root.tab-menu-panel, root.tab-menu-tab);
                    }
                }
                MenuItem {
                    label: root.strings.fav-save-all-tabs;
                    clicked => {
                        root.tab-menu-open = false;
                        root.fav-save-all-tabs(root.tab-menu-panel);
                    }
                }
                // The tab bar's position is set from its dedicated
                // button in the navigation bar.
            }
        }

        // ===== Modal popup for naming or renaming a favorites container =====
        // It shares the rules of the other naming popups: validation via
        // `is_valid_entry_name`, deferred focus, and a disabled button if the name is invalid.
        if root.fav-name-open : ModalBackdrop { }
        if root.fav-name-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: 196px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            Timer {
                interval: 1ms;
                running: root.fav-name-focus-armed;
                triggered => {
                    favname-edit.focus();
                    // Caret at the END of the line (no selection) — same behavior
                    // as a folder name (see rename-edit).
                    favname-edit.set-selection-offsets(99999, 99999);
                    root.fav-name-focus-armed = false;
                }
            }

            VerticalBox {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: root.fav-name-rename ? root.strings.fav-rename : root.strings.fav-new-container;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                favname-edit := EditLineEdit {
                    placeholder-text: root.strings.create-placeholder;
                    text <=> root.fav-name-value;
                    edited(t) => { root.fav-name-check(t); }
                    accepted(t) => {
                        if (!root.fav-name-invalid && t != "") { root.fav-name-confirm(); }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.strings.btn-cancel;
                        clicked => { root.fav-name-open = false; }
                    }
                    Button {
                        text: root.fav-name-rename ? root.strings.rename-confirm : root.strings.create-confirm;
                        primary: true;
                        enabled: !root.fav-name-invalid && root.fav-name-value != "";
                        clicked => { root.fav-name-confirm(); }
                    }
                }
            }
        }

        // ===== "Save as favorite" popup =====
        if root.fav-save-open : ModalBackdrop { }
        if root.fav-save-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: 300px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: root.strings.fav-popup-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                // Target (path, or "N items").
                Text {
                    text: root.fav-save-target;
                    color: Theme.foreground.with-alpha(0.7);
                    font-size: 12px;
                    overflow: elide;
                }
                // Alias (single item).
                if !root.fav-save-multi : Text {
                    text: root.strings.fav-popup-alias;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 0.3px;
                    color: Theme.foreground.with-alpha(0.55);
                }
                if !root.fav-save-multi : fav-save-alias-edit := EditLineEdit {
                    text <=> root.fav-save-alias;
                }
                // Target container.
                Text {
                    text: root.strings.fav-popup-container;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 0.3px;
                    color: Theme.foreground.with-alpha(0.55);
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    ComboBox {
                        model: root.fav-container-labels;
                        current-index <=> root.fav-container-index;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: root.strings.fav-popup-new;
                        clicked => {
                            // Opens the creation sub-popup (name + parent container).
                            root.fav-newc-name = root.strings.fav-new-container;
                            root.fav-newc-parent-index = root.fav-container-index;
                            root.fav-newc-open = true;
                            root.fav-newc-focus-armed = true;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.strings.btn-cancel;
                        clicked => { root.fav-save-open = false; }
                    }
                    Button {
                        text: root.strings.fav-save;
                        primary: true;
                        enabled: root.fav-save-multi || root.fav-save-alias != "";
                        clicked => {
                            root.fav-save-commit(root.fav-save-alias, root.fav-container-index);
                            root.fav-save-open = false;
                        }
                    }
                }
            }
        }

        // ===== "New container" sub-popup (from the save flow) =====
        if root.fav-newc-open : ModalBackdrop { }
        if root.fav-newc-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            height: 210px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;
            Timer {
                interval: 1ms;
                running: root.fav-newc-focus-armed;
                triggered => {
                    fav-newc-edit.focus();
                    fav-newc-edit.set-selection-offsets(0, 99999);
                    root.fav-newc-focus-armed = false;
                }
            }
            VerticalBox {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: root.strings.fav-new-container;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                fav-newc-edit := EditLineEdit {
                    text <=> root.fav-newc-name;
                    accepted(t) => {
                        if (t != "") {
                            root.fav-save-new-container(t, root.fav-newc-parent-index);
                            root.fav-newc-open = false;
                        }
                    }
                }
                Text {
                    text: root.strings.fav-popup-parent;
                    font-size: 10px;
                    font-weight: 600;
                    letter-spacing: 0.3px;
                    color: Theme.foreground.with-alpha(0.55);
                }
                ComboBox {
                    model: root.fav-container-labels;
                    current-index <=> root.fav-newc-parent-index;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.strings.btn-cancel;
                        clicked => { root.fav-newc-open = false; }
                    }
                    Button {
                        text: root.strings.fav-save;
                        primary: true;
                        enabled: root.fav-newc-name != "";
                        clicked => {
                            root.fav-save-new-container(root.fav-newc-name, root.fav-newc-parent-index);
                            root.fav-newc-open = false;
                        }
                    }
                }
            }
        }

        // ===== Columns menu (right-click on a header) =====
        // Lists ALL columns (check/uncheck). "name" (anchor) greyed out.
        if root.columns-menu-open : Rectangle {
            property <[ColumnInfo]> cols: root.panels[root.columns-menu-panel].columns-menu;
            x: min(root.columns-menu-x, root.width - self.width - 8px);
            y: min(root.columns-menu-y, root.height - self.height - 8px);
            width: 210px;
            // height = grouping section (label 22 + 3x30 + separator 9 = 121)
            //          + columns (nx30) + padding (8)
            // grouping (121) + columns (nx30) + ext filter (separator 9 + 30) + padding 8
            height: self.cols.length * 30px + 168px;
            background: Theme.surface;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                // "Grouping" section: 3 exclusive modes -----
                // Marks (check.svg) the active mode; orthogonal to column
                // sorting (which remains driven by clicking the header).
                Text {
                    text: root.strings.group-section;
                    font-size: 10px;
                    color: Theme.foreground.with-alpha(0.5);
                    height: 22px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
                for gopt[gi] in [
                    { code: "folders", label: root.strings.group-folders-first },
                    { code: "files", label: root.strings.group-files-first },
                    { code: "mixed", label: root.strings.group-mixed },
                ] : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: gitem.has-hover ? Theme.alternate-background : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 9px;
                        // Radio mark (check.svg if active), full-height slot.
                        Rectangle {
                            width: 16px;
                            height: parent.height;
                            if gopt.code == root.panels[root.columns-menu-panel].group-mode : Image {
                                source: @image-url("../../assets/icons/check.svg");
                                width: 12px;
                                height: 12px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: Theme.accent-background;
                            }
                        }
                        Text {
                            text: gopt.label;
                            font-size: 12px;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    gitem := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.set-group-mode(root.columns-menu-panel, gopt.code);
                            root.columns-menu-open = false;
                        }
                    }
                }
                // Separator between grouping and column visibility.
                Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Theme.border;
                    }
                }
                for col[ci] in parent.cols : Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    opacity: col.id == "name" ? 0.5 : 1.0;   // anchor, not uncheckable
                    background: citem.has-hover && col.id != "name"
                        ? Theme.alternate-background
                        : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 9px;
                        // Checkbox (full-height slot → vertical centering).
                        Rectangle {
                            width: 16px;
                            height: parent.height;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: col.visible ? Theme.accent-background : Theme.border;
                                background: col.visible ? Theme.accent-background : transparent;
                                if col.visible : Image {
                                    source: @image-url("../../assets/icons/check.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: Theme.accent-foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: col.label;
                            font-size: 12px;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    citem := TouchArea {
                        mouse-cursor: col.id == "name" ? default : pointer;
                        clicked => {
                            if (col.id != "name") {
                                root.column-toggle(root.columns-menu-panel, col.id, !col.visible);
                            }
                        }
                    }
                }
                // Separator before the extension filter option.
                Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Theme.border;
                    }
                }
                // "Filter by extension" option: checkable, unchecked by default.
                // Shows/hides the panel's input bar; closes the menu to
                // let the field take focus.
                Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: xfitem.has-hover ? Theme.alternate-background : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 9px;
                        Rectangle {
                            width: 16px;
                            height: parent.height;
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.panels[root.columns-menu-panel].ext-filter-on
                                    ? Theme.accent-background : Theme.border;
                                background: root.panels[root.columns-menu-panel].ext-filter-on
                                    ? Theme.accent-background : transparent;
                                if root.panels[root.columns-menu-panel].ext-filter-on : Image {
                                    source: @image-url("../../assets/icons/check.svg");
                                    width: 10px;
                                    height: 10px;
                                    colorize: Theme.accent-foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Text {
                            text: root.strings.ext-filter-label;
                            font-size: 12px;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    xfitem := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.ext-filter-toggle(root.columns-menu-panel);
                            root.columns-menu-open = false;
                            // Immediate keyboard focus → direct input with no click,
                            // like the type-ahead filter (no caret).
                            key-scope.focus();
                        }
                    }
                }
            }
        }

        // ===== Cross-view drag'n'drop drop menu =====
        // Move / Copy / Link here. Opened on release over another view.
        if root.file-drop-menu-open : Rectangle {
            x: min(root.file-drop-menu-x, root.width - self.width - 8px);
            y: min(root.file-drop-menu-y, root.height - self.height - 8px);
            width: 200px;
            height: 94px;
            background: Theme.surface;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                MenuItem {
                    label: root.strings.drop-move;
                    clicked => { root.file-drop-menu-open = false; root.file-drop-action(0); }
                }
                MenuItem {
                    label: root.strings.drop-copy;
                    clicked => { root.file-drop-menu-open = false; root.file-drop-action(1); }
                }
                MenuItem {
                    label: root.strings.drop-link;
                    clicked => { root.file-drop-menu-open = false; root.file-drop-action(2); }
                }
            }
        }

        // ===== Settings panel =====
        // Same here: the backdrop only absorbs clicks, doesn't close it. Escape or X.
        if root.settings-open : ModalBackdrop { }
        if root.settings-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 560px;
            // 480 → 620: less scrolling to reach the bottom of the tabs
            // (long General, "Open with"). Bounded to the window to stay
            // visible on small screens.
            height: min(620px, parent.height - 40px);
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // Header
                Rectangle {
                    height: 50px;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 12px;
                        Text {
                            text: root.strings.settings-title;
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        // Ranger's version (discreet, to the right of the title).
                        Text {
                            text: "v" + root.app-version;
                            font-size: 12px;
                            color: Theme.foreground.with-alpha(0.45);
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                        Rectangle { width: 10px; }
                        // "X" button (subtle red)
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            background: close-settings-touch.has-hover ? Tokens.danger.with-alpha(0.27) : Tokens.danger.with-alpha(0.13);
                            border-width: 1px;
                            border-color: Tokens.danger.with-alpha(0.4);
                            Image {
                                source: @image-url("../../assets/icons/close.svg");
                                width: 14px;
                                height: 14px;
                                colorize: close-settings-touch.has-hover ? Tokens.danger : Theme.foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            close-settings-touch := TouchArea {
                                clicked => { root.settings-open = false; }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // Tab bar: General | Shortcuts. The shortcuts page is
                // separate so there's no need to scroll through all of "General" anymore.
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 4px;
                    // -- "General" tab --
                    Rectangle {
                        height: 30px;
                        width: gen-tab-txt.preferred-width + 26px;
                        border-radius: 6px;
                        background: root.settings-tab == 0 ? Theme.accent-background.with-alpha(0.14)
                            : (gen-tab-touch.has-hover ? Theme.alternate-background : transparent);
                        gen-tab-txt := Text {
                            text: root.strings.settings-tab-general;
                            x: (parent.width - self.width) / 2;
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: 12.5px;
                            font-weight: root.settings-tab == 0 ? 700 : 500;
                            color: root.settings-tab == 0 ? Theme.accent-background : Theme.foreground.with-alpha(0.75);
                        }
                        gen-tab-touch := TouchArea { clicked => { root.settings-tab = 0; } }
                    }
                    // -- "Shortcuts" tab --
                    Rectangle {
                        height: 30px;
                        width: sc-tab-txt.preferred-width + 26px;
                        border-radius: 6px;
                        background: root.settings-tab == 1 ? Theme.accent-background.with-alpha(0.14)
                            : (sc-tab-touch.has-hover ? Theme.alternate-background : transparent);
                        sc-tab-txt := Text {
                            text: root.strings.settings-shortcuts-section;
                            x: (parent.width - self.width) / 2;
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: 12.5px;
                            font-weight: root.settings-tab == 1 ? 700 : 500;
                            color: root.settings-tab == 1 ? Theme.accent-background : Theme.foreground.with-alpha(0.75);
                        }
                        sc-tab-touch := TouchArea { clicked => { root.settings-tab = 1; } }
                    }
                    // "Open with" tab --
                    Rectangle {
                        height: 30px;
                        width: ow-tab-txt.preferred-width + 26px;
                        border-radius: 6px;
                        background: root.settings-tab == 2 ? Theme.accent-background.with-alpha(0.14)
                            : (ow-tab-touch.has-hover ? Theme.alternate-background : transparent);
                        ow-tab-txt := Text {
                            text: root.strings.settings-openers-section;
                            x: (parent.width - self.width) / 2;
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: 12.5px;
                            font-weight: root.settings-tab == 2 ? 700 : 500;
                            color: root.settings-tab == 2 ? Theme.accent-background : Theme.foreground.with-alpha(0.75);
                        }
                        ow-tab-touch := TouchArea { clicked => { root.settings-tab = 2; } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // Scrollable content — GENERAL tab
                if root.settings-tab == 0 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 18px;

                        // -- Language selector (compact 32px row) --
                        Rectangle {
                            height: 32px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.strings.settings-language;
                                    // min-width (instead of a fixed width): the label
                                    // widens if a language is long (the ComboBox
                                    // absorbs it), instead of truncating the text at 150%.
                                    min-width: 160px;
                                    vertical-alignment: center;
                                    color: Theme.foreground;
                                    font-size: 13px;
                                }
                                settings-lang := ComboBox {
                                    model: root.language-labels;
                                    current-index <=> root.language-index;
                                    horizontal-stretch: 1;
                                    selected(_) => { root.language-changed(settings-lang.current-index); }
                                }
                            }
                        }

                        // -- Theme selector --
                        Rectangle {
                            height: 32px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.strings.settings-theme;
                                    // min-width (instead of a fixed width): the label
                                    // widens if a language is long (the ComboBox
                                    // absorbs it), instead of truncating the text at 150%.
                                    min-width: 160px;
                                    vertical-alignment: center;
                                    color: Theme.foreground;
                                    font-size: 13px;
                                }
                                settings-theme := ComboBox {
                                    model: root.theme-labels;
                                    current-index <=> root.theme-pref;
                                    horizontal-stretch: 1;
                                    selected(_) => { root.theme-changed(settings-theme.current-index); }
                                }
                            }
                        }

                        // -- Interface zoom (factor x screen scale) --
                        Rectangle {
                            height: 32px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.strings.settings-ui-scale;
                                    min-width: 160px;
                                    vertical-alignment: center;
                                    color: Theme.foreground;
                                    font-size: 13px;
                                }
                                settings-ui-scale := ComboBox {
                                    model: root.ui-scale-labels;
                                    current-index <=> root.ui-scale-index;
                                    horizontal-stretch: 1;
                                    selected(_) => { root.ui-scale-changed(settings-ui-scale.current-index); }
                                }
                            }
                        }

                        // DEFAULT tab bar position (new "from
                        // scratch" views; existing views keep
                        // their per-view setting).
                        Rectangle {
                            height: 32px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.strings.settings-tabbar-default;
                                    // min-width (instead of a fixed width): the label
                                    // widens if a language is long (the ComboBox
                                    // absorbs it), instead of truncating the text at 150%.
                                    min-width: 160px;
                                    vertical-alignment: center;
                                    color: Theme.foreground;
                                    font-size: 13px;
                                }
                                settings-tabbar := ComboBox {
                                    model: root.tabbar-default-labels;
                                    current-index <=> root.tabbar-default-pref;
                                    horizontal-stretch: 1;
                                    selected(_) => { root.tabbar-default-changed(settings-tabbar.current-index); }
                                }
                            }
                        }

                        // Timezone of the "Modified" column: local time
                        // (default) or UTC.
                        Rectangle {
                            height: 32px;
                            HorizontalLayout {
                                spacing: 12px;
                                Text {
                                    text: root.strings.settings-clock-label;
                                    // min-width (instead of a fixed width): the label
                                    // widens if a language is long (the ComboBox
                                    // absorbs it), instead of truncating the text at 150%.
                                    min-width: 160px;
                                    vertical-alignment: center;
                                    color: Theme.foreground;
                                    font-size: 13px;
                                }
                                settings-clock := ComboBox {
                                    model: [root.strings.settings-clock-local, "UTC"];
                                    current-index <=> root.clock-utc-pref;
                                    horizontal-stretch: 1;
                                    selected(_) => { root.clock-mode-changed(settings-clock.current-index); }
                                }
                            }
                        }

                        // "Full path" tooltip on tab hover —
                        // opt-in, unchecked by default.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: root.strings.settings-tab-tooltip-label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: root.strings.settings-tab-tooltip-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    CheckBox {
                                        checked <=> root.tab-tooltip-enabled;
                                        toggled => { root.tab-tooltip-changed(self.checked); }
                                    }
                                }
                            }
                        }

                        // Hybrid Preview mode: previewable content
                        // keeps the chosen zoom, plain icons stay at
                        // normal height. Enabled by default.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: root.strings.settings-compact-preview-label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: root.strings.settings-compact-preview-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    CheckBox {
                                        checked <=> root.compact-preview-rows-enabled;
                                        toggled => { root.compact-preview-rows-changed(self.checked); }
                                    }
                                }
                            }
                        }

                        // "Video thumbnails (ffmpeg)" section — LINUX only.
                        // Discreet when ffmpeg is present; guides toward installation
                        // (command per distro, detected one highlighted) otherwise.
                        if !root.platform-windows : Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                // Header: title+hint (stretch) · badge · recheck.
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: root.strings.settings-ffmpeg-title;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: root.ffmpeg-found
                                                ? root.strings.settings-ffmpeg-hint-ok
                                                : root.strings.settings-ffmpeg-hint-missing;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    // Status badge: green (found) / amber (missing).
                                    // Amber, not red: ffmpeg is an optional convenience,
                                    // not a destructive error.
                                    status-badge := Rectangle {
                                        property <color> tone: root.ffmpeg-found ? Tokens.success : Tokens.warning;
                                        height: 22px;
                                        vertical-stretch: 0;
                                        border-radius: 11px;
                                        background: status-badge.tone.with-alpha(0.15);
                                        HorizontalLayout {
                                            padding-left: 9px;
                                            padding-right: 9px;
                                            spacing: 5px;
                                            Image {
                                                width: 12px;
                                                height: 12px;
                                                y: (parent.height - self.height) / 2;
                                                source: root.ffmpeg-found
                                                    ? @image-url("../../assets/icons/check.svg")
                                                    : @image-url("../../assets/icons/alert-triangle.svg");
                                                colorize: status-badge.tone;
                                            }
                                            Text {
                                                text: root.ffmpeg-found
                                                    ? (root.ffmpeg-version == "" ? "ffmpeg" : "ffmpeg " + root.ffmpeg-version)
                                                    : root.strings.settings-ffmpeg-missing-badge;
                                                font-size: 12px;
                                                font-weight: 600;
                                                color: status-badge.tone;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    // "Recheck" button.
                                    Rectangle {
                                        height: 28px;
                                        vertical-stretch: 0;
                                        border-radius: 6px;
                                        border-width: 1px;
                                        border-color: recheck-touch.has-hover ? Theme.accent-background : Theme.border;
                                        background: recheck-touch.has-hover ? Theme.alternate-background : transparent;
                                        HorizontalLayout {
                                            padding-left: 9px;
                                            padding-right: 10px;
                                            spacing: 6px;
                                            Image {
                                                width: 13px;
                                                height: 13px;
                                                y: (parent.height - self.height) / 2;
                                                source: @image-url("../../assets/icons/refresh.svg");
                                                colorize: Theme.foreground.with-alpha(0.7);
                                            }
                                            Text {
                                                text: root.strings.settings-ffmpeg-recheck;
                                                font-size: 12px;
                                                color: Theme.foreground;
                                                vertical-alignment: center;
                                            }
                                        }
                                        recheck-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.ffmpeg-recheck(); }
                                        }
                                    }
                                }
                                // "Missing" body: honest Flatpak message OR the
                                // per-distribution install commands.
                                if !root.ffmpeg-found && root.ffmpeg-flatpak : Text {
                                    text: root.strings.settings-ffmpeg-flatpak;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.55);
                                    wrap: word-wrap;
                                }
                                if !root.ffmpeg-found && !root.ffmpeg-flatpak : Rectangle {
                                    // "Inset" field (more recessed than the card).
                                    background: Theme.background;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Tokens.hairline;
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 4px;
                                        FfmpegCmdRow {
                                            distro: "Debian/Ubuntu";
                                            command: "sudo apt install ffmpeg";
                                            promoted: root.ffmpeg-detected-index == 0;
                                            detected-label: root.strings.settings-ffmpeg-detected;
                                            copy(t) => { root.settings-copy(t); }
                                        }
                                        FfmpegCmdRow {
                                            distro: "Fedora";
                                            command: "sudo dnf install ffmpeg-free";
                                            promoted: root.ffmpeg-detected-index == 1;
                                            detected-label: root.strings.settings-ffmpeg-detected;
                                            copy(t) => { root.settings-copy(t); }
                                        }
                                        FfmpegCmdRow {
                                            distro: "Arch/Manjaro";
                                            command: "sudo pacman -S ffmpeg";
                                            promoted: root.ffmpeg-detected-index == 2;
                                            detected-label: root.strings.settings-ffmpeg-detected;
                                            copy(t) => { root.settings-copy(t); }
                                        }
                                        FfmpegCmdRow {
                                            distro: "Alpine";
                                            command: "sudo apk add ffmpeg";
                                            promoted: root.ffmpeg-detected-index == 3;
                                            detected-label: root.strings.settings-ffmpeg-detected;
                                            copy(t) => { root.settings-copy(t); }
                                        }
                                    }
                                }
                            }
                        }

                        // "Unsaved changes" guard before loading
                        // another workspace — checked by default;
                        // uncheckable by an advanced user.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: root.strings.settings-ws-warn-label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: root.strings.settings-ws-warn-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    CheckBox {
                                        checked <=> root.ws-warn-unsaved;
                                        toggled => { root.ws-warn-unsaved-changed(self.checked); }
                                    }
                                }
                            }
                        }

                        // "Folder modification date" section. The label
                        // on the card below also serves as the section header.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: root.strings.settings-rmtime-label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: root.strings.settings-rmtime-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    SpinBox {
                                        width: 96px;
                                        minimum: 0;
                                        maximum: 8;
                                        value <=> root.rmtime-depth;
                                        edited(v) => { root.rmtime-depth-changed(v); }
                                    }
                                }
                            }
                        }

                        // "Folder size" section. Same design as the modification
                        // date above; on the Rust side both share ONE walk.
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: root.strings.settings-fsize-label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: root.strings.settings-fsize-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    SpinBox {
                                        width: 96px;
                                        minimum: 0;
                                        maximum: 8;
                                        value <=> root.size-depth;
                                        edited(v) => { root.size-depth-changed(v); }
                                    }
                                }
                            }
                        }

                        // "Default columns" section --
                        Text {
                            text: root.strings.settings-columns-section;
                            font-weight: 600;
                            font-size: 11px;
                            color: Theme.foreground.with-alpha(0.6);
                            letter-spacing: 0.5px;
                        }
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 0px;
                                for col[ci] in root.settings-columns : Rectangle {
                                    height: 32px;
                                    border-radius: 5px;
                                    opacity: col.id == "name" ? 0.5 : 1.0;
                                    background: scol-touch.has-hover && col.id != "name"
                                        ? Theme.alternate-background
                                        : transparent;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 10px;
                                        spacing: 10px;
                                        Rectangle {
                                            width: 16px;
                                            height: parent.height;
                                            Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: col.visible ? Theme.accent-background : Theme.border;
                                                background: col.visible ? Theme.accent-background : transparent;
                                                if col.visible : Image {
                                                    source: @image-url("../../assets/icons/check.svg");
                                                    width: 10px;
                                                    height: 10px;
                                                    colorize: Theme.accent-foreground;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        Text {
                                            text: col.label;
                                            font-size: 13px;
                                            color: Theme.foreground;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    scol-touch := TouchArea {
                                        mouse-cursor: col.id == "name" ? default : pointer;
                                        clicked => {
                                            if (col.id != "name") {
                                                root.default-column-toggle(col.id, !col.visible);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // -- "Storage locations" section --
                        Text {
                            text: root.strings.settings-paths-section;
                            font-weight: 600;
                            font-size: 11px;
                            color: Theme.foreground.with-alpha(0.6);
                            // "Section header" style: uppercase + letter-spacing
                            // (visual effect reminiscent of Apple Preferences / GNOME Settings).
                            letter-spacing: 0.5px;
                        }
                        // -- Card grouping the 3 XDG paths --
                        Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 12px;
                                if !root.config-path-redundant : PathRow {
                                    label: root.strings.settings-config-path;
                                    value: root.config-dir-path;
                                    open-text: root.strings.settings-open;
                                    open-clicked => { root.open-config-dir(); }
                                }
                                if !root.config-path-redundant : Rectangle { height: 1px; background: Theme.border; }
                                PathRow {
                                    label: root.strings.settings-data-path;
                                    value: root.data-dir-path;
                                    open-text: root.strings.settings-open;
                                    open-clicked => { root.open-data-dir(); }
                                }
                                Rectangle { height: 1px; background: Theme.border; }
                                PathRow {
                                    label: root.strings.settings-cache-path;
                                    value: root.cache-dir-path;
                                    open-text: root.strings.settings-open;
                                    open-clicked => { root.open-cache-dir(); }
                                }
                            }
                        }

                    }
                } // <- end of the GENERAL tab (closes VerticalLayout + ScrollView)

                // Scrollable content of the Shortcuts tab.
                if root.settings-tab == 1 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 18px;
                        sc-box := VerticalLayout {
                            spacing: 10px;
                            property <bool> reset-all-armed: false;

                            // Header: search + reset all
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    height: 32px;
                                    horizontal-stretch: 1;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        Image {
                                            width: 14px;
                                            height: 14px;
                                            y: (parent.height - self.height) / 2;
                                            source: @image-url("../../assets/icons/search.svg");
                                            colorize: Theme.foreground.with-alpha(0.5);
                                        }
                                        sc-search := EditLineEdit {
                                            placeholder-text: root.strings.shortcut-search-placeholder;
                                            horizontal-stretch: 1;
                                            text <=> root.shortcut-search-text;
                                            edited(t) => { root.shortcut-search(t); }
                                        }
                                        if root.shortcut-search-text != "" : Rectangle {
                                            width: 18px;
                                            Image {
                                                width: 12px;
                                                height: 12px;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                source: @image-url("../../assets/icons/close.svg");
                                                colorize: Theme.foreground.with-alpha(0.6);
                                            }
                                            TouchArea {
                                                clicked => { root.shortcut-search-text = ""; root.shortcut-search(""); }
                                            }
                                        }
                                    }
                                }
                                if root.shortcut-has-overrides : Rectangle {
                                    height: 32px;
                                    width: rall-text.preferred-width + 24px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: rall-touch.has-hover ? Theme.accent-background : Theme.border;
                                    background: rall-touch.has-hover ? Theme.alternate-background : transparent;
                                    rall-text := Text {
                                        text: sc-box.reset-all-armed
                                            ? root.strings.shortcut-reset-all-confirm
                                            : root.strings.shortcut-reset-all;
                                        font-size: 12px;
                                        color: sc-box.reset-all-armed ? Tokens.danger : Theme.foreground;
                                        x: (parent.width - self.width) / 2;
                                        vertical-alignment: center;
                                    }
                                    rall-touch := TouchArea {
                                        clicked => {
                                            if (sc-box.reset-all-armed) {
                                                root.shortcut-reset-all();
                                                sc-box.reset-all-armed = false;
                                            } else {
                                                sc-box.reset-all-armed = true;
                                            }
                                        }
                                    }
                                }
                            }

                            // Grouped list
                            for grp[gi] in root.shortcut-groups : VerticalLayout {
                                spacing: 0px;
                                Text {
                                    text: grp.name;
                                    font-weight: 600;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.5);
                                    letter-spacing: 0.5px;
                                    height: 28px;
                                    vertical-alignment: bottom;
                                }
                                Rectangle {
                                    background: Theme.alternate-background.with-alpha(0.5);
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 0px;
                                        for row[ri] in grp.rows : VerticalLayout {
                                            spacing: 0px;
                                            // Main row
                                            Rectangle {
                                                height: 36px;
                                                border-radius: 5px;
                                                background: row-hover.has-hover ? Theme.alternate-background : transparent;
                                                row-hover := TouchArea {
                                                    pointer-event(ev) => {
                                                        if (ev.kind == PointerEventKind.down
                                                                && ev.button == PointerEventButton.right) {
                                                            root.open-shortcut-menu(row.action-id,
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y);
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: row.name;
                                                        font-size: 13px;
                                                        color: Theme.foreground;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }
                                                    if row.overridden : Rectangle {
                                                        width: 22px;
                                                        Image {
                                                            width: 13px;
                                                            height: 13px;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            source: @image-url("../../assets/icons/refresh.svg");
                                                            colorize: rst-touch.has-hover ? Theme.accent-background : Theme.foreground.with-alpha(0.55);
                                                        }
                                                        rst-touch := TouchArea {
                                                            clicked => { root.shortcut-reset(row.action-id); }
                                                        }
                                                    }
                                                    // Clickable cluster: capture pill / caps / unassigned
                                                    Rectangle {
                                                        width: sc-cluster.preferred-width;
                                                        sc-cluster := HorizontalLayout {
                                                            spacing: 3px;
                                                            if root.shortcut-capturing == row.action-id : Rectangle {
                                                                height: 24px;
                                                                width: 168px;
                                                                y: (parent.height - self.height) / 2;
                                                                border-radius: 6px;
                                                                border-width: 1px;
                                                                border-color: Theme.accent-background;
                                                                background: Theme.accent-background.with-alpha(0.10);
                                                                Text {
                                                                    text: root.strings.shortcut-listening;
                                                                    font-size: 11px;
                                                                    color: Theme.accent-background;
                                                                    x: (parent.width - self.width) / 2;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                            if root.shortcut-capturing != row.action-id && row.assigned : HorizontalLayout {
                                                                spacing: 3px;
                                                                for cap[ci] in row.caps : HorizontalLayout {
                                                                    spacing: 3px;
                                                                    if ci > 0 : Text {
                                                                        text: "+";
                                                                        font-size: 11px;
                                                                        color: Theme.foreground.with-alpha(0.45);
                                                                        vertical-alignment: center;
                                                                    }
                                                                    Rectangle {
                                                                        height: 22px;
                                                                        width: cap.kind == 0 ? max(24px, cap-lbl.preferred-width + 14px) : 24px;
                                                                        y: (parent.height - self.height) / 2;
                                                                        border-radius: 5px;
                                                                        border-width: 1px;
                                                                        border-color: Theme.border;
                                                                        background: Theme.surface;
                                                                        cap-lbl := Text {
                                                                            visible: cap.kind == 0;
                                                                            text: cap.label;
                                                                            font-size: 11px;
                                                                            font-weight: 600;
                                                                            color: Theme.foreground;
                                                                            x: (parent.width - self.width) / 2;
                                                                            vertical-alignment: center;
                                                                        }
                                                                        if cap.kind != 0 : Image {
                                                                            width: 11px;
                                                                            height: 11px;
                                                                            x: (parent.width - self.width) / 2;
                                                                            y: (parent.height - self.height) / 2;
                                                                            colorize: Theme.foreground;
                                                                            source: cap.kind == 1 ? @image-url("../../assets/icons/arrow-up.svg")
                                                                                : cap.kind == 2 ? @image-url("../../assets/icons/arrow-down.svg")
                                                                                : cap.kind == 3 ? @image-url("../../assets/icons/chevron-left.svg")
                                                                                : @image-url("../../assets/icons/chevron-right.svg");
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            if root.shortcut-capturing != row.action-id && !row.assigned : Text {
                                                                text: root.strings.shortcut-unassigned;
                                                                font-size: 11px;
                                                                font-italic: true;
                                                                color: Theme.foreground.with-alpha(0.4);
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.shortcut-capturing = row.action-id;
                                                                key-scope.focus();
                                                            }
                                                            pointer-event(ev) => {
                                                                if (ev.kind == PointerEventKind.down
                                                                        && ev.button == PointerEventButton.right) {
                                                                    root.open-shortcut-menu(row.action-id,
                                                                        self.absolute-position.x + self.mouse-x,
                                                                        self.absolute-position.y + self.mouse-y);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            // Conflict band
                                            if row.action-id == root.shortcut-conflict-action : Rectangle {
                                                height: 32px;
                                                border-radius: 6px;
                                                background: Tokens.danger.with-alpha(0.12);
                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 8px;
                                                    spacing: 8px;
                                                    Text {
                                                        text: root.shortcut-conflict-message;
                                                        font-size: 11px;
                                                        color: Tokens.danger;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }
                                                    Rectangle {
                                                        width: ra-text.preferred-width + 18px;
                                                        height: 24px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 5px;
                                                        border-width: 1px;
                                                        border-color: Theme.accent-background;
                                                        background: ra-touch.has-hover ? Theme.accent-background.with-alpha(0.12) : transparent;
                                                        ra-text := Text {
                                                            text: root.strings.shortcut-conflict-reassign;
                                                            font-size: 11px;
                                                            color: Theme.accent-background;
                                                            x: (parent.width - self.width) / 2;
                                                            vertical-alignment: center;
                                                        }
                                                        ra-touch := TouchArea { clicked => { root.shortcut-resolve-conflict(true); } }
                                                    }
                                                    Rectangle {
                                                        width: rk-text.preferred-width + 18px;
                                                        height: 24px;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: 5px;
                                                        border-width: 1px;
                                                        border-color: Theme.border;
                                                        background: rk-touch.has-hover ? Theme.alternate-background : transparent;
                                                        rk-text := Text {
                                                            text: root.strings.shortcut-conflict-keep;
                                                            font-size: 11px;
                                                            color: Theme.foreground;
                                                            x: (parent.width - self.width) / 2;
                                                            vertical-alignment: center;
                                                        }
                                                        rk-touch := TouchArea { clicked => { root.shortcut-resolve-conflict(false); } }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.shortcut-groups.length == 0 : Text {
                                text: root.strings.shortcut-no-results;
                                color: Theme.foreground.with-alpha(0.5);
                                font-size: 12px;
                                height: 40px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // Scrollable content — OPEN WITH tab
                if root.settings-tab == 2 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;
                        // "Open with" and "Detected Windows entries" sub-tabs.
                        // The segmented style follows the shortcut popup's. A
                        // fixed height keeps the buttons from occupying the free space
                        // when the content is empty.
                        if root.platform-windows : HorizontalBox {
                            height: 32px;
                            padding: 0px;
                            spacing: 6px;
                            Button {
                                text: root.strings.settings-openers-section;
                                primary: root.ow-subtab == 0;
                                clicked => { root.ow-subtab = 0; }
                            }
                            Button {
                                text: root.strings.settings-shellext-list-label;
                                primary: root.ow-subtab == 1;
                                clicked => { root.ow-subtab = 1; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.ow-subtab == 0 : HorizontalLayout {
                            height: 32px;
                            spacing: 8px;
                            Rectangle {
                                height: 32px;
                                horizontal-stretch: 1;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 6px;
                                    spacing: 6px;
                                    Image {
                                        width: 14px;
                                        height: 14px;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("../../assets/icons/search.svg");
                                        colorize: Theme.foreground.with-alpha(0.5);
                                    }
                                    ow-search := EditLineEdit {
                                        placeholder-text: root.strings.ow-search-placeholder;
                                        horizontal-stretch: 1;
                                        text <=> root.opener-search-text;
                                        edited(t) => { root.opener-search(t); }
                                    }
                                    if root.opener-search-text != "" : Rectangle {
                                        width: 18px;
                                        Image {
                                            width: 12px;
                                            height: 12px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: @image-url("../../assets/icons/close.svg");
                                            colorize: Theme.foreground.with-alpha(0.6);
                                        }
                                        TouchArea {
                                            clicked => {
                                                root.opener-search-text = "";
                                                root.opener-search("");
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                width: owadd-txt.preferred-width + 22px;
                                height: 32px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: owadd-ta.has-hover ? Theme.accent-background : Theme.border;
                                background: owadd-ta.has-hover ? Theme.alternate-background : transparent;
                                owadd-txt := Text { text: root.strings.ow-add; font-size: 12px; color: Theme.foreground; x: (parent.width - self.width)/2; vertical-alignment: center; height: parent.height; }
                                owadd-ta := TouchArea { clicked => { root.ow-add(); } }
                            }
                        }
                        // Ready-made archiving/sharing commands, on their own
                        // block under the search row. Wrapped over two rows so
                        // the menu never scrolls sideways — even in the longer
                        // languages or when every tool is installed. The label
                        // keeps a fixed height so its box cannot grow with the
                        // platform font's line spacing (which left a gap above
                        // the buttons on Linux).
                        // Ready-made commands, collapsed by default. The
                        // whole header line toggles it, on the model of the
                        // sidebar section headers.
                        // Shown even with nothing detected: the block is how
                        // one learns the recipes exist at all, and that
                        // installing an archiver makes them appear.
                        if root.ow-subtab == 0 : VerticalLayout {
                            spacing: 6px;
                            Rectangle {
                                // Fixed height: a bare Text grew with the system
                                // line spacing and left a gap on Linux.
                                height: 26px;
                                border-radius: 5px;
                                background: rcp-hdr.has-hover ? Theme.alternate-background : transparent;
                                accessible-role: button;
                                accessible-label: root.strings.ow-recipes-label;
                                accessible-action-default => { root.ow-recipes-open = !root.ow-recipes-open; }
                                rcp-hdr := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.ow-recipes-open = !root.ow-recipes-open; }
                                }
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    // Fixed slot: the two chevrons differ in
                                    // width, and the label would shift on toggle.
                                    Rectangle {
                                        width: 12px;
                                        Image {
                                            width: 10px;
                                            height: 10px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            source: root.ow-recipes-open
                                                ? @image-url("../../assets/icons/chevron-down.svg")
                                                : @image-url("../../assets/icons/chevron-right.svg");
                                            colorize: Theme.foreground.with-alpha(rcp-hdr.has-hover ? 0.75 : 0.45);
                                        }
                                    }
                                    Text {
                                        text: root.strings.ow-recipes-label;
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: Theme.foreground.with-alpha(rcp-hdr.has-hover ? 0.8 : 0.55);
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    // Collapsed, this count is the only thing
                                    // saying the section holds anything.
                                    Text {
                                        text: "(" + (root.ow-recipes-col1.length + root.ow-recipes-col2.length) + ")";
                                        font-size: 11px;
                                        color: Theme.foreground.with-alpha(0.4);
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                            if root.ow-recipes-open : VerticalLayout {
                                padding-left: 18px;
                                spacing: 6px;
                                Text {
                                    text: root.strings.ow-recipes-hint;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.55);
                                    wrap: word-wrap;
                                }
                                if root.ow-recipes-missing != "" : Text {
                                    text: root.ow-recipes-missing;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.4);
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        for r in root.ow-recipes-col1 : OwRecipeButton {
                                            recipe: r;
                                            activate => { root.ow-recipe-add(r.index); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 3px;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        for r in root.ow-recipes-col2 : OwRecipeButton {
                                            recipe: r;
                                            activate => { root.ow-recipe-add(r.index); }
                                        }
                                    }
                                }
                            }
                        }
                        if root.ow-subtab == 0 : Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                if root.openers-all.length == 0 : Text {
                                    text: root.opener-search-text == ""
                                        ? root.strings.ow-empty
                                        : root.strings.ow-no-results;
                                    font-size: 12px;
                                    color: Theme.foreground.with-alpha(0.45);
                                    height: 30px;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                                for op[oi] in root.openers-all : Rectangle {
                                    height: 32px;
                                    border-radius: 5px;
                                    background: oprow.has-hover ? Theme.alternate-background : transparent;
                                    oprow := TouchArea { }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 4px;
                                        spacing: 6px;
                                        CommandIcon {
                                            kind: op.icon-kind;
                                            extracted: op.icon;
                                            available: op.available;
                                        }
                                        Text {
                                            text: op.label;
                                            font-size: 13px;
                                            color: op.available ? Theme.foreground : Theme.foreground.with-alpha(0.45);
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        SidebarHeaderAction { icon: @image-url("../../assets/icons/chevron-up.svg"); tooltip: root.strings.ow-move-up; clicked => { root.ow-move(op.id, -1); } }
                                        SidebarHeaderAction { icon: @image-url("../../assets/icons/chevron-down.svg"); tooltip: root.strings.ow-move-down; clicked => { root.ow-move(op.id, 1); } }
                                        SidebarHeaderAction { icon: @image-url("../../assets/icons/duplicate.svg"); tooltip: root.strings.ow-duplicate-tip; clicked => { root.ow-duplicate(op.id); } }
                                        SidebarHeaderAction { icon: @image-url("../../assets/icons/pencil.svg"); tooltip: root.strings.ow-edit-tip; clicked => { root.ow-edit(op.id); } }
                                        SidebarHeaderAction { icon: @image-url("../../assets/icons/trash.svg"); tooltip: root.strings.ow-delete-tip; clicked => { root.ow-delete(op.id); } }
                                    }
                                }
                            }
                        }

                        // ===== Detected Windows entries (shell extensions) =====
                        // Dedicated sub-tab. List built at LAUNCH
                        // (completed as right-clicks happen); unchecking hides
                        // the entry from the context menu.
                        // Global toggle for the Windows context menu —
                        // moved here from the General tab: everything
                        // related to shell extensions lives in this sub-tab.
                        if root.platform-windows && root.ow-subtab == 1 : Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 12px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 3px;
                                        Text {
                                            text: root.strings.settings-shellmenu-label;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.foreground;
                                        }
                                        Text {
                                            text: root.strings.settings-shellmenu-hint;
                                            font-size: 11px;
                                            color: Theme.foreground.with-alpha(0.55);
                                            wrap: word-wrap;
                                        }
                                    }
                                    CheckBox {
                                        checked <=> root.shell-menu-enabled;
                                        toggled => { root.shell-menu-changed(self.checked); }
                                    }
                                }
                            }
                        }
                        // The list below only makes sense if the integration is
                        // active → greyed out/hidden otherwise.
                        if root.platform-windows && root.ow-subtab == 1 && root.shell-menu-enabled : Text {
                            text: root.strings.settings-shellext-list-hint;
                            font-size: 11px;
                            color: Theme.foreground.with-alpha(0.55);
                            wrap: word-wrap;
                        }
                        if root.platform-windows && root.ow-subtab == 1 && root.shell-menu-enabled && root.shell-ext-rows.length == 0 : Text {
                            text: root.strings.settings-shellext-empty;
                            font-size: 12px;
                            color: Theme.foreground.with-alpha(0.45);
                            height: 40px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        if root.platform-windows && root.ow-subtab == 1 && root.shell-menu-enabled && root.shell-ext-rows.length > 0 : Rectangle {
                            background: Theme.alternate-background.with-alpha(0.5);
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                for sx in root.shell-ext-rows : Rectangle {
                                    height: 28px;
                                    border-radius: 5px;
                                    background: sxrow.has-hover ? Theme.alternate-background : transparent;
                                    sxrow := TouchArea { }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 4px;
                                        spacing: 6px;
                                        Text {
                                            text: sx.label;
                                            font-size: 13px;
                                            color: Theme.foreground;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        CheckBox {
                                            checked: sx.enabled;
                                            toggled => { root.shell-ext-toggle(sx.label, self.checked); }
                                        }
                                    }
                                }
                            }
                        }
                        // End spring: absorbs the free space → the
                        // cards/tabs keep their natural height even when
                        // the list is empty or hidden.
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        // ===== Context menu of a keyboard shortcut =====
        // Rendered AFTER the Settings dialog → on top of it. Gated on
        // `settings-open`: closing settings also hides this menu.
        if root.settings-open && root.shortcut-menu-open : Rectangle {
            x: min(root.shortcut-menu-x, root.width - self.width - 8px);
            y: min(root.shortcut-menu-y, root.height - self.height - 8px);
            width: 240px;
            height: 40px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 18px;
            drop-shadow-color: #000000.with-alpha(0.25);
            drop-shadow-offset-y: 4px;
            TouchArea { }
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    label: root.strings.shortcut-unassign;
                    clicked => {
                        root.shortcut-menu-open = false;
                        root.shortcut-unassign(root.shortcut-menu-action);
                    }
                }
            }
        }

        // ===== Workspaces overlay =====
        if root.workspaces-open : ModalBackdrop { }
        if root.workspaces-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 440px;
            // Adaptive height driven by the list's ACTUAL content.
            // A row measures 44px and the spacing between two rows 4px; the
            // bottom padding adds 12px, i.e. `48 * N + 8` in total. The old
            // formula started at 480px and then added these rows on top: three
            // workspaces were therefore enough to reach 620px while leaving a
            // large empty area in the ScrollView.
            property <length> ws-list-ideal-height:
                root.workspaces.length == 0
                    ? 112px
                    : 8px + root.workspaces.length * 48px;
            // 188px cover the header, Save area, separators, and list
            // title. The name-taken warning adds its own line. 300px remains
            // a readable minimum for the empty state; beyond 620px the list
            // scrolls. The window bound keeps priority on small screens.
            property <length> ws-card-ideal-height:
                188px + self.ws-list-ideal-height + (root.ws-name-taken ? 21px : 0px);
            height: min(
                parent.height - 40px,
                min(620px, max(300px, self.ws-card-ideal-height)));
            background: Theme.background;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            // Toast timer: clears the message after 2s.
            Timer {
                interval: 2s;
                running: root.ws-toast != "";
                triggered => { root.ws-toast = ""; }
            }

            // Deferred focus of the "name" field (armed by the bridge on Ctrl+S of a
            // still-unnamed workspace). Same shared component as the
            // Rename / New / Paste-conflict popups.
            DeferredLineEditFocus {
                armed <=> root.ws-name-focus-armed;
                apply-focus => { ws-name-input.focus(); }
            }

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // Header + X
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: root.strings.ws-title;
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        // "Start a new workspace" button: starts over from the
                        // 1st-launch state (1 panel, $HOME). Goes through the
                        // guard — the bridge resets+closes if the current state
                        // is clean, otherwise opens the warning dialog.
                        Rectangle {
                            width: ws-reset-text.preferred-width + 22px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: ws-reset-touch.has-hover
                                ? Theme.accent-background
                                : Theme.border;
                            background: ws-reset-touch.has-hover
                                ? Theme.alternate-background
                                : transparent;
                            ws-reset-text := Text {
                                text: root.strings.ws-reset;
                                font-size: 12px;
                                color: Theme.foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ws-reset-touch := TouchArea {
                                mouse-cursor: pointer;
                                // The bridge decides: direct reset + close, or
                                // opening the dialog (which then closes itself).
                                clicked => { root.ws-reset-guarded(); }
                            }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            background: ws-close-touch.has-hover ? Tokens.danger.with-alpha(0.27) : transparent;
                            Image {
                                source: @image-url("../../assets/icons/close.svg");
                                width: 14px;
                                height: 14px;
                                colorize: ws-close-touch.has-hover ? Tokens.danger : Theme.foreground.with-alpha(0.7);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ws-close-touch := TouchArea {
                                clicked => { root.workspaces-open = false; }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // --- "Save" area (fixed, at the top) ---
                Rectangle {
                    background: Theme.alternate-background.with-alpha(0.35);
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: root.strings.ws-save-section;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.foreground.with-alpha(0.55);
                            letter-spacing: 0.5px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            height: 34px;
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Theme.background;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: ws-name-input.has-focus
                                    ? Theme.accent-background
                                    : Theme.border;
                                ws-name-input := EditTextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    text: "";
                                    font-size: 13px;
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                    single-line: true;
                                    selection-background-color: Theme.accent-background.with-alpha(0.5);
                                    accepted => {
                                        if (self.text != "" && !root.ws-name-taken) {
                                            root.ws-save-new(self.text);
                                            self.text = "";
                                        }
                                    }
                                    changed text => { root.ws-name-check(self.text); }
                                    Text {
                                        x: 0;
                                        visible: ws-name-input.text == "";
                                        text: root.strings.ws-name-placeholder;
                                        font-size: 13px;
                                        color: Theme.foreground.with-alpha(0.4);
                                        vertical-alignment: center;
                                        height: parent.height;
                                    }
                                }
                            }
                            // Save button — disabled if the field is empty or if
                            // the name already exists (live validation by the bridge).
                            Rectangle {
                                width: 104px;
                                height: 34px;
                                border-radius: 6px;
                                property <bool> active: ws-name-input.text != "" && !root.ws-name-taken;
                                opacity: self.active ? 1.0 : 0.45;
                                background: save-touch.has-hover && self.active
                                    ? Theme.accent-background.with-alpha(0.85)
                                    : Theme.accent-background;
                                Text {
                                    text: root.strings.ws-save-btn;
                                    font-size: 12px;
                                    color: Theme.accent-foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                save-touch := TouchArea {
                                    enabled: parent.active;
                                    clicked => {
                                        root.ws-save-new(ws-name-input.text);
                                        ws-name-input.text = "";
                                    }
                                }
                            }
                        }
                        if root.ws-name-taken : Text {
                            text: root.strings.ws-name-taken;
                            font-size: 11px;
                            color: Tokens.danger;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }

                // --- "My workspaces (N)" section + scrollable list ---
                Rectangle {
                    height: 14px;
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    Text {
                        text: root.strings.ws-saved-section + "  (" + root.workspaces.length + ")";
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.foreground.with-alpha(0.55);
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    // Sort direction toggle button (newest <-> oldest). The arrow
                    // indicates the current direction (down = most recent on top).
                    Rectangle {
                        width: ws-sort-text.preferred-width + 46px;
                        height: 22px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: ws-sort-touch.has-hover
                            ? Theme.accent-background
                            : Theme.border;
                        background: ws-sort-touch.has-hover
                            ? Theme.alternate-background
                            : transparent;
                        HorizontalLayout {
                            spacing: 5px;
                            alignment: center;
                            Rectangle {
                                width: 12px;
                                Image {
                                    source: root.ws-sort-newest-first
                                        ? @image-url("../../assets/icons/arrow-down.svg")
                                        : @image-url("../../assets/icons/arrow-up.svg");
                                    width: 12px;
                                    height: 12px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Theme.foreground;
                                }
                            }
                            ws-sort-text := Text {
                                text: root.ws-sort-newest-first
                                    ? root.strings.ws-sort-newest
                                    : root.strings.ws-sort-oldest;
                                font-size: 11px;
                                color: Theme.foreground;
                                vertical-alignment: center;
                            }
                        }
                        ws-sort-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.ws-toggle-sort(); }
                        }
                    }
                }
                Rectangle { height: 8px; }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 12px;
                        spacing: 4px;

                        // Empty state (title + bootstrap hint).
                        if root.workspaces.length == 0 : VerticalLayout {
                            padding-top: 30px;
                            spacing: 6px;
                            Text {
                                text: root.strings.ws-empty;
                                font-size: 13px;
                                color: Theme.foreground.with-alpha(0.6);
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.strings.ws-empty-hint;
                                font-size: 12px;
                                color: Theme.foreground.with-alpha(0.4);
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        for ws[wi] in root.workspaces : WorkspaceRow {
                            name: ws.name;
                            panels: ws.panels;
                            tabs: ws.tabs;
                            is-current: ws.is-current;
                            is-dirty: ws.is-dirty;
                            strings: root.strings;
                            // Load GOES THROUGH the guard: the bridge loads
                            // directly if nothing is pending, otherwise it opens the
                            // dialog (which itself closes the overlay once loaded).
                            load => { root.ws-load-guarded(ws.id); }
                            // "Update" (amber pill) = save the current
                            // state, 1 direct click (clear intent). The hover ⟳
                            // of ANOTHER row keeps its 2-step confirmation.
                            update-now => { root.ws-overwrite(ws.id); }
                            overwrite => { root.ws-overwrite(ws.id); }
                            delete => { root.ws-delete(ws.id); }
                            rename(n) => { root.ws-rename(ws.id, n); }
                        }
                    }
                }

                // --- Feedback toast (bottom band, auto-dismiss) ---
                if root.ws-toast != "" : Rectangle {
                    height: 34px;
                    background: Theme.accent-background.with-alpha(0.15);
                    Rectangle { y: 0; height: 1px; background: Theme.border; }
                    Image {
                        source: @image-url("../../assets/icons/check.svg");
                        width: 13px;
                        height: 13px;
                        colorize: Theme.foreground;
                        x: 16px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.ws-toast;
                        font-size: 12px;
                        color: Theme.foreground;
                        x: 37px;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                }
            }
        }

        // ===== Rename popup =====
        // Lightweight modal: title + current name + LineEdit + Cancel/Rename.
        // The backdrop absorbs clicks (TouchArea with no handler); only X / Escape
        // / Cancel / Enter close it.
        if root.rename-popup-open : ModalBackdrop { }
        if root.rename-popup-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: 244px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            // Deferred focus (armed on opening): focus + caret before
            // a file's extension, or at the end for a folder.
            DeferredLineEditFocus {
                armed <=> root.rename-focus-armed;
                apply-focus => {
                    rename-edit.focus();
                    let offset = root.filename-caret-offset(
                        root.rename-new-name, root.rename-current-is-dir);
                    rename-edit.set-selection-offsets(offset, offset);
                }
            }

            VerticalBox {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: root.strings.rename-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                Text {
                    text: root.strings.rename-current-prefix + root.rename-current-name;
                    color: Theme.foreground.with-alpha(0.7);
                    font-size: 12px;
                    overflow: elide;
                }
                rename-edit := EditLineEdit {
                    placeholder-text: root.strings.rename-new-placeholder;
                    text <=> root.rename-new-name;
                    // Live validation carried by the widget — same mechanism as the
                    // paste-conflict popup (`pc-edit`). Avoids a global
                    // `changed` that would call back into Rust on every write to the property,
                    // including those made by the bridge on opening.
                    edited(t) => { root.rename-check(t); }
                    accepted(t) => {
                        // Confirmation blocked on conflict (same guard as paste).
                        if (!root.rename-conflict && t != "") {
                            root.rename-confirmed(t);
                            root.rename-popup-open = false;
                        }
                    }
                }
                // Why the name is refused: already taken, or unusable on this
                // filesystem. The bridge decides and translates.
                Text {
                    text: root.rename-name-error == "" ? " " : root.rename-name-error;
                    color: Tokens.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.strings.btn-cancel;
                        clicked => { root.rename-popup-open = false; }
                    }
                    if root.rename-replace-available : Button {
                        text: root.strings.rename-force-replace;
                        clicked => {
                            if (root.rename-force-replace(root.rename-new-name)) {
                                root.rename-popup-open = false;
                            }
                        }
                    }
                    Button {
                        text: root.strings.rename-confirm;
                        primary: true;
                        enabled: !root.rename-conflict && root.rename-new-name != "";
                        clicked => {
                            root.rename-confirmed(root.rename-new-name);
                            root.rename-popup-open = false;
                        }
                    }
                }
            }
        }

        // ===== New folder / file / shortcut popup (empty-area) =====
        // Same modal pattern as Rename: backdrop + centered card + deferred
        // focus (caret adapted to the type). `create-kind` picks the title/action; shortcut
        // mode (2) adds a "Target" field → taller card.
        if root.create-popup-open : ModalBackdrop { }
        if root.create-popup-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: root.create-kind == 2 ? 290px : (root.create-kind == 3 ? 258px : 220px);
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            DeferredLineEditFocus {
                armed <=> root.create-focus-armed;
                apply-focus => {
                    create-edit.focus();
                    // Only kind 0 is a folder. File, .lnk shortcut and
                    // symlink are all file entries and share the rule.
                    let offset = root.filename-caret-offset(
                        root.create-name, root.create-kind == 0);
                    create-edit.set-selection-offsets(offset, offset);
                }
            }

            VerticalBox {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: root.create-kind == 0
                        ? root.strings.ctx-new-folder
                        : (root.create-kind == 1 ? root.strings.ctx-new-file
                            : (root.create-kind == 2 ? root.strings.ctx-new-shortcut
                                : root.strings.ctx-create-link));
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                create-edit := EditLineEdit {
                    placeholder-text: root.strings.create-placeholder;
                    text <=> root.create-name;
                    accepted(t) => {
                        if (root.create-can-confirm
                            && root.create-confirmed(root.create-kind, t, root.create-target)) {
                            root.create-popup-open = false;
                            // Returns focus to the view: a second Enter press opens
                            // the freshly created entry, which is selected.
                            key-scope.focus();
                        }
                    }
                }
                if root.create-kind == 0 || root.create-kind == 1 : Text {
                    text: root.create-name-error == "" ? " " : root.create-name-error;
                    color: Tokens.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                // Shortcut mode only. Two tabs, Folder / File:
                // they determine the type of "Browse…" picker (folder vs
                // file) — creating the .lnk is identical either way.
                if root.create-kind == 2 : HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    Button {
                        text: root.strings.prop-kind-folder;
                        primary: root.create-shortcut-folder;
                        clicked => { root.create-shortcut-folder = true; }
                    }
                    Button {
                        text: root.strings.prop-kind-file;
                        primary: !root.create-shortcut-folder;
                        clicked => { root.create-shortcut-folder = false; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                // "Target" field — the path can be typed OR chosen via the
                // native picker ("Browse…", folder or file depending on the tab).
                if root.create-kind == 2 : HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Text {
                        text: root.strings.create-shortcut-target;
                        font-size: 12px;
                        color: Theme.foreground.with-alpha(0.6);
                        vertical-alignment: center;
                    }
                    LineEdit {
                        placeholder-text: root.strings.create-shortcut-target;
                        text <=> root.create-target;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: root.strings.create-browse;
                        clicked => { root.create-browse-target(); }
                    }
                }
                // "Create link" mode (kind 3): Shortcut
                // (.lnk, Windows) / Symlink tabs, then a reminder of the target (selected
                // file). The link is created in the current folder.
                if root.create-kind == 3 : HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    // .lnk shortcut tab: Windows only.
                    if root.platform-windows : Button {
                        text: root.strings.ctx-create-link;
                        primary: !root.create-link-symlink;
                        clicked => { root.create-link-symlink = false; }
                    }
                    Button {
                        text: root.strings.create-symlink-tab;
                        primary: root.create-link-symlink;
                        clicked => { root.create-link-symlink = true; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.create-kind == 3 : Text {
                    text: "→ " + root.create-target;
                    font-size: 11px;
                    color: Theme.foreground.with-alpha(0.55);
                    overflow: elide;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.strings.btn-cancel;
                        clicked => { root.create-popup-open = false; }
                    }
                    Button {
                        text: root.strings.create-confirm;
                        primary: true;
                        enabled: root.create-can-confirm;
                        clicked => {
                            if (root.create-confirmed(
                                root.create-kind, root.create-name, root.create-target
                            )) {
                                root.create-popup-open = false;
                                key-scope.focus(); // focus view → 2nd Enter opens the created entry
                            }
                        }
                    }
                }
            }
        }

        // ===== "Permanent deletion" popup =====
        // Shared between network-without-trash and Shift+Delete. Delete button is
        // secondary (not primary): the action is irreversible, Cancel comes first.
        if root.delete-warning-open : ModalBackdrop { }
        if root.delete-warning-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 460px;
            height: 196px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            VerticalBox {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: root.strings.net-delete-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                Text {
                    text: root.delete-warning-permanent
                        ? root.strings.permanent-delete-body
                        : root.strings.net-delete-body;
                    wrap: word-wrap;
                    color: Theme.foreground;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    padding: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.strings.btn-cancel;
                        clicked => { root.delete-warning-open = false; }
                    }
                    Button {
                        // "Delete permanently" (NOT "trash": on
                        // a network volume the deletion is irreversible).
                        text: root.strings.net-delete-confirm;
                        clicked => {
                            root.delete-warning-confirmed();
                            root.delete-warning-open = false;
                        }
                    }
                }
            }
        }

        // ===== "Unsaved changes" dialog (safety guard) =====
        // Opens when asked to load ANOTHER workspace while
        // the current one has unsaved changes. Rendered at the
        // window level (after the Workspaces overlay, which stays open behind it)
        // to layer cleanly on top. Three outcomes: load without saving
        // (red, destructive, on the left), Cancel (neutral / cross), save
        // and load (primary = default). Title & body are interpolated by the bridge.
        // Dim absorbs clicks WITHOUT closing (default): this warning needs an
        // explicit choice from its own buttons.
        if root.ws-dirty-warn-open : ModalBackdrop { }
        if root.ws-dirty-warn-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 500px;
            height: 240px;
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            // Close cross (= Cancel) in the top-right corner.
            close-x := TouchArea {
                x: parent.width - 34px;
                y: 10px;
                width: 24px;
                height: 24px;
                mouse-cursor: pointer;
                clicked => { root.ws-dirty-warn-open = false; }
                Image {
                    width: 14px;
                    height: 14px;
                    source: @image-url("../../assets/icons/close.svg");
                    colorize: close-x.has-hover ? Theme.foreground : Theme.foreground.with-alpha(0.5);
                }
            }

            VerticalBox {
                padding: 18px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 10px;
                    Image {
                        width: 22px;
                        height: 22px;
                        source: @image-url("../../assets/icons/alert-triangle.svg");
                        colorize: Tokens.warning;
                    }
                    Text {
                        text: root.ws-dirty-title-text;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.foreground;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        wrap: word-wrap;
                    }
                    Rectangle { width: 20px; } // reserves space for the cross
                }
                Text {
                    text: root.ws-dirty-body-text;
                    wrap: word-wrap;
                    color: Theme.foreground.with-alpha(0.8);
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    // Destructive on the left (red ghost): executes the pending
                    // action WITHOUT saving — loads the target, or starts
                    // fresh if the pending action is a "new workspace".
                    WsButton {
                        label: root.strings.ws-dirty-discard;
                        danger: true;
                        clicked => {
                            if (root.ws-dirty-reset) { root.ws-reset(); }
                            else { root.ws-load(root.ws-dirty-target-id); }
                            root.ws-dirty-warn-open = false;
                            root.workspaces-open = false;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // Neutral: Cancel.
                    WsButton {
                        label: root.strings.btn-cancel;
                        clicked => { root.ws-dirty-warn-open = false; }
                    }
                    // Primary (default): save the current one THEN load the target.
                    WsButton {
                        label: root.strings.ws-dirty-save-load;
                        primary: true;
                        clicked => { root.ws-save-and-load(); }
                    }
                }
            }
        }

        // ===== Paste conflict popup =====
        // Opens when a pasted item has a name that already exists in the
        // folder. The user confirms the proposed name (`… - Copy01`) or
        // types another one (protected against collisions). Opening/closing
        // is driven by the bridge (chaining multiple conflicts).
        if root.paste-conflict-open : ModalBackdrop { }
        if root.paste-conflict-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 520px;
            height: 300px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;

            DeferredLineEditFocus {
                armed <=> root.paste-conflict-focus-armed;
                apply-focus => {
                    pc-edit.focus();
                    let offset = root.filename-caret-offset(
                        root.paste-conflict-name, root.paste-conflict-is-dir);
                    pc-edit.set-selection-offsets(offset, offset);
                }
            }

            VerticalBox {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: root.strings.paste-conflict-title;
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.foreground;
                }
                Text {
                    text: root.paste-conflict-original;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.foreground.with-alpha(0.8);
                    overflow: elide;
                }
                Text {
                    text: root.strings.paste-conflict-hint;
                    font-size: 12px;
                    color: Theme.foreground.with-alpha(0.55);
                    wrap: word-wrap;
                }
                pc-edit := EditLineEdit {
                    text <=> root.paste-conflict-name;
                    edited(t) => { root.paste-conflict-check(t); }
                    accepted(t) => {
                        if (!root.paste-conflict-name-taken && t != "") {
                            root.paste-conflict-confirm(t);
                        }
                    }
                }
                Text {
                    text: root.paste-conflict-name-taken ? root.strings.paste-conflict-taken : " ";
                    font-size: 11px;
                    color: Tokens.danger;
                }
                Rectangle { vertical-stretch: 1; }
                // Row 1 — replace (this item / all) · skip. HIDDEN for
                // a copy within the same folder (rename only).
                if !root.paste-conflict-rename-only : HorizontalBox {
                    padding: 0px;
                    Button {
                        text: root.strings.paste-conflict-replace;
                        clicked => { root.paste-conflict-replace(); }
                    }
                    Button {
                        text: root.strings.paste-conflict-replace-all;
                        clicked => { root.paste-conflict-replace-all(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.strings.paste-conflict-skip;
                        clicked => { root.paste-conflict-skip(); }
                    }
                    Button {
                        text: root.strings.paste-conflict-skip-all;
                        clicked => { root.paste-conflict-skip-all(); }
                    }
                }
                // Row 2 — cancel / rename.
                HorizontalBox {
                    padding: 0px;
                    Button {
                        text: root.strings.btn-cancel;
                        clicked => {
                            root.paste-conflict-open = false;
                            root.paste-conflict-cancel();
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.strings.paste-conflict-confirm;
                        primary: true;
                        enabled: !root.paste-conflict-name-taken && root.paste-conflict-name != "";
                        clicked => { root.paste-conflict-confirm(root.paste-conflict-name); }
                    }
                }
            }
        }

        // ===== Non-blocking progress toasts, stacked bottom-right =====
        // Cards are drawn upwards from the bottom corner. Past the third one the
        // stack would eat the window, so the remainder is summarised by the chip
        // below. Each card runs its own auto-dismiss countdown.
        for op[i] in root.ops : ProgressToast {
            visible: i < 3;
            x: parent.width - self.width - 16px;
            y: parent.height - 16px - (i + 1) * 88px - i * 8px;
            op-state: op.state;
            progress: op.progress;
            indeterminate: op.indeterminate;
            title: op.title;
            detail: op.detail;
            percent: op.percent;
            cancel-label: root.strings.btn-cancel;
            cancel => { root.op-cancel(op.id); }
            dismiss => { root.op-dismiss(op.id); }
        }
        // Sits one slot above the third card, on the same right edge.
        if root.ops.length > 3 : Rectangle {
            x: parent.width - self.width - 16px;
            y: parent.height - 16px - 3 * 88px - 3 * 8px - 32px;
            width: 360px;
            height: 32px;
            background: Theme.background;
            border-radius: Tokens.radius-overlay;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;
            // Absorbs clicks on the chip (but NOT elsewhere → non-blocking).
            TouchArea { }
            Text {
                text: root.ops-more-text;
                font-size: 12px;
                color: Theme.foreground.with-alpha(0.7);
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // ===== Drag-and-drop indicator — pill following the cursor =====
        // Icon, tint and label reflect the action in real time: open with
        // the executable target, copy (Ctrl), or move/menu.
        if root.file-drag-active : Rectangle {
            // Window-relative position provided by file-drag-progress, offset to
            // stay beside the cursor (not underneath it).
            x: root.file-drag-abs-x + 14px;
            y: root.file-drag-abs-y + 12px;
            width: drag-feedback-row.preferred-width + 18px;
            height: 26px;
            border-radius: 7px;
            // The NON-DROPPABLE ZONE takes priority: red pill + "forbidden" icon +
            // cancel label, instead of move/copy/open-with. A
            // single element (no separate floating badge) → lighter display.
            background: root.file-drop-will-cancel
                ? Tokens.danger
                : (root.file-drag-target-exec
                    ? Tokens.warning
                    : (root.file-drag-copy ? Tokens.success : Theme.accent-background));
            drop-shadow-blur: 10px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drag-feedback-row := HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                spacing: 7px;
                // An Image directly nested in a Layout is top-aligned
                // by Slint. The full-height slot guarantees vertical centering.
                Rectangle {
                    width: 15px;
                    Image {
                        width: 15px;
                        height: 15px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: root.file-drop-will-cancel
                            ? @image-url("../../assets/icons/no-drop.svg")
                            : (root.file-drag-target-exec
                                ? @image-url("../../assets/icons/application.svg")
                                : (root.file-drag-copy
                                    ? @image-url("../../assets/icons/plus.svg")
                                    : @image-url("../../assets/icons/move.svg")));
                        colorize: Theme.accent-foreground;
                    }
                }
                // Non-droppable zone: the "forbidden" icon is enough → no
                // label (the pill shrinks to the icon's round dot).
                if !root.file-drop-will-cancel : Text {
                    text: root.file-drag-target-exec
                        ? root.strings.drag-open-with
                        : (root.file-drag-copy ? root.strings.drop-copy : root.strings.drop-move);
                    font-size: 11px;
                    color: Theme.accent-foreground;
                    vertical-alignment: center;
                }
            }
        }

        // ===== GLOBAL "notice" toast (bottom-center, non-blocking) =====
        // Transient feedback for silent cases (e.g. access denied to an
        // unreadable folder, which would otherwise look like an empty folder). Subtle
        // "danger" tint + lock icon. Auto-dismiss after 2.8s.
        if root.notice-text != "" : notice-box := Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 18px;
            height: 38px;
            width: notice-row.preferred-width + 32px;
            border-radius: 10px;
            // Tint based on tone: success green · info accent · danger red.
            property <color> tone-color: root.notice-tone == 1
                ? Tokens.success
                : (root.notice-tone == 2 ? Theme.accent-background : Tokens.danger);
            background: root.notice-tone == 1
                ? (Theme.dark ? #1e2a1c : #eef4e8)
                : (root.notice-tone == 2
                    ? (Theme.dark ? #1c2530 : #e9eff8)
                    : (Theme.dark ? #2a1c20 : #fbe9ea));
            border-width: 1px;
            border-color: self.tone-color.with-alpha(0.45);
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000.with-alpha(0.30);
            drop-shadow-offset-y: 3px;
            notice-row := HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 9px;
                Image {
                    width: 15px;
                    height: 15px;
                    y: (parent.height - self.height) / 2;
                    // 0 lock · 1 open lock · 2 check · 3 bookmark.
                    source: root.notice-icon == 1
                        ? @image-url("../../assets/icons/unlock.svg")
                        : (root.notice-icon == 2
                            ? @image-url("../../assets/icons/check.svg")
                            : (root.notice-icon == 3
                                ? @image-url("../../assets/icons/bookmark.svg")
                                : @image-url("../../assets/icons/lock.svg")));
                    colorize: notice-box.tone-color;
                }
                Text {
                    text: root.notice-text;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: Theme.foreground;
                    vertical-alignment: center;
                }
            }
        }
        Timer {
            interval: root.notice-duration;
            running: root.notice-text != "";
            triggered => { root.notice-text = ""; }
        }
        // Auto-expand: a collapsed container hovered during a drag
        // expands after a short delay (in-place insertion on the bridge side → the ongoing
        // drag survives). The countdown restarts on every change of
        // hovered container.
        fav-autoexp-timer := Timer {
            interval: 650ms;
            running: root.fav-drag-active && root.fav-drag-hover-container != "";
            triggered => { root.fav-expand(root.fav-drag-hover-container); }
        }
        // Also auto-expands during a TAB or FILE drag over a
        // collapsed container — makes the gesture consistent with internal drag.
        // `root.fav-ext-collapsed` (declared at the root) tracks
        // `fav-panel.hover-collapsed-container`; its `changed` (at the root) restarts
        // this countdown.
        fav-autoexp-ext-timer := Timer {
            interval: 650ms;
            running: (root.drag-active || root.file-drag-active)
                && root.fav-ext-collapsed != "";
            triggered => { root.fav-expand(root.fav-ext-collapsed); }
        }
        Timer {
            interval: 50ms;
            running: root.file-drag-refresh-pending && !root.file-drag-active
                && !root.file-drop-menu-open && !root.op-busy;
            triggered => {
                root.file-drag-refresh-pending = false;
                root.refresh();
            }
        }
        // Drive change detection: subst, USB, `net use`,
        // mount… don't always emit a system event. We probe the
        // signature only while the "Locations" panel is open;
        // the bridge only rebuilds the sidebar if it changed (near-zero cost).
        Timer {
            interval: 1500ms;
            running: root.left-panel == 1;
            triggered => { root.poll-drives(); }
        }
        // Cross-instance IPC init: shortly after startup (the window
        // exists → HWND available for tagging + subclassing). RETRIES as long
        // as the bridge returns `false` (window not found yet).
        ipc-init-timer := Timer {
            interval: 250ms;
            running: true;
            triggered => { if (root.init-ipc()) { ipc-init-timer.running = false; } }
        }
        // Re-checking unavailable tabs: active ONLY as long
        // as at least one panel is; the bridge only tests `is_dir` if a
        // drive/mount changed (non-blocking otherwise).
        Timer {
            interval: 2s;
            running: root.any-unavailable;
            triggered => { root.recheck-unavailable(); }
        }
        // Closes the "Open with", "New", and Windows shell sub-menu cascade
        // flyouts when neither the parent entry nor the flyout is hovered
        // (small delay → tolerates passing through the gap between them).
        FlyoutCloseTimer {
            open <=> root.ow-menu-open;
            parent-hover: root.ow-parent-hover;
            flyout-hover: root.ow-flyout-hover;
        }
        FlyoutCloseTimer {
            open <=> root.new-menu-open;
            parent-hover: root.new-parent-hover;
            flyout-hover: root.new-flyout-hover;
        }
        FlyoutCloseTimer {
            open <=> root.ctx-shell-sub-open;
            parent-hover: root.ctx-shell-sub-parent-hover;
            flyout-hover: root.ctx-shell-sub-flyout-hover;
        }

        // ===== "Custom command" popup — rendered LAST
        // (so it sits above Settings → editing from the "Open with" tab).
        if root.ow-popup-open : ModalBackdrop { }
        if root.ow-popup-open : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 520px;
            // Sized to its OWN content — the form plus the pinned footer — so
            // every field (down to the last checkbox) shows without scrolling,
            // in any language and whether or not the Windows admin row is there.
            // Clamped to the window (the card is centred): only on a short window
            // (or at 150% scale) does the form fall back to scrolling.
            // `max(preferred, min)`: a bare LineEdit and a Button declare a
            // preferred height of 0 with a minimum of 32, so summing the
            // preferred alone can under-measure the card and make the form
            // scroll on a screen that had room for it.
            height: min(
                max(owp-form.preferred-height, owp-form.min-height)
                    + max(owp-footer.preferred-height, owp-footer.min-height) + 3px,
                parent.height - 32px);
            background: Theme.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.with-alpha(0.35);
            drop-shadow-offset-y: 6px;
            Timer {
                interval: 1ms;
                running: root.ow-popup-focus-armed;
                triggered => {
                    owp-name.focus();
                    owp-name.set-selection-offsets(0, 99999);
                    root.ow-popup-focus-armed = false;
                }
            }
            // Card body: a scrollable form ABOVE a pinned footer. The footer
            // (Cancel/Save) lives outside the scroll area so it stays visible
            // however tall the form is or however short the window — the user
            // never has to scroll to reach it. The form itself still scrolls as
            // a fallback on a very short window (or at 150% scale) instead of
            // spilling past the card's edges.
            VerticalLayout {
            ScrollView {
                vertical-stretch: 1;
            owp-form := VerticalBox {
                padding: 18px;
                spacing: 11px;   // a bit more breathing room between fields
                Text { text: root.strings.ow-title; font-size: 16px; font-weight: 700; color: Theme.foreground; }
                Text { text: root.strings.ow-name; font-size: 10px; font-weight: 600; color: Theme.foreground.with-alpha(0.55); }
                owp-name := EditLineEdit { text <=> root.ow-popup-name; }
                Text { text: root.strings.ow-program; font-size: 10px; font-weight: 600; color: Theme.foreground.with-alpha(0.55); }
                // OS/Store app (association, no exe): FIXED field + label — avoids an
                // editable empty field the user might mistake for broken.
                if root.ow-popup-is-store : Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.alternate-background.with-alpha(0.45);
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: root.strings.ow-store-program;
                            font-size: 12px;
                            font-italic: true;
                            color: Theme.foreground.with-alpha(0.55);
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                // Editable program + "Browse…" button (native exe picker).
                if !root.ow-popup-is-store : HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    LineEdit { text <=> root.ow-popup-program; horizontal-stretch: 1; edited(t) => { root.ow-popup-changed(); } }
                    Button { text: "…"; clicked => { root.ow-browse(); } }
                }
                Text { text: root.strings.ow-args; font-size: 10px; font-weight: 600; color: Theme.foreground.with-alpha(0.55); }
                owp-args := HintEdit { hint: "{file}"; text <=> root.ow-popup-args; edited(t) => { root.ow-popup-changed(); } }
                // Tag insertion buttons, one per tag the core substitutes.
                // The label sits on its OWN line: sharing a row with six
                // buttons left too little room in longer languages and at 150%
                // scale. Hovering a button explains what it stands for.
                Text { text: root.strings.ow-tags; font-size: 11px; color: Theme.foreground.with-alpha(0.55); }
                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    for t in [
                        { tag: "{file}", hint: root.strings.ow-tag-file },
                        { tag: "{dir}", hint: root.strings.ow-tag-dir },
                        { tag: "{dirname}", hint: root.strings.ow-tag-dirname },
                        { tag: "{name}", hint: root.strings.ow-tag-name },
                        { tag: "{stem}", hint: root.strings.ow-tag-stem },
                        { tag: "{ext}", hint: root.strings.ow-tag-ext },
                        { tag: "{uri}", hint: root.strings.ow-tag-uri },
                        { tag: "{files}", hint: root.strings.ow-tag-files },
                    ] : Rectangle {
                        width: tagtxt.preferred-width + 14px;
                        height: 22px;
                        border-radius: 5px;
                        // Filled rather than outlined: these insert text, they
                        // are not toggles, and six more outlines next to the
                        // field borders above only added noise.
                        border-width: 1px;
                        border-color: tagta.has-hover ? Theme.accent-background : transparent;
                        background: tagta.has-hover
                            ? Theme.accent-background.with-alpha(0.18)
                            : Theme.foreground.with-alpha(0.07);
                        tagtxt := Text { text: t.tag; font-size: 11px; font-weight: 500; color: Tokens.ext; x: (parent.width - self.width)/2; vertical-alignment: center; height: parent.height; }
                        tagta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.ow-popup-args = root.ow-popup-args == "" ? t.tag : root.ow-popup-args + " " + t.tag;
                                root.ow-popup-changed();
                                // Scroll the field to the freshly appended tag:
                                // on a long command it lands out of sight and the
                                // click would otherwise look like it did nothing.
                                owp-args.focus-end();
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.owp-hovered-tag = t.hint;
                                    Tip.text = t.hint;
                                    Tip.x = self.absolute-position.x;
                                    Tip.y = self.absolute-position.y - 26px;
                                } else if (Tip.text == t.hint) {
                                    root.owp-hovered-tag = "";
                                    Tip.text = "";
                                }
                            }
                        }
                    }
                    // The row leaves room to spare: spend it on the hovered
                    // tag's meaning, so learning the six tags doesn't require
                    // six separate hovers.
                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            x: 0;
                            height: parent.height;
                            text: root.owp-hovered-tag;
                            font-size: 10px;
                            color: Theme.foreground.with-alpha(0.55);
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                // Command preview. Monospace and wrapped over two lines rather
                // than elided: elision cut the END of the line, which is exactly
                // the arguments being typed. Argument boundaries are quoted by
                // the bridge, so a path containing spaces no longer reads as two
                // arguments.
                Text { text: root.strings.ow-preview; font-size: 10px; font-weight: 600; color: Theme.foreground.with-alpha(0.55); }
                Text {
                    text: root.ow-popup-preview;
                    font-family: "monospace";
                    font-size: 11px;
                    color: Theme.foreground.with-alpha(0.85);
                    wrap: word-wrap;
                    height: 26px;   // two lines at 11px; beyond that, elide
                    overflow: elide;
                }
                // How many processes this will start — the rule that decides it
                // (a tag in the arguments) was otherwise invisible.
                Text {
                    text: root.ow-popup-runs;
                    font-size: 10px;
                    color: Theme.foreground.with-alpha(0.55);
                    overflow: elide;
                }
                // "Custom default app": extensions opened with this
                // program on double-click, instead
                // of the OS default. Hoverable label → explanatory tooltip.
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    Rectangle {
                        width: owdef-txt.preferred-width;
                        owdef-txt := Text {
                            text: root.strings.ow-default-ext;
                            font-size: 11px;
                            color: Theme.foreground.with-alpha(0.55);
                            vertical-alignment: center;
                            height: parent.height;
                        }
                        owdef-ta := TouchArea {
                            // Signals that this label carries an explanation;
                            // nothing else marked it as hoverable.
                            mouse-cursor: help;
                            changed has-hover => {
                                if (self.has-hover) {
                                    Tip.text = root.strings.ow-default-ext-hint;
                                    Tip.x = self.absolute-position.x;
                                    Tip.y = self.absolute-position.y - 26px;
                                } else if (Tip.text == root.strings.ow-default-ext-hint) {
                                    Tip.text = "";
                                }
                            }
                        }
                    }
                    HintEdit { hint: "png, jpg"; text <=> root.ow-popup-default-ext; horizontal-stretch: 1; }
                }
                // "Where to show this command" box: groups the TWO
                // visibility settings for the per-extension "Open with" flyout and
                // the views' context menu.
                Rectangle {
                    background: Theme.alternate-background.with-alpha(0.5);
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Text {
                            text: root.strings.ow-show-in-section;
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.foreground.with-alpha(0.6);
                            letter-spacing: 0.5px;
                        }
                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            // Wrapped like its twin above: a bare Text gets
                            // squeezed by the field once the label grows, and
                            // this is the narrowest row of the popup in German.
                            Rectangle {
                                width: owused-txt.preferred-width;
                                owused-txt := Text {
                                    text: root.strings.ow-used-ext;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.55);
                                    vertical-alignment: center;
                                    height: parent.height;
                                }
                                owused-ta := TouchArea {
                                    mouse-cursor: help;
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            Tip.text = root.strings.ow-used-ext-hint;
                                            Tip.x = self.absolute-position.x;
                                            Tip.y = self.absolute-position.y - 26px;
                                        } else if (Tip.text == root.strings.ow-used-ext-hint) {
                                            Tip.text = "";
                                        }
                                    }
                                }
                            }
                            HintEdit { hint: "png, jpg"; text <=> root.ow-popup-used-ext; horizontal-stretch: 1; }
                        }
                        // Label on ITS OWN line: shared with the 3 checkboxes on
                        // a single row, it didn't leave enough room for the
                        // last label ("Background…", "Ansichtshintergrund")
                        // which overflowed in longer languages and/or at 150% scale.
                        Text {
                            text: root.strings.ow-ctx-menu;
                            font-size: 11px;
                            color: Theme.foreground.with-alpha(0.55);
                        }
                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            CheckBox { text: root.strings.ow-ctx-files; checked <=> root.ow-popup-ctx-file; }
                            CheckBox { text: root.strings.ow-ctx-dirs; checked <=> root.ow-popup-ctx-dir; }
                            CheckBox { text: root.strings.ow-ctx-background; checked <=> root.ow-popup-ctx-bg; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        // Extension filter of the FILE entry — folders and the
                        // view background have none. Shown only with that box
                        // ticked: a filter that visibly filters nothing is
                        // noise, and the popup's scarce resource is height.
                        // Indented by 18px indicator + 12px checkbox spacing so
                        // the label starts under the word "Files" it qualifies.
                        if root.ow-popup-ctx-file : HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            // Gutter + spacing = 30px, the checkbox indicator
                            // (18) plus its internal spacing (12), so the label
                            // still starts under the word "Files". The elbow
                            // arrow sits under the box it descends from, making
                            // the subordination visible rather than implied.
                            Rectangle {
                                width: 22px;
                                Image {
                                    source: @image-url("../../assets/icons/corner-down-right.svg");
                                    width: 12px;
                                    height: 12px;
                                    x: 6px;
                                    y: (parent.height - self.height) / 2;
                                    colorize: Theme.foreground.with-alpha(0.35);
                                }
                            }
                            Rectangle {
                                width: owctx-txt.preferred-width;
                                owctx-txt := Text {
                                    text: root.strings.ow-ctx-ext;
                                    font-size: 11px;
                                    color: Theme.foreground.with-alpha(0.55);
                                    vertical-alignment: center;
                                    height: parent.height;
                                }
                                owctx-ta := TouchArea {
                                    mouse-cursor: help;
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            Tip.text = root.strings.ow-ctx-ext-hint;
                                            Tip.x = self.absolute-position.x;
                                            Tip.y = self.absolute-position.y - 26px;
                                        } else if (Tip.text == root.strings.ow-ctx-ext-hint) {
                                            Tip.text = "";
                                        }
                                    }
                                }
                            }
                            // Hint "*" rather than "png, jpg": emptying the
                            // field then shows what to type to mean "every
                            // file", and tells this field apart from the two
                            // other extension fields above.
                            HintEdit { hint: "*"; text <=> root.ow-popup-ctx-ext; horizontal-stretch: 1; }
                        }
                    }
                }
                // "Run as administrator" (UAC elevation) — Windows
                // ONLY and excluding OS/Store apps (an association can't be elevated).
                // Unchecked by default and placed at the bottom, since it configures the
                // launch behavior rather than the command's visibility.
                if root.platform-windows && !root.ow-popup-is-store : HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    CheckBox {
                        text: root.strings.ow-run-as-admin;
                        checked <=> root.ow-popup-elevated;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            }
            // Footer pinned OUTSIDE the scroll body: Cancel/Save stay visible no
            // matter how tall the form grows or how short the window is. The
            // hairline marks the edge when the form scrolls under it.
            Rectangle { height: 1px; background: Theme.border; }
            owp-footer := HorizontalBox {
                padding-left: 18px;
                padding-right: 18px;
                padding-top: 12px;
                padding-bottom: 18px;
                // A custom command is always saved:
                // `ow-popup-add` stays true and no one-off mode is offered.
                Rectangle { horizontal-stretch: 1; }
                Button { text: root.strings.btn-cancel; clicked => { root.ow-popup-open = false; } }
                Button {
                    text: root.strings.fav-save;
                    primary: true;
                    enabled: root.ow-popup-valid;
                    clicked => { root.ow-popup-commit(); root.ow-popup-open = false; }
                }
            }
            }
        }

        // ===== GLOBAL tooltip — rendered VERY LAST → above
        // everything (panels, popups). Position set by the hovered button (global Tip).
        if Tip.text != "" : Rectangle {
            x: clamp(Tip.x, 4px, max(4px, parent.width - self.width - 4px));
            y: clamp(Tip.y, 4px, max(4px, parent.height - self.height - 4px));
            width: gtip.preferred-width + 14px;
            height: 24px;
            background: #1a1a1a;
            border-radius: 4px;
            drop-shadow-blur: 6px;
            drop-shadow-color: #00000066;
            gtip := Text {
                text: Tip.text;
                font-size: 11px;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

    }
}
